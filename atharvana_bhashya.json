  "0c3b3109-48f3-4331-9766-35d14cd7e5e7": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "न चक्षुषा गृह्यते नापि वाचा नान्यैर्देवैस्तपसा कर्मणा वा।",
     "ज्ञानप्रसादेन विशुद्धसत्त्वस्ततस्तु तं पश्यते निष्कलं ध्यायमानः॥ ३/१/८॥"
    ]
   }
  ],
  "ffc76c2a-6358-4e15-94f0-0d1d9123edcb": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“नान्यैर्देवैर्हरिं पश्येज्ज्ञानरूपेण वायुना।",
     "ब्रह्मणा परमज्ञानरूपेण हरिणा तथा।",
     "प्रसन्नेनैव तं पश्येदन्येऽनुज्ञाप्रदायिनः॥”",
     "इति च।",
     "षोडशकलाशरीरो न भवतीति",
     "निष्कलः।",
     "“यदा पश्यः पश्यते रुग्मवर्णम्”",
     "“आनन्दरूपममृतं यद् विभाति”",
     "इत्युक्तत्वात्।"
    ],
    "pramana": true,
    "kutra": [
     "आथर्वणोपनिषत् ३/१/३",
     "आथर्वणोपनिषत् २/२/१०"
    ],
    "variants": [
     {
      "bg_patha": "“निष्कळः”",
      "trk_patha": "“निष्कलः”"
     }
    ]
   }
  ],
  "8425d870-2ff0-418e-883c-c9886aa3083d": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "एषोऽणुरात्मा चेतसा वेदितव्यो यस्मिन् प्राणः पञ्चधा संविवेश।",
     "प्राणैश्चित्तं सर्वमोतं प्रजानां यस्मिन् विशुद्धे विभवत्येष आत्मा॥ ३/१/९॥",
     "यंयं लोकं मनसा संविभाति विशुद्धसत्त्वः कामयते यांश्च कामान्।",
     "तन्तं लोकं जयते तांश्च कामांस्तस्मादात्मज्ञं ह्यर्चयेत् भूतिकामः॥ ३/१/१०॥"
    ]
   }
  ],
