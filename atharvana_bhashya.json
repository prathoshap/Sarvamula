  "a9b10eaa-f216-406c-af11-1153c1ddc7a4": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "यथा नद्यः स्यन्दमानाः समुद्रायणाः समुद्रं प्राप्यास्तं गच्छन्ति नामरूपेऽविहाय।",
     "तथा विद्वान्नामरूपाद् विमुक्तः परात् परं पुरुषमुपैति दिव्यम्॥ ३/२/८॥"
    ]
   }
  ],
  "94206517-6409-42a7-92fb-9b9fae6e0c40": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“अगम्यनामरूपत्वादमुक्तैर्मुक्तिगा नराः।",
     "विहीननामरूपास्तु",
     "नहि",
     "तद्रहितत्वतः।",
     "अशरीरो यथा वायुः सामान्यागम्यदेहतः।",
     "एवं नद्यः समुद्रस्थाः सामान्यागम्यरूपतः॥”",
     "इति च।",
     "“स्वकीयमुदकं नद्यः समुद्रे नैव जानते।",
     "वायुस्तु तत् पृथग् ज्ञात्वा मेघे कृत्वा प्रवर्षति॥”",
     "इति च।",
     "विमुक्तः",
     "इत्यमुक्त इत्यर्थः।",
     "“विप्रियः”",
     "इतिवत्।",
     "‘अविहाय’",
     "इति च।",
     "“अनन्तं वै नाम”",
     "इति श्रुतेः।"
    ],
    "pramana": true,
    "kutra": [
     "मृग्यम्, अपाहरद् विप्रियमिति तु भागवते १/७/१४",
     "बृहदारण्यकोपनिषत् ५/२/१२"
