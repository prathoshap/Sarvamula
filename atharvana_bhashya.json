  "f4176c32-71f6-4c47-acbe-15cb1b36330b": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "स वेदैतत् परमं ब्रह्मधाम यत्र विश्वं निहितं भाति शुभ्रम्।",
     "उपासते पुरुषं ये ह्यकामास्ते शुक्रमेतदतिवर्तन्ति धीराः॥ ३/२/१॥"
    ]
   }
  ],
  "bed4f09e-d9d5-4c14-a83d-700f86ada415": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "स",
     "आत्मज्ञार्चको ब्रह्मणो धाम प्राणं",
     "वेद।",
     "यत्र विश्वं",
     "पूर्णं ब्रह्म",
     "निहितम्।",
     "“प्रधानं धाम विष्णोस्तु प्राण एव प्रकीर्तितः।",
     "उपायैर्यो विजानीयात् प्राणस्थं परमेश्वरम्।",
     "तस्य प्राणे हरिर्नित्यमाविष्टो भवति ध्रुवम्।",
     "नित्यं",
     "प्राणे स्थितस्यैव",
     "विष्णोरावेश एव हि।",
     "प्राणद्वारेण यज्ज्ञानदीपनं ज्ञानिनः सदा।",
     "सन्निधानं यथा प्राप्ताः पिशाचाः पुरुषेष्वपि।",
     "तत्र स्थित्वाऽपि भुञ्जन्त आविशेयुः पुनश्च ते।",
     "मन्त्रादिभिस्तथा विष्णुः सदा प्राणस्थितोऽपि सन्।",
     "ज्ञानदीप्त्यादिकं कुर्याज्ज्ञानिनः पुनरेव तु॥”",
     "इति च।",
     "एतच्छुक्रं",
     "प्रत्यन्यदतिवर्तन्ते।",
     "“सर्वं तीर्त्वा हरिं शुक्रं",
     "प्रतिवर्ती भवेत्",
     "पुनः।",
     "ज्ञानिनः सा हि मुक्तिः स्यात् तन्नैवात्येति कश्चन॥”",
     "इति महावाराहे।"
    ],
    "pramana": true,
    "variants": [
     {
      "bg_patha": "“प्राणस्थितस्यैव”",
      "trk_patha": "“प्राणे स्थितस्यैव”"
     },
     {
      "bg_patha": "“प्रति वृत्तिर्भवेत्”",
      "trk_patha": "“प्रतिवर्ती भवेत्”"
     },
     {
      "bg_patha": "“इति महावराहे”",
      "trk_patha": "“इति महावाराहे”"
     }
    ]
   }
