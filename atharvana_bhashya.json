  "0f74fe61-6a85-4c1b-9a7e-e902bf234184": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "तस्मादृचः साम यजूंषि दीक्षा यज्ञाश्च सर्वे क्रतवो दक्षिणाश्च।",
     "संवत्सरश्च यजमानश्च लोकाः सोमो यत्र पवते यत्र सूर्यः॥ २/१/६॥",
     "तस्माच्च देवा बहुधा सम्प्रसूताः साध्या मनुष्याः पशवो वयांसि।",
     "प्राणापानौ व्रीहियवौ तपश्च श्रद्धा सत्यं ब्रह्मचर्यं विधिश्च॥ २/१/७॥",
     "सप्त प्राणाः प्रभवन्ति तस्मात् सप्तार्चिषः समिधः सप्त होमाः।",
     "इमे लोका येषु चरन्ति प्राणा गुहाशयां निहिताः सप्तसप्त॥२/१/८॥"
    ]
   }
  ],
  "bb2cbae2-a458-4660-a084-d5cbafe070c2": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "सप्तार्चिषः",
     "वृत्तयः।",
     "होमाः",
     "सम्बन्धाः।",
     "लोकाः",
     "गोलकाः।",
     "गुहाशयां",
     "बुद्धौ।",
     "“लोपः समाने”",
     "इति सूत्रादेकयकारलोपः।",
     "प्रतिपुरुषं",
     "सप्तसप्त।"
    ],
    "pramana": true,
    "variants": [
     {
      "bg_patha": "“गोळकाः”",
      "trk_patha": "“गोलकाः”"
     }
    ]
   }
  ],
  "2a479847-9618-497d-a242-91b426198225": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "अतः समुद्राः गिरयश्च सर्वेऽस्मात् स्यन्दन्ते सिन्धवः सर्वरूपाः।",
     "अतश्च सर्वा ओषधयो रसाश्च येनैव भूतैस्तिष्ठते ह्यन्तरात्मा॥२/१/९॥",
     "पुरुष एवेदं विश्वं कर्म तपो ब्रह्म परामृतम्।",
     "एतद् यो वेद निहितं गुहायां सोऽविद्याग्रन्थिं विकिरतीह सोम्य॥ २/१/१०॥"
    ]
   }
  ],
  "a8bba305-9851-4d9c-83f3-98d51b37dc42": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "भगवतः",
     "कर्म",
     "चेष्टा",
     "तपो",
     "ज्ञानं च परामृतब्रह्माख्यः",
     "पुरुषो",
     "भगवानेव।",
     "“यैषा चेष्टा भगवतो यच्च ज्ञानं परात्मनः।",
     "तत् सर्वं भगवानेव ये च धर्मा बलादयः॥”",
     "इति च।",
     "“स्वाभाविकी ज्ञानबलक्रिया च”",
     "इति श्रुतिः।"
    ],
    "pramana": true,
    "kutra": [
     "श्वेताश्वतरोपनिषत् ६"
    ],
    "variants": [
     {
      "pathanatara": "परामूतब्रह्माख्याः इति प्राचीनकोशे इति गोविन्दाचार्याः।"
     }
    ],
    "footnote": [
     "वाक्यस्याद्यार्धभागो पूर्वखण्डे पठ्यते कृपाठे प्रमादेन।"
    ]
   }
  ],
  "cea044b0-cbcd-4ccf-9b24-0e4ee924b5b9": [
   {
    "content_type": "Colophon_Mula",
    "is_padya": false,
    "text": [
     "॥ इति द्वितीयमुण्डके प्रथमः खण्डः॥"
    ]
   }
  ],
  "86d53633-4693-42ed-823b-1977514d6a7c": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "द्वितीयमुण्डके द्वितीयः खण्डः"
    ],
    "heading_level": 1
   }
  ],
  "e169fc2c-3441-4c43-8aa4-1cd90c31b1a9": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "आविः सन्निहितं गुहाचरं नाम महत् पदम्।",
     "अत्रैतत् सर्वमर्पितमेजत् प्राणन्निमिषच्च यत्॥ २/२/१॥",
     "एतज्जानथ सदसद्वरेण्यं परं विज्ञानाद् यद्वरिष्ठं प्रजानाम्।",
     "यदर्चिमद् यदणुभ्योऽणु च यस्मिंल्लोका निहिता लोकिनश्च॥२/२/२॥"
    ]
   }
  ],
  "008bc2c7-875b-4022-ad0d-77ab9337a17b": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "विज्ञानात्",
     "ब्रह्मणः",
     "परम्।",
     "“नाभिह्रदादिह सतोऽम्भसि यस्य पुंसो विज्ञानशक्तिरहमासमनन्तशक्तेः”",
     "इति भागवते।"
    ],
    "pramana": true,
    "kutra": [
     "भागवतम् ३/१०/२४"
    ],
    "variants": [
     {
      "bg_patha": "“इति हि भागवते”",
      "trk_patha": "“इति भागवते”"
     }
    ]
   }
  ],
  "cc90e367-3a46-4fb7-892b-9260f1a87090": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "तदेतक्षरं ब्रह्म स प्राणस्तदु वाङ् मनः।",
     "तदेतत् सत्यं तदमृतं तद् वेद्धव्यं सोम्य विद्धि॥२/२/३॥"
    ]
   }
  ],
  "8e29376b-fe85-4014-b803-d472bd1b1b5b": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“प्राणः प्रणयनाद् विष्णुर्वक्तृत्वाद् वागुदीरितः।",
     "मनो मन्तृत्वतो विष्णुः सर्वजीवनियामकः॥”",
     "इति शब्दनिर्णये।"
    ],
    "pramana": true
   }
  ],
  "30d3c828-3a45-4671-b4aa-6a12060a6680": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "धनुर्गृहीत्वोपनिषदं महास्त्रं शरं ह्युपासानिशितं सन्दधीत।",
     "आयम्य तद्भावगतेन चेतसा लक्ष्यं तदेवाक्षरं सोम्य विद्धि॥ २/२/४॥",
     "प्रणवो धनुः शरो ह्यात्मा ब्रह्म तल्लक्ष्यमुच्यते।",
     "अप्रमत्तेन वेद्धव्यं शरवत् तन्मयो भवेत्॥ २/२/५॥",
     "यस्मिन् द्यौः पृथिवी चान्तरिक्षमोतं मनः सह प्राणैश्च सर्वैः।",
     "तमेवैकं जानथ आत्मानमन्या वाचो विमुञ्चथामृतस्यैष सेतुः॥ २/२/६॥"
    ]
   }
  ],
  "7c99898f-ca47-4783-bfe5-ba4230bcab55": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "अमृतस्य",
     "मुक्तस्य",
     "सेतुः।",
     "“मुक्तोपसृप्यव्यपदेशात्”",
     "“मुक्तानां परमा गतिः”",
     "इत्यादेः।"
    ],
    "pramana": true,
    "kutra": [
     "ब्रह्मसूत्रम् १/३/२",
     "भारतम् १३/१४९/१७"
    ]
   }
  ],
  "d8dab13d-e72a-42bb-8b35-66b041e6cebb": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "अरा इव रथनाभौ संहता यत्र नाड्यः स एषोन्तश्चरते बहुधा जायमानः।",
     "ओमित्येवं ध्यायत आत्मानं स्वस्ति वः पराय तमसः परस्तात्॥ २/२/७॥"
    ]
   }
  ],
  "9dd59376-09fb-45c6-b5ae-751746a29757": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“हृदयस्थः सदा विष्णुर्बहुधा",
     "चैकधा भवन्।",
     "चरति स्वेच्छयैवान्तः सर्वजीवान् नियामयन्॥”",
     "इति प्रवृत्ते।"
    ],
    "pramana": true,
    "variants": [
     {
      "bg_patha": "“चैकधाऽभवत्”",
      "trk_patha": "“चैकधा भवन्”",
      "pathanatara": "“चैकधा भवेत्” - पा।"
     }
    ]
   }
  ],
  "b6617398-09ea-483d-b467-5bd3c3f100b5": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "यः सर्वज्ञः सर्वविद् यस्यैष महिमा भुवि।",
     "दिव्ये ब्रह्मपुरे ह्येष व्योम्यात्मा प्रतिष्ठितः॥ २/२/९॥",
     "मनोमयः प्राणशरीरनेता प्रतिष्ठितोऽन्ने हृदयं सन्निधाय।",
     "तद् विज्ञानेन परिपश्यन्ति धीरा आनन्दरूपममृतं यद् विभाति॥२/२/१०॥",
     "भिद्यते हृदयग्रन्थिश्छिद्यन्ते सर्वसंशयाः।",
     "क्षीयन्ते चास्य कर्माणि तस्मिन् दृष्टे परावरे॥ २/२/११॥",
     "हिरण्मये परे कोशे विरजं ब्रह्म निष्कलम्।",
     "तच्छुभ्रं ज्योतिषां ज्योतिस्तद् यदात्मविदो विदुः॥ २/२/१२॥"
    ]
   }
  ],
  "f5ffbe0f-f4a5-4db8-bb1c-ecaf386805f8": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“परा अप्यवरा यस्मात् स हि विष्णुः परावरः।",
     "ब्रह्माण्डमध्यगो नित्यं तपत्येष रवौ स्थितः॥”",
     "इति च।"
    ],
    "pramana": true
   }
  ],
  "5f63b9b9-155a-4bba-9130-682067714236": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "न तत्र सूर्यो भाति न चन्द्रतारकं नेमा विद्युतो भान्ति कुतोऽयमग्निः।",
     "तमेव भान्तमनुभाति सर्वं तस्य भासा सर्वमिदं विभाति॥ २/२/१३॥"
    ]
   }
  ],
  "f777d569-a387-4633-a686-4be14a29913c": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "सूर्यादयस्तं न भासयन्ति।"
    ]
   }
  ],
  "ed8426d8-24d9-4d0b-8d8c-074c445ad572": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "ब्रह्मैवेदममृतं पुरस्तात् पश्चाद् ब्रह्म दक्षिणतश्चोत्तरेण।",
     "अधश्चोर्ध्वं च प्रसृतं ब्रह्मैवेदं विश्वमिदं वरिष्ठम्॥ २/२/१४॥"
    ]
   }
  ],
  "cc5b5430-4295-4c6c-92c8-6a01a72fa8bc": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "इदं ब्रह्मैव विश्वं",
     "पूर्णम्।",
     "इदमेव",
     "वरिष्ठं",
     "सर्वोत्तमम्।",
     "इदंशब्दानां बहुत्वाद् ब्रह्मविषय एवेदंशब्दः।"
    ],
    "variants": [
     {
      "bg_patha": "“इदमेव च”",
      "trk_patha": "“इदमेव”"
     }
    ]
   }
  ],
  "997a98a8-a23c-4b7a-b8ea-d6f2eba61c51": [
   {
    "content_type": "Colophon_Mula",
    "is_padya": false,
    "text": [
     "॥ इति द्वितीयमुण्डके द्वितीयः खण्डः॥"
    ]
   }
  ],
  "7b6bc84b-f7b2-484c-902d-a2014bb29831": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "तृतीयमुण्डके प्रथमः खण्डः"
