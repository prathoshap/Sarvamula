  "9c746c69-24aa-475d-a240-d3a12dea540a": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "द्वा सुपर्णा सयुजा सखाया समानं वृक्षं परिषस्वजाते।",
     "तयोरन्यः पिप्पलं स्वाद्वत्त्यनश्नन्नन्यो अभिचाकशीति॥ ३/१/१॥"
    ]
   }
  ],
  "6a747f34-723f-45dd-9cd2-0dc1eb179520": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "स्वादुवत् सर्वदाऽत्ति।",
     "नतु स्वाद्वेव।",
     "“तस्येदाहुः",
     "पिप्पलं स्वाद्वग्रे तन्नोन्नशद् यः पितरं न वेद”",
     "इत्यज्ञानां स्वादुनिषेधात्।",
     "जीवाद्यमेव नाश्नाति भगवान्।",
     "नतु नाश्नात्येव।",
     "“तस्येदाहुः",
     "पिप्पलं स्वादु”",
     "इत्युक्तत्वात्।",
     "“स्वातन्त्र्येणैव भोक्तृत्वाद् दुःखाभोगाच्च सर्वदा।",
     "अभोक्ता चैव भोक्ता च भगवान् विष्णुरव्ययः॥”",
     "इति च तत्त्वसारे।"
    ],
    "pramana": true,
    "kutra": [
     "ऋग्वेदसंहिता १/१६४/२२",
     "ऋग्वेदसंहिता १/१६४/२२"
    ],
    "variants": [
     {
      "bg_patha": "“नत्वस्वाद्वेव”",
      "trk_patha": "“नतु स्वाद्वेव”"
     },
     {
      "bg_patha": "“तस्येदाहुः”",
      "trk_patha": "“तस्येदाहुः”",
      "pathanatara": "“तस्येदमाहुः” - पा।"
     },
     {
      "bg_patha": "“तस्येदाहुः”",
      "trk_patha": "“तस्येदाहुः”",
      "pathanatara": "“तस्येदमाहुः” - पा।"
     },
     {
      "bg_patha": "“इति तत्त्वसारे”",
      "trk_patha": "“इति च तत्त्वसारे”"
     }
    ]
   }
  ],
  "661fb583-1bf7-447f-90b1-8e7d2148df24": [
   {
    "content_type": "Mula",
    "is_padya": false,
    "text": [
     "समाने वृक्षे पुरुषो निमग्नोऽनीशया शोचति मुह्यमानः।",
     "जुष्टं यदा पश्यत्यन्यमीशमस्य महिमानमिति वीतशोकः॥ ३/१/२॥"
    ]
   }
  ],
  "a5d55a71-f2a4-4094-a0e7-d611acf52618": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“नास्तीशोऽस्या यतोऽन्यो हि ततोऽनीशा हरेर्मतिः।",
     "तया मुह्यति जीवस्तमन्यं ज्ञात्वा विमुच्यते।",
     "जीवादन्यः",
     "स्वतन्त्रोऽयं",
     "यतोऽतः पुरुषोत्तमः॥”",
     "इति ब्रह्मसारे।"
    ],
    "pramana": true,
    "variants": [
     {
      "bg_patha": "“स्वतन्त्रो यो”",
      "trk_patha": "“स्वतन्त्रोऽयं”"
     }
    ]
   }
  ],
  "f3498f8b-8d1a-4e24-8ba5-a46ea05900d5": [
   {
    "content_type": "Mula",
    "is_padya": false,
    "text": [
     "यदा पश्यः पश्यते रुग्मवर्णं कर्तारमीशं पुरुषं ब्रह्मयोनिम्।",
     "तदा विद्वान् पुण्यपापे विधूय निरञ्जनः परमं साम्यमुपैति॥ ३/१/३॥"
    ]
   }
  ],
  "ce469519-ddba-4398-a663-8a9e86873adf": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "पुण्यं चानिष्टं",
     "विधूय।"
    ]
   }
  ],
  "38f611c8-e11b-4891-a612-34ac3967e188": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "प्राणो ह्येष सर्वभूतैर्विभाति विजानन् विद्वान् भवते नातिवादी।",
     "आत्मक्रीड आत्मरतिः क्रियावानेष ब्रह्मविदां वरिष्ठः॥३/१/४॥",
     "सत्येन लभ्यस्तपसा ह्येष आत्मा सम्यग्ज्ञानेन ब्रह्मचर्येण नित्यम्।",
     "अन्तःशरीरे ज्योतिर्मयो हि शुभ्रो यं पश्यन्ति यतयः क्षीणदोषाः॥ ३/१/५॥",
     "सत्यमेव जयति नानृतं सत्येन विततो देवयानः।",
     "येनाक्रमन्त्यृषयो ह्याप्तकामा यत्र तत् सत्यस्य परमं निधानम्॥ ३/१/६॥"
    ]
   }
  ],
  "8686348b-4a53-40ae-859d-c91c76cef34b": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“सत्यो हि भगवान् विष्णुः सद्गुणत्वात् प्रकीर्तितः।",
     "असुरास्तद्विरुद्धत्वादनृताः परिकीर्तिताः।",
     "तस्य विष्णोर्निधानं तु वैकुण्ठो लोक उत्तमः॥”",
     "इति च।"
    ],
    "pramana": true
   }
  ],
  "5bacbb20-9437-4c69-ad20-72ffdbf69d48": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "बृहच्च तद् दिव्यमचिन्त्यरूपं सूक्ष्माच्च तत् सूक्ष्मतरं विभाति।",
     "दूरात् सुदूरे तदिहान्तिके च पश्यत्स्विहैव निहितं गुहायाम्॥३/१/७॥"
    ]
   }
  ],
  "6af2d9c7-d462-4e6f-a013-1f7aced8dec6": [
   {
