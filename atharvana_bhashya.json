  "e9238188-4bf9-481d-8c98-1471d28ba480": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "तदेतत् सत्यं",
     "भगवान्।",
     "तत्कामाः",
     "कर्माणि",
     "आचरथ।",
     "तदा साऽपि परविद्या।",
     "अन्यथा",
     "“प्लवा ह्येते अदृढा यज्ञरूपाः”।",
     "भगवद्विषयत्वेन कृते",
     "“एष वः पुण्यः सुकृतो ब्रह्मलोकः”,",
     "परब्रह्मलोकः।",
     "“निष्कामं ज्ञानपूर्वं",
     "यन्निवृत्तमिह",
     "चोच्यते।",
     "निवृत्तं सेवमानस्तु ब्रह्माभ्येति सनातनम्॥”",
     "इति व्यासस्मृतौ।",
     "“स य आत्मानमेव लोकमुपास्ते न हास्य कर्म क्षीयते”",
     "इति च श्रुतिः।",
     "“सहयज्ञाः प्रजाः सृष्ट्वा”",
     "इत्युक्त्वा,",
     "“एवं प्रवर्तितं चक्रं नानुवर्तयतीह यः।",
     "अघायुरिन्द्रियारामो मोघं पार्थ स जीवति॥”",
     "इति च।",
     "“यान्ति मद्याजिनोऽपि माम्”",
     "इति च।",
     "“अहं हि सर्वयज्ञानां भोक्ता च प्रभुरेव च।",
     "नतु मामभिजानन्ति तत्त्वेनातश्च्यवन्ति ते॥”",
     "इति च।",
     "“यस्त्वात्मरतिः”",
     "इत्युक्त्वाऽपि",
     "“कुर्याद् विद्वांस्तथाऽसक्तः”",
     "इत्येवोक्तत्वाच्च।",
     "“ये त्वेतदभ्यसूयन्तो नानुतिष्ठन्ति मे मतम्।",
     "सर्वज्ञानविमूढांस्तान् विद्धि नष्टानचेतसः॥”",
     "इति च।",
     "“लोकेऽस्मिन् द्विविधा निष्ठा पुरा प्रोक्ता मयाऽनघ”",
     "इत्युक्तत्वाच्च",
     "नात्राश्रमान्तरविरोधः।",
     "त्रेतायां बहुधा सन्ततानि कृते त्वेकप्रकारेणैव सन्ततानि।",
     "“अग्निष्टोमादिभिर्यज्ञैः सर्वदेवस्थितं हरिम्।",
     "यजन्ति तांश्च कारित्वाद् वसुस्तस्मात् तथाऽयजत्।",
     "पृथक्पृथक् च त्रेतायां यजन्ते देवतागणान्।",
     "यथा कृते तथा प्राज्ञास्त्रेतायां बहुधा ततः॥”",
     "इति पाद्मे।",
     "“यमिन्द्रमाहुर्वरुणं यमाहुर्यं मित्रमाहुर्यमु सत्यमाहुः।",
     "यो देवानां देवतमो जनित्रो वायोस्तस्मै सोममेभ्यो जुहोमि॥”",
     "“एवं वायोः पितरं विष्णुमेव यजन्ति देवैः सह ये कृते जनाः।",
     "एवं त्रेतायां केचिदन्ये पृथक् तानिष्ट्वा विष्णावर्पयन्ते नचान्यैः॥”",
     "इति च ब्रह्माण्डे।"
    ],
    "pramana": true,
    "kutra": [
     "आथर्वणोपनिषत् १/२/७",
