  "ce7e1907-069a-4561-8c48-f328d9f9e6a5": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "‘प्रकृष्टप्रकाशश्चन्द्रः’ इत्यादिषु प्रकृष्टत्वादिविशेषणानि सन्त्येवेति न तत्साम्यम्।",
     "अनित्यदेशकालसम्बन्धित्वस्य सत्त्वान्न ‘सोऽयं देवदत्तः’ इत्याद्युपमा च।",
     "देवदत्तादिस्वरूपमात्रस्य सिद्धत्वान्न स्वरूपमात्रे प्रश्नः।",
     "नक्षत्रादिव्यतिरेकमात्रस्यापि सिद्धत्वान्न व्यतिरेकमात्रे।",
     "अन्यथा प्रश्नस्यैवासम्भवात्।",
     "अतः ‘कैर्विशेषणैर्विशिष्टः’ इति प्रश्ने प्रकृष्टप्रकाशतद्देशकालादिविशिष्ट एव वाक्यार्थः।",
     "अङ्गीक्रियमाणत्वाद् विशिष्टादेः, अनिर्वचनीयाभावाच्च सत्यत्वं च सिद्धम्।"
    ]
   }
  ],
  "2a99b4a1-62fd-4f2f-9262-da00541401a6": [
   {
    "content_type": "Heading4",
    "is_padya": false,
    "text": [
     "विशिष्टस्यानिर्वचनीयतानिरासः"
    ],
    "heading_level": 4
