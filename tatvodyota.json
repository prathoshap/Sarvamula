  "c1b57602-374d-4044-b278-644fce2fee8b": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“मय्यनन्तगुणेऽनन्ते गुणतोऽनन्तविग्रहे।",
     "यदासीत् तत एवाद्यः स्वयम्भूः समभूदजः॥”",
     "“उत्तमः पुरुषस्त्वन्यः परमात्मेत्युदाहृतः।",
     "यो लोकत्रयमाविश्य बिभर्त्यव्यय ईश्वरः॥”",
     "इति भगवद्राद्धान्तः।"
    ],
    "pramana": true,
    "kutra": [
