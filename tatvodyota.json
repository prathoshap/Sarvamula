{
 "title": "tu",
 "content": {
  "bcfd7dd2-5d56-4ba0-9a66-0afb320f8124": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "मङ्गलाचरणम्"
    ],
    "heading_level": 1
   }
  ],
  "6dfd5581-ea3d-418c-a678-57f63e32c414": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "ॐ॥ सर्वत्राखिलसच्छक्तिः स्वतन्त्रोऽशेषदर्शनः।",
     "नित्यातादृशचिच्चेत्ययन्तेष्टो नो रमापतिः॥"
    ]
   }
  ],
  "704ea682-7a29-40b5-8936-3b887f1ef78a": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "मुक्तभेदेऽनुमानम्"
    ],
    "heading_level": 1
   }
  ],
  "2a938ad0-8fc2-4020-a1e4-d823a3ae9897": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "विमतो भिन्नः, मुक्तत्वात्, यदित्थं तत् तथा, यथा सम्प्रतिपन्नः।"
    ]
   }
  ],
  "ecb2504e-5e5c-4788-969c-baf1361dd2cd": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "तत्र साध्यविकल्पनिराकरणम्"
    ],
    "heading_level": 1
   }
  ],
  "c28ae6ed-77b2-47f7-8879-23b395ec0e5d": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "नच भेदे विकल्पो युज्यते।",
     "अनिर्वचनीयस्य सर्वत्राप्रसिद्धत्वादेव।",
     "शशविषाणं गोविषाणं वोच्यत इतिवत्।"
    ]
   }
  ],
  "36c20af2-70a4-4f6f-905e-13e194b7abdb": [
   {
    "content_type": "Heading2",
    "is_padya": false,
    "text": [
     "अनिर्वचनीये प्रमाणाभावोपपादनम्"
    ],
    "heading_level": 2
   }
  ],
  "2766a21d-33aa-497a-a2ae-8343b7bfcb03": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "नचानिर्वचनीये किञ्चिन्मानम्।"
    ]
   }
  ],
  "72c7b1e7-fea5-4885-b75a-e438f7f43bc1": [
   {
    "content_type": "Heading3",
    "is_padya": false,
    "text": [
     "तत्र प्रत्यक्षनिरासः"
    ],
    "heading_level": 3
   }
  ],
  "6d1f00e6-d1b2-4849-9377-d83d54ad8258": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "मिथ्याशब्दोऽनिर्वचनीयं वदतीत्यत्र च।"
    ]
   }
  ],
  "fddad2b5-ffcf-4651-a0f9-eafcb55e9385": [
   {
    "content_type": "Heading3",
    "is_padya": false,
    "text": [
     "अनुमाननिरासः"
    ],
    "heading_level": 3
   }
  ],
  "fceb1fa7-e811-4a4a-81e7-4d47d421fefb": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "अनुमानस्य चाप्रसिद्धविशेषणः पक्षः।",
     "नच धूमत्ववन्मिथ्यात्वमित्युभयसम्प्रतिपन्नं सामान्यमस्ति।",
     "नच बाष्पारोपितधूमेन धूमवत्त्वं व्यभिचरति।"
    ]
   }
  ],
  "5deaac43-63f5-4c95-ae46-201a43af5b62": [
   {
    "content_type": "Heading3",
    "is_padya": false,
    "text": [
     "आगमनिरासः"
    ],
    "heading_level": 3
   }
  ],
  "f679bb17-60cc-4e24-a5af-8ca1b7af3d39": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "नच भावाभावविलक्षणं क्वचिदागमो वक्ति।"
    ]
   }
  ],
  "496bb3c9-3e9f-4f0a-a567-09bf68f44de1": [
   {
    "content_type": "Heading4",
    "is_padya": false,
    "text": [
     "नासदासीदिति श्रुत्यर्थविचारः"
    ],
    "heading_level": 4
   }
  ],
  "34529a7e-4a46-4694-b55e-bca726e9eaa7": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“नासदासीन्नो सदासीत् तदानीं नासीद् रजो नो व्योमापरो यत्”",
     "इत्यत्र च।",
     "पारिशेष्येणानिर्वचनीयत्वाङ्गीकारे",
     "“आनीदवातं स्वधया तदेकम्”",
     "इति तदानीं परिशिष्टत्वाद् ब्रह्मण एवानिर्वचनीयत्वं स्यात्।",
     "“मूर्तं सदिति सम्प्रोक्तममूर्तमसदुच्यते।",
     "मूर्तामूर्तेतरद् ब्रह्म न सत् तन्नासदुच्यते॥”",
     "इति पैङ्गिश्रुतिः।",
     "“यदन्यद् वायोश्चान्तरिक्षाच्चैतत् सत्”",
     "इति माध्यन्दिनश्रुतिः।"
    ],
    "pramana": true,
    "kutra": [
     "ऋग्वेदसंहिता १०/१२९/१",
     "ऋग्वेदसंहिता १०/१२९/२"
    ]
   }
  ],
  "e25875fb-4968-482c-933a-689e640c906c": [
   {
    "content_type": "Heading4",
    "is_padya": false,
    "text": [
     "श्रुतिपुराणादिगतानिर्वाच्यत्वादिशब्दानामर्थविवरणम्"
    ],
    "heading_level": 4
   }
  ],
  "594b1cc1-5be2-4371-b37d-2c911415fbe8": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“अद्भुतत्वादनिर्वाच्यं ब्रह्म चिच्चेत्यमेव च।",
     "अचिन्त्यं तत एवैतदतर्क्याज्ञेयमेव च।",
     "ऋ गताविति धातोस्तु पूर्वावगतवत् सदा।",
     "स्थितेर्ब्रह्मर्तमित्युक्तमनृतं परिणामतः।",
     "प्रकृतिप्राकृतं प्रोक्तमसत् तदशुभत्वतः।",
     "असतां बुद्धिगम्यत्वादसत्यमिति चोच्यते।",
     "नियमेन बहिश्चित्तास्ते(ऽ)सन्तो ब्रह्मणि स्थिताः।",
     "विश्वं सत्यं वशे विष्णोर्नित्यमेव प्रवाहतः।",
     "न क्वाप्यनीदृशं विश्वं तत्तत्कालानुसारतः।",
     "असत्यमप्रतिष्ठं ये जगदाहुरनीश्वरम्।",
     "त आसुरा स्वयं नष्टा जगतः क्षयकारिणः॥’",
     "इत्यादि व्यासस्मृतौ।"
    ],
    "pramana": true
   }
  ],
  "7f0a1633-0949-4fb8-b10d-0414e0a61282": [
   {
    "content_type": "Heading4",
    "is_padya": false,
    "text": [
     "विश्वसत्यत्वसमर्थकवचनानि"
    ],
    "heading_level": 4
   }
  ],
  "920d1545-da19-4ab6-ad51-3fd0fbc50b75": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“असत्यमप्रतिष्ठं ते जगदाहुरनीश्वरम्।",
     "अपरस्परसम्भूतं किमन्यत् कामहैतुकम्॥",
     "एतां दृष्टिमवष्टभ्य नष्टात्मानोऽल्पबुद्धयः।",
     "प्रभवन्त्युग्रकर्माणः क्षयाय जगतोऽहिताः॥”",
     "इत्यादि च गीतासु।",
     "“विश्वं सत्यं मघवाना युवोरिदापश्च न प्रमिनन्ति व्रतं वाम्”",
     "“प्र घा न्वस्य महतो महानि सत्या सत्यस्य करणानि वोचम्”",
     "“सत्यः सो अस्य महिमा गृणे शवो यज्ञेषु विप्रराज्ये”",
     "“कविर्मनीषी परिभूः स्वयम्भूर्याथातथ्यतोऽर्थान् व्यदधाच्छाश्वतीभ्यः समाभ्यः”",
     "इत्यादिश्रुतिभ्यश्च।"
    ],
    "pramana": true,
    "kutra": [
     "भगवद्गीता १६/८-९",
     "ऋग्वेदसंहिता २/२४/१२",
     "ऋग्वेदसंहिता २/१५/१",
     "ऋग्वेदसंहिता ८/३/४",
     "ईशावास्योपनिषत् ८"
    ]
   }
  ],
  "66e8afb1-33a9-42af-a691-cc1f339a5183": [
   {
    "content_type": "Heading3",
    "is_padya": false,
    "text": [
     "अर्थापत्तिनिरासः"
    ],
    "heading_level": 3
   }
  ],
  "2295f613-c04f-4878-86a1-720aa42cff27": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "नचार्थापत्त्याऽनिर्वचनीयसिद्धिः।"
    ]
   }
  ],
  "8af93c06-21dd-4466-9a80-42fe92509888": [
   {
    "content_type": "Heading4",
    "is_padya": false,
    "text": [
     "असतः प्रतीतिसमर्थनम्"
    ],
    "heading_level": 4
   }
  ],
  "f33ca7b8-74b7-44b1-a1db-8df81ecfaec1": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "असतः प्रतीतिं विनाऽसद्वैलक्षण्यज्ञानानुपपत्तेः।"
    ]
   }
  ],
  "a1ec5ce1-d5b2-41d9-b65a-c8296d71eaf1": [
   {
    "content_type": "Heading4",
    "is_padya": false,
    "text": [
     "जगतो बाध्यत्वनिरासः"
    ],
    "heading_level": 4
   }
  ],
  "b2d3f691-4992-4c25-b36f-64ce732cb5f3": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "नच बाध्यं जगदित्यत्र किञ्चिन्मानम्।",
     "बाध्यत्वमपि हि तेषां मिथ्या।",
     "तस्य च मिथ्यात्वेऽबाध्यत्वमेव सत्यं स्यात्।",
     "सद्विलक्षणत्वं च सज्जातिविलक्षणत्वं सन्मात्रविलक्षणत्वं वा।",
     "जात्यङ्गीकारे सद्बहुत्वम्।",
     "सन्मात्रविलक्षणत्वं चेत् सिद्धसाधनता।",
     "ब्रह्मवैलक्षण्याङ्गीकारात्।",
     "नच कयाऽपि युक्त्या मानेन वा भेदनिराकरणं भवति।",
     "अङ्गीक्रियमाणत्वात्।",
     "अनिर्वचनीयासिद्धेश्च।",
     "सद्विलक्षणत्वमसद्विलक्षणत्वं च मिथ्येत्यविलक्षणत्वमेव सत्यं स्यात्।"
    ]
   }
  ],
  "54b3085e-be93-4903-97d4-89ae6bdeebba": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "तत्र हेत्वादिविकल्पनिराकरणम्"
    ],
    "heading_level": 1
   }
  ],
  "7548c930-4f6c-4c01-be28-35988d9165cf": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "एवमेव हेत्वादिष्वपि विकल्पो निराकरणीयः।"
    ]
   }
  ],
  "af5b60a4-82fc-4484-933b-b63e67b74fb9": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "दृश्यत्वाद्यनुमाननिराकरणम् - प्रत्येकशः"
    ],
    "heading_level": 1
   }
  ],
  "96f34ea5-e2a7-4bf3-8b77-f75618f68f5f": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "दृश्यत्वाद्यनुमानेष्वपि एत एव दोषाः।"
    ]
   }
  ],
  "d5fe59d3-4f9c-4d3d-b2f9-07e924dd15ce": [
   {
    "content_type": "Heading2",
    "is_padya": false,
    "text": [
     "दृश्यत्वहेतुनिराकरणम्"
    ],
    "heading_level": 2
   }
  ],
  "2cbcea98-2ee3-4547-bb4a-f0cf981b40e1": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "आत्मनोऽपि दृश्यत्वादनैकान्तिकता च।",
     "नचात्मनो दृक्कर्मत्वं विना तज्ज्ञानत्वम्।",
     "तदज्ञाननिवृत्तिश्च तेन भवति।",
     "नच तदाकारम्।",
     "अतद्विषयत्वादेव।",
     "तद्विषयत्वमेव हि तदाकारत्वम्।",
     "नहि ज्ञानज्ञेययोरेकाकारता।",
     "नह्यज्ञानस्य घटाश्रयत्वं ब्रह्माश्रयत्वं वाऽस्ति।",
     "पुङ्गतमेव हि तमः।",
     "ज्ञानेन निवर्तते।",
     "विषयाश्रयं चेदज्ञानं निवर्तते तर्ह्येकेन ज्ञातस्य घटस्यान्यैरज्ञातत्वं न स्यात्।",
     "अतद्विषयज्ञानेन तदज्ञाननिवृत्तौ घटज्ञानेनापि निवर्तेत।",
     "अविषयत्वादेव तस्य ज्ञानत्वं न स्याद् घटवत्।"
    ]
   }
  ],
  "b5ba8bcb-f101-4a9a-9ad5-33ce3a6b897e": [
   {
    "content_type": "Heading2",
    "is_padya": false,
    "text": [
     "जडत्वहेतुनिराकरणम्"
    ],
    "heading_level": 2
   }
  ],
  "b89655f9-f6c3-4216-ab37-e2541c74426e": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "जडत्वं चाप्रमातृत्वमेव।",
     "नच प्रमातृत्वमात्मनस्तैरङ्गीक्रियते।",
     "अतस्तदप्यनैकान्तिकम्।",
     "मिथ्याप्रमातृत्वं चानिर्वचनीयनिरासादेव निरस्तम्।",
     "यदि जडत्वं नामाप्रकाशत्वं तदप्यात्मनः  स्वविषयप्रकाशत्वाभावात् परविषयप्रकाशत्वाभावाच्चानैकान्तिकमेव।",
     "स्वविषयत्वं हि कर्तृकर्मविरोधात् तैर्नाङ्गीक्रियते।",
     "मिथ्याभूतपरविषयत्वं चानिर्वचनीयनिरासादेव निरस्तम्।",
     "विषयवर्जितः प्रकाश एव न भवति घटवत्।",
     "तत्प्रमाणाभावात्।"
    ]
   }
  ],
  "0ca41af2-89a3-49a1-8bef-95f5c9087efb": [
   {
    "content_type": "Heading2",
    "is_padya": false,
    "text": [
     "परिच्छिन्नत्वहेतुनिराकरणम्"
    ],
    "heading_level": 2
   }
  ],
  "ac54ba5f-704d-424a-a7d8-6c8e952d7612": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "देशतः कालतः परिच्छिन्नत्वं प्रकृतिकालादिष्वभावाद् भागासिद्धम्।",
     "वस्तुतः परिच्छिन्नत्वमात्मनोऽपि भेदाङ्गीकारादनैकान्तिकम्।"
    ]
   }
  ],
  "38771d8c-02d2-4b9f-b8f5-fd78f4ceace3": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "दृश्यत्वाद्यनुमानानां साधारणतो निराकरणम्"
    ],
    "heading_level": 1
   }
  ],
  "24352671-5e9b-4ebc-8790-c86447fb26c5": [
   {
    "content_type": "Heading2",
    "is_padya": false,
    "text": [
     "कालातीतता"
    ],
    "heading_level": 2
   }
  ],
  "e38a5356-342c-4ffd-b167-8f87a6223446": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "प्रत्यक्षबाधितं च जगन्मिथ्यात्वम्।",
     "सदिति प्रतीयमानत्वात्।",
     "नच प्रत्यक्षसिद्धमन्येन केनापि बाध्यं दृष्टम्।",
     "चन्द्रप्रादेशत्वादिविषयं तु दूरस्थत्वादिदोषयुक्तत्वादपटु।",
     "नच जगत्प्रत्यक्षस्यापटुत्वे किञ्चिन्मानम्।"
    ]
   }
  ],
