  "5d1e198b-296d-4ff1-ba4b-61daa01599bc": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "अनिर्वचनीयासिद्धेरेवानुमानस्याप्यसिद्धिः।",
     "यदि जगन्मिथ्या स्यात् तदा दृश्यत्वाद्यनुमानस्यापि जगदन्तःपातित्वेन मिथ्यात्वादसिद्धिः स्यात्।"
    ]
   }
  ],
  "07338e07-54bc-46ec-a01f-c9c1077471bc": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "वाचारम्भणश्रुतेरद्वैतप्रतिपादकत्वनिराकरणम्"
    ],
    "heading_level": 1
   }
  ],
  "9f60fc52-a9ec-4233-b331-f4c76b0c1eba": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "वाचारम्भणं विविधप्रकारः, नामधेयं नित्यं धार्यं नाम मृत्तिकेत्यादि",
     "वैदिकमेवेत्येतद् वचनं सत्यमिति श्रुतेरर्थः।",
     "अनित्यत्वात् साङ्केतिकं नामाप्रधानम्, नित्यत्वान्मृत्तिकादिनामैव प्रधानम्।",
     "प्रधानज्ञानादप्रधानं ज्ञातार्थमिव भवति।",
     "एवं प्रधानस्य परमात्मनो ज्ञानादप्रधानं ज्ञातमिव भवति।",
     "प्राधान्यज्ञापनार्थमेव सृष्ट्यादिकथनम्।",
     "“यथा सोम्य”",
     "इत्याद्यपि सादृश्यकथनम्।",
     "नचैकनखनिकृन्तनविकारः सर्वं कार्ष्णायसम्।",
     "प्रधानपुरुषज्ञानाद् ग्रामो ज्ञात इति व्यपदेशोऽस्ति।",
     "नहि सत्यज्ञानेन मिथ्याज्ञानं भवति।"
    ],
    "pramana": true,
    "kutra": [
     "छान्दोग्योपनिषत् ६/१/२,३,४"
    ],
    "variants": [
     {
      "bg_patha": "“वैदिकमेवेत्येतद् वचनं सत्यमिति श्रुतेरर्थः”",
      "trk_patha": "“वैदिकमेव”"
     }
    ]
   }
  ],
  "7b251a7c-069d-4eaa-b7b4-e612be0448f0": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "मुक्तत्वहेतोरप्रयोजकतानिरासाय विपक्षे बाधकोक्तिः"
    ],
    "heading_level": 1
   }
  ],
  "337a2e69-9be6-49e4-acf9-650f57403c75": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "मुक्तामुक्तयोर्भेदाभावे मुक्तस्य संसारः संसारिणो वा मुक्तत्वं स्यात्।",
     "यद्यज्ञानकृतो भेदः, तर्हीश्वरस्याज्ञानाभावात् संसारिणैक्यं तेनानुभूयेत।",
     "ततश्च दुःखित्वं स्यात्।"
    ]
   }
  ],
  "5db40157-554e-43df-bc40-445e7b265b12": [
   {
    "content_type": "Heading2",
    "is_padya": false,
    "text": [
     "भगवद्वचनैरेव भेदसमर्थनेनापि बाधकसूचनम्"
    ],
    "heading_level": 2
   }
  ],
  "ff3dca2b-96d3-416e-aa5f-6d920cefc661": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“तान्यहं वेद सर्वाणि न त्वं वेत्थ परन्तप”",
     "“सुखं दुःखं भवो(ऽ)भावो भयं चाभयमेव च।",
     "अहिंसा समता तुष्टिस्तपो दानं यशोऽयशः॥",
     "भवन्ति भावा भूतानां मत्त एव पृथग्विधाः॥”",
     "“यस्मात् क्षरमतीतोऽहमक्षरादपि चोत्तमः।",
     "अतोऽस्मि लोके वेदे च प्रथितः पुरुषोत्तमः॥”",
     "इत्यादिनेश्वरेणापि भेदस्यैवानुभूयमानत्वाच्च।"
    ],
    "pramana": true,
    "kutra": [
     "भगवद्गीता ४/५",
     "भगवद्गीता १०/४-५",
     "भगवद्गीता १५/१८"
    ]
   }
  ],
  "39a57f79-2bd8-4e91-9dba-43caf1ea4580": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "ईश्वरप्रत्यक्षमूलानुमानान्तरेणापि मुक्तभेदसमर्थनम्"
    ],
    "heading_level": 1
   }
  ],
  "e242bc08-e68f-448d-840c-7e89cb51ce54": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "तत एवाभ्रान्तत्वान्न मुक्तस्यापि भेदनिवृत्तिः।"
    ]
   }
  ],
  "75578b71-7f62-4048-ba17-c71b90ed77b1": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "औपाधिकभेदनिरासः"
    ],
    "heading_level": 1
   }
  ],
  "2f65cb64-97ef-4c05-a620-e292e86ccb0f": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "नचोपाधिभेदमात्रेणेश्वरस्य दुःखाभावः।",
     "हस्तपादाद्युपाधिभेदेऽपि भोक्तुरेकत्वानुभवात्।",
     "“उद्यतायुधदोर्दण्डाः पतितस्वशिरोक्षिभिः।",
     "पश्यन्तः पातयन्ति स्म कबन्धा अप्यरीन् युधि॥”",
     "इति भारतवचनान्न विश्लेषाद् विशेषः।",
     "अतोऽनौपाधिकत्वादेव भेदस्य न मुक्तस्येश्वरैक्यम्।"
    ],
    "pramana": true
   }
  ],
  "08b1418d-7132-4ad4-88a5-0fa7e79e9c5e": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "आगमैर्मुक्तभेदसमर्थनम्"
    ],
    "heading_level": 1
   }
  ],
  "3b18487e-df2b-4f5b-abac-d92837ba1198": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“इदं ज्ञानमुपाश्रित्य मम साधर्म्यमागताः।",
     "सर्गेऽपि नोपजायन्ते प्रलये न व्यथन्ति च॥”",
     "“यदा पश्यः पश्यते रुग्मवर्णं कर्तारमीशं पुरुषं ब्रह्मयोनिम्।",
     "तदा विद्वान् पुण्यपापे विधूय निरञ्जनः परमं साम्यमुपैति॥”",
     "इत्यादि मुक्तभेदवचनेभ्यश्च।"
    ],
    "pramana": true,
    "kutra": [
     "भगवद्गीता १४/२",
     "आथर्वणोपनिषत् ३/१/३"
    ],
    "variants": [
     {
      "pathanatara": "‘रुक्मवर्णम्’ - पा।"
     }
    ]
   }
  ],
  "bd92718d-e0d0-49d9-92c0-4350a86b4eda": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "मुक्ताभेदवचनानामन्यार्थनिरूपणम्"
    ],
    "heading_level": 1
   }
  ],
  "8c4e4d03-494e-48ed-ab89-55b08f7de711": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "एवं प्रत्यक्षानुमानागमविरुद्धत्वादभेदविषयवत् प्रतीयमानान्यपि वाक्यानि सादृश्याद्यर्थान्येव योजनीयानि।",
     "“विरुद्धवत्‌ प्रतीयन्त आगमा यत्र वै मिथः।",
     "तत्र दृष्टानुसारेण तेषामर्थोऽन्ववेक्ष्यते॥”",
     "इति ब्राह्मवचनाच्च।"
    ],
    "pramana": true
   }
  ],
  "4ca5b38b-ce10-4a97-9ff8-9fa6e3351ea0": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "भेदज्ञानस्य भ्रान्तित्वनिरासः"
    ],
    "heading_level": 1
   }
  ],
  "dbb9d683-3b9e-49a2-beed-afdf18566a17": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "भेदाद्यनुभवस्य भ्रान्तित्वाङ्गीकारे तदपलापयुक्तेर्नितरां भ्रान्तित्वाद् भेदाद्यनुभवस्याभ्रान्तित्वमेव भवति।",
     "परस्परविरुद्धयोरन्यतरनिषेधस्यान्यतरविधिनान्तरीयकत्वात्।"
    ]
   }
  ],
  "bd9539d3-b33f-4567-a892-c1cbdc2401d4": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "एकजीववादिनोऽपि विपक्षे बाधकनिरूपणम्"
    ],
    "heading_level": 1
   }
  ],
  "697d92e5-a1ad-47a3-a584-ab78e28210c5": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "एकजीववादपक्षे तन्निष्ठानां मृत्यनन्तरमपि विश्वस्यानिवृत्तत्वाद् भेदनिष्ठ एवैकजीव इत्यापतति।",
     "तस्य च तत्रैवाग्रहान्न कदाचिद् भेदनिवृत्तिरित्यनिवृत्तिरेव भवति।",
     "नचैकजीवाज्ञानपरिकल्पिताः समस्ता इत्यत्र किञ्चिन्मानम्।"
    ]
   }
  ],
  "cffbf759-dcbd-43af-9b17-ec032458520e": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "मुक्तभेदसमर्थनोपसंहारः"
    ],
    "heading_level": 1
   }
  ],
  "4afa6459-c04a-4547-bdff-b65a35d911f5": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "अतो मुक्तेभ्योऽप्यन्य एव समस्तगुणपरिपूर्णो भगवान् विष्णुरिति सिद्धम्।"
    ]
   }
  ],
  "68098986-0fdf-4a8f-9126-91ff61e11713": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "मुक्तस्येश्वरनियन्तृत्वसमर्थनम्"
    ],
    "heading_level": 1
   }
  ],
  "f85024ff-c029-4dc5-a555-26e2b1587353": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“ब्रह्मेशानादिभिर्देवैर्यत् प्राप्तुं नैव शक्यते।",
     "तद् यत्स्वभावः कैवल्यं स भवान् केवलो हरे॥”",
     "“परो मात्रया तन्वा वृधान न ते महित्वमन्वश्नुवन्ति”"
    ],
    "pramana": true,
    "kutra": [
     "ऋग्वेदसंहिता ७/९९/१"
    ]
   }
  ],
  "dbee36f0-6bc8-4b30-b7da-c21cc15c9c47": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "अन्तिममङ्गलाचरणम्"
    ],
    "heading_level": 1
   }
  ],
  "4cd7b3e7-890d-4b5f-b194-4a3def7ef444": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "सत्यचिच्चेत्यपतये मुक्तामुक्तोत्तमाय ते।",
     "नमो नारायणायार्यवृन्दवन्दितपद्द्वय॥",
     "“आनन्दतीर्थपुंसिहो मायावादिदितेः सुतान्।",
     "विदार्य",
     "युक्तिनखरैरप्रतीपो विभासते॥”",
     "“पलायध्वम्पलायध्वं त्वरया मायिदानवाः।",
     "सर्वज्ञहरिरायाति तर्कागमदरारिभृत्॥”",
     "“द्रवतद्रवताशु मायिनः प्रविशध्वमतन्द्रिता गुहाः।",
     "कमलारमणाम्बराश्रयः समुदेत्यखिलज्ञभास्करः॥”",
     "“नृहरिः सकलज्ञनामकः समुपैति हि मायिदानवान्।",
     "प्रपलायनमत्र तत् क्षमं त्वरया वो वसतिर्गुहासु च॥”",
     "“जयत्यानन्दतीर्थेष्टदेवता नरकेसरी।",
     "विपाटिताज्ञानतमःकपाटात्युरुहुङ्कृतः॥”",
     "“जयत्यमितपौरुषः स्वजनतेष्टचिन्तामणिः।",
     "अजेशमुखवन्दितो गुणगणार्णवः श्रीपतिः॥”",
     "“सर्वज्ञसन्मुनीन्द्रोच्चसन्मनःपङ्कजालयः।",
     "अजितो जयति श्रीशो रमाबाहुलताश्रयः॥”"
    ],
    "pramana": true,
    "variants": [
     {
      "bg_patha": "“युक्तिनखरैरप्रतीपोऽतिशोभते॥”",
      "trk_patha": "“युक्तिनखरैरप्रतीपो विभासते॥”",
      "pathanatara": "‘अप्रतीपोऽभिभासते’ - इति प्रचलितपाठ इति गोविन्दाचार्याः। कृपाठे तु न तथा।"
     }
    ]
   }
  ],
  "caf889b0-f410-46c0-8a14-1fad8f6715d3": [
   {
