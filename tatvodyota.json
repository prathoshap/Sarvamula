  "e5b98bae-8fd3-4012-90a3-79760073d7ad": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "दृष्टस्य वस्तुनो बलवद्दृष्टिं विना नान्यद् बाधकमिति दुर्घटत्वे सुघटत्वे वा नानिर्वचनीयसिद्धिः।",
     "सर्ववैलक्षण्याङ्गीकाराद् दुर्घटमपि ब्रह्म प्रमाणादङ्गीक्रियत एव।",
     "जगतो भिन्नमभिन्नं भिन्नाभिन्नं वेत्यादिविकल्पस्तत्रापि युज्यते।",
     "भिन्नं चेद् भेदादिविशिष्टाच्छुद्धं भिन्नमभिन्नं वेत्याद्यनवस्था।",
     "अभिन्नं चेन्मिथ्यारूपेण जगता ब्रह्मापि मिथ्यैव स्यात्।",
     "भिन्नाभिन्नं चेद् दोषद्वयमपि।",
     "उभयविलक्षणं चेदनिर्वचनीयत्वं ब्रह्मण एवापतितम्।",
     "यद्येवमपि नानिर्वचनीयत्वं ब्रह्मणस्तर्हि जगतोऽपि न स्यात्।",
     "“विश्वं सत्यम्”",
     "इत्यादिवचनमत्राप्युक्तम्।",
     "“न सत्तन्नासदुच्यते”,",
     "“असद्वा इदमग्र आसीत्”,",
     "“नासदासीन्नो सदासीत्”",
     "इत्यादि ब्रह्मणोऽपि मिथ्यात्वे प्रमाणमस्ति।",
     "नहि दृष्टेर्बलवत् किञ्चित् प्रमाणम्।",
     "नहि युक्तिपराजितोऽपि क्षुधितो नान्नमत्ति।",
     "बलवद्दृष्ट्यबाधे।",
     "नचान्नत्वे दुर्घटे तस्यानन्नत्वं भवति।",
     "दृष्ट्यबाधितदृष्टस्य।",
     "नचान्नानन्नवैलक्षण्यमनुभूयते।",
     "नच तथा व्यवहारः।",
     "नच तत्र किञ्चिन्मानम्।",
     "अतो विशिष्टादिनिराकरणयुक्तीनामपि विशिष्टाद्यपेक्षत्वाज्जात्युत्तरमिति न युक्तिबाधाऽपि।"
    ],
    "pramana": true,
    "kutra": [
     "ऋग्वेदसंहिता २/२४/१२",
     "भगवद्गीता",
     "तैत्तिरीयोपनिषत् २/७",
     "ऋग्वेदसंहिता १०/१२९/१"
    ],
    "variants": [
     {
      "bg_patha": "“नासदासीन्नो सदासीत् तदानीम्”",
      "trk_patha": "“नासदासीन्नो सदासीत्”"
     }
    ]
   }
  ],
