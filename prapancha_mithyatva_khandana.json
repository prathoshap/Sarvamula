  "99bd558a-e266-4df8-9c0c-1ba206f8632b": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "साध्यधर्मविशिष्टः पक्षः।",
     "साध्यसमानधर्मविशिष्टः सपक्षः।",
     "साध्यविपरीतधर्मविशिष्टो विपक्षः।",
     "पक्षवचनं प्रतिज्ञा।",
     "लिङ्गं हेतुः।",
     "निदर्शनं दृष्टान्तः।"
    ]
   }
  ],
