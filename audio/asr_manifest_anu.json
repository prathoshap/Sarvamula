{
 "bsb_1_1_1_u01_sutra_p01_050706_ANU": "अथातो ब्रह्मजिज्ञासा",
 "bsb_1_1_1_u03_gadya_p01_7f43f0_ANU": "द्वापरे सर्वत्र ज्ञान आकुलीभूते तन्निर्णयाय",
 "bsb_1_1_1_u03_gadya_p02_ae5c61_ANU": "ब्रह्मरुद्रेन्द्रादिभिरर्थितो भगवान् नारायणो व्यासत्वेनावततार",
 "bsb_1_1_1_u03_gadya_p03_b208f6_ANU": "अथेष्टानिष्टप्राप्तिपरिहारेच्छूनां तद्योगमविजानतां",
 "bsb_1_1_1_u03_gadya_p04_734840_ANU": "तज्ज्ञापनार्थं वेदमुत्सन्नं व्यञ्जयंश्चतुर्धा व्यभजत्",
 "bsb_1_1_1_u03_gadya_p05_c1a397_ANU": "चतुर्विंशतिधैकशतधा सहस्रधा द्वादशधा च",
 "bsb_1_1_1_u03_gadya_p06_02e7f5_ANU": "तदर्थनिर्णयाय ब्रह्मसूत्राणि चकार तच्चोक्तं स्कान्दे",
 "bsb_1_1_1_u05_gadya_p01_29252d_ANU": "इत्यादि अथातो ब्रह्मजिज्ञासा अथशब्दो मङ्गलार्थोऽधिकारानन्तर्यार्थश्च",
 "bsb_1_1_1_u05_gadya_p02_c0c646_ANU": "अतः शब्दो हेत्वर्थः उक्तं च गारुडे",
 "bsb_1_1_1_u07_gadya_p01_e083b5_ANU": "इति",
 "bsb_1_1_1_u08_gadya_p01_c6fec4_ANU": "अधिकारश्चोक्तो भागवततन्त्रे",
 "bsb_1_1_1_u10_gadya_p01_e083b5_ANU": "इति",
 "bsb_1_1_1_u13_gadya_p01_66520d_ANU": "इति चोपरि",
 "bsb_1_1_1_u18_gadya_p01_c51f05_ANU": "इत्यादिश्रुतिभ्यश्च व्योमसंहितायां च",
 "bsb_1_1_1_u20_gadya_p01_6a9537_ANU": "इति यतो नारायणप्रसादमृते न मोक्षः",
 "bsb_1_1_1_u20_gadya_p02_abb315_ANU": "नच ज्ञानं विनाऽत्यर्थप्रसादः अतो ब्रह्मजिज्ञासा कर्तव्या",
 "bsb_1_1_1_u22_gadya_p01_00b2e5_ANU": "इति बृहत्संहितायाम्",
 "bsb_1_1_1_u27_gadya_p01_0263bb_ANU": "इत्यादिश्रुतिस्मृतिभ्यः",
 "bsb_1_1_1_u29_gadya_p01_f73f25_ANU": "इति नारदीये ब्रह्मशब्दश्च विष्णावेव",
 "bsb_1_1_1_u31_gadya_p01_43f738_ANU": "इत्याद्युक्त्वा",
 "bsb_1_1_1_u33_gadya_p01_35b771_ANU": "इति हि श्रुतिः",
 "bsb_1_1_1_u35_gadya_p01_c81d09_ANU": "इति वचनाद् विष्णुरेव हि तत्रोच्यते नचेतरशब्दात् तत्प्राप्तिः",
 "bsb_1_1_1_u37_gadya_p01_b352a8_ANU": "इति भाल्लवेयश्रुतिः",
 "bsb_1_1_1_u39_gadya_p01_d04122_ANU": "इत्येवशब्दान्नान्येषां सर्वनामता",
 "bsb_1_1_1_u41_gadya_p01_bcbc2c_ANU": "इति हि विष्णोर्लिङ्गम् नच प्रसिद्धार्थं विनाऽन्योऽर्थो युज्यते",
 "bsb_1_1_1_u43_gadya_p01_2ae75f_ANU": "इति स्कान्दे",
 "bsb_1_1_1_u45_gadya_p01_b2ce73_ANU": "इति समाख्याश्रुतौ",
 "bsb_1_1_1_u47_gadya_p01_97ecfc_ANU": "इत्युक्त्वा",
 "bsb_1_1_1_u49_gadya_p01_bbb34e_ANU": "इत्याह उग्रो रुद्रः समुद्रेऽन्तर्नारायणः",
 "bsb_1_1_1_u49_gadya_p02_435ceb_ANU": "प्रसिद्धत्वात् सूचितत्वाच्चास्यार्थस्य",
 "bsb_1_1_1_u49_gadya_p03_557a3a_ANU": "नचाविरोधे प्रसिद्धः परित्यज्यते",
 "bsb_1_1_1_u49_gadya_p04_14709c_ANU": "उक्तन्यायेन च श्रुतय एतमेव वदन्ति",
 "bsb_1_1_1_u51_gadya_p01_1dae96_ANU": "इति हरिवंशेषु नचेतरग्रन्थविरोधः",
 "bsb_1_1_1_u53_gadya_p01_5e265c_ANU": "इति वाराहवचनात् शैवे च स्कान्दे",
 "bsb_1_1_1_u55_gadya_p01_9c0b24_ANU": "इति ब्राह्मे च ब्रह्मवैवर्ते",
 "bsb_1_1_1_u57_gadya_p01_a9da16_ANU": "इति नच वैष्णवेषु तथा तच्च",
 "bsb_1_1_1_u59_gadya_p01_a4ac45_ANU": "इत्युक्तम्",
 "bsb_1_1_2_u01_sutra_p01_5dfbc6_ANU": "जन्माद्यस्य यतः",
 "bsb_1_1_2_u02_gadya_p01_89172c_ANU": "ब्रह्मणो लक्षणमाह- जन्माद्यस्य यतः",
 "bsb_1_1_2_u02_gadya_p02_454572_ANU": "सृष्टिस्थितिसंहारनियमनज्ञानाज्ञानबन्धमोक्षा यतः",
 "bsb_1_1_2_u04_gadya_p01_2ae75f_ANU": "इति स्कान्दे",
 "bsb_1_1_2_u05_padya_p01_eee66f_ANU": "यतो वा इमानि भूतानि जायन्ते",
 "bsb_1_1_2_u05_padya_p02_98def0_ANU": "येन जातानि जीवन्ति",
 "bsb_1_1_2_u05_padya_p03_091bf2_ANU": "यत् प्रयन्त्यभि संविशन्ति तद् विजिज्ञासस्व तद् ब्रह्मेति",
 "bsb_1_1_2_u10_gadya_p01_a409df_ANU": "इत्यादि च"
}