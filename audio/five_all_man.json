{
 "ymb_001_u01_padya_p01_5b63f6": "ध्यायेत् परमानन्दं यन्माता पतिमयदपरमानन्दम्",
 "ymb_001_u01_padya_p02_0d06de": "उज्झितपरमानं दम्पत्याद्याद्याश्रमैः सदैवपरमानन्दम्",
 "ymb_001_u02_padya_p01_3b65de": "यस्य करालोलं चक्रं कालः परः स हि करालोऽलम्",
 "ymb_001_u02_padya_p02_953ba2": "यस्य गदा पवमानः सन् यो व्यासोऽभवत् सदापवमानः",
 "ymb_002_u01_padya_p01_0820aa": "यस्य रमा न मनोगं जगृहे विश्वम्भराऽपि नमनोऽगम्",
 "ymb_002_u01_padya_p02_06f6af": "यस्य पुमानानन्दं भुङ्क्ते यद्धाम कपतिमानानन्दम्",
 "ymb_002_u02_padya_p01_7f8738": "परमेषु यदा तेजः परमेषु चकार वासुदेवोऽजः",
 "ymb_002_u02_padya_p02_6a1c6a": "मानधि बिभ्रत्सु मनो माऽनधिमाऽऽसीन्नवासुदेवोजः",
 "ymb_002_u03_padya_p01_682ba4": "सोऽजनि देवक्यन्ते यस्मादनुकम्पनावदेव क्यन्ते",
 "ymb_002_u03_padya_p02_5cd8c4": "अवदन् देव क्यं ते भुवनं हि सुराः सदैवदेऽव क्यन्ते",
 "ymb_003_u01_padya_p01_050b51": "नीतो वसुदेवेन स्वततेन स गोकुलं सुवसुदेऽवे न",
 "ymb_003_u01_padya_p02_4a32ba": "तत्र यशोदा तनयं मेने कृष्णं स्वकीयमवदातनयम्",
 "ymb_003_u02_padya_p01_d2942c": "ववृधे गोकुलमध्याद्यो देवो विश्वमद्भुताकुलमध्यात्",
 "ymb_003_u02_padya_p02_6695dc": "तत्र च पूतनिकाया वधमकरोद् यन्निजाः सुपूतनिकायाः",
 "ymb_003_u03_padya_p01_79a8a5": "अधुनोच्छकटं लो ली पादाङ्गुष्ठेन वातपेशशकटं लोली",
 "ymb_003_u03_padya_p02_1af8b4": "अतनोद् रक्षामस्य स्वाज्ञानाद् गोपिका सदेरक्षामस्य",
 "ymb_003_u04_padya_p01_df53f5": "मुखलालनलोला तन्मुखगं जगदचष्ट सालनलोलातत्",
 "ymb_003_u04_padya_p02_966de6": "नाध्यैन्मायामस्य जगत्प्रभोः स्वधिकतततमायामस्य",
 "ymb_003_u05_padya_p01_de4982": "तस्य सुशर्माण्यकरो दरिणो गर्गः सदुक्तिकर्माण्यकरोत्",
 "ymb_003_u05_padya_p02_922a79": "अवदन्नामानमयं जगदादिं वासुदेवनामानमयम्",
 "ymb_003_u06_padya_p01_a709fe": "तस्य सखा बलनामा ज्येष्ठो भ्राताऽथ यन्निजाबलना मा",
 "ymb_003_u06_padya_p02_398f0a": "यस्य च पर्यङ्कोऽयं पूर्वतनो विष्णुमजसपर्यं कोऽयम्",
 "ymb_003_u07_padya_p01_50afd8": "तेन हतो वातरयस्तृणचक्रो नाम दितिसुतोऽवातरयः",
 "ymb_003_u07_padya_p02_1aa939": "हरमाणो बालतमं स्वात्मानं कण्ठरोधिनाऽबालतमम्",
 "ymb_003_u08_padya_p01_98354b": "सोऽवनिमध्ये रङ्गन्नरिदरयुग् बालरूपमध्येरं गन्",
 "ymb_003_u08_padya_p02_8465be": "अमुषन्नवनीतमदः स्वगोकुले गोपिकासु नवनीतमदः",
 "ymb_003_u09_padya_p01_2fbdde": "तन्माता कोपमिता तमनुससारात्मवादवाकोपमिता",
 "ymb_003_u09_padya_p02_482819": "जगृहे सा नमनं तं देवं तच्चिन्तयैव सानमनन्तम्",
 "ymb_003_u10_padya_p01_df6afa": "अथ साऽन्तरिताऽमानं विष्णुं विश्वोद्भवं सदाऽन्तरितामानम्",
 "ymb_003_u10_padya_p02_c6a888": "अनयद् दामोदरतां योऽरमयत् सुन्दरीं निजामोदरताम्",
 "ymb_003_u11_padya_p01_58ded7": "चक्रे सोऽर्जुननाशं प्राप्नोति यत्स्मृतिः सदाऽर्जुनना शम्",
 "ymb_003_u11_padya_p02_b12b6d": "तौ च गतौ निजमोकस्तेनैव नुतेन यन्निजानिजमोकः",
 "ymb_003_u12_padya_p01_ed0ed5": "अथ वृन्दावनवासं गोपाश्चक्रुर्जगत्क्षिताऽवनवासम्",
 "ymb_003_u12_padya_p02_85cab1": "तत्र बकासुरमारः शौरिरभून्नित्यसंश्रितासुरमारः",
 "ymb_003_u13_padya_p01_9ac098": "अहनद् वत्सतनूकं योऽपाल्लोकं स्वयत्नवत्सतनूकम्",
 "ymb_003_u13_padya_p02_308cfc": "सोऽपाद् वत्सानमरः सहाग्रजो गोपवत्सवत्सानमरः",
 "ymb_003_u14_padya_p01_7b22f1": "स विभुः श्रीमानहिके ननर्त यस्य श्रमानमा मा न हिके",
 "ymb_003_u14_padya_p02_b7d8a6": "अकरोन्नद्युदकान्तं कान्तं नीत्वोरगं स नाऽद्युदकान्तम्",
 "ymb_003_u15_padya_p01_d41320": "हत्वा धेनुकमूढं बलात् प्रलम्बं च खेट् सधेनुकमूढम्",
 "ymb_003_u15_padya_p02_2207b3": "व्रजमावीदमृताशः पीत्वा वह्निं चरस्थिरादमृताशः",
 "ymb_003_u16_padya_p01_ca0f49": "गिरिणा रक्षाऽपि कृता व्रजस्य तेन स्वरक्षरक्षाऽपि कृता",
 "ymb_003_u16_padya_p02_b88dc1": "शक्राय व्यञ्जयता स्वां शक्तिं विश्वमात्मनाऽव्यं जयता",
 "ymb_003_u17_padya_p01_4c32cf": "रेमे गोपीष्वरिहा स मन्मथाक्रान्तसुन्दरीपीष्वरिहा",
 "ymb_003_u17_padya_p02_8f8ca2": "पूर्णानन्दैकतनुः स विश्वरुक्पावनोऽप्यनन्दैकतनुः",
 "ymb_003_u18_padya_p01_cac112": "अथ हतयोर्गलिकेश्योः श्वफल्कजप्रापितः पुरीं गलिकेश्योः",
 "ymb_003_u18_padya_p02_f98e83": "भङ्क्त्वा धनुराजवरं जघान तेनैव च स्वयं राजवरम्",
 "ymb_003_u19_padya_p01_504122": "मृद्गन् गजमुग्रबलं सबलो रङ्गं विवेश सृतिमुग् रबलम्",
 "ymb_003_u19_padya_p02_3565a8": "हत्वा मल्लौ बलिनौ कंसं च विमोक्षितौ ततौ लौ बलिनौ",
 "ymb_003_u20_padya_p01_2563fb": "प्रादात् सान्दीपनये मृतपुत्रं ज्ञानदीपसान्दीपनये",
 "ymb_003_u20_padya_p02_32be80": "गुर्वर्थेऽज्ञानतमःप्रभेदिता नित्यसम्भृताज्ञानतमः",
 "ymb_003_u21_padya_p01_8fc277": "जित्वा मागधराजं तोषितमकरोत् सदात्मयोगधराजम्",
 "ymb_003_u21_padya_p02_4cb4a9": "अनुकुर्वन् निजसदनं चक्रे रम्यां पुरं सुबोधनिजसदनम्",
 "ymb_003_u22_padya_p01_f12a08": "प्रसभं सगजबलस्य क्षत्रस्योच्चैः समगधराजबलस्य",
 "ymb_003_u22_padya_p02_091fc3": "मानं शिशुपालवरं हत्वा भैष्मीमवाप शिशुपालवरम्",
 "ymb_003_u23_padya_p01_622d84": "हंसो डिभिकश्चपलावमुना संसूदितौ यवनकश्च पला",
 "ymb_003_u23_padya_p02_b7dfad": "कीर्तिर्विमला विरता प्रतता विश्वाधिपावनीलाविरता",
 "ymb_003_u24_padya_p01_35c58c": "सत्याजाम्बवतीर्या भार्या विन्दाद्या भानुसाम्बवतीर्याः",
 "ymb_003_u24_padya_p02_8e912e": "प्रद्युम्नं मोदरतः प्राप ज्येष्ठं हरिः सुतं मोदरतः",
 "ymb_003_u25_padya_p01_70cef0": "यत्परिवारतयेशा जाता देवा नृपात्मना रतयेशाः",
 "ymb_003_u25_padya_p02_91b1f3": "यद्भरितं विषसर्पप्रभृति ध्वान्तं न मारुतिं विषसर्प",
 "ymb_004_u01_padya_p01_062258": "येन हिडिम्बबकाद्या रक्षोधीशा निपातिता बबकाद्याः",
 "ymb_004_u01_padya_p02_f926c0": "भीमे प्रीतिममेयां व्यञ्जयता तेनैव शेषपाति ममे याम्",
 "ymb_004_u02_padya_p01_aa0445": "अथ कृष्णावरणे तान् प्राप्तान् राज्ञोऽशृणोत् सदावरणेतान्",
 "ymb_004_u02_padya_p02_02e430": "द्रष्टुं यातः सबलस्तां चैनैषीत् पृथासुतांस्ततः सबलः",
 "ymb_004_u03_padya_p01_c446ae": "तानिन्द्रस्थलवासांश्चक्रे कृष्णः परो निजस्थलवासान्",
 "ymb_004_u03_padya_p02_f8b9fc": "स्वबलोद्रेचितमानैर्जुगोप धर्मं च तैः पराचितमानैः",
 "ymb_004_u04_padya_p01_c5b2eb": "वालिवधानुनयाय प्रणयी सख्यं सुसन्दधे नु नयाय",
 "ymb_004_u04_padya_p02_7e0a70": "वासवजेन विशेषात् तेनैव पुनर्नृजन्मजेन विशेषात्",
 "ymb_004_u05_padya_p01_cbf84d": "मातुः परिभवहान्यै राज्ञा द्युसदामितश्च परिभवहाऽन्यैः",
 "ymb_004_u05_padya_p02_a9d1c2": "अभवन्नरकमुरारिर्योऽवासीदत् समस्तनरकमुरारिः",
 "ymb_005_u01_padya_p01_ca3e66": "नीतो दिवि देववरै रेमे सत्यासमन्वितोऽदेववरैः",
 "ymb_005_u01_padya_p02_a0d723": "सर्वर्तुवने शशिना निशि सत्यां वासरे वनेऽशशिना",
 "ymb_005_u02_padya_p01_fcab0b": "सुरतरुमापालिमतात् प्रकाशयञ्छक्तिमात्मनः पालिमतात्",
 "ymb_005_u02_padya_p02_2d1a08": "सुरवरवीरेषु दरी प्रधानजीवेश्वरः परेषुदरी",
 "ymb_005_u03_padya_p01_1a39fe": "पुरमभियायारिदरी दत्वा भद्रां पृथासुतायारिदरी",
 "ymb_005_u03_padya_p02_beed93": "शक्रपुरीमभियातः प्रादाद् वह्नेर्वनं सतामभियाऽतः",
 "ymb_005_u04_padya_p01_5ff3db": "शिवभक्तप्रवराद्यं पुमान् न सेहे गिरीशविप्रवराद्यम्",
 "ymb_005_u04_padya_p02_84b068": "तं स्वात्मेन्द्रवरेण व्यधुनोद् भीमेन धूतरुद्रवरेण",
 "ymb_005_u05_padya_p01_4f231a": "यस्याज्ञाबलसारैः पार्थैर्दिग्भ्यो हृतं धनं बलसारैः",
 "ymb_005_u05_padya_p02_66907c": "जित्वा क्ष्मामविशेषां प्रसह्य भूपान् समस्तकामविशेषाम्",
 "ymb_005_u06_padya_p01_d97a3a": "अथ पार्थान् क्रतुराजं प्रापयदमरेट् सरुद्रशक्रतुराजम्",
 "ymb_005_u06_padya_p02_390651": "पूजा तेनावापि च्छिन्नश्चैद्यः सृतिं गते नावाऽपि",
 "ymb_005_u07_padya_p01_d713be": "निहतौ सौभकरूशौ शीतो भातश्च येन तौ भकरूशौ",
 "ymb_005_u07_padya_p02_ea8c86": "अजयद् रुद्रं च रणे बाणार्थेऽवनतिपतितकचन्द्रं चरणे",
 "ymb_005_u08_padya_p01_959545": "असृजज्ज्वरमुग्रतमःक्षयप्रदो लीलयाऽधिवरमुग् रतमः",
 "ymb_005_u08_padya_p02_b90f1d": "क्रीडामात्रं विश्वं प्रकाशयन्नात्मनः सविहरकमात्रं विश्वम्",
 "ymb_005_u09_padya_p01_a9085e": "यस्यावेशोरुबलान्न्यहनत् पार्थोऽसुरान् प्रजेशोरुबलान्",
 "ymb_005_u09_padya_p02_ea7283": "वरदानादस्यैव जगत्प्रभोरीरणात् समनुगतनादस्यैव",
 "ymb_006_u01_padya_p01_cb6057": "यस्यावेशात् स बलः प्रचकर्ष पुरं प्रसह्य चेशात् सबलः",
 "ymb_006_u01_padya_p02_505144": "कुरुपतिनाम नु यमुनाऽऽकृष्टा येनाहुरर्ह्यमतनु यमुना",
 "ymb_007_u01_padya_p01_f2bbe5": "यद्बलवान् क्रोधवशान् निनाय नाशं वृकोदरः क्रोधवशान्",
 "ymb_007_u01_padya_p02_54fe9c": "लेभेऽचान्या गम्यं स्थानं पुष्पाणि धाम चान्यागम्यम्",
 "ymb_008_u01_padya_p01_a6f023": "यद्बलभारवहत्त्वान्नाचलदुरगादिभिः सुभारवहत्त्वात्",
 "ymb_008_u01_padya_p02_0c96ea": "धर्मादरिहाऽपि पदं भीमो येनैव साहसं रिहाऽपि पदम्",
 "ymb_008_u02_padya_p01_fa5960": "नहि नहुषोऽलं नहितुं धर्मो द्रौणिस्तथेतरोऽलं न हितुम्",
 "ymb_008_u02_padya_p02_954a7f": "नो राट्कर्णौ ब्रह्मवरी येन ध्वस्तोऽस्त्रमग्रहीत् सब्रह्मवरी",
 "ymb_008_u03_padya_p01_cba99e": "क्षात्रं धर्मं स्ववता गुरुवृत्त्यै केशवाज्ञया च मं स्ववता",
 "ymb_008_u03_padya_p02_d401d3": "सर्वं सेहेऽमनसा भीमेनेशैकमानिना हेमनसा",
 "ymb_008_u04_padya_p01_ac2abb": "यद्भक्तप्रवरेण प्रोतः स्वस्मिन् स कीचकः प्रवरेण",
 "ymb_008_u04_padya_p02_39897e": "पतितास्तस्य सहायाः कृष्णार्थे मानिनः समस्य सहायाः",
 "ymb_008_u05_padya_p01_c8e7c8": "यद्भक्त्याऽनुगृहीतौ पार्थो भीमश्च गोनृपौ नु गृहीतौ",
 "ymb_008_u05_padya_p02_d32da4": "ऋणमुक्त्यै सुव्यत्यस्त्यै क्रमशो वीरावमुञ्चतां सुव्यत्यस्त्यै",
 "ymb_008_u06_padya_p01_06acef": "यद्भक्त्याऽमितयाऽलं कृष्णा कार्ये विवेश कृष्णाकार्ये",
 "ymb_008_u06_padya_p02_4efdb9": "यामीरार्द्धतनुत्वान्नापाद् भीमादृतेऽपि नाऽपाद् भीमात्",
 "ymb_009_u01_padya_p01_85429e": "यां स्प्रष्टुमिच्छन्तमजातशत्रुं न्यवारयत् स्वस्थमजातशत्रुम्",
 "ymb_009_u01_padya_p02_7e4ca6": "शंरूपाने नित्यरतेरियं श्रीरिति स्म देवेड् यदितेरियंश्रीः",
 "ymb_009_u02_padya_p01_43531a": "मनसामनसाऽमनसा मनसा यमनन्तमजस्रमवेदनुया",
 "ymb_009_u02_padya_p02_f94713": "विलयं विलयं विलयं विलयन्निखिलं त्वशुभं प्रचकार च यः",
 "ymb_009_u03_padya_p01_c75b5e": "सोऽगाद् दूतमुखेन प्रभुणेदं वर्तते यदूतमुखेन",
 "ymb_009_u03_padya_p02_e3b8e0": "पार्थार्थे बहुतनुतां यत्र प्राकाशयत् स्वयं सबहुतनुताम्",
 "ymb_010_u01_padya_p01_189e93": "गुरुकर्णनदीजादीनवधीच्चक्षुर्बलेन जनदीजादीन्",
 "ymb_010_u01_padya_p02_6e6748": "शक्त्या निजया परवान् स्वजनानुद्रेचयन्ननन्तयाऽपरवान्",
 "ymb_010_u02_padya_p01_595250": "यस्य सुनीतिसहायान्न रिपून् मेनेऽर्जुनः समेतसहा यान्",
 "ymb_010_u02_padya_p02_bf0599": "अकरोच्चासु परासुप्रततिं सेनासु धावनासुपरासु",
 "ymb_010_u03_padya_p01_ba9baa": "येन जयद्रथमारः पार्थः शत्रूनवापतद् रथमारः",
 "ymb_010_u03_padya_p02_34daaa": "यद्विरहादपि देहे स रथः शश्वत् स्थितेः सदादपि देहे",
 "ymb_010_u04_padya_p01_27f33f": "यद्भरितो भरताभः प्रभुरम्भाभावितोऽभिभरताभः",
 "ymb_010_u04_padya_p02_2f4a70": "भीमो रभसाऽभिभवी प्रसभं भाभाभिभूर्भासा भिभवी",
 "ymb_010_u05_padya_p01_f2f6d7": "यदनुग्रहपूर्णत्वाद् भीमः सर्वानरीननहिपूर्णत्वाऽत्",
 "ymb_010_u05_padya_p02_0e4891": "अदहद् बाहुबलेन क्रोधाग्नावाहितान् निजाहुबलेन",
 "ymb_010_u06_padya_p01_68d981": "कृष्णाभीमाप्ततमः क्षीणं येन स्वकीयहृदयमाप्ततमः",
 "ymb_010_u06_padya_p02_41a62d": "धृतराष्ट्रसुतानवधीद् भीमेन स्थापितो मनसि सुसुतानवधीत्",
 "ymb_010_u07_padya_p01_b53ac2": "भीमविपाटितदेहानदर्शयत् स्वानरीन् विपाटितदेहान्",
 "ymb_010_u07_padya_p02_ac6d09": "कृष्णाया हितकारी सम्यगीरप्रियः सदाऽहितकारी",
 "ymb_010_u08_padya_p01_9aa09b": "अथ हरिणा पीतबलं द्रौणेरस्त्रं महारिणाऽपीतबलम्",
 "ymb_010_u08_padya_p02_5c756a": "दधता वासोमरणं नीतं चक्रेऽभिमन्युजं सोमरणम्",
 "ymb_011_u01_padya_p01_6522ef": "तस्य च रक्षा सुकृता जनार्दनेनेशशेषकेक्षासुकृता",
 "ymb_011_u01_padya_p02_017904": "पार्थेषु प्रेमवता नित्यं भर्त्राऽसुतासुविप्रेमवता",
 "ymb_011_u02_padya_p01_5a960f": "ज्ञानं परमं प्रादाद् भीष्मगतः सृतिविमोक्षचरमं प्रादात्",
 "ymb_011_u02_padya_p02_244597": "पाण्डुसुतानामधिकं चक्रे वेदं गुणोत्तरं स्वनामधिकम्",
 "ymb_011_u03_padya_p01_75e74d": "तेनावापि सुजातैर्हरिमेधस्तुरगवर्तनेऽपि सुजातैः",
 "ymb_011_u03_padya_p02_6bcf64": "पाण्डुसुतैः सवसूकैः प्राप्तैर्व्यासात्मना सुसवसूकैः",
 "ymb_011_u04_padya_p01_e982d7": "तदनु स पाण्डुतनूजै रेमे क्ष्मां पालयन् सुपाण्डुतनुजैः",
 "ymb_011_u04_padya_p02_32ce09": "अनुपमसुखरूपोऽजः परमः श्रीवल्लभः सति खरूपो जः",
 "ymb_011_u05_padya_p01_bae91b": "सुगतिं चरमामददान्निजयोग्यां ज्ञानिसुततिं परमामददात्",
 "ymb_011_u05_padya_p02_be86ec": "पार्थानां सयदूनां स पितृप्रेष्यादिनामिनां सयदूनाम्",
 "ymb_012_u01_padya_p01_596c82": "रेमे तत्रापिसुखी परमोऽनन्तो ननन्द तत्रापि सुखी",
 "ymb_012_u01_padya_p02_d9f420": "प्राणेनेन्दिरया च प्रयुतो नित्यं महागुणेन्दिरया च",
 "ymb_012_u02_padya_p01_b0f55b": "एवं सर्वाणि हरे रूपाणि श्रीपतेः सुपर्वाणिहरेः",
 "ymb_012_u02_padya_p02_9571f0": "पूर्णसुखानि सुभान्ति प्रततानि निरन्तराणि सुभान्ति",
 "ymb_013_u01_padya_p01_1889c8": "राम राम महाबाहो माया ते सुदुरासदा",
 "ymb_013_u01_padya_p02_47c649": "वादसादद को लोके पादावेव तवासजेत्",
 "ymb_014_u01_padya_p01_5b631c": "जेत् सवातव वेदापाके लोकोदद सादवा",
 "ymb_014_u01_padya_p02_6b5541": "दासरादुसुतेयामाहोबाहा मम राम रा",
 "ymb_014_u02_padya_p01_0c9b0d": "देवानां पतयो नित्यं मतं यस्य न जानते",
 "ymb_014_u02_padya_p02_e0f927": "तस्मै देव नमस्येऽहं भवते सुरमारये",
 "ymb_015_u01_padya_p01_15f931": "समस्तदेवजनकवासुदेवपरामृत",
 "ymb_015_u01_padya_p02_3f4ccb": "वासुदेव परामृत ज्ञानमूर्ते नमोऽस्तु ते",
 "ymb_016_u01_padya_p01_95ca9e": "देवादे देवलोकप पूर्णानन्दमहोदधे",
 "ymb_016_u01_padya_p02_85d11a": "सर्वज्ञेश रमानाथ देवाऽदेऽदेऽव लोकप",
 "ymb_016_u02_padya_p01_2bdea2": "यो निर्ममेऽशेषपुराणविद्द्यां यो निर्ममेशे षपुराणविद्द्याम्",
 "ymb_016_u02_padya_p02_e97814": "योनिर्ममेशेषपुराऽणविद् यां योऽनिर्ममेऽशेषपुराणविद् द्याम्",
 "ymb_017_u01_padya_p01_57424a": "अनन्तपारामितविक्रमेश प्रभो रमापारमनन्तपार",
 "ymb_017_u01_padya_p02_839d20": "महागुणाढ्यापरिमेयसत्त्व रमालयाशेषमहागुणाढ्य",
 "ymb_018_u01_padya_p01_2aa07a": "भा भा भा भा भा भा भा भा भा भा भा भा भा भा",
 "ymb_018_u01_padya_p02_2aa07a": "भा भा भा भा भा भा भा भा भा भा भा भा भा भा",
 "ymb_019_u01_padya_p01_82e9f2": "नैव परः केशवतः परमादस्मात् समश्च सुकेशवतः",
 "ymb_019_u01_padya_p02_67d108": "सोऽयं शपथवरो नः शश्वत् सन्धारितः सुशपथवरोऽनः",
 "ymb_020_u01_padya_p01_368641": "कृष्णकथेयं यमिता सुखतीर्थेनोदिताऽनने यंयमिता",
 "ymb_020_u01_padya_p02_dac19d": "भक्तिमता परमेशे सर्वोद्रेकात् सदानुताऽऽप रमेशे",
 "ymb_020_u02_padya_p01_4b53c2": "इति नारायणनामा सुखतीर्थसुपूजितः सुरायणना मा",
 "ymb_020_u02_padya_p02_be37ea": "पूर्ण गुणैर्धिक पूर्णज्ञानेच्छाभक्तिभिः स्वधिकपूर्ण",
 "ymb_020_u03_padya_p01_1bed56": "इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितं यमकभारतं सम्पूर्णम्",
 "prs_001_u01_padya_p01_7e2059": "पान्त्वस्मान् पुरुहूतवैरिबलवन्मातङ्गमाद्यद्घटा",
 "prs_001_u01_padya_p02_b50c8d": "कुम्भोच्चाद्रिविपाटनाधिकपटुप्रत्येकवज्रायिताः",
 "prs_001_u01_padya_p03_058e25": "श्रीमत्कण्ठीरवास्यप्रततसुनखरादारितारातिदूर",
 "prs_001_u01_padya_p04_22db93": "प्रध्वस्तध्वान्तशान्तप्रविततमनसा भाविता नाकिवृन्दैः",
 "prs_001_u02_padya_p01_f0036e": "लक्ष्मीकान्त समन्ततो विकलयन् नैवेशितुस्ते समं",
 "prs_001_u02_padya_p02_b59aa9": "पश्याम्युत्तमवस्तु दूरतरतोऽपास्तं रसो योऽष्टमः",
 "prs_001_u02_padya_p03_be3516": "यद्रोषोत्करदक्षनेत्रकुटिलप्रान्तोत्थिताग्निस्फुर",
 "prs_001_u02_padya_p04_c4515f": "त्खद्योतोपमविस्फुलिङ्गभसिता ब्रह्मेशशक्रोत्कराः",
 "prs_001_u03_padya_p01_78cfbc": "अम्बरगङ्गाचुम्बितपादः पदतलविदलितगुरुतरशकटः",
 "prs_001_u03_padya_p02_17c13e": "कालियनागक्ष्वेलनिहन्ता सरसिजनवदलविकसितनयनः",
 "prs_001_u03_padya_p03_fcb413": "कालघनालीकर्बुरकायः शरशतशकलितसुररिपुनिवहः",
 "prs_001_u03_padya_p04_2248a1": "सन्ततमस्मान् पातु मुरारिः सततगसमजवखगपतिनिरतः",
 "prs_002_u01_padya_p01_3e9dfe": "शङ्खचक्रगदापद्मशार्ङ्गखड्गधरं सदा",
 "prs_002_u01_padya_p02_a14a79": "नमामि पितरं नित्यं वासुदेवं जगत्पतिम्",
 "prs_003_u01_padya_p01_200e94": "सच्चिदानन्दरूपं तमनामयमनन्तरम्",
 "prs_003_u01_padya_p02_9dbef4": "एकमेकान्तमभयं विष्णुं विश्वहृदि स्थितम्",
 "prs_003_u02_padya_p01_506e9d": "नानास्वभावमत्यन्तस्वभावेन विचारितम्",
 "prs_003_u02_padya_p02_9b03f7": "अविशेषमनाद्यन्तं प्रणमामि सनातनम्",
 "prs_003_u03_padya_p01_11464e": "कुन्देन्दुसन्निभं वन्दे सुधारसनिभं विभुम्‌",
 "prs_003_u03_padya_p02_07db60": "ज्ञानमुद्रापुस्तकादिशङ्खाक्षायुधधारिणम्",
 "prs_003_u04_padya_p01_98da80": "आनन्दमजरं नित्यमात्मेशममितद्युतिम्‌",
 "prs_003_u04_padya_p02_bd33dc": "वन्दे विश्वस्य पितरं विष्णुं विश्वेश्वरं सदा",
 "prs_003_u05_padya_p01_31ad4e": "अमन्दानन्दसन्दोहसन्तोषितजगत्त्रयम्‌",
 "prs_003_u05_padya_p02_eed6a2": "नारायणमणीयांसं वन्दे देवं सनातनम्‌",
 "prs_003_u06_padya_p01_172fcb": "सूर्यमण्डलमध्यस्थं वराभयकरोद्यतम्‌",
 "prs_003_u06_padya_p02_f76fed": "सूर्यामितद्युतिं वन्दे नारायणमनामयम्",
 "prs_003_u07_padya_p01_6c1456": "विश्वं विश्वाकरं वन्दे विश्वस्य प्रपितामहम्",
 "prs_003_u07_padya_p02_5260b8": "नानारूपमजं नित्यं विश्वात्मानं प्रजापतिम्‌",
 "prs_003_u08_padya_p01_c82c7c": "कालाकालविचारादिप्रकालितसदातनम्",
 "prs_003_u08_padya_p02_d1e3b3": "पुरुषं प्रकृतिस्थं च वन्दे विष्णुमजोत्तमम्",
 "prs_003_u09_padya_p01_f3e44a": "ब्रह्मणः पितरं वन्दे शङ्करस्य पितामहम्‌",
 "prs_003_u09_padya_p02_0c88d1": "श्रियः पतिमजं नित्यमिन्द्रादिप्रपितामहम्‌",
 "prs_003_u10_padya_p01_d3036a": "प्रतिप्रति स्थितं विष्णुं नित्यामृतमनामयम्",
 "prs_003_u10_padya_p02_85a3c9": "शङ्खचक्रधरं वन्दे वराभयकरोद्यतम्‌",
 "prs_003_u11_padya_p01_0ee2aa": "प्रतापप्रविशेषेण दूरीकृतविदूषणम्",
 "prs_003_u11_padya_p02_aed3c8": "विदारितारिमत्यन्तप्रसन्नं प्रणमाम्यहम्‌",
 "prs_003_u12_padya_p01_bc2168": "अप्रमेयमजं नित्यं विशालममृतं परम्‌",
 "prs_003_u12_padya_p02_5ebd01": "कृतनित्यालयालोके नमस्यामि जगत्पतिम्",
 "prs_003_u13_padya_p01_2abe88": "सुनित्यसुखमक्षय्यं शुद्धं शान्तं निरञ्जनम्",
 "prs_003_u13_padya_p02_a35b01": "लोकालोकविचाराढ्यं नमस्यामि श्रियः पतिम्",
 "prs_003_u14_padya_p01_55e645": "अमन्दानन्दसन्दोहसान्द्रमिन्द्रानुजं परम्",
 "prs_003_u14_padya_p02_2cf80a": "नित्यावदातमेकान्तं प्रमाणातीतमक्षयम्‌",
 "prs_003_u14_padya_p03_ff4432": "लोकालोकपतिं दिव्यं नमस्यामि रमापतिम्",
 "prs_003_u15_padya_p01_888a89": "रामोऽखिलानन्दतनुः स एव भीमोऽतिपापेषु दुरन्तवीर्यः",
 "prs_003_u15_padya_p02_20c25d": "कामः स एवाजितकामिनीषु सोमः स एवात्मपदाश्रितेषु",
 "prs_004_u01_padya_p01_f072d8": "चञ्चलोऽयं मनोमीनः समानेयो हरिस्थले",
 "prs_004_u01_padya_p02_452a34": "विषयोदकसञ्चारी सद्भक्तिबडिशाहृतः",
 "prs_004_u02_padya_p01_a5bdb7": "प्रादेशमात्रं तत्त्वार्थे जयार्थेऽरत्निमात्रकम्",
 "prs_004_u02_padya_p02_2e8959": "ख्यातिपूजार्थिनो हस्तमात्रं पत्रमुदाहृतम्",
 "prs_004_u03_padya_p01_d01f5a": "असम्बद्धप्रवचनमसम्बद्धाः प्रवृत्तयः",
 "prs_004_u03_padya_p02_6b941a": "प्रतिज्ञायाश्च सन्त्यागः कथायाः पूर्वनिग्रहः",
 "prs_004_u04_padya_p01_ed2822": "श्रुतिर्नाम समुद्दिष्टं लिङ्गं तल्लक्षणं स्मृतम्",
 "prs_004_u04_padya_p02_6aac32": "पदानि निरपेक्षाणि वाक्यं प्रकरणं तथा",
 "prs_004_u04_padya_p03_4f5b76": "एकस्य प्रतिपत्त्यङ्गवचनं स्थानमुच्यते",
 "prs_004_u04_padya_p04_196e75": "अन्यत्र तत्समोक्तिस्तु समाख्या स्थानमेव च",
 "prs_004_u04_padya_p05_a0127b": "अध्यायादिप्रबन्धास्तु प्रभेदा आगमस्य च",
 "prs_004_u05_padya_p01_ff355b": "श्रुत्वा तद्दिनमारभ्य दशाहमशुचिर्भवेत्",
 "prs_004_u05_padya_p02_910643": "पितरौ तु मृतौ स्यातां दूरस्थोऽपिच पुत्रकः",
 "prs_004_u06_padya_p01_01295d": "अतिक्रान्ते दशाहे तु त्रिरात्रमशुचिर्भवेत्",
 "prs_004_u06_padya_p02_612b11": "संवत्सरे व्यतीते तु स्पृष्ट्वैवापो विशुद्ध्यति",
 "prs_004_u07_padya_p01_cc0a54": "ज्ञातिविषयमेतत्",
 "prs_004_u07_padya_p02_6b185f": "बिल्वमङ्गलः साधुः",
 "ypk_001_u01_padya_p01_2ba72f": "समिच्चर्वाज्यकान् हुत्वा सम्यक् पुरुषसूक्ततः",
 "ypk_001_u01_padya_p02_c51f40": "सर्वेषामभयं दत्वा विरक्तः प्रव्रजेद्धरिम्",
 "ypk_001_u02_padya_p01_f0bbb9": "स्मृत्वा भागवतं शुद्धमाचार्यं शरणं व्रजेत्",
 "ypk_001_u02_padya_p02_fcf5ec": "अधीहि भगवो ब्रह्मेत्यस्मै ब्रूयाद् गुरुः परम्",
 "ypk_001_u03_padya_p01_2757db": "उच्चारयेत् त्रिशस्तारं दक्षिणे श्रवणे तथा",
 "ypk_001_u03_padya_p02_ca82c4": "ऋषिच्छन्दोदैवतानि ब्रूयात् तस्य क्रमात् सुधीः",
 "ypk_002_u01_padya_p01_b10a2b": "अन्तर्यामीति गायत्री परमात्मेत्यनुक्रमात्",
 "ypk_002_u01_padya_p02_b2fc46": "विश्वश्च तैजसः प्राज्ञस्तुर्यश्चाक्षरदेवताः",
 "ypk_002_u02_padya_p01_d450cf": "कृष्णो रामो नृसिंहश्च वराहो विष्णुरेव च",
 "ypk_002_u02_padya_p02_2923fb": "परञ्ज्योतिः परम्ब्रह्म वासुदेव इति क्रमात्",
 "ypk_002_u03_padya_p01_180ea4": "अकारादेस्तथा शान्तातिशान्तान्तस्य देवताः",
 "ypk_002_u03_padya_p02_2d471c": "एवमुक्त्वा तु तद्ध्यानं ब्रूयाद् भक्ताय सद्गुरुः",
 "ypk_002_u04_padya_p01_8e4602": "अष्टपत्रे तु हृत्पद्मे मध्ये सूर्येन्दुवह्निगम्",
 "ypk_002_u04_padya_p02_a4495f": "पीठं तत्पद्ममध्यस्थं नारायणमनामयम्",
 "ypk_003_u01_padya_p01_f6470e": "उद्यदादित्यसङ्काशं तेजसाऽनुपमं सदा",
 "ypk_003_u01_padya_p02_bdc945": "सहस्रेणापि सूर्याणां सज्ज्ञानानन्दरूपिणम्",
 "ypk_003_u02_padya_p01_8a08cf": "अतिरक्ततलं भास्वन्नखव्रातविभूषितम्",
 "ypk_003_u02_padya_p02_6bdfed": "वृत्तजङ्घं वृत्तजानुं हस्तिहस्तोरुमीश्वरम्",
 "ypk_003_u03_padya_p01_0a1c94": "महाकटितटाबद्धकाञ्चीपीताम्बरोज्ज्वलम्",
 "ypk_003_u03_padya_p02_a10aab": "सुनिम्ननाभिं त्रिवलिं सुवृत्तोदरबन्धनम्",
 "ypk_003_u04_padya_p01_68f99f": "विशाळवक्षसं भ्राजत्कौस्तुभामुक्तकन्धरम्",
 "ypk_003_u04_padya_p02_48767a": "वनमालाधरं हारवैजयन्त्यादिभिर्युतम्",
 "ypk_003_u05_padya_p01_84b569": "पृथुदीर्घचतुर्बाहुं चक्रशङ्खगदाम्बुजैः",
 "ypk_003_u05_padya_p02_10c68b": "युक्तमुन्निद्रपद्माक्षं स्फुरन्मकरकुण्डलम्",
 "ypk_003_u06_padya_p01_dca294": "पूर्णचन्द्रायुतोद्रिक्तकान्तिमन्मुखपङ्कजम्",
 "ypk_003_u06_padya_p02_51d96a": "सुभ्रुवं सुललाटान्तं किरीटाबद्धमूर्धजम्",
 "ypk_003_u06_padya_p03_085f7f": "निःशेषदुःखदमनं नित्यानन्दं शुचिस्मितम्",
 "ypk_003_u07_padya_p01_7accc9": "विश्वादींश्चैव कृष्णादीनेवम्भूतान् सनातनान्",
 "ypk_003_u07_padya_p02_c8b0df": "अभिन्नानेव सततं तस्माद् विष्णोः परात्मनः",
 "ypk_003_u07_padya_p03_acad98": "वराभयोद्यतकरान् नित्यानन्दैकरूपिणः",
 "ypk_003_u08_padya_p01_d826a6": "एवमुक्त्वा गुरुर्ध्यानं शपथं कारयेत् ततः",
 "ypk_003_u08_padya_p02_667a06": "न विष्णुं वैष्णवांश्चैव विसृजेयमिति त्रिशः",
 "ypk_004_u01_padya_p01_cdb22f": "नचान्यदेवतासाम्यं तदैक्यमथवा हरेः",
 "ypk_004_u01_padya_p02_50afd2": "चिन्तयेयं मृतौ वाऽपि नचाप्येकत्ववादिभिः",
 "ypk_004_u02_padya_p01_b767e9": "समत्ववादिभिर्वाऽहं सङ्गच्छेयं कदाचन",
 "ypk_004_u02_padya_p02_bf32aa": "तन्निन्दकैश्च तद्भक्तनिन्दकैर्वा महामुने",
 "ypk_004_u03_padya_p01_5d5c26": "एवं कृते तु शपथे मस्तके हस्तपङ्कजम्",
 "ypk_004_u03_padya_p02_cf48b4": "निधायोत्तीर्य संसारात् सुखी भव हरेः प्रियः",
 "ypk_005_u01_padya_p01_bd1e8d": "सर्वदुःखदिभिर्मुक्तो नित्यानन्दैकरूपकः",
 "ypk_005_u01_padya_p02_10e105": "सम्प्राप्य विष्णुसामीप्यं तत्रापि हरिभक्तिमान्",
 "ypk_005_u02_padya_p01_0e54a8": "भक्तिमांश्चान्यदेवेषु तारतम्यं च संस्मरन्",
 "ypk_005_u02_padya_p02_68a900": "सर्वोत्कर्षं स्मरन् विष्णोर्भूयाश्चैव सदा सुखी",
 "ypk_005_u03_padya_p01_25a9e5": "न मुक्तौ विष्णुनैक्यं वा मुक्तानां साम्यमेव वा",
 "ypk_005_u03_padya_p02_ba0846": "स्मरेथा इति चोक्त्वाऽथ समयाननुशिक्षयेत्",
 "ypk_005_u04_padya_p01_9c85f7": "नित्यशश्च हरेः पूजा जपध्यानसमर्पणम्",
 "ypk_005_u04_padya_p02_b7a992": "कर्तव्यं तु त्वया वत्स जपश्च त्रिसहस्रकः",
 "ypk_006_u01_padya_p01_05b4a7": "मध्यमः प्रणवस्योक्तो योऽवरः स सहस्रकः",
 "ypk_006_u01_padya_p02_56bb92": "त्रिसहस्रात् परो यस्तु स उत्तमजपः स्मृतः",
 "ypk_006_u02_padya_p01_ae59b3": "आत्मानं प्रतिबिम्बत्वे ध्यायन् बिम्बं जनार्दनम्",
 "ypk_006_u02_padya_p02_15c7d4": "ध्यायस्व सततं वत्स सपर्यां नित्यशः कुरु",
 "ypk_006_u02_padya_p03_27a0d8": "मानसैर्वाऽथ पुष्पैर्वा प्रणवेन समाहितः",
 "ypk_006_u03_padya_p01_bc3bc3": "अन्यांश्च वैष्णवान् मन्त्राञ्जपेथा भक्तिपूर्वकम्",
 "ypk_006_u03_padya_p02_fb658b": "शृणुष्व वैष्णवं शास्त्रं सदा वेदार्थतत्परः",
 "ypk_006_u04_padya_p01_8cd21b": "वेदान् मन्त्रानुपनिषत्सहितान् सर्वदा शृणु",
 "ypk_006_u04_padya_p02_2abceb": "इतिहासपुराणं च पञ्चरात्रं तथैव च",
 "ypk_006_u05_padya_p01_86c755": "तदर्थान् ब्रह्मसूत्रैश्च सम्यङ् निर्णीय तत्त्वतः",
 "ypk_006_u05_padya_p02_045ff6": "विष्णोः सर्वोत्तमत्वं च सर्वदा प्रतिपादय",
 "ypk_006_u06_padya_p01_e6f4e7": "इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितो यतिप्रणवकल्पः सम्पूर्णः",
 "jyk_001_u01_padya_p01_633d78": "रोहिण्यामर्धरात्रे तु यदा कालाष्टमी भवेत्",
 "jyk_001_u01_padya_p02_66e8b0": "जयन्ती नाम सा प्रोक्ता सर्वपापप्रणाशनी",
 "jyk_001_u02_padya_p01_3d3b8c": "यस्यां जातो हरिः साक्षान्निशीथे भगवानजः",
 "jyk_001_u02_padya_p02_bff55a": "तस्मात् तद्दिनमत्यन्तं पुण्यं पापहरं परम्",
 "jyk_001_u03_padya_p01_e86a54": "तस्मात् सर्वैरुपोष्या सा जयन्ती नाम वै सदा",
 "jyk_001_u03_padya_p02_229d3e": "द्विजातिभिर्विशेषेण तद्भक्तैश्च विशेषतः",
 "jyk_001_u04_padya_p01_34f283": "यो भुङ्क्ते तद्दिने मोहात् पूयशोणितमत्ति सः",
 "jyk_001_u04_padya_p02_edcdff": "तस्मादुपवसेत् पुण्यं तद्दिनं श्रद्धयाऽन्वितः",
 "jyk_001_u05_padya_p01_f6bc30": "कृत्वा शौचं यथान्यायं स्नानं कुर्यादतन्द्रितः",
 "jyk_001_u05_padya_p02_e3e1e7": "प्रभातकाले मेधावी योगायेति यथाविधि",
 "jyk_001_u06_padya_p01_dd3605": "नित्याह्निकं प्रकुर्वीत भगवन्तमनुस्मरन्",
 "jyk_001_u06_padya_p02_816122": "मध्याह्नकाले च पुमान् सायङ्काले त्वतन्द्रितः",
 "jyk_001_u07_padya_p01_b8ef7f": "स्नायीत पूर्वमन्त्रेण वासुदेवमनुस्मरन्",
 "jyk_001_u07_padya_p02_a1314c": "ततः पूजां प्रकुर्वीत विधिवत् सुसमाहितः",
 "jyk_001_u08_padya_p01_7afc13": "यज्ञायेति च मन्त्रेण श्रद्धाभक्तियुतः पुमान्",
 "jyk_001_u08_padya_p02_0de1d7": "कृष्णं च बलभद्रं च वसुदेवं च देवकीम्",
 "jyk_001_u09_padya_p01_336388": "नन्दगोपं यशोदां च सुभद्रां तत्र पूजयेत्",
 "jyk_001_u09_padya_p02_938c63": "अर्घ्यं दत्वा समभ्यर्च्याभ्युत्थिते शशिमण्डले",
 "jyk_001_u10_padya_p01_17ad60": "जातः कंसवधार्थाय भूभारोत्तारणाय च",
 "jyk_001_u10_padya_p02_a39cb7": "कौरवाणां विनाशाय दैत्यानां निधनाय च",
 "jyk_001_u11_padya_p01_dd9a14": "पाण्डवानां हितार्थाय धर्मसंस्थापनाय च",
 "jyk_001_u11_padya_p02_bb0e6e": "गृहाणार्घ्यं मया दत्तं देवक्या सहितो हरे",
 "jyk_001_u12_padya_p01_8f3a8c": "क्षीरोदार्णवसम्भूत अत्रिगोत्रसमुद्धव",
 "jyk_001_u12_padya_p02_c3658d": "गृहाणार्घ्यं मया दत्तं रोहिण्या सहितः शशिन्",
 "jyk_001_u13_padya_p01_ae2514": "दत्वाऽर्घ्यं मनुनाऽनेन ह्युपस्थाय विधुं बुधः",
 "jyk_001_u13_padya_p02_7f15a5": "शशिने चन्द्रदेवाय सोमदेवाय चेन्दवे",
 "jyk_001_u14_padya_p01_fa2dd1": "मृगिणे शीतबिम्बाय लोकदीपाय दीपिने",
 "jyk_001_u14_padya_p02_903f15": "शीतदीधितिबिम्बाय तारकापतये नमः",
 "jyk_001_u15_padya_p01_3809ea": "उपसंहृत्य तत् सर्वं ब्रह्मचारी जितेन्द्रियः",
 "jyk_001_u15_padya_p02_e4f0e9": "विश्वायेति च मन्त्रेण ततः स्वापं समाचरेत्",
 "jyk_001_u16_padya_p01_0c2bd5": "ततो नित्याह्निकं कृत्वा शक्तितो दीयतां धनम्",
 "jyk_001_u16_padya_p02_aaab6e": "सर्वायेति च मन्त्रेण ततः पारणमाचरेत्",
 "jyk_001_u16_padya_p03_829658": "धर्मायेति ततः स्वस्थो मुच्यते सर्वकिल्बिषैः",
 "jyk_001_u17_padya_p01_c1cb21": "इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितो जयन्तीनिर्णयः सम्पूर्णः",
 "nyp_001_u01_padya_p01_74ad33": "नरनारायणं नत्वा पूर्णं ब्रह्माक्षरोदितम्",
 "nyp_001_u01_padya_p02_4a5ea2": "यतेराचरणं वक्ष्ये पूर्णं शास्त्रानुसारतः",
 "nyp_001_u02_padya_p01_b6a020": "अरुणोदयवेळायामुत्थाय हरिमानसः",
 "nyp_001_u02_padya_p02_ef8fb7": "शौचादिकं यथान्यायं कृत्वा दन्तान् विशोधयेत्",
 "nyp_001_u03_padya_p01_4f2095": "कटिशौचं मृदा कुर्याच्छुद्ध्यर्थं जलसंस्थितः",
 "nyp_001_u03_padya_p02_6bad1f": "स्नानं कुर्याद् यथोक्तेन विधिना नियतो हरौ",
 "nyp_001_u04_padya_p01_b68787": "धृतोर्ध्वपुण्ड्रं विधिवत् प्रकल्प्यासनमच्युते",
 "nyp_001_u04_padya_p02_d280c3": "मनो निवेश्याष्टमन्त्रान् यथाशक्ति जपेच्छुचिः",
 "nyp_001_u05_padya_p01_331d96": "द्वादशसहस्रावृत्ति परं ब्रह्माक्षरं जपेत्",
 "nyp_001_u05_padya_p02_5dfa18": "दण्डोदकं जपस्यान्ते दद्याद् विधिविधानतः",
 "nyp_001_u06_padya_p01_f32082": "देवतां परमां सम्यक् पूजयेच्च विधानतः",
 "nyp_001_u06_padya_p02_13b224": "भिक्षाकाले विधानेन चरेद् भिक्षाटनं यतिः",
 "nyp_001_u06_padya_p03_ac92d5": "एकत्र भिक्षाचरणं जघन्यमिति चोच्यते",
 "nyp_001_u07_padya_p01_16f1cc": "अनेकभिक्षाचरणं मुख्यधर्मो यतेः स्मृतः",
 "nyp_001_u07_padya_p02_bc5d2d": "त्रिपञ्चसप्तसद्मानि गच्छेन्नातोऽधिकं पुनः",
 "nyp_001_u08_padya_p01_16e065": "भिक्षाग्रहणकाले तु गृह्णीयाद् दातृतो जलम्",
 "nyp_001_u08_padya_p02_441624": "भिक्षान्ने तज्जलं प्रोक्ष्य पुनर्ग्राह्यं विदा जलम्",
 "nyp_001_u09_padya_p01_d5b2a9": "निवेदयेत् तदन्नं तु वारिजस्योदकेन तु",
 "nyp_001_u09_padya_p02_ca74f8": "प्रोक्ष्य देवाय महते मूलमन्त्रेण वाग्यतः",
 "nyp_001_u09_padya_p03_8661e8": "तदन्नं भक्षयेत् स्वस्थो ह्यजवद्धरिमानसः",
 "nyp_001_u10_padya_p01_65da81": "त्रिवारमुदकस्रानं यतेः शास्त्रेषु चोदितम्",
 "nyp_001_u10_padya_p02_8f0541": "अशक्तस्य यतेः शास्त्रे द्विवारं स्रानचोद‌ना",
 "nyp_001_u10_padya_p03_085635": "अत्यन्ताशक्तविषये त्वेकं स्नानं स्मृतं बुधैः",
 "nyp_001_u11_padya_p01_fe3078": "वेदान्तशास्त्राभ्यसनं मुख्यधर्मो यतेः स्मृतः",
 "nyp_001_u11_padya_p02_9d2118": "देवो नारायणो नित्यं सृष्टिस्थित्यन्तकारकः",
 "nyp_001_u11_padya_p03_055479": "भक्तानां मुक्तिदो नित्यमन्यथाज्ञानिनां तमः",
 "nyp_001_u12_padya_p01_be1de0": "पूर्णप्रज्ञेन मुनिना व्यासवाक्यसमुद्धृतिः",
 "nyp_001_u12_padya_p02_2d0848": "न्यासधर्मस्य विषये शुभा सङ्क्षेपतः कृता",
 "nyp_001_u13_padya_p01_176735": "इति श्रीमदानन्दतीर्थभगवत्पादकृता न्यासपद्धतिः समाप्ता"
}