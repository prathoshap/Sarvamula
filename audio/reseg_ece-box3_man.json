{
 "bsb_1_1_3_u02_padya_p02_eb153c": "शास्त्रयोनित्वात्",
 "bsb_1_1_3_u07_padya_p02_86e29c": "शक्यत्वाच्चानुमानां सर्वत्र",
 "bsb_1_1_3_u15_padya_p02_151706": "शास्त्रं योनिः प्रमाणमस्येति शास्त्रयोनि",
 "bsb_1_1_6_u04_padya_p02_6d31f7": "आत्मशब्दात्",
 "bsb_1_1_26_u06_padya_p02_f74d54": "पाद इत्येकदेशपरिमितम्",
 "bsb_1_1_31_u04_padya_p02_791a2b": "प्राणसंवादादि मुख्यप्राणलिङ्गम्",
 "bsb_1_1_31_u04_padya_p06_940277": "इहाश्रितत्वाच्च",
 "bsb_1_3_28_u06_padya_p01_650610": "यथैव कालनियमः सुरादिनियमस्तथा",
 "bsb_1_3_28_u07_gadya_p03_7ff104": "यथेदानीं तथोपर्यपि देवा भविष्यन्तीतीतरेषामनुमानाच्च",
 "bsb_2_1_14_u04_padya_p04_ddd345": "नह्यन्यस्यान्यत्वं युज्यत इति चेत्",
 "bsb_2_1_14_u04_padya_p08_802161": "तथाच श्रुतिः",
 "bsb_2_1_14_u13_padya_p02_75f553": "फलत्वेऽपि युक्तिविरोधेऽन्तर्भावादत्रोक्तम्",
 "bsb_2_1_26_u02_padya_p02_055864": "नच कर्तुरीश्वरस्यादृष्टिविरोधः",
 "bsb_2_1_29_u02_padya_p01_d02005": "आत्मनि चैवं विचित्राश्च हि",
 "bsb_2_1_32_u02_padya_p02_c815fc": "नच करणाभावादनुपपत्तिरिति युक्तम्",
 "bsb_2_2_5_u02_padya_p04_4c98a2": "अतो ब्रवीति- अन्यत्राभावाच्च न तृणादिवत्",
 "bsb_2_3_24_u02_padya_p02_0fc536": "अणोरपि जीवस्य सर्वशरीरव्याप्तिर्युज्यते",
 "bsb_2_4_1_u08_padya_p02_619e72": "अत उच्यते- तथा प्राणाः",
 "bsb_3_1_4_u04_padya_p01_21f586": "इत्यादिश्रुतेर्न प्राणानां जीवेन सह गतिरिति चेत्",
 "bsb_3_1_4_u06_padya_p02_daefdb": "ब्रह्माण्डे च",
 "bsb_3_1_27_u02_padya_p04_7cb421": "शब्दविहितत्वात्",
 "bsb_3_2_13_u04_padya_p01_aa7892": "इति",
 "bsb_3_2_22_u02_padya_p02_1f6d01": "अत आह- प्रकृतैतावत्त्वं हि प्रतिषेधति ततो ब्रवीति च भूयः",
 "bsb_3_3_4_u02_padya_p01_e172fe": "सलिलवच्च तन्नियमः",
 "bsb_3_3_40_u02_padya_p01_b8afc9": "प्रकृतेरपि जन्मादेः संसारप्राप्तेः किमिति नामादिष्वपाठ इति",
 "bsb_3_3_56_u02_padya_p02_bd2bc6": "ज्ञानादिभेदे विद्यमानेऽपि नांशांशिनोः पृथग्भाव एव",
 "bsb_3_3_58_u02_padya_p02_7ae9ca": "सर्वदेवतामन्त्रा यथाऽधीयन्ते",
 "bsb_3_3_59_u02_padya_p03_f6e23a": "दीक्षाप्रायणीयोदयनीयसवनत्रयावभृथात्मकः क्रतुः",
 "bsb_3_4_27_u02_padya_p01_ee3945": "शमदमाद्युपेतः स्यात् तथाऽपि तु तद्विधेस्तदङ्गतया तेषामवश्यानुष्ठेयत्वात्",
 "bsb_3_4_41_u02_padya_p01_c606bc": "नचाधिकारिकमपि पतनानुमानात् तदयोगात्",
 "bsb_3_4_41_u02_padya_p05_847c63": "चशब्दस्तु ज्ञानार्थिनां पूर्वोक्तादित्थम्भावान्तरसूचकः",
 "bsb_3_4_51_u02_padya_p02_67999b": "एवमेव प्रारब्धकर्माभावे शरीरपातानन्तरमेव मोक्षः",
 "bsb_4_1_4_u04_padya_p03_63283b": "ब्रह्मतर्के च",
 "bsb_4_1_17_u02_padya_p01_286c87": "अतोऽन्यदपीत्येकेषामुभयोः",
 "bsb_4_4_16_u04_padya_p01_5edefc": "इत्यादिना स्वर्गादिस्थस्यैतदिति वाच्यम्",
 "bsb_4_4_16_u07_padya_p02_83543a": "ब्रह्मवैवर्ते च–",
 "nvv_seq137_u02_padya_p02_a3b1d7": "स्वतन्त्रस्य च पूर्णगुणत्वनियमात्",
 "nvv_seq143_u02_padya_p01_6a8a0c": "नच वियत उत्पत्तिमत्वेऽनुभूतियुक्तिबहुवाग्विरोधोऽस्ति",
 "nvv_seq143_u02_padya_p05_284830": "आकाशो नीलिमोदेति न प्रदेशः कथञ्चन",
 "nvv_seq157_u02_padya_p02_d878fe": "क्रमादुत्पद्यते क्रमाद् विलीयते क्रमेणैवोत्पत्तिर्विलयश्च क्रमेणैव ह्यस्योत्पत्तिविलयौ इत्यादिलोकानुसारिबहुवाक्यानुरोधश्च यथोत्पत्तिविलये",
 "nvv_seq193_u02_padya_p01_949552": "नच यत्प्राप्तिर्यत्परित्याग उत्पत्तिर्मरणं तथा",
 "nvv_seq193_u02_padya_p05_1321c9": "किं नाम न सृजेदेष येन शक्त्येदमावृतम्",
 "nvv_seq195_u02_padya_p03_24e6a0": "तद्दासाः पञ्च चान्येऽपि प्राणाद्याः सद्गुणैर्युताः",
 "nvv_seq203_u02_padya_p03_374468": "रूपापेक्षं तथा नाम व्यवहारस्तदात्मकः",
 "nvv_seq248_u02_padya_p01_c5d472": "नच पितुः सकाशादन्यतो वौदर्यगर्भस्थशरीरमेव प्रवेष्टुमुपपत्तेर्योनिप्रवेशाभाव इति वाच्यम्",
 "nvv_seq248_u02_padya_p05_4e4919": "इति वचनाच्च",
 "nvv_seq262_u02_padya_p04_6bdb99": "इति श्रुतिमानात्",
 "nvv_seq282_u02_padya_p04_54253a": "इत्यादिश्रुतिभ्योऽलौकिकत्वावगमात्",
 "nvv_seq288_u02_padya_p04_e1ce6a": "करोति क्वापि नियता क्रीडा सृष्ट्यादिकाऽस्य च",
 "nvv_seq288_u02_padya_p08_466dd0": "इति श्रुतेश्च",
 "nvv_seq290_u02_padya_p04_5c1e32": "क्वचिद् ददाति क्वच नो ददाति नह्यानन्त्यात् कर्मणां भोगनाशः",
 "nvv_seq290_u02_padya_p08_fcf624": "इति ब्रह्माण्डे",
 "nvv_seq290_u02_padya_p12_6cbc39": "अतः प्रलोभकल्पने श्रुतहानिरश्रुतकल्पना चेति हरिरेव फलप्रदः",
 "nvv_seq298_u02_padya_p04_eecfe9": "युगपत् स्वभुजौ यद्वद् ध्यायेत् तावत एव सः",
 "nvv_seq304_u02_padya_p01_5be4ef": "प्रियशिरस्त्वादीनामानन्दादिविशेषत्वेनैव दर्शनात् तेषामपि सर्वोपसंहार्यत्वमिति न मन्तव्यम्",
 "nvv_seq316_u02_padya_p01_c93f81": "ब्रह्मणश्च ब्रह्माण्याश्च स्थानैक्यं गुणतारतम्यं च यथागुणोपासनं मुक्तावाधिक्यं न भवतीत्यत्र लिङ्गम्",
 "nvv_seq316_u02_padya_p05_0adea5": "कदाचिल्लोपयेद् देवी स्थानैक्यं न गुणैस्ततः",
 "nvv_seq320_u02_padya_p02_32bf65": "सत्यो ज्ञानं परमानन्दरूप आत्मेत्येवं नित्यदोपासनं स्यात्",
 "nvv_seq320_u02_padya_p06_52270f": "देवानां युगपज्ज्ञानं मनुष्याणां तथा नतु",
 "nvv_seq330_u02_padya_p02_2f7f73": "अधिकारानुसारित्वात् प्रयत्नस्य",
 "nvv_seq330_u02_padya_p06_4e4919": "इति वचनाच्च",
 "nvv_seq336_u02_padya_p04_24a549": "पूर्ण आत्मा पूर्णो नात्र किञ्चिदूनं पूर्णमेवाधस्तात् पूर्णमुपरिष्टात् पूर्णं",
 "nvv_seq336_u02_padya_p08_91a9ba": "पूर्णस्य पूर्णमादाय पूर्णमेवावशिष्यते",
 "nvv_seq336_u02_padya_p12_4e4919": "इति वचनाच्च",
 "nvv_seq382_u02_padya_p04_99bab9": "विपरीतप्रवृत्तेस्तु तस्य ह्रासोऽधिकं भवेत्",
 "nvv_seq388_u02_padya_p03_6ae15b": "तदेष श्लोकः",
 "nvv_seq388_u02_padya_p07_7e729a": "यो ह्यत्वरया स महत्",
 "nvv_seq411_u02_padya_p02_d4eacf": "न चेत् कर्माक्षय इति वाच्यम्",
 "nvv_seq411_u02_padya_p06_4e4919": "इति वचनाच्च",
 "nvv_seq417_u02_padya_p04_aeb701": "पृथक्स्थितेन रूपेण जीवं धारयति प्रभुः",
 "nvv_seq417_u02_padya_p08_57f97b": "पृथक्छक्तोऽपि तद्गैस्तु स्वरूपैस्तद्गकार्यकृत्",
 "nvv_seq431_u02_padya_p02_7d323a": "क्रियानुवृत्तिर्लौकिके साधने तु मनोनुवृत्तिर्वैदिके साधने स्यात्",
 "nvv_seq431_u02_padya_p06_aae660": "वचनप्रामाण्यात्",
 "nvv_seq449_u02_padya_p04_9b38ec": "पूर्णैश्वर्याद् भगवान् वासुदेवो विरुद्धशक्तिर्नच दोषस्पृगीशः",
 "nvv_seq457_u02_padya_p02_90413c": "तदभावे भोगासम्भव इति दोषः",
 "nvv_seq459_u02_padya_p01_14a60e": "नच सङ्कल्पादेव समस्तसम्भवात् सृष्ट्यादिसमस्तकार्यसम्भवः",
 "nvv_seq459_u02_padya_p05_1a5c6d": "नहि कश्चित् सुशक्तोऽपि चकाराचेतनं चितम्",
 "nvv_seq459_u02_padya_p09_d6812d": "मुक्तानां तु नियन्तारस्तेषां ब्रह्माऽस्य वै हरिः",
 "ait_seq12_u01_padya_p03_d4045a": "अन्तरीक्ष्यो यतो द्युस्थो द्युनामाऽतिप्रकाशनात्",
 "ait_seq12_u01_padya_p07_74b2b0": "पृथक्पृथक् च तस्याङ्गान्युक्थानि जगदीशितुः",
 "ait_seq12_u01_padya_p11_b29f0d": "विष्णोस्तृचाशीतिवत् स्यात् प्रसिद्धान्नमिति स्फुटम्",
 "ait_seq12_u01_padya_p15_e70623": "मुखनासाचक्षुषां तद्भोग्यमन्नं हरेः श्रुतम्",
 "ait_seq12_u01_padya_p19_bae3b1": "तस्मात् तस्यार्क इति सा प्रोच्यते वैदिकैः पदैः",
 "ait_seq12_u01_padya_p23_90d76b": "स्थितो विष्णुस्तदर्कास्ते तस्मादेव प्रकीर्तिताः",
 "ait_seq12_u01_padya_p27_473032": "विष्णोर्वाग् भार्गवो रामः प्राणोऽस्य नरकेसरी",
 "ait_seq12_u01_padya_p31_2c2709": "अङ्गाङ्गित्वेनैक एव स्वानन्दानुभवे स्थितः",
 "ait_seq12_u01_padya_p35_672dbe": "अन्ननामा स एवान्ने चेष्टयन् सर्वमास्थितः",
 "ait_seq12_u01_padya_p39_9ee2cb": "परस्य विष्णोर्धामत्वात् सूर्यो ब्रध्न इतीरितः",
 "ait_seq12_u01_padya_p43_b498e3": "इतो गतं सर्वमत्ति द्युनामा भगवान् परः",
 "ait_seq12_u01_padya_p47_08dfee": "हरिः स सर्वजीवानां न भुज्यन्ते यथाऽमुना",
 "ait_seq16_u01_padya_p03_b3d46f": "यस्मात् प्रपेदे भगवान् प्रपदाच्चतुराननम्",
 "ait_seq16_u01_padya_p07_b574b0": "अयादूर्ध्वं ततो विष्णुः प्रपदादूरुमत्र च",
 "ait_seq16_u01_padya_p11_453235": "उर्वेव गरणं चक्रे वायुर्यत्र स्थितः सदा",
 "ait_seq16_u01_padya_p15_15cddf": "उरोमध्ये च हृदयं तत्रावासो हरेः सदा",
 "ait_seq16_u01_padya_p19_f40f3a": "उदरस्थं च हृद्गं च ते उभे ब्रह्म तत् परम्",
 "ait_seq16_u01_padya_p23_f8a7d5": "तत्र प्राणात्मना वायुर्मनोरूपेण शङ्करः",
 "ait_seq16_u01_padya_p27_b916d3": "श्रोत्रं चन्द्रो रविश्चक्षुर्वागग्निः परिकीर्तितः",
 "ait_seq16_u01_padya_p31_81a372": "ते विष्णोराज्ञयाऽवोचन्नुत्क्रमाम पृथक्पृथक्",
 "ait_seq16_u01_padya_p35_c7d15b": "निष्क्रान्तेषु न वै पातः शरीरस्याभवत् क्वचित्",
 "ait_seq16_u01_padya_p39_9eca65": "पुनस्ते प्राविशन् सर्वे वह्निसूर्यो शशी शिवः",
 "ait_seq16_u01_padya_p43_2aa3d2": "उच्चत्वं च गुणाधिक्यं त्वमुच्चोऽसीति तेऽब्रुवन्",
 "ait_seq16_u01_padya_p47_193bb7": "वायुः स संस्तुतस्तैश्च प्रसन्नोऽभूद् दिवौकसाम्",
 "ait_seq18_u01_padya_p04_f51250": "येये गुणान् विजानन्ति वायोस्तानाविशन्मरुत्",
 "ait_seq18_u01_padya_p08_7c3a1a": "सङ्गतत्वात् सायमिति तद् रूपं नामतोऽभवत्",
 "ait_seq18_u01_padya_p12_ed341e": "मित्रो यमश्च वरुणः कुबेरश्च दिगीश्वराः",
 "ait_seq18_u01_padya_p16_303226": "श्रोत्रं तु वरुणः काम्यशास्त्रार्थं मित्र एव च",
 "ait_seq18_u01_padya_p20_23865d": "एताः सर्वा देवता हि ब्रह्मवायुसुपर्णकाः",
 "ait_seq18_u01_padya_p24_ad2c8b": "देवमात्रास्तदन्ये तु स आविः पुरुषोत्तमः",
 "ait_seq18_u01_padya_p28_3b0028": "मदभीष्टं ममादातुं नैवेष्टे कश्चनाञ्जसा",
 "ait_seq18_u01_padya_p32_b9a213": "मन्निषेधे न शक्तोऽस्ति प्रीता देवा हि मे सदा",
 "ait_seq18_u01_padya_p36_fea68c": "वेद तं च नियोक्तारमुपास्ते विष्णुमव्ययम्",
 "ait_seq18_u01_padya_p40_3e212e": "इत्येतद्ध्यानयोग्याश्च मुनयो देवतास्तथा",
 "ait_seq18_u01_padya_p44_3c22e3": "सर्वोत्तमत्वात् पूर्णत्वात् सर्वज्ञत्वात् तथैव च",
 "ait_seq18_u01_padya_p48_ff235d": "तीति ब्रह्मा समुद्धिष्टः स एवान्नाभिमानवान्",
 "ait_seq18_u01_padya_p52_121b82": "देवतात्रयमेतत् तु सहितं सत्यमुच्यते",
 "ait_seq18_u01_padya_p56_c7ce9c": "देवता मुनयश्चैव योग्या अस्या अपि स्फुटम्",
 "ait_seq20_u01_padya_p03_74a778": "विप्रक्षत्रियवैश्यादिरूपं चाखिलमेव तु",
 "ait_seq20_u01_padya_p07_b4da4b": "य एतद् विष्णुवाचैव बद्धं नामाख्यदामभिः",
 "ait_seq20_u01_padya_p11_85b1fe": "योग्यश्चास्या उपासाया योग्यो ब्रह्मपदस्य यः",
 "ait_seq20_u01_padya_p15_8bad52": "तथैव वायुना बद्धं जगदेतत् ततोऽवरम्",
 "ait_seq20_u01_padya_p19_64dbf9": "लोमप्राणादिभेदश्च नैव कश्चिच्चिदात्मनि",
 "ait_seq20_u01_padya_p23_158788": "योग्या अस्याश्च विद्याया भृग्वाद्या देवतास्तथा",
 "ait_seq20_u01_padya_p27_d934a1": "छन्दस्सु संस्थितो वायुर्वायौ च स जनार्दनः",
 "ait_seq20_u01_padya_p31_95e927": "आ समन्तात् पराक् चापि पञ्चभूतेभ्य ईश्वरः",
 "ait_seq20_u01_padya_p35_7a9f5f": "अन्तश्च सर्वलोकेषु चरतो लोकसाक्षिणौ",
 "ait_seq20_u01_padya_p39_6c1646": "आवृताः सर्वजीवा हि यथैव कनकावटाः",
 "ait_seq20_u01_padya_p43_05250f": "स वायुः प्रकृतिश्चैव विष्टब्धौ केशवेन हि",
 "ait_seq20_u01_padya_p47_845783": "इति विद्यात्",
 "ait_seq24_u01_padya_p04_f6d595": "इदं मदाख्यं यद् ब्रह्म ह्याप इत्यभिधीयते",
 "ait_seq24_u01_padya_p08_3b25f1": "स्वतन्त्रत्वाज्जगन्नाथः पितृत्वात् परमेशितुः",
 "ait_seq24_u01_padya_p12_18c193": "यथा पितामहाद्याश्च पितरो नाम कीर्तिताः",
 "ait_seq24_u01_padya_p16_d28e05": "नारायणादिनामानि ददौ नान्यस्य केशवः",
 "ait_seq24_u01_padya_p20_50d0c7": "मत्पर्यन्तं तथा व्याप्तिं देवानामपि सर्वशः",
 "ait_seq24_u01_padya_p24_07a967": "ज्ञानकर्मबलेहाद्या मद्दता इति किं वदे",
 "ait_seq24_u01_padya_p28_2cb4c0": "प्राणनामा प्रणेतृत्वात् तमेनं गुणपूर्तितः",
 "ait_seq24_u01_padya_p32_54e7af": "पराभवति पाप्माऽस्य द्वेष्टा निरयगः सदा",
 "ait_seq24_u01_padya_p36_f74012": "अज्ञानादिप्रदातृत्वात् स एवाभूतिनामकः",
 "ait_seq24_u01_padya_p40_64c211": "देवानामपि सर्वेषां प्रधानोऽद्यापि मारुतः",
 "ait_seq24_u01_padya_p44_579055": "इत्येवोपासते तस्मात् पराभूताश्च सर्वशः",
 "ait_seq24_u01_padya_p48_3c3009": "ज्ञानैश्वर्यादिभिः सोऽपि भवेत् तस्य परात्मनः",
 "ait_seq24_u01_padya_p52_6a12a8": "प्राणं नियमयत्यस्मिन् शरीरे पुरुषोत्तमः",
 "ait_seq24_u01_padya_p56_4e41e6": "अवाक् प्राक् च सदा गच्छेद् वायुरानन्दरूपिणा",
 "ait_seq24_u01_padya_p60_132f5d": "अनित्या अपि देहास्ते शश्वत् सन्त्या विमोक्षतः",
 "ait_seq24_u01_padya_p64_05624b": "जडं तज्जडतामेति चेतना वायुदेवता",
 "ait_seq24_u01_padya_p68_cca215": "य एवं वेद तं वायुममृतं सर्वनायकम्",
 "ait_seq24_u01_padya_p72_6134c0": "ब्रह्म पन्थाः सत्यं कर्म इति तस्य नारायणस्य वासुदेवाद्याः",
 "ait_seq24_u01_padya_p76_9aff9c": "तथा इति निर्णयः",
 "ait_seq24_u03_padya_p02_c0d23d": "ब्रह्मा हैव ताइ ते",
 "ait_seq24_u04_padya_p04_4a5532": "स्वरस्पर्शविभागेन तत्रोक्तिः स्याद् विभक्तिषु",
 "ait_seq24_u04_padya_p08_a24fd4": "नैश्वर्ये न बले चैव नानन्दादिगुणेष्वपि",
 "ait_seq24_u07_padya_p01_a71816": "इत्यतो ब्रह्मा ह इति दैर्घ्यमपि परब्रह्मत्वविवक्षया",
 "ait_seq24_u08_padya_p01_61dc95": "तस्योष्णिग् लोमानि",
 "ait_seq24_u12_padya_p01_ff0d5d": "सप्तसु प्रथमा",
 "ait_seq24_u16_padya_p01_efd91e": "ब्राह्मणोऽस्य मुखमासीत्",
 "ait_seq24_u19_padya_p01_1ad601": "इति च स्कान्दे",
 "ait_seq24_u19_padya_p05_c8d8eb": "दिग्भ्योऽप्यन्य एव विशृणोति जीवः",
 "ait_seq24_u21_padya_p01_ded6e4": "इत्यादिना भगवतः सकाशाद्धि सर्वेषां सृष्टिः प्रसिद्धा",
 "ait_seq24_u21_padya_p05_ab4664": "नहि यत्किञ्चित् कारणत्वमस्तीत्येतावता ब्राह्मणस्य चण्डालः पितेत्युच्यते",
 "ait_seq24_u24_padya_p01_6ff10c": "मनुष्याणां तु यत् कर्म न देवोत्पत्तिकारणम्",
 "ait_seq24_u25_gadya_p01_7e4c84": "इति च ब्रह्माण्डे",
 "ait_seq24_u27_padya_p03_c8ffea": "यथा",
 "ait_seq24_u30_padya_p01_27c148": "पूर्वं तु बादरायणो हेतुव्यपदेशात्",
 "ait_seq71_u01_padya_p02_67f74c": "अत आधिक्यात् बृहतीसम्पादनमेव वरम्",
 "ait_seq71_u03_padya_p02_53e904": "अष्टचतुरक्षराण्यनुष्टुप्",
 "ait_seq71_u03_padya_p06_febf10": "वायुस्तस्य प्रतिमारूपमिदं बृहतीसहस्रम्",
 "ait_seq71_u03_padya_p10_5da9dc": "वाग्रूपाया उमाया उत्पत्तिः संस्मृता भवत्येवं जानतः",
 "ait_seq71_u03_padya_p14_2e4b30": "तस्माद् बृहत्याः सकाशादनुष्टुप्सम्पादने तस्यैव विष्णोः प्रतिमान्तरं तस्मादेव निर्मितं भवति",
 "ait_seq71_u03_padya_p18_2d3f79": "वायुरेव यद् भगवन्नियतो नियामयति तस्मात्",
 "ait_seq71_u11_padya_p02_0f27b0": "स वा एष वाचः परमो विकारः",
 "ait_seq71_u15_padya_p01_e7580d": "इत्यादि शब्दनिर्णये",
 "ait_seq71_u15_padya_p05_e1fb50": "वाच उद्वर्तनाशक्तेः स्वयमेवोद्वर्तते",
 "ait_seq71_u15_padya_p09_9c7d3b": "अकारस्यादौ स्थितत्वेन च यथार्थरूपत्वात्",
 "ait_seq71_u15_padya_p13_a3b2c3": "यमर्थमकारो वक्ति तमेव वक्तीति",
 "ait_seq71_u15_padya_p17_605b25": "तस्माद् विजानतः सर्वमपि भगवन्नामैव",
 "ait_seq73_u03_padya_p04_c928c2": "स हि यत् प्रथमत इन्द्रो बभूव स्वेच्छया यज्ञनामा",
 "ait_seq73_u05_padya_p03_80d981": "अतो विष्णावेवेन्द्रशब्दं प्रयुङ्क्ते श्रुतिः",
 "ait_seq73_u07_padya_p04_3ca048": "नहि सर्वेषां पृथङ् मत्सिशब्ददर्शन एकस्यैवान्यथात्वं युज्यते",
 "ait_seq73_u09_padya_p02_942f8f": "यत्र चैवं भूतेष्वेकत्वे विरोधो दृश्यते तत्र तेनैव विरोधेन द्वित्वं भवति",
 "ait_seq73_u11_padya_p03_418f3a": "तस्मान्मुख्यतो विष्णावेवेन्द्रादिशब्दा अन्येषामुपचारतः",
 "ait_seq73_u17_padya_p02_cb4ce1": "पूज्यो ह्यग्रजो भवति",
 "ait_seq73_u19_padya_p04_b0dd5d": "अन्येन्द्रो हि",
 "ait_seq73_u25_padya_p01_bd5601": "इति धातोर्विशेषेण धारणपोषणकर्ता हि वेधाः",
 "ait_seq73_u27_padya_p03_7f421a": "मनुष्यदृष्टिगोचरतां प्राप्यैषु लोकेषु राजति",
 "ait_seq73_u29_padya_p02_f9bf1a": "नहि मृतः पुनरेषु लोकेष्वेव राजति",
 "ait_seq73_u33_padya_p02_f66615": "यदनेन रूपेणामुं लोकमभिसम्भवति",
 "ait_seq73_u35_padya_p02_e1200f": "यच्छब्दः किंशब्दार्थे",
 "ait_seq73_u39_padya_p01_8db353": "इति शब्दनिर्णये",
 "ait_seq73_u39_padya_p05_e509a7": "दिविष्ठाय स्वपुरुषरूपाय प्रयच्छति देवरेतःस्थिताय च",
 "ait_seq73_u39_padya_p09_41c90d": "एवमादित्यनाम्नो विष्णोः",
 "ait_seq73_u39_padya_p13_d2100f": "भगवानेव ह्यत्र प्रस्तुतः",
 "ait_seq75_u01_padya_p01_00959d": "यन्नारायणादिरूपेण पञ्चविधमक्षरं परं ब्रह्म तत् स्वस्मिन्नेव स्त्रीपुंरूपेण समेति",
 "ait_seq75_u01_padya_p05_5b4ee1": "तत्र तस्मिन्नेव परे ब्रह्मणि नारायणाख्ये सर्वदेवा एकीभवन्ति मुक्ताः",
 "ait_seq75_u04_padya_p01_13a707": "इत्यादिवत्",
 "ait_seq75_u04_padya_p05_226a04": "नचाज्ञात एकत्वे पुनर्ज्ञाते ऐक्यं प्राप्त इति प्रयोगो दृश्यते",
 "ait_seq75_u04_padya_p09_f45189": "किन्तु संसर्ग एव भवति",
 "ait_seq75_u08_padya_p03_b97e16": "तस्मान्न पुनरुक्तिः",
 "ait_seq75_u08_padya_p07_38a2ed": "ततश्चाधिकं समतृप्यन्",
 "ait_seq75_u08_padya_p11_b86af4": "सर्वयुजो भवन्ति मनोवाक्कर्मभिस्तत्रैव युक्ता भवन्ति",
 "ait_seq75_u14_padya_p02_3d41e1": "स्वतन्त्रो हि भगवान् तत्प्रेरित एव तं वदतीत्यभिप्रायः",
 "ait_seq75_u14_padya_p06_12b084": "तस्माद् वदत्येव",
 "ait_seq75_u22_padya_p03_20ce0f": "अकारो विशेषतो नारायणवाचक इत्याह- अः इति ब्रह्मेति",
 "ait_seq75_u24_padya_p04_3361f3": "प्रत्यक्षत्वाज्जीवजडात्मकस्य जगत एवानुक्तावपि प्रस्तुतरूपत्वात् तदन्यस्तद्विरोधी तत्र दृश्यमानदोषवर्जितश्चाकारशब्दार्थ इति सिद्ध्यति",
 "ait_seq75_u24_padya_p08_a02d5b": "नच शून्यस्याशब्दार्थता",
 "ait_seq75_u24_padya_p12_afa51a": "एकदेशार्थत्वात्",
 "ait_seq75_u24_padya_p16_bb6277": "तस्मात् पारतन्त्र्याल्पगुणत्वादिसर्ववस्तुस्वभावविरुद्धस्वभावं स्वतन्त्रं पूर्णगुणं सर्वजीवजडेभ्योऽन्यद् अज्ञानदुःखाल्पत्वपारतन्त्र्योत्पत्तिनाशादिसर्वदोषविवर्जितं ब्रह्मैवाशब्दार्थः",
 "ait_seq75_u24_padya_p20_441afe": "तस्मादकारशब्दार्थ एव ब्रह्मशब्दार्थः",
 "ait_seq75_u26_padya_p02_b40964": "अः इति ब्रह्म पूर्णं वस्तूच्यते",
 "ait_seq75_u26_padya_p06_9c30cc": "अन्येषां सर्वेषां मदधीनत्वादल्पत्वादिति",
 "ait_seq75_u28_padya_p01_1028a2": "इति",
 "ait_seq75_u30_padya_p01_dcf9fe": "इति",
 "ait_seq75_u34_padya_p03_98e323": "जीवस्थितेनाक्षरगेनाक्षरनाम्ना स्वरूपेण जीवाख्यसूर्यस्थितमहराख्यं स्वरूपमाप्नोति तेन चाक्षराख्यं स्वरूपमाप्नोति",
 "ait_seq75_u36_padya_p04_b2a0bb": "नच नपुंसकरूपं भगवतः कुत्रचिदुक्तम्",
 "ait_seq75_u38_padya_p01_6bc841": "इति ब्रह्माण्डे",
 "ait_seq75_u40_padya_p02_36ef93": "तेन रथेनाध्यात्मं शरीराख्येनाधिदैवं रथरूपेण",
 "ait_seq75_u44_padya_p03_59e013": "विवस्वतो विष्णोः सकाशाद् दिवोदुहिता अहनी च जायन्ते",
 "ait_seq75_u44_padya_p07_376c39": "सूर्यस्याश्विनामाभावात्",
 "ait_seq75_u46_padya_p02_ac44c8": "नच रात्रौ सुदिनमिति प्रयोगो दृष्टः",
 "ait_seq75_u48_padya_p01_415f84": "इति ज्ञानावस्थायां मुक्तौ भोगबाहुल्यकारणत्वात् साऽपि मुक्तिवत् सुदिनम्",
 "ait_seq75_u50_padya_p03_771c13": "ज्ञानात् पूर्वं तु पतनसंशयादेव न सुदिनम्",
 "ait_seq75_u52_padya_p01_10a562": "इति वचनात्",
 "ait_seq186_u01_padya_p01_737262": "भगवदुपासकस्य यस्मिन् कस्मिंश्चिद् दोष उक्ते तं प्रत्युक्तिप्रकारः पूर्वं दर्शितः",
 "ait_seq186_u03_padya_p01_1fe17e": "इति च",
 "ait_seq186_u03_padya_p05_b6eb15": "मम प्रीतिं कर्तुं नाशकः",
 "vtn_seq40_u06_padya_p03_f53149": "नच वर्णपदादीनामनित्यत्वं वक्तुं युक्तम्",
 "vtn_seq40_u06_padya_p07_2cda84": "पुराणानामप्यन्यथाशब्दरचनमेवानित्यत्वम्",
 "vtn_seq73_u01_padya_p04_a3c8b0": "द्विविधं बलवत्त्वं च बहुत्वाच्च स्वभावतः",
 "vtn_seq73_u01_padya_p08_196f82": "बल्येवानुभवस्तत्र निर्दोषं त्वक्षजादिकम्",
 "vtn_seq76_u01_padya_p01_ccbc56": "यामाहुरनुमां केचित् त्रियाद्यवयवात्मिकाम्",
 "vtn_seq76_u01_padya_p05_40378b": "तथोपनयरूपा च परा निगमनात्मिका",
 "vtn_seq76_u01_padya_p09_337a83": "प्रतिज्ञावयवत्वात्तु स्वातन्त्र्येणैव मानताम्",
 "vtn_seq76_u01_padya_p13_6a3b9e": "प्रामाण्यं यात्यनुभवो ज्ञापयत्युपपत्तिताम्",
 "vtn_seq78_u01_padya_p04_d8ea47": "जनकं प्रमाणमुद्दिष्टं स्वस्यार्थस्य प्रकाशनात्",
 "vtn_seq80_u01_padya_p03_9a8c26": "एतत्सदृशताज्ञानमुपमानं प्रकीर्तितम्",
 "vtn_seq80_u01_padya_p07_d7f6b5": "एकं प्रत्यक्षरूपं स्याद् द्वितीयमनुमात्मकम्",
 "vtn_seq170_u04_padya_p01_ae01e4": "यथा सोम्य मधु मधुकृतो निस्तिष्ठन्ति नानात्ययानां वृक्षाणां रसानां",
 "vtn_seq170_u04_padya_p05_747666": "त इह व्याघ्रो वा सिंहो वा वृको वा",
 "vtn_seq170_u05_padya_p04_4fd517": "प्रजाः सत आगम्य न विदुः सत आगच्छामह इति",
 "vtn_seq170_u07_padya_p01_df9854": "न्यग्रोधफलमत आहरेतीदं भगव इति भिन्धीति भिन्नं भगव इति",
 "vtn_seq170_u07_padya_p05_5589dd": "सोम्यैषोऽणिम्न एवं महान् न्यग्रोधस्तिष्ठति",
 "vtn_seq172_u01_padya_p02_d850e0": "इह व्याघ्रो वा सिंहो वा",
 "vtn_seq174_u02_padya_p02_7be39c": "स्व इति परमात्मनोऽभिधानम्",
 "vtn_seq174_u08_padya_p02_c8bd10": "एकीभावविवक्षायां",
 "vtn_seq219_u07_padya_p01_2b8024": "यत्र त्वस्य सर्वमात्मैवाभूत् तत् केन कं पश्येत् तत्",
 "vtn_seq222_u06_padya_p02_19dddb": "नहि भोगाभावो",
 "vtn_seq250_u02_padya_p04_877bc8": "नच निवर्तते",
 "vtn_seq250_u02_padya_p08_ab840e": "मायामात्रत्वात्",
 "vtn_seq250_u02_padya_p12_bd9d70": "नहीश्वरस्य भ्रान्तिः",
 "vtn_seq250_u04_padya_p03_940060": "सर्वस्मादुत्तमोऽर्थः स एक एवेत्यर्थः",
 "vtn_seq250_u06_padya_p03_a57784": "अन्येषां समाधिकभावः",
 "vtn_seq250_u08_padya_p04_5667c5": "विद्येतेत्यस्य चोत्पत्त्यर्थानङ्गीकारे यद्यदस्ति तत्तन्निवर्तत इति व्याप्त्यभावान्निवर्तेतेति न युज्यते",
 "vtn_seq250_u08_padya_p08_60a99d": "अज्ञानिनां पक्ष एव द्वैतं न विद्यत इत्यर्थः",
 "vtn_seq252_u05_padya_p04_a426e0": "’ इति",
 "gb_2_14d_u01_padya_p04_b05595": "नच विपर्यये किञ्चिन्मानम्",
 "gb_2_17b_u26_padya_p01_475266": "इत्यादि मोक्षानन्तरमपि भेदवचनेभ्यः",
 "gb_2_17b_u40_padya_p03_8cb2f8": "नचैकविज्ञानेन सर्वविज्ञानं तत्पक्षे",
 "gb_2_17b_u42_padya_p01_07ddc8": "इत्येतदात्मसम्बन्धि",
 "gb_2_17b_u44_padya_p02_bf4541": "अविद्यमानमेवेश्वरं सृष्ट्यादिकं चाप्राप्तमेवात्मनो भिन्नत्वेन प्रापयित्वा तन्निषेधे कथं श्रुतेरुन्मत्तवाक्यत्वं",
 "gb_2_17b_u46_padya_p03_157679": "अभेदानुवादेन भेदोपदेशः किमिति न स्यात्? सर्वशाखान्ते भेदोक्तेश्चैतदेव युक्तम्",
 "gb_2_17b_u53_padya_p04_0ef4e8": "लक्षितस्वरूपस्यापि न स्वरूपाद् विशेषः",
 "gb_2_17b_u53_padya_p08_d7b057": "अतः सत्यत्वं सत्यं स्यात्",
 "gb_2_17b_u53_padya_p12_22dccb": "अतो जीवेश्वरयोर्भेद एवेति सिद्धम्",
 "gb_2_39_u06_padya_p02_6843a8": "साङ्ख्यस्य निरीश्वरत्वादुक्तत्वाच्चेश्वरस्य",
 "gb_2_39_u08_padya_p01_b715db": "इति",
 "gb_3_17_u10_padya_p03_1d1a0a": "असक्त आचरन्नेव यस्मात् परमाप्नोति",
 "gb_3_17_u13_padya_p01_ca0a7a": "ब्रह्मनिष्ठा ब्रह्मरता ब्रह्मज्ञानसुतर्पिताः",
 "gb_3_17_u16_padya_p01_eb7e37": "इत्येवशब्देन मुक्तानामेभ्यो विशेषो दर्शितः",
 "gb_7_7_u18_padya_p03_4bf2a2": "अन्यथा",
 "gb_7_7_u31_padya_p02_51f1ed": "बहूनां जन्मनामन्ते ज्ञानवान् भवति",
 "gb_7_27_u04_padya_p01_7446a9": "इति च भारते",
 "gb_7_27_u06_padya_p01_db7233": "इत्युक्तत्वात्",
 "gb_11_1_u20_padya_p01_1c1f2b": "इत्यादिरूपविशेषणाच्च रूपस्येश्वरसाक्षात्स्वरूपत्वम्",
 "gb_11_1_u29_padya_p02_6e91e3": "कमलासने ब्रह्मणि स्थितं रुद्रम्",
 "gb_13_0_u01_padya_p01_8141c2": "अर्जुन उवाच",
 "gb_13_13_u10_padya_p01_93b096": "इति पूर्वमेव सिद्धत्वात्",
 "gt_2_55_u04_padya_p01_60c27a": "इत्यादिना दर्शयिष्यन् लक्षणं प्रथमत आह- प्रजहातीति",
 "gt_2_55_u04_padya_p05_9ced3d": "शुकादीनामपीषद्दर्शनात्",
 "gt_2_55_u06_padya_p03_1e044a": "तच्चोक्तम्",
 "gt_2_55_u08_padya_p02_d33777": "अत एव वैलक्षण्यादनधिकारिणामाग्रहादि चेदस्ति",
 "gt_2_55_u10_padya_p01_381998": "इति स्नेहनिषेधात्",
 "gt_2_55_u10_padya_p05_8a444b": "तथाऽपि न तत्रैवेति नियमः",
 "gt_2_55_u12_padya_p02_6bd57c": "मनोगता हि कामाः",
 "gt_2_55_u14_padya_p01_dcf9fe": "इति",
 "gt_2_55_u14_padya_p05_90a0db": "परमात्मन्येव स्थितः सन्",
 "gt_2_55_u16_padya_p01_10f955": "इत्युक्तं हि नारायणरामकल्पे",
 "gt_3_34_u02_padya_p03_1f4bb5": "तथाह्युक्तम्",
 "gt_5_2_u13_padya_p01_bafb3c": "इत्यादेश्च ब्राह्मे",
 "gt_13_0_u02_padya_p01_2bd347": "श्रीभगवानुवाच- इदं शरीरं कौन्तेय क्षेत्रमित्यभिधीयते",
 "gt_16_1_u06_gadya_p01_57c625": "इत्यभिधानम् पैशुनं परोपद्रवनिमित्तदोषाणां राजादेः",
 "gt_16_1_u08_padya_p01_d26b1e": "इत्यभिधानम्",
 "gt_16_1_u10_padya_p02_8d0034": "अचापलं स्थैर्यम्",
 "gt_16_1_u13_padya_p01_28db7d": "अक्रोधदोषकृच्छत्रोः क्षमावान् स निगद्यते",
 "gt_16_11_u09_padya_p03_80a354": "यदि स्यान्मामपीदानीं कारयतु - इत्यादि",
 "gt_17_27b_u01_padya_p01_b2d89c": "ओमित्युक्त्वाऽनभिसन्धाय फलं यज्ञदानतपआदिकृतामतिप्रीतेर्नामसाम्याद् ब्रह्मैव निष्पादितं भवतीत्याशयः",
 "tvk_seq14_u01_padya_p02_8cc65f": "नित्यानित्यत्वभेदेन देशः कालः श्रुतिस्तथा",
 "tvk_seq18_u01_padya_p02_9ef4f0": "रूपमेव द्विधं तच्च यावद्वस्तु च खण्डितम्",
 "tvk_seq18_u01_padya_p06_829954": "क्रियाक्रियावतोस्तद्वत् तथा जातिविशेषयोः",
 "uk_seq5_u01_padya_p05_250fd5": "अज्ञता चाल्पशक्तित्वं दुःखित्वं स्वल्पकर्तृता",
 "uk_seq5_u03_padya_p01_96a029": "इत्यादिवाक्यान्मृषा नच",
 "uk_seq11_u07_gadya_p01_11ef1e": "इति श्रुतेः सदा",
 "tdy_seq72_u03_padya_p01_cd73f5": "इति भारतवचनान्न विश्लेषाद् विशेषः",
 "tsk_seq12_u01_padya_p05_cf2549": "देवर्षिपितृपनरा इति मुक्तास्तु पञ्चधा",
 "tsk_seq12_u01_padya_p09_9cdc95": "ते च प्राप्तान्धतमसः सृतिसंस्था इति द्विधा",
 "man_seq1_u03_gadya_p01_ef43ea": "इति पाद्मे",
 "kat_seq11_u09_padya_p02_251990": "लोकादिः प्रतिष्ठा ब्रह्मजज्ञोऽनन्तलोकाप्तिरित्यादिविशेषणैश्च भगवानेव",
 "kat_seq11_u11_padya_p04_471873": "नचाग्निपरिज्ञानमात्रेणानन्तलोकाप्तिर्भगवज्ज्ञानं विना",
 "kan_seq288_u02_padya_p02_5e4ded": "बभूवेति",
 "kan_seq288_u06_padya_p04_7fa0e1": "कक्ष्यं नारायणकवचम्",
 "kan_seq288_u06_padya_p08_f94f62": "स्तनयित्नुर्वृष्टिमिव",
 "kan_seq288_u06_padya_p12_6355be": "पूर्वं जानन्नपीन्द्रः पश्चाद् विश्वरूपाच्छुश्रावेति पुनर्नवत्वायेति न विश्वरूपस्त्वाष्ट्रोऽश्विभ्यामित्यनेन विरोधः",
 "knr_seq35_u04_padya_p02_4ab1c6": "आयो जानातीत्यायोमन्यः",
 "knr_seq35_u04_padya_p06_32fe2b": "अयनेन प्राप्यं दूरस्थम् आयो इति वा",
 "knr_seq35_u06_padya_p04_64f69e": "विश्वध विश्वधारक",
 "cha_seq200_u50_padya_p01_3ff34a": "असत्यमप्रतिष्ठं ते जगदाहुरनीश्वरम् एतां दृष्टिमवष्टभ्य नष्टात्मानोऽल्पबुद्धयः",
 "bt_1_8_5_u01_padya_p02_05f65d": "सोग्निष्‍टोमस्य यो हन्ति गजरथौ सोऽश्‍वमेधराजसूयाभ्याम्",
 "bt_10_21_50_u02_padya_p34_8c67b9": "अन्यानि भूतानि मात्रामुपजीवन्ति",
 "bt_10_40_15_u04_padya_p04_3938bc": "जीवगुणा विसंवृताः अधिसंवृताः",
 "bt_10_40_15_u04_padya_p08_85a627": "अनोऽस्यनन्तोऽसि सृजतो हि ते श्रुतयोऽनुवर्तन्ते नैवासृजतः",
 "bt_10_40_17_u03_padya_p01_1c36cf": "त्यजन्ति तापं य उ ते भवत्कथा इति स्म",
 "bt_10_40_19_u10_padya_p02_db41e9": "प्राण एवैनमनुभुङ्क्ते प्राणमितरा देवताः",
 "bt_10_40_19_u13_padya_p02_698a82": "पुरुषं तस्मात्प्रपदे तस्मात्प्रपदे इत्याचक्षते",
 "bt_10_40_19_u13_padya_p06_855743": "ऊर्ध्वं त्वेवोदसर्प-त्तच्छिरोऽश्रयत यच्छिरोऽश्रयत तच्छिरोऽभवत्तच्छिरसः शिरस्त्वं ता एता शिर्षञ्च्छ्रियः",
 "bt_11_9_25_u04_padya_p02_7e11c9": "प्रश्वसित्यभूतिरित्यसुरास्ते ह पराबभूवुः"
}