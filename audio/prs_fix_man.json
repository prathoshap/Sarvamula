{
 "prs_002_u01_padya_p01_78cfbc": "अम्बरगङ्गाचुम्बितपादः पदतलविदलितगुरुतरशकटः",
 "prs_002_u01_padya_p02_17c13e": "कालियनागक्ष्वेलनिहन्ता सरसिजनवदलविकसितनयनः",
 "prs_002_u01_padya_p03_fcb413": "कालघनालीकर्बुरकायः शरशतशकलितसुररिपुनिवहः",
 "prs_002_u01_padya_p04_2248a1": "सन्ततमस्मान् पातु मुरारिः सततगसमजवखगपतिनिरतः",
 "prs_003_u01_padya_p01_3e9dfe": "शङ्खचक्रगदापद्मशार्ङ्गखड्गधरं सदा",
 "prs_003_u01_padya_p02_a14a79": "नमामि पितरं नित्यं वासुदेवं जगत्पतिम्",
 "prs_003_u02_padya_p01_200e94": "सच्चिदानन्दरूपं तमनामयमनन्तरम्",
 "prs_003_u02_padya_p02_9dbef4": "एकमेकान्तमभयं विष्णुं विश्वहृदि स्थितम्",
 "prs_003_u03_padya_p01_506e9d": "नानास्वभावमत्यन्तस्वभावेन विचारितम्",
 "prs_003_u03_padya_p02_9b03f7": "अविशेषमनाद्यन्तं प्रणमामि सनातनम्",
 "prs_003_u04_padya_p01_11464e": "कुन्देन्दुसन्निभं वन्दे सुधारसनिभं विभुम्‌",
 "prs_003_u04_padya_p02_07db60": "ज्ञानमुद्रापुस्तकादिशङ्खाक्षायुधधारिणम्",
 "prs_003_u05_padya_p01_98da80": "आनन्दमजरं नित्यमात्मेशममितद्युतिम्‌",
 "prs_003_u05_padya_p02_bd33dc": "वन्दे विश्वस्य पितरं विष्णुं विश्वेश्वरं सदा",
 "prs_003_u06_padya_p01_31ad4e": "अमन्दानन्दसन्दोहसन्तोषितजगत्त्रयम्‌",
 "prs_003_u06_padya_p02_eed6a2": "नारायणमणीयांसं वन्दे देवं सनातनम्‌",
 "prs_003_u07_padya_p01_172fcb": "सूर्यमण्डलमध्यस्थं वराभयकरोद्यतम्‌",
 "prs_003_u07_padya_p02_f76fed": "सूर्यामितद्युतिं वन्दे नारायणमनामयम्",
 "prs_003_u08_padya_p01_6c1456": "विश्वं विश्वाकरं वन्दे विश्वस्य प्रपितामहम्",
 "prs_003_u08_padya_p02_5260b8": "नानारूपमजं नित्यं विश्वात्मानं प्रजापतिम्‌",
 "prs_003_u09_padya_p01_c82c7c": "कालाकालविचारादिप्रकालितसदातनम्",
 "prs_003_u09_padya_p02_d1e3b3": "पुरुषं प्रकृतिस्थं च वन्दे विष्णुमजोत्तमम्",
 "prs_003_u10_padya_p01_f3e44a": "ब्रह्मणः पितरं वन्दे शङ्करस्य पितामहम्‌",
 "prs_003_u10_padya_p02_0c88d1": "श्रियः पतिमजं नित्यमिन्द्रादिप्रपितामहम्‌",
 "prs_003_u11_padya_p01_d3036a": "प्रतिप्रति स्थितं विष्णुं नित्यामृतमनामयम्",
 "prs_003_u11_padya_p02_85a3c9": "शङ्खचक्रधरं वन्दे वराभयकरोद्यतम्‌",
 "prs_003_u12_padya_p01_0ee2aa": "प्रतापप्रविशेषेण दूरीकृतविदूषणम्",
 "prs_003_u12_padya_p02_aed3c8": "विदारितारिमत्यन्तप्रसन्नं प्रणमाम्यहम्‌",
 "prs_003_u13_padya_p01_bc2168": "अप्रमेयमजं नित्यं विशालममृतं परम्‌",
 "prs_003_u13_padya_p02_5ebd01": "कृतनित्यालयालोके नमस्यामि जगत्पतिम्",
 "prs_003_u14_padya_p01_2abe88": "सुनित्यसुखमक्षय्यं शुद्धं शान्तं निरञ्जनम्",
 "prs_003_u14_padya_p02_a35b01": "लोकालोकविचाराढ्यं नमस्यामि श्रियः पतिम्",
 "prs_003_u15_padya_p01_55e645": "अमन्दानन्दसन्दोहसान्द्रमिन्द्रानुजं परम्",
 "prs_003_u15_padya_p02_2cf80a": "नित्यावदातमेकान्तं प्रमाणातीतमक्षयम्‌",
 "prs_003_u15_padya_p03_ff4432": "लोकालोकपतिं दिव्यं नमस्यामि रमापतिम्",
 "prs_004_u01_padya_p01_888a89": "रामोऽखिलानन्दतनुः स एव भीमोऽतिपापेषु दुरन्तवीर्यः",
 "prs_004_u01_padya_p02_20c25d": "कामः स एवाजितकामिनीषु सोमः स एवात्मपदाश्रितेषु",
 "prs_004_u02_padya_p01_f072d8": "चञ्चलोऽयं मनोमीनः समानेयो हरिस्थले",
 "prs_004_u02_padya_p02_452a34": "विषयोदकसञ्चारी सद्भक्तिबडिशाहृतः",
 "prs_004_u03_padya_p01_a5bdb7": "प्रादेशमात्रं तत्त्वार्थे जयार्थेऽरत्निमात्रकम्",
 "prs_004_u03_padya_p02_2e8959": "ख्यातिपूजार्थिनो हस्तमात्रं पत्रमुदाहृतम्",
 "prs_004_u04_padya_p01_d01f5a": "असम्बद्धप्रवचनमसम्बद्धाः प्रवृत्तयः",
 "prs_004_u04_padya_p02_6b941a": "प्रतिज्ञायाश्च सन्त्यागः कथायाः पूर्वनिग्रहः",
 "prs_004_u05_padya_p01_ed2822": "श्रुतिर्नाम समुद्दिष्टं लिङ्गं तल्लक्षणं स्मृतम्",
 "prs_004_u05_padya_p02_6aac32": "पदानि निरपेक्षाणि वाक्यं प्रकरणं तथा",
 "prs_004_u05_padya_p03_4f5b76": "एकस्य प्रतिपत्त्यङ्गवचनं स्थानमुच्यते",
 "prs_004_u05_padya_p04_196e75": "अन्यत्र तत्समोक्तिस्तु समाख्या स्थानमेव च",
 "prs_004_u05_padya_p05_a0127b": "अध्यायादिप्रबन्धास्तु प्रभेदा आगमस्य च",
 "prs_004_u06_padya_p01_ff355b": "श्रुत्वा तद्दिनमारभ्य दशाहमशुचिर्भवेत्",
 "prs_004_u06_padya_p02_910643": "पितरौ तु मृतौ स्यातां दूरस्थोऽपिच पुत्रकः",
 "prs_004_u07_padya_p01_01295d": "अतिक्रान्ते दशाहे तु त्रिरात्रमशुचिर्भवेत्",
 "prs_004_u07_padya_p02_612b11": "संवत्सरे व्यतीते तु स्पृष्ट्वैवापो विशुद्ध्यति",
 "prs_004_u08_padya_p01_cc0a54": "ज्ञातिविषयमेतत्",
 "prs_004_u08_padya_p02_6b185f": "बिल्वमङ्गलः साधुः"
}