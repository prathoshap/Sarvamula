[{"id": "kat_seq7_u01_sutra_p01_d89d11", "meter": "anuṣṭubh", "padas": ["शान्तसङ्कल्पः सुमना यथा स्याद् वीतमन्युर्गौतमो माऽभि मृत्यो त्वत्प्रसृष्टं माऽभि वदेत् प्रतीत एतत् त्रयाणां प्रथमं वरं वृणे यथा पुरस्ताद् भविता प्रतीत औद्दालकिरारुणिर्मत्प्रसृष्टः सुखं रात्रीः शयिता वीतमन्युस्त्वां ददृशिवान् मृत्युमुखात् प्रमुक्तम् स्वर्गे लोके न भयं किञ्चनास्ति न तत्र त्वं न जरया बिभेति उभे तीर्त्वा अशनायापिपासे शोकातिगो मोदते स्वर्गलोके स त्वमग्निं स्वर्ग्यमध्येषि मृत्यो प्रब्रूहि तं श्रद्दधानाय मह्यम् स्वर्गलोका अमृतत्वं भजन्त एतद् द्वितीयेन वृणे वरेण प्र ते ब्रवीमि तदु मे निबोध स्वर्ग्यमग्निं नचिकेतः प्रजानन् अनन्तलोकाप्तिमथो प्रतिष्ठां विद्धि त्वमेतं निहितं गुहायाम् लोकादिमग्निं तमुवाच तस्मै या इष्टका यावतीर्या यथा वा स चापि तत् प्रत्यवदद् यथोक्तमथास्य मृत्युः पुनराह तुष्टः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq41_u01_sutra_p01_5e6b29", "meter": "anuṣṭubh", "padas": ["अणोरणीयान् महतो महीयानात्माऽस्य जन्तोर्निहितो गुहायाम् तमक्रतुः पश्यति वीतशोको धातुः प्रसादान्महिमानमात्मनः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq72_u01_sutra_p01_22ecb9", "meter": "śārdūlavikrīḍita", "padas": ["पुरमेकादशद्वारमजस्यावक्रचेतसः अनुष्ठाय न शोचति विमुक्तश्च विमुच्यते एतद् वै तत्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq43_u01_sutra_p01_4ed41f", "meter": "anuṣṭubh", "padas": ["आसीनो दूरं व्रजति शयानो याति सर्वतः कस्तं मदामदं देवं मदन्यो ज्ञातुमर्हति"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq13_u02_gadya_p01_882aec", "meter": "anuṣṭubh", "padas": ["प्रेते मुक्ते मनुष्ये नियामकत्वेन भगवान् अस्तीति ज्ञानिनो वदन्ति"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq29_u09_gadya_p03_358a89", "meter": "anuṣṭubh", "padas": ["नच मृत्वा यमं प्राप्तस्य नचिकेतसो मृतोऽस्ति न वेति संशयो युज्यते"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq68_u04_gadya_p06_7db8ea", "meter": "anuṣṭubh", "padas": ["भेदाभेद एव निषिध्यते नतु भेद इत्याशङ्कां निवारयितुं एवं"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq37_u03_gadya_p06_3b1e7c", "meter": "anuṣṭubh", "padas": ["विपश्चितस्