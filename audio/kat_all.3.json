[{"id": "kat_seq17_u01_sutra_p01_95a0a6", "meter": "anuṣṭubh", "padas": ["देवैरत्रापि विचिकित्सितं किल त्वं च मृत्यो यन्न सुज्ञेयमात्थ वक्ता चास्य त्वादृगन्यो न लभ्यो नान्यो वरस्तुल्य एतस्य कश्चित् शतायुषः पुत्रपौत्रान् वृणीष्व बहून् पशून् हस्तिहिरण्यमश्वान् भूमेर्महदायतनं वृणीष्व स्वयं च जीव शरदो यावदिच्छसि एतत् तुल्यं यदि मन्यसे वरं वृणीष्व वित्तं चिरजीविकां च महाभूमौ नचिकेतस्त्वमेधि कामानां त्वा कामभाजं करोमि येये कामा दुर्लभा मर्त्यलोके सर्वान् कामांश्छन्दतः प्रार्थयस्व इमा रामाः सरथाः सतूर्या नहीदृशा लम्भनीया मनुष्यैः आभिर्मत्प्रत्ताभिः परिचारयस्व नचिकेतो मरणं माऽनु प्राक्षीः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq85_u01_sutra_p01_d54be5", "meter": "anuṣṭubh", "padas": ["यदा पञ्चावतिष्ठन्ते ज्ञानानि मनसा सह बुद्धिश्च न विचेष्टति तमाहुः परमां गतिम् तां योगमिति मन्यन्ते स्थिरामिन्द्रियधारणाम् अप्रमत्तस्तदा भवति योगो हि प्रभवाप्ययौ"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq66_u01_sutra_p01_7b9f18", "meter": "anuṣṭubh", "padas": ["अरण्योर्निहितो जातवेदा गर्भ इव सुभृतो गर्भिणीभिः दिवे दिव ईड्यो जागृवद्भिर्हविष्मद्भिर्मनुष्येभिरग्निः एतद् वै तत्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq15_u01_sutra_p01_0b285e", "meter": "sragdharā", "padas": ["देवैरत्रापि विचिकित्सितं पुरा नहि सुज्ञेयोऽणुरेष धर्मः अन्यं वरं नचिकेतो वृणीष्व मा मोपरोत्सीरति मा सृजैवम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq11_u09_gadya_p02_251990", "meter": "anuṣṭubh", "padas": ["लोकादिः प्रतिष्ठा ब्रह्मजज्ञोऽनन्तलोकाप्तिरित्यादिविशेषणैश्च भगवानेव"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq81_u02_gadya_p01_405e6c", "meter": "anuṣṭubh", "padas": ["पुनः इन्द्रियेभ्यः परं मनः इत्यादि देवतातारतम्यज्ञानपूर्वकं भगवतः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq68_u04_gadya_p08_29415d", "meter": "anuṣṭubh", "padas": ["भगवद्धर्माणामवयवगुणकर्मणां भेददर्शने पृथग् दोषमाह"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq68_u04_gadya_p04_78910c", "meter": "anuṣṭubh", "padas": ["नेह नानाऽस्ति किञ्चन इति किञ्चनशब्दादवयवानां गुणानां"], "seed": 60, "no_sandhi": true}