    "verse": "१",
    "start": 93,
    "end": 182,
    "padas": [
     "विष्णुरेव विजिज्ञास्यः सर्वकर्ताऽऽगमोदितः",
     "समन्वयादीक्षतेश्च पूर्णानन्दोऽन्तरः खवत्"
    ],
    "bounds": [
     "hard",
     "hard"
    ],
    "gapafter": [
     false,
     false
    ],
    "lead_gap": false,
    "meter": "anuṣṭubh",
    "meter_src": "fallback",
    "opens_pranava": false,
    "text": "विष्णुरेव विजिज्ञास्यः सर्वकर्ताऽऽगमोदितः समन्वयादीक्षतेश्च पूर्णानन्दोऽन्तरः खवत्",
