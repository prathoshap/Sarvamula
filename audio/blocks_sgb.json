    ],
    "lead_gap": false,
    "meter": "anuṣṭubh",
    "meter_src": "fallback",
    "opens_pranava": false,
    "text": "ज्ञेयो न वेदैः शूद्राद्यैः कम्पकोऽन्यश्च जीवतः पतित्वादिगुणैर्युक्तस्तदन्यत्र च वाचकैः",
