    "verse": "२",
    "start": 182,
    "end": 274,
    "padas": [
     "प्रणेता ज्योतिरित्याद्यैः प्रसिद्धैरन्यवस्तुषु",
     "उच्यते विष्णुरेवैकः सर्वैः सर्वगुणत्वतः"
    ],
    "bounds": [
     "hard",
     "hard"
    ],
    "gapafter": [
     false,
     false
    ],
    "lead_gap": false,
    "meter": "anuṣṭubh",
    "meter_src": "fallback",
    "opens_pranava": false,
    "text": "प्रणेता ज्योतिरित्याद्यैः प्रसिद्धैरन्यवस्तुषु उच्यते विष्णुरेवैकः सर्वैः सर्वगुणत्वतः",
