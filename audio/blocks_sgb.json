    ],
    "lead_gap": false,
    "meter": "anuṣṭubh",
    "meter_src": "fallback",
    "opens_pranava": false,
    "text": "सर्वगोऽत्ता नियन्ता च दृश्यत्वाद्युज्झितः सदा | विश्वजीवान्तरत्वाद्यैर्लिङ्गैः सर्वैर्युतः स हि",
