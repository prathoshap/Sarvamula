    "verse": "७",
    "start": 638,
    "end": 756,
    "padas": [
     "अवान्तरं कारणं च प्रकृतिः शून्यमेव च",
     "इत्याद्यन्यत्र नियतैरपि मुख्यतयोदितः",
     "शब्दैरतोऽनन्तगुणो यच्छब्दा योगवृत्तयः"
    ],
    "bounds": [
     "hard",
     "hard",
     "hard"
    ],
    "gapafter": [
     false,
     false,
     false
    ],
    "lead_gap": false,
    "meter": "anuṣṭubh",
    "meter_src": "fallback",
    "opens_pranava": false,
    "text": "अवान्तरं कारणं च प्रकृतिः शून्यमेव च इत्याद्यन्यत्र नियतैरपि मुख्यतयोदितः शब्दैरतोऽनन्तगुणो यच्छब्दा योगवृत्तयः",
