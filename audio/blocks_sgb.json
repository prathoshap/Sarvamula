    "verse": "६",
    "start": 550,
    "end": 638,
    "padas": [
     "मुख्यतः सर्वशब्दैश्च वाच्य एको जनार्दनः",
     "अव्यक्तः कर्मवाक्यैश्च वाच्य एकोऽमितात्मकः"
    ],
    "bounds": [
     "hard",
     "hard"
    ],
    "gapafter": [
     false,
     false
    ],
    "lead_gap": false,
    "meter": "anuṣṭubh",
    "meter_src": "fallback",
    "opens_pranava": false,
    "text": "मुख्यतः सर्वशब्दैश्च वाच्य एको जनार्दनः अव्यक्तः कर्मवाक्यैश्च वाच्य एकोऽमितात्मकः",
