    ],
    "lead_gap": false,
    "meter": "anuṣṭubh",
    "meter_src": "fallback",
    "opens_pranava": false,
    "text": "सर्वाश्रयः पूर्णगुणः सोऽक्षरः सन् हृदब्जगः सूर्यादिभासकः प्राणप्रेरको दैवतैरपि",
