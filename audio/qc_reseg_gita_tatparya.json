{
 "gt_2_55_u02_padya_p02_9edc2a": "मत्तादिप्रवृत्तिवदिति",
 "gt_2_55_u04_padya_p04_fc3776": "प्रायः सर्वान् प्रजहाति",
 "gt_2_55_u06_padya_p02_e7153b": "यदा त्विन्द्रादीनामाग्रहो दृश्यते तदाभिभूतं तेषां ज्ञानम्",
 "gt_2_55_u08_padya_p01_4f245b": "इति",
 "gt_2_55_u09_padya_p01_c5dc93": "यः सर्वत्रानभिस्नेहः",
 "gt_2_55_u10_padya_p04_37c442": "सम्प्रज्ञाते त्वविरोधः",
 "gt_2_55_u12_padya_p01_fa8e13": "इति स्मृतेः",
 "gt_2_55_u13_padya_p01_ddd51b": "रसोऽप्यस्य परं दृष्ट्वा निवर्तते",
 "gt_2_55_u14_padya_p04_ccd2d9": "आत्मना परमात्मना",
 "gt_2_55_u15_padya_p02_30987c": "देवाद् भवति वै तुष्टिर्नान्यथा तु कथञ्चन",
 "gt_3_34_u02_padya_p02_4012bc": "निग्रहात् सद्यः प्रयोजनाभावेऽपि भवत्येवातिप्रयत्नत इत्याशयवानाह- इन्द्रियस्येति",
 "gt_3_34_u04_gadya_p01_dcf9fe": "इति",
 "gt_13_0_u01_padya_p01_8141c2": "अर्जुन उवाच",
 "gt_16_1_u05_padya_p01_7418f0": "ब्रह्मचर्यादिकं तपः",
 "gt_16_1_u07_padya_p02_3730b4": "राजादेस्तु मदाद् भीतेरदृष्टिर्दर्प उच्यते",
 "gt_16_1_u10_padya_p01_ef2b82": "इत्यभिधानात्",
 "gt_16_1_u12_padya_p02_9cf042": "क्षमा तु क्रोधाभावेन सहापकर्तुरनपकृतिः",
 "gt_16_11_u09_padya_p02_da775c": "न कस्यचिद् विष्णुः कारयिता",
 "gt_16_11_u11_gadya_p01_f5934d": "इति सामवेदे यास्कश्रुतिः",
 "gt_2_55_u04_padya_p01_60c27a": "इत्यादिना दर्शयिष्यन् लक्षणं प्रथमत आह- प्रजहातीति",
 "gt_2_55_u04_padya_p05_9ced3d": "शुकादीनामपीषद्दर्शनात्",
 "gt_2_55_u06_padya_p03_1e044a": "तच्चोक्तम्",
 "gt_2_55_u08_padya_p02_d33777": "अत एव वैलक्षण्यादनधिकारिणामाग्रहादि चेदस्ति",
 "gt_2_55_u10_padya_p01_381998": "इति स्नेहनिषेधात्",
 "gt_2_55_u10_padya_p05_8a444b": "तथाऽपि न तत्रैवेति नियमः",
 "gt_2_55_u12_padya_p02_6bd57c": "मनोगता हि कामाः",
 "gt_2_55_u14_padya_p01_dcf9fe": "इति",
 "gt_2_55_u14_padya_p05_90a0db": "परमात्मन्येव स्थितः सन्",
 "gt_2_55_u16_padya_p01_10f955": "इत्युक्तं हि नारायणरामकल्पे",
 "gt_3_34_u02_padya_p03_1f4bb5": "तथाह्युक्तम्",
 "gt_5_2_u13_padya_p01_bafb3c": "इत्यादेश्च ब्राह्मे",
 "gt_13_0_u02_padya_p01_2bd347": "श्रीभगवानुवाच- इदं शरीरं कौन्तेय क्षेत्रमित्यभिधीयते",
 "gt_16_1_u06_gadya_p01_57c625": "इत्यभिधानम् पैशुनं परोपद्रवनिमित्तदोषाणां राजादेः",
 "gt_16_1_u08_padya_p01_d26b1e": "इत्यभिधानम्",
 "gt_16_1_u10_padya_p02_8d0034": "अचापलं स्थैर्यम्",
 "gt_16_1_u13_padya_p01_28db7d": "अक्रोधदोषकृच्छत्रोः क्षमावान् स निगद्यते",
 "gt_16_11_u09_padya_p03_80a354": "यदि स्यान्मामपीदानीं कारयतु - इत्यादि",
 "gt_17_27b_u01_padya_p01_b2d89c": "ओमित्युक्त्वाऽनभिसन्धाय फलं यज्ञदानतपआदिकृतामतिप्रीतेर्नामसाम्याद् ब्रह्मैव निष्पादितं भवतीत्याशयः",
 "gt_2_55_u04_padya_p02_98ac56": "एवं परमानन्दतृप्तः किमर्थं प्रवृत्तिं करोति? इति प्रश्नाभिप्रायः",
 "gt_2_55_u05_padya_p01_720917": "त्वत्पादभक्तिमिच्छन्ति ज्ञानिनस्तत्त्वदर्शिनः",
 "gt_2_55_u07_padya_p01_699f50": "आधिकारिकपुंसां तु बृहत्कर्मत्वकारणात्",
 "gt_2_55_u08_padya_p03_87d03a": "न ते ज्ञानिन इत्यवगन्तव्यम्",
 "gt_2_55_u10_padya_p02_829602": "नहि समाधिं कुर्वतस्तस्य शुभाशुभप्राप्तिरस्ति",
 "gt_2_55_u11_padya_p01_b513d2": "कामादयो न जायन्ते ह्यपि विक्षिप्तचेतसाम्",
 "gt_2_55_u12_padya_p03_0c6887": "अतस्तत्रैव तद्विरुद्धज्ञानोत्पत्तौ युक्तं हानं तेषामिति दर्शयति- मनोगतानिति",
 "gt_2_55_u14_padya_p02_5b292d": "नचैतददृष्ट्याऽपलपनीयम्",
 "gt_2_55_u14_padya_p06_3bbbc5": "आत्माख्ये तस्मिन् स्थितस्य तत्प्रसादादेव तुष्टिर्भवति",
 "gt_2_55_u16_padya_p02_38b5fa": "अतो नात्मा जीवः",
 "gt_3_34_u03_padya_p01_23d09b": "संस्कारो बलवानेव ब्रह्माद्या अपि तद्वशाः",
 "gt_5_2_u13_padya_p02_a04862": "अतो नात्राश्रमः सन्न्यास उक्तः",
 "gt_16_1_u04_padya_p01_3822ff": "पुमर्थसाधनविरोधीन्यनेनाध्यायेन दर्शयति",
 "gt_16_1_u06_gadya_p02_d95bcb": "कथनम्",
 "gt_16_1_u08_padya_p02_fd7452": "लौल्यं रागः",
 "gt_16_1_u11_padya_p01_8730cf": "चपलश्चञ्चलोऽस्थिरः",
 "gt_16_1_u14_gadya_p01_ef2b82": "इत्यभिधानात्",
 "gt_16_11_u10_padya_p01_414067": "ईश्वरो यदि सर्वस्य कारकः कारयीत माम्",
 "gt_17_27b_u01_padya_p02_9117e0": "तथाचर्ग्वेदखिलेषु",
 "gt_2_55_u02_padya_p01_cbdbfd": "गमनादिप्रवृत्तिर्नात्यभिसन्धिपूर्विका",
 "gt_2_55_u04_padya_p03_3393cc": "प्रारब्धकर्मणेषत्तिरोहितब्रह्मणो वासनया प्रायोऽल्पाभिसन्धिपूर्विका प्रवृत्तिः सम्भवतीत्याशयवान् परिहरति",
 "gt_2_55_u06_padya_p01_e90db8": "इत्युक्तेस्तामिच्छन्ति",
 "gt_2_55_u07_padya_p02_bf63aa": "उद्भवाभिभवौ ज्ञाने ततोऽन्येभ्यो विलक्षणाः",
 "gt_2_55_u08_padya_p04_f89694": "नचात्र समाधिं कुर्वतो लक्षणमुच्यते",
 "gt_2_55_u10_padya_p03_6c872e": "असम्प्रज्ञातसमाधेः",
 "gt_2_55_u11_padya_p02_c396cb": "ज्ञानिनां ज्ञाननिर्धूतमलानां देवसंश्रयात्",
 "gt_2_55_u12_padya_p04_0c7a2c": "विरोधश्चोच्यते",
 "gt_2_55_u14_padya_p03_ed52bc": "पुरुषवैशेष्यात्",
 "gt_2_55_u15_padya_p01_8d55a8": "विषयांस्तु परित्यज्य रामे स्थितिमतस्ततः",
 "gt_3_34_u02_padya_p01_b1025b": "तथाऽपि शक्तितो निग्रहः कार्यः",
 "gt_3_34_u03_padya_p02_72baa3": "तथाऽपि सोऽन्यथा कर्तुं शक्यतेऽतिप्रयत्नतः",
 "gt_12_1_u14_padya_p01_d7bc56": "चतुःशिखण्डा युवतिः सुपेशा घृतप्रतीका वयुनानि वस्ते",
 "gt_16_1_u04_padya_p02_a5fb88": "तपः ब्रह्मचर्यादि",
 "gt_16_1_u07_padya_p01_141a83": "परोपद्रवहेतूनां दोषाणां पैशुनं वचः",
 "gt_16_1_u09_padya_p01_7290d2": "रागो लौल्यं तथा रक्तिः",
 "gt_16_1_u12_padya_p01_cabd34": "इत्यभिधानात्",
 "gt_16_11_u09_padya_p01_e3e06b": "मामात्मपरदेहेष्विति",
 "gt_16_11_u10_padya_p02_dae0f8": "अद्येति वादिनं ब्रूयात् सदाऽधो यास्यसीति ह",
 "gt_18_67b_u01_padya_p01_4245c2": "पूर्णादोषमहाविष्णोर्गीतामाश्रित्य लेशतः"
}