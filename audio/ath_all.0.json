[{"id": "ath_seq14_u01_sutra_p01_e49298", "meter": "anuṣṭubh", "padas": ["यदा लेलायते ह्यर्चिः समिद्धे हव्यवाहने तदाज्यभागावन्तरेणाहुतीः प्रतिपादयेत् यस्याग्निहोत्रमदर्शमपौर्णमासमनाग्रयणमतिथिवर्जितं च अहुतमवैश्वदेवमविधिना हुतमासप्तमांस्तस्य लोकान् हिनस्ति काली कराली च मनोजवा च सुलोहिता या च सुधूम्रवर्णा स्फुलिङ्गिनी विश्वरुची च देवी लेलायमाना इति सप्त जिह्वाः एतेषु यश्चरते भ्राजमानेषु यथाकालं चाहुतयो ह्याददायन् तं नयन्त्येताः सूर्यस्य रश्मयो यत्र देवानां पतिरेकोऽधिवासः एह्येहीति तमाहुतयः सुवर्चसः सूर्यस्य रश्मिभिर्यजमानं वहन्ति प्रियां वाचमभिवदन्त्योऽर्चयन्त्य एष वः पुण्यः सुकृतो ब्रह्मलोकः प्लवा ह्येते अदृढा यज्ञरूपा अष्टादशोक्तमवरं येषु कर्म एतच्छ्रेयो येऽभिनन्दन्ति मूढा जरामृत्युं ते पुनरेवापियन्ति अविद्यायामन्तरे वेष्ट्यमानाः स्वयं धीराः पण्डितम्मन्यमानाः जङ्घन्यमानाः परियन्ति मूढा अन्धेनैव नीयमाना यथाऽन्धाः अविद्यायां बहुधा वर्तमाना वयं कृतार्था इत्यभिमन्यन्ति बालाः यत् कर्मिणो न प्रवेदयन्ति रागात् तेनातुराः क्षीणलोकाश्च्यवन्ते इष्टापूर्तं मन्यमाना वरिष्ठं नान्यच्छ्रेयो वेदयन्ते प्रमूढाः नाकस्य पृष्ठे ते सुकृतेऽनुभूत्वा इमं लोकं हीनतरं वाऽऽविशन्ति"], "seed": 60, "no_sandhi": true}, {"id": "ath_seq43_u01_sutra_p01_5b7e6c", "meter": "sragdharā", "padas": ["ब्रह्मैवेदममृतं पुरस्तात् पश्चाद् ब्रह्म दक्षिणतश्चोत्तरेण अधश्चोर्ध्वं च प्रसृतं ब्रह्मैवेदं विश्वमिदं वरिष्ठम्"], "seed": 60, "no_sandhi": true}, {"id": "ath_seq62_u01_sutra_p01_7ecadc", "meter": "anuṣṭubh", "padas": ["स वेदैतत् परमं ब्रह्मधाम यत्र विश्वं निहितं भाति शुभ्रम् उपासते पुरुषं ये ह्यकामास्ते शुक्रमेतदतिवर्तन्ति धीराः"], "seed": 60, "no_sandhi": true}, {"id": "ath_seq68_u11_gadya_p01_f8bc63", "meter": "anuṣṭubh", "padas": ["इति नदीदृष्टान्तपूर्वकं पुरुषप्राप्तिकथनाच्च मुक्ता देवता एवोच्यन्ते"], "seed": 60, "no_sandhi": true}, {"id": "ath_seq6_u22_padya_p01_b642d7", "meter": "indravajrā", "padas": ["येनाक्षरं पुरुषं वेद सत्यं प्रोवाच तां तत्त्वतो ब्रह्मविद्याम्"], "seed": 60, "no_sandhi": true}, {"id": "ath_seq6_u09_padya_p01_3d103b", "meter": "indravajrā", "padas": ["वेदैश्च सर्वैरहमेव वेद्यो वेदान