{
 "gt_12_13_u08_padya_p01_f6c54c": "इत्यादेः सामान्यविशेषव्याख्यानव्याख्येयभावेनापुनरुक्तिः",
 "gt_12_13_u10_padya_p02_ed94f3": "उपचारपरिहारार्थं पूर्वम्",
 "gt_14_9_u09_padya_p01_2f0226": "रजसस्तु फलं दुःखमिति",
 "gt_14_9_u10_padya_p01_149e08": "रजसो ह्येव जायते मात्रया सुखं दुःखं तस्मात् तान्",
 "gt_14_9_u11_padya_p02_38fa43": "अन्यथा दुःखस्यातिकष्टत्वात् तमोऽधिकत्वं रजसो न स्यात्",
 "nvv_seq342_u02_padya_p03_1ecbed": "आनन्दह्रासदोषेण सैव मुक्तिर्विदुष्यति",
 "nvv_seq358_u02_padya_p01_5ea8f4": "भक्तिरेवैनम् इति भक्तेरेव पृथङ्मोचकत्वदर्शनान्नेशकृत्यमिति न मन्तव्यम्",
 "nvv_seq358_u02_padya_p04_dc1e93": "किञ्चिन्न मोचयेद् वाऽसौ स्वातन्त्र्यं तेन तस्य हि",
 "nvv_seq358_u02_padya_p07_ab8fb2": "इति ब्रह्मतर्कवचनादनादिगुणविस्तरे सत्यप्यव्यक्त्यादिना तदिच्छां विना मोक्षाप्राप्तेः",
 "nvv_seq427_u02_padya_p03_28e394": "अपूर्णतादिभावो वा दुःखं वा नास्ति किञ्चन",
 "nvv_seq439_u02_padya_p01_e45f47": "नच चतुर्मुखमुक्तिपर्यन्तं सन्ततत्वनियमात् बन्धस्य तावद् भगवत्प्राप्तिर्नास्तीति नियमः",
 "nvv_seq439_u02_padya_p04_3cf66a": "इति श्रुतेस्तथा प्राप्तत्वात्",
 "nvv_seq439_u02_padya_p07_d2a765": "नच परप्राप्तिर्यस्याभीष्टा तस्य तत्प्राप्तिरिति नियमः",
 "nvv_seq439_u02_padya_p10_792a92": "प्राप्यते नियमेनैव कैश्चिदेवाप्यते मृतौ",
 "nvv_seq439_u02_padya_p13_33fff8": "श्रुत्युक्तानुवृत्तेरेव न्याय्यत्वात्",
 "nvv_seq439_u02_padya_p16_5334e2": "अन्तर्भेदाधिकरणत्वात् समुदायोक्तिः",
 "spr_seq8_u02_padya_p03_5b1199": "ते प्राकाश्या अभिवदन्ति",
 "spr_seq8_u04_padya_p02_339b7b": "प्राणशब्देन प्रधानवायुः",
 "bsb_2_1_27_u02_padya_p03_2b3d0a": "एकेनाङ्गुलिमात्रेण प्रवर्तमानोऽपि पूर्णप्रवृत्तिः स्यात्",
 "bsb_2_1_27_u02_padya_p06_5eacc0": "नचैकदेशेन",
 "bsb_2_1_27_u04_padya_p02_4554bf": "नचोपाधिकृतोंऽशः",
 "vtn_seq127_u01_padya_p01_80412e": "यदि न स्वरूपं भेदः",
 "vtn_seq127_u01_padya_p04_b1d88a": "नहि कश्चित् तथा संशयं करोति",
 "mbtn_gap0171_h0": "देव्यां स चाजनयदिन्द्रहुताशनौ द्वौ पुत्रौ यमौ कुशलवौ बलिनौ गुणाढ्यौ",
 "mbtn_gap0430_h0": "एतत् कृत्वा धृतराष्ट्रात्मजः स ययौ कुरून् निवसत्यत्र रामे",
 "mbtn_gap0543_h0": "तं द्व्यष्टसाहस्रगृहेषु दृष्ट्वा तावत्स्वरूपैर्विहरन्तमेकम्",
 "mbtn_gap0664_h0": "निहन्ति शैवनायकं य एव वैष्णवाग्रणीः",
 "mbtn_gap0798_h0": "रात्रौ युधिष्ठिरश्‍चिन्तामाप्य पार्थं व्यगर्हयत्",
 "mbtn_gap0974_h0": "ते किञ्चिद् दूरतस्तस्थुः पश्यन्तो युद्धमद्भुतम्",
 "mbtn_gap1145_h0": "विनोत्तरां तां तु कथां निशम्य पारीक्षितोऽयाचत तातदृष्टिम्",
 "bsb_seq76_u01_gadya_p02_efe5b3": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते प्रथमाध्यायस्य प्रथमः",
 "bsb_seq149_u01_gadya_p02_f35cff": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते प्रथमाध्यायस्य द्वितीयः",
 "bsb_seq251_u01_gadya_p02_54bc33": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते प्रथमाध्यायस्य तृतीयः",
 "bsb_seq318_u01_gadya_p02_3f62e9": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते प्रथमाध्यायस्य चतुर्थः",
 "bsb_seq408_u01_gadya_p02_8a8d1b": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते द्वितीयाध्यायस्य प्रथमः",
 "bsb_seq512_u01_gadya_p02_b5a73b": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते द्वितीयाध्यायस्य द्वितीयः",
 "bsb_seq639_u01_gadya_p02_126e9c": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते द्वितीयाध्यायस्य तृतीयः",
 "bsb_seq780_u01_gadya_p02_89e68f": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते तृतीयाध्यायस्य प्रथमः",
 "bsb_seq886_u01_gadya_p02_65b702": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते तृतीयाध्यायस्य द्वितीयः",
 "bsb_seq1066_u01_gadya_p02_e335a7": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते तृतीयाध्यायस्य तृतीयः",
 "bsb_seq1114_u01_padya_p02_370537": "परस्य ब्रह्मणो ह्येव सर्वविध्यतिदूरता",
 "bsb_seq1117_u01_padya_p02_7340ab": "ब्रह्मणः परमस्यैव सर्वविध्यतिदूरता",
 "bsb_seq1183_u01_gadya_p02_3c6acf": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते तृतीयाध्यायस्य चतुर्थः",
 "bsb_seq1194_u01_padya_p02_da7e52": "नानाक्लेशसमायुक्तोऽप्येतावन्नैव विस्मरेत्",
 "bsb_seq1194_u03_padya_p02_a5966f": "सर्वेषां च मुमुक्षूणामुपदेशश्च तादृशः",
 "bsb_seq1233_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_seq1289_u01_gadya_p01_b9b2b7": "न केवलं कालादिकृते ब्रह्मचन्द्रगती स्मर्येते",
 "bsb_seq1289_u02_padya_p02_0ee017": "तत्र प्रयाता गच्छन्ति ब्रह्म ब्रह्मविदो जनाः",
 "bsb_seq1289_u03_gadya_p01_645ef0": "इत्यत्र योगीति विशेषणात् स्मरणनिमित्ते चैते गती",
 "bsb_seq1289_u05_gadya_p01_2a0e89": "इत्यध्यात्मे",
 "bsb_seq1290_u01_gadya_p03_e50581": "पादः",
 "bsb_seq1330_u01_gadya_p03_e50581": "पादः",
 "bsb_seq1389_u01_gadya_p03_e50581": "पादः",
 "bsb_1_1_31_u04_padya_p06_940277": "इहाश्रितत्वाच्च",
 "bsb_2_2_5_u02_padya_p04_4c98a2": "अतो ब्रवीति- अन्यत्राभावाच्च न तृणादिवत्",
 "bsb_3_3_40_u02_padya_p01_b8afc9": "प्रकृतेरपि जन्मादेः संसारप्राप्तेः किमिति नामादिष्वपाठ इति",
 "bsb_4_1_17_u02_padya_p01_286c87": "अतोऽन्यदपीत्येकेषामुभयोः",
 "nvv_seq195_u02_padya_p03_24e6a0": "तद्दासाः पञ्च चान्येऽपि प्राणाद्याः सद्गुणैर्युताः",
 "nvv_seq290_u02_padya_p08_fcf624": "इति ब्रह्माण्डे",
 "nvv_seq330_u02_padya_p06_4e4919": "इति वचनाच्च",
 "nvv_seq417_u02_padya_p04_aeb701": "पृथक्स्थितेन रूपेण जीवं धारयति प्रभुः",
 "ait_seq12_u01_padya_p03_d4045a": "अन्तरीक्ष्यो यतो द्युस्थो द्युनामाऽतिप्रकाशनात्",
 "ait_seq12_u01_padya_p39_9ee2cb": "परस्य विष्णोर्धामत्वात् सूर्यो ब्रध्न इतीरितः",
 "ait_seq16_u01_padya_p27_b916d3": "श्रोत्रं चन्द्रो रविश्चक्षुर्वागग्निः परिकीर्तितः",
 "ait_seq18_u01_padya_p16_303226": "श्रोत्रं तु वरुणः काम्यशास्त्रार्थं मित्र एव च",
 "ait_seq18_u01_padya_p52_121b82": "देवतात्रयमेतत् तु सहितं सत्यमुच्यते",
 "ait_seq20_u01_padya_p31_95e927": "आ समन्तात् पराक् चापि पञ्चभूतेभ्य ईश्वरः",
 "ait_seq24_u01_padya_p20_50d0c7": "मत्पर्यन्तं तथा व्याप्तिं देवानामपि सर्वशः",
 "ait_seq24_u01_padya_p56_4e41e6": "अवाक् प्राक् च सदा गच्छेद् वायुरानन्दरूपिणा",
 "ait_seq24_u07_padya_p01_a71816": "इत्यतो ब्रह्मा ह इति दैर्घ्यमपि परब्रह्मत्वविवक्षया",
 "ait_seq24_u25_gadya_p01_7e4c84": "इति च ब्रह्माण्डे",
 "ait_seq71_u11_padya_p02_0f27b0": "स वा एष वाचः परमो विकारः",
 "ait_seq73_u09_padya_p02_942f8f": "यत्र चैवं भूतेष्वेकत्वे विरोधो दृश्यते तत्र तेनैव विरोधेन द्वित्वं भवति",
 "ait_seq73_u39_padya_p01_8db353": "इति शब्दनिर्णये",
 "ait_seq75_u08_padya_p03_b97e16": "तस्मान्न पुनरुक्तिः",
 "ait_seq75_u24_padya_p16_bb6277": "तस्मात् पारतन्त्र्याल्पगुणत्वादिसर्ववस्तुस्वभावविरुद्धस्वभावं स्वतन्त्रं पूर्णगुणं सर्वजीवजडेभ्योऽन्यद् अज्ञानदुःखाल्पत्वपारतन्त्र्योत्पत्तिनाशादिसर्वदोषविवर्जितं ब्रह्मैवाशब्दार्थः",
 "ait_seq75_u40_padya_p02_36ef93": "तेन रथेनाध्यात्मं शरीराख्येनाधिदैवं रथरूपेण",
 "ait_seq186_u03_padya_p05_b6eb15": "मम प्रीतिं कर्तुं नाशकः",
 "vtn_seq78_u01_padya_p04_d8ea47": "जनकं प्रमाणमुद्दिष्टं स्वस्यार्थस्य प्रकाशनात्",
 "vtn_seq174_u02_padya_p02_7be39c": "स्व इति परमात्मनोऽभिधानम्",
 "vtn_seq250_u08_padya_p04_5667c5": "विद्येतेत्यस्य चोत्पत्त्यर्थानङ्गीकारे यद्यदस्ति तत्तन्निवर्तत इति व्याप्त्यभावान्निवर्तेतेति न युज्यते",
 "gb_2_17b_u53_padya_p04_0ef4e8": "लक्षितस्वरूपस्यापि न स्वरूपाद् विशेषः",
 "gb_7_7_u31_padya_p02_51f1ed": "बहूनां जन्मनामन्ते ज्ञानवान् भवति",
 "gt_2_55_u06_padya_p03_1e044a": "तच्चोक्तम्",
 "gt_5_2_u13_padya_p01_bafb3c": "इत्यादेश्च ब्राह्मे",
 "tvk_seq18_u01_padya_p02_9ef4f0": "रूपमेव द्विधं तच्च यावद्वस्तु च खण्डितम्",
 "kat_seq11_u09_padya_p02_251990": "लोकादिः प्रतिष्ठा ब्रह्मजज्ञोऽनन्तलोकाप्तिरित्यादिविशेषणैश्च भगवानेव",
 "cha_seq200_u50_padya_p01_3ff34a": "असत्यमप्रतिष्ठं ते जगदाहुरनीश्वरम् एतां दृष्टिमवष्टभ्य नष्टात्मानोऽल्पबुद्धयः",
 "bt_11_9_25_u04_padya_p02_7e11c9": "प्रश्वसित्यभूतिरित्यसुरास्ते ह पराबभूवुः",
 "bsb_1_3_28_u06_padya_p01_650610": "यथैव कालनियमः सुरादिनियमस्तथा",
 "bsb_2_3_24_u02_padya_p02_0fc536": "अणोरपि जीवस्य सर्वशरीरव्याप्तिर्युज्यते",
 "bsb_3_3_56_u02_padya_p02_bd2bc6": "ज्ञानादिभेदे विद्यमानेऽपि नांशांशिनोः पृथग्भाव एव",
 "bsb_4_4_16_u04_padya_p01_5edefc": "इत्यादिना स्वर्गादिस्थस्यैतदिति वाच्यम्",
 "nvv_seq203_u02_padya_p03_374468": "रूपापेक्षं तथा नाम व्यवहारस्तदात्मकः",
 "nvv_seq290_u02_padya_p12_6cbc39": "अतः प्रलोभकल्पने श्रुतहानिरश्रुतकल्पना चेति हरिरेव फलप्रदः",
 "nvv_seq336_u02_padya_p04_24a549": "पूर्ण आत्मा पूर्णो नात्र किञ्चिदूनं पूर्णमेवाधस्तात् पूर्णमुपरिष्टात् पूर्णं",
 "nvv_seq417_u02_padya_p08_57f97b": "पृथक्छक्तोऽपि तद्गैस्तु स्वरूपैस्तद्गकार्यकृत्",
 "ait_seq12_u01_padya_p07_74b2b0": "पृथक्पृथक् च तस्याङ्गान्युक्थानि जगदीशितुः",
 "ait_seq12_u01_padya_p43_b498e3": "इतो गतं सर्वमत्ति द्युनामा भगवान् परः",
 "ait_seq16_u01_padya_p31_81a372": "ते विष्णोराज्ञयाऽवोचन्नुत्क्रमाम पृथक्पृथक्",
 "ait_seq18_u01_padya_p20_23865d": "एताः सर्वा देवता हि ब्रह्मवायुसुपर्णकाः",
 "ait_seq18_u01_padya_p56_c7ce9c": "देवता मुनयश्चैव योग्या अस्या अपि स्फुटम्",
 "ait_seq20_u01_padya_p35_7a9f5f": "अन्तश्च सर्वलोकेषु चरतो लोकसाक्षिणौ",
 "ait_seq24_u01_padya_p24_07a967": "ज्ञानकर्मबलेहाद्या मद्दता इति किं वदे",
 "ait_seq24_u01_padya_p60_132f5d": "अनित्या अपि देहास्ते शश्वत् सन्त्या विमोक्षतः",
 "ait_seq24_u08_padya_p01_61dc95": "तस्योष्णिग् लोमानि",
 "ait_seq24_u27_padya_p03_c8ffea": "यथा",
 "ait_seq71_u15_padya_p01_e7580d": "इत्यादि शब्दनिर्णये",
 "ait_seq73_u11_padya_p03_418f3a": "तस्मान्मुख्यतो विष्णावेवेन्द्रादिशब्दा अन्येषामुपचारतः",
 "ait_seq73_u39_padya_p05_e509a7": "दिविष्ठाय स्वपुरुषरूपाय प्रयच्छति देवरेतःस्थिताय च",
 "ait_seq75_u08_padya_p07_38a2ed": "ततश्चाधिकं समतृप्यन्",
 "ait_seq75_u24_padya_p20_441afe": "तस्मादकारशब्दार्थ एव ब्रह्मशब्दार्थः",
 "ait_seq75_u44_padya_p03_59e013": "विवस्वतो विष्णोः सकाशाद् दिवोदुहिता अहनी च जायन्ते",
 "vtn_seq40_u06_padya_p03_f53149": "नच वर्णपदादीनामनित्यत्वं वक्तुं युक्तम्",
 "vtn_seq80_u01_padya_p03_9a8c26": "एतत्सदृशताज्ञानमुपमानं प्रकीर्तितम्",
 "vtn_seq174_u08_padya_p02_c8bd10": "एकीभावविवक्षायां",
 "vtn_seq250_u08_padya_p08_60a99d": "अज्ञानिनां पक्ष एव द्वैतं न विद्यत इत्यर्थः",
 "gb_2_17b_u53_padya_p08_d7b057": "अतः सत्यत्वं सत्यं स्यात्",
 "gb_7_27_u04_padya_p01_7446a9": "इति च भारते",
 "gt_2_55_u08_padya_p02_d33777": "अत एव वैलक्षण्यादनधिकारिणामाग्रहादि चेदस्ति",
 "gt_13_0_u02_padya_p01_2bd347": "श्रीभगवानुवाच- इदं शरीरं कौन्तेय क्षेत्रमित्यभिधीयते",
 "tvk_seq18_u01_padya_p06_829954": "क्रियाक्रियावतोस्तद्वत् तथा जातिविशेषयोः",
 "kat_seq11_u11_padya_p04_471873": "नचाग्निपरिज्ञानमात्रेणानन्तलोकाप्तिर्भगवज्ज्ञानं विना",
 "bt_1_8_5_u01_padya_p02_05f65d": "सोग्निष्‍टोमस्य यो हन्ति गजरथौ सोऽश्‍वमेधराजसूयाभ्याम्",
 "bsb_1_1_3_u15_padya_p02_151706": "शास्त्रं योनिः प्रमाणमस्येति शास्त्रयोनि",
 "bsb_2_1_14_u13_padya_p02_75f553": "फलत्वेऽपि युक्तिविरोधेऽन्तर्भावादत्रोक्तम्",
 "bsb_3_1_27_u02_padya_p04_7cb421": "शब्दविहितत्वात्",
 "bsb_3_4_41_u02_padya_p01_c606bc": "नचाधिकारिकमपि पतनानुमानात् तदयोगात्",
 "nvv_seq143_u02_padya_p05_284830": "आकाशो नीलिमोदेति न प्रदेशः कथञ्चन",
 "nvv_seq282_u02_padya_p04_54253a": "इत्यादिश्रुतिभ्योऽलौकिकत्वावगमात्",
 "nvv_seq316_u02_padya_p05_0adea5": "कदाचिल्लोपयेद् देवी स्थानैक्यं न गुणैस्ततः",
 "nvv_seq388_u02_padya_p03_6ae15b": "तदेष श्लोकः",
 "nvv_seq457_u02_padya_p02_90413c": "तदभावे भोगासम्भव इति दोषः",
 "ait_seq12_u01_padya_p23_90d76b": "स्थितो विष्णुस्तदर्कास्ते तस्मादेव प्रकीर्तिताः",
 "ait_seq16_u01_padya_p11_453235": "उर्वेव गरणं चक्रे वायुर्यत्र स्थितः सदा",
 "ait_seq16_u01_padya_p47_193bb7": "वायुः स संस्तुतस्तैश्च प्रसन्नोऽभूद् दिवौकसाम्",
 "ait_seq18_u01_padya_p36_fea68c": "वेद तं च नियोक्तारमुपास्ते विष्णुमव्ययम्",
 "ait_seq20_u01_padya_p15_8bad52": "तथैव वायुना बद्धं जगदेतत् ततोऽवरम्",
 "ait_seq24_u01_padya_p04_f6d595": "इदं मदाख्यं यद् ब्रह्म ह्याप इत्यभिधीयते",
 "ait_seq24_u01_padya_p40_64c211": "देवानामपि सर्वेषां प्रधानोऽद्यापि मारुतः",
 "ait_seq24_u01_padya_p76_9aff9c": "तथा इति निर्णयः",
 "ait_seq24_u19_padya_p05_c8d8eb": "दिग्भ्योऽप्यन्य एव विशृणोति जीवः",
 "ait_seq71_u03_padya_p06_febf10": "वायुस्तस्य प्रतिमारूपमिदं बृहतीसहस्रम्",
 "ait_seq71_u15_padya_p17_605b25": "तस्माद् विजानतः सर्वमपि भगवन्नामैव",
 "ait_seq73_u27_padya_p03_7f421a": "मनुष्यदृष्टिगोचरतां प्राप्यैषु लोकेषु राजति",
 "ait_seq75_u01_padya_p05_5b4ee1": "तत्र तस्मिन्नेव परे ब्रह्मणि नारायणाख्ये सर्वदेवा एकीभवन्ति मुक्ताः",
 "ait_seq75_u22_padya_p03_20ce0f": "अकारो विशेषतो नारायणवाचक इत्याह- अः इति ब्रह्मेति",
 "ait_seq75_u30_padya_p01_dcf9fe": "इति",
 "ait_seq75_u50_padya_p03_771c13": "ज्ञानात् पूर्वं तु पतनसंशयादेव न सुदिनम्",
 "vtn_seq76_u01_padya_p01_ccbc56": "यामाहुरनुमां केचित् त्रियाद्यवयवात्मिकाम्",
 "vtn_seq170_u05_padya_p04_4fd517": "प्रजाः सत आगम्य न विदुः सत आगच्छामह इति",
 "vtn_seq250_u02_padya_p08_ab840e": "मायामात्रत्वात्",
 "gb_2_17b_u40_padya_p03_8cb2f8": "नचैकविज्ञानेन सर्वविज्ञानं तत्पक्षे",
 "gb_3_17_u10_padya_p03_1d1a0a": "असक्त आचरन्नेव यस्मात् परमाप्नोति",
 "gb_13_0_u01_padya_p01_8141c2": "अर्जुन उवाच",
 "gt_2_55_u14_padya_p01_dcf9fe": "इति",
 "gt_16_1_u13_padya_p01_28db7d": "अक्रोधदोषकृच्छत्रोः क्षमावान् स निगद्यते",
 "tdy_seq72_u03_padya_p01_cd73f5": "इति भारतवचनान्न विश्लेषाद् विशेषः",
 "kan_seq288_u06_padya_p12_6355be": "पूर्वं जानन्नपीन्द्रः पश्चाद् विश्वरूपाच्छुश्रावेति पुनर्नवत्वायेति न विश्वरूपस्त्वाष्ट्रोऽश्विभ्यामित्यनेन विरोधः",
 "bt_10_40_17_u03_padya_p01_1c36cf": "त्यजन्ति तापं य उ ते भवत्कथा इति स्म"
}