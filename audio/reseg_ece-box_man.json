{
 "bsb_1_1_3_u02_padya_p01_13e469": "अनुमानतोऽन्ये न कल्पनीयाः",
 "bsb_1_1_3_u07_padya_p01_9e77cf": "इत्यादि महाकौर्मे",
 "bsb_1_1_3_u15_padya_p01_219c0c": "इत्यारभ्य वेदपञ्चरात्रयोरैक्याभिप्रायेण पञ्चरात्रस्यैव प्रामाण्यमुक्तमितरेषां भिन्नमतत्वं प्रदर्श्य मोक्षधर्मेष्वपि",
 "bsb_1_1_6_u04_padya_p01_4f4e4f": "इति युक्तम्",
 "bsb_1_1_26_u06_padya_p01_b02d3a": "इति श्रुतेः",
 "bsb_1_1_31_u04_padya_p01_367494": "इति जीवलिङ्गम्",
 "bsb_1_1_31_u04_padya_p05_af1ec7": "अन्तर्बहिः सर्वगतत्वेनेत्युपासात्रैविध्यात्",
 "bsb_1_3_7_u04_gadya_p01_f0eb48": "इतीशजीवयोः स्थित्यदनोक्तेः",
 "bsb_1_3_28_u07_gadya_p02_8ef0f4": "महतां प्रत्यक्षात्",
 "bsb_2_1_14_u04_padya_p03_efed1b": "अतः पूर्वमपि स एव",
 "bsb_2_1_14_u04_padya_p07_9de8d7": "एवं स्यादत्रापि",
 "bsb_2_1_14_u13_padya_p01_5c7f53": "इत्यादि च",
 "bsb_2_1_26_u02_padya_p01_7dd5cb": "देवादिवदपि लोके",
 "bsb_2_1_26_u02_padya_p05_88bd06": "किम्वीश्वरस्य",
 "bsb_2_1_32_u02_padya_p01_898f18": "विकरणत्वान्नेति चेत् तदुक्तम्",
 "bsb_2_2_5_u02_padya_p03_f98886": "एवं प्रधानादीश्वरानुगृहीतं जगदिति",
 "bsb_2_3_24_u02_padya_p01_eaf8c9": "अविरोधश्चन्दनवत्",
 "bsb_2_4_1_u08_padya_p01_43a14f": "इति च",
 "bsb_2_4_4_u03_padya_p02_a6f3a2": "अत आह- तत्प्राक्छ्रुतेश्च",
 "bsb_3_1_4_u06_padya_p01_8f16d3": "इति ब्राह्मे",
 "bsb_3_1_27_u02_padya_p03_9319c9": "न",
 "bsb_3_2_13_u02_padya_p03_cc84db": "चशब्दादनन्तरूपत्वं चैके शाखिनः पठन्ति",
 "bsb_3_2_22_u02_padya_p01_0d5c66": "सृष्टिसंहारकर्तृत्वमेवास्य न पालकत्वं स्वतः सिद्धेरिति",
 "bsb_3_2_22_u04_padya_p02_eca379": "चशब्दात् स्मृतिश्च",
 "bsb_3_3_4_u02_padya_p04_0a3226": "आग्नेये च–",
 "bsb_3_3_56_u02_padya_p01_52bc8f": "व्यतिरेकस्तद्भावभावित्वान्न तूपलब्धिवत्",
 "bsb_3_3_58_u02_padya_p01_44a70f": "मन्त्रादिवद् वाऽविरोधः",
 "bsb_3_3_59_u02_padya_p02_bd7a80": "सर्वगुणेषु भूमगुणस्य ज्यायस्त्वं क्रतुवत् सर्वत्र सहभावात्",
 "bsb_3_4_1_u02_padya_p03_6423cb": "यद्दर्शनार्थमुपासनोक्ता तस्माद् दर्शनात् सर्वपुरुषार्थप्राप्तिरिति बादरायणो मन्यते",
 "bsb_3_4_27_u08_padya_p02_82b72e": "तुशब्दः पूर्णफलार्थत्वं सूचयति",
 "bsb_3_4_41_u02_padya_p04_0a43be": "किमु परस्येति सूचयितुमपिशब्दः",
 "bsb_3_4_51_u02_padya_p01_c97283": "एवं मुक्तिफलानियमस्तदवस्थावधृतेस्तदवस्थावधृतेः",
 "bsb_4_1_4_u04_padya_p02_73afee": "किन्तु तत्स्थत्वेनैवोपासनं कार्यम्",
 "bsb_4_1_6_u04_padya_p03_e28bac": "नारायणतन्त्रे",
 "bsb_4_1_17_u02_padya_p04_5c6d29": "तथा ह्येकेषां पाठ उभयोस्त्यागेन",
 "bsb_4_4_16_u07_padya_p01_182015": "इत्याद्याविष्कृतत्वात्",
 "nvv_seq137_u02_padya_p01_a27006": "सर्वचेतना अपूर्णगुणा इति नियमो न",
 "nvv_seq137_u02_padya_p05_d3564e": "इति श्रुतेः",
 "nvv_seq143_u02_padya_p04_f78670": "उत्पत्तिवचनानामसितवर्णभूततदभिमानिशरीरविषयत्वं पराधीनविशेषवत्त्वमात्रविषयत्वं चेति व्यवस्था",
 "nvv_seq157_u02_padya_p01_9eb65f": "नच लोकानुसारित्वम्",
 "nvv_seq157_u02_padya_p05_1c01c6": "इति श्रुतेः क्रमवाक्यस्य सावकाशत्वाद् वैरूप्यं बहुप्रकारत्वं क्रमस्य",
 "nvv_seq193_u02_padya_p04_b7dedf": "महत्वान्महतां विष्णुः कर्ता प्राणस्य चैकराट्",
 "nvv_seq195_u02_padya_p02_64e862": "अशेषगुणपूर्णानि मुख्यरूपाणि पञ्च च",
 "nvv_seq203_u02_padya_p02_3d1b8c": "त्रिवृत्क्रिया यतो विष्णो रूपं च तदपेक्षया",
 "nvv_seq203_u02_padya_p06_5d4630": "इत्यादेस्तस्यैव कर्तृत्वशक्तेर्विरिञ्चस्य तु द्वारतयोपपत्तेः",
 "nvv_seq248_u02_padya_p04_51d6d4": "सामान्यजननं चैव नृणां सामान्यहेतुतः",
 "nvv_seq262_u02_padya_p03_d7200c": "तिरस्कर्ता च कर्ता च न खण्डेशः स राजवत्",
 "nvv_seq282_u02_padya_p03_ae6815": "तथाऽपि शब्दा लौकिका अप्यमुष्मिन् प्रवर्तमाना अधिकार्थान् वदन्ति",
 "nvv_seq288_u02_padya_p03_05d3ba": "स्वातन्त्र्यात् क्रीडते विष्णुर्नच स्वातन्त्र्यमन्यगम्",
 "nvv_seq288_u02_padya_p07_f16a0a": "स्वतन्त्रः पूर्णशक्तिः सन् कुतोऽसौ नियतिं त्यजेत्",
 "nvv_seq290_u02_padya_p03_61221d": "कर्माण्यनन्तानि यथेष्टमीशः सम्पाद्य तेषां फलमिच्छयैव",
 "nvv_seq290_u02_padya_p07_ab07f2": "क्वचिज्ज्ञानं जनयन् भस्म कुर्यात् स्वेच्छावृत्तिस्तस्य विष्णोः सदैव",
 "nvv_seq290_u02_padya_p11_9077de": "इति श्रुतेः",
 "nvv_seq298_u02_padya_p03_2f6cc6": "यस्य यावद् गुणाः स्पष्टं प्रतिभासन्त्युपासने",
 "nvv_seq298_u02_padya_p07_59fbbc": "इति श्रुतेर्युगपद्गुणप्रतीत्यादिमाहात्म्यान्निर्णयोपपत्तेः",
 "nvv_seq304_u02_padya_p04_290960": "इति श्रुतेः स्वयोग्यगुणैरेव फलभावात्",
 "nvv_seq316_u02_padya_p04_95959a": "स्मरेत् त्रैविक्रमाद्यांस्तु नित्यविक्रान्तिपूर्वकैः",
 "nvv_seq320_u02_padya_p01_d77f86": "नच मुमुक्षव इत्यविशेषाद् भरणस्य द्युतेश्च सर्वेषामपेक्षितत्वाच्च सम्भृतिद्युव्याप्ती अपि सामान्ये",
 "nvv_seq320_u02_padya_p05_f7e406": "न व्याप्तिर्जगदस्मृत्या नानाशक्तिर्यतो मता",
 "nvv_seq330_u02_padya_p01_e125eb": "नच प्रयत्नानुसारिणो मुक्तावाधिकारिकानन्दादयः",
 "nvv_seq330_u02_padya_p05_c93f7b": "कथञ्चिदधिके यत्ने दोषः कश्चित् समापतेत्",
 "nvv_seq336_u02_padya_p03_65c28b": "श्रद्धा पूर्णा मतिः पूर्णा सुखं पूर्णं भूमा पूर्णोऽहं",
 "nvv_seq336_u02_padya_p07_d5f09e": "पूर्णमदः पूर्णमिदं पूर्णात् पूर्णमुदच्यते",
 "nvv_seq336_u02_padya_p11_e4442f": "तस्मै नमो भगवते यस्मादेव विमुच्यते",
 "nvv_seq382_u02_padya_p03_04895a": "या स्थितिस्तां समाप्नोति यथाशक्ति प्रयत्नतः",
 "nvv_seq388_u02_padya_p02_4a5a13": "त्वरयैव गृहिणः साधयन्ति मुक्तिमत्वरयैव यतयस्तेभ्यश्चात्वरया देवास्तेषु च ब्रह्मा",
 "nvv_seq388_u02_padya_p06_a18dde": "यो हि त्वरया साधयेत् स मन्दं सुखमाप्नुयात्",
 "nvv_seq411_u02_padya_p01_d5e718": "नच ज्ञानोदयेऽशेषकर्मक्षये कृतकृत्यत्वात् तदैव मुक्तिः",
 "nvv_seq411_u02_padya_p05_c908e7": "प्रारब्धानि तु भोगेन क्षपयन् स्वं पदं नयेत्",
 "nvv_seq417_u02_padya_p03_a84bdd": "मनःस्थेन विशेषेण कार्मैः कर्मकृदेव च",
 "nvv_seq417_u02_padya_p07_f7412a": "तान्येतान्यवशान्येव तथाऽपि कृपयैव सः",
 "nvv_seq431_u02_padya_p01_5e9864": "नच कृष्यादिलौकिकसाधनस्य फलस्मरणानपेक्षत्वात् स्वर्गमोक्षयोरपि तथात्वमिति वाच्यम्",
 "nvv_seq431_u02_padya_p05_89aeed": "अतोऽत्र फलानुस्मरणं लवनादिकृष्यनुवृत्तिवद् द्रष्टव्यम्",
 "nvv_seq449_u02_padya_p03_721538": "पूर्णानन्दः पूर्णभुक् पूर्णकर्ता पूर्णज्ञानः पूर्णभाः पूर्णशक्तिः",
 "nvv_seq457_u02_padya_p01_ce8e36": "नच देहभावे तत्कार्यदुःखादिः",
 "nvv_seq457_u02_padya_p05_52ec31": "इति श्रुत्यैव विशेषकॢप्तेः",
 "nvv_seq459_u02_padya_p04_189d42": "अयोग्यशक्तितस्त्वेव नाधिकानन्दसम्भवः",
 "nvv_seq459_u02_padya_p08_fc3023": "मुक्तानां न जगद्यत्नस्तथाऽपि विबुधाः सदा",
 "ait_seq12_u01_padya_p02_5fd0a2": "प्रथितः पृथिवीनामा सोऽन्तरिक्षाभिधोऽत्रगः",
 "ait_seq12_u01_padya_p06_bc9ab0": "अहमुक्थमिति ह्येतां विद्यामनुभवत्यसौ",
 "ait_seq12_u01_padya_p10_53817d": "तृचाशीतिविभिन्नस्य शस्त्रस्यान्नत्वहेतुतः",
 "ait_seq12_u01_padya_p14_dfa5e9": "अदनाघ्राणदृष्ट्याख्यभोगत्रयविभागतः",
 "ait_seq12_u01_padya_p18_80b877": "सुपर्णप्रतिमा सा यत् तदारूढो जनार्दनः",
 "ait_seq12_u01_padya_p22_e3bd8a": "तेषु स्थिते सुपर्णे च रूपभेदैः पृथक्पृथक्",
 "ait_seq12_u01_padya_p26_8b97ec": "जीववाक्प्राणचक्षुष्षु तद्वागाद्यास्ततः स्थिताः",
 "ait_seq12_u01_padya_p30_947eb3": "अविशेषोऽपि भगवान् पूर्णैश्वर्यस्वरूपतः",
 "ait_seq12_u01_padya_p34_07771e": "अग्न्यादिषु च तन्नामा वासुदेवः स संस्थितः",
 "ait_seq12_u01_padya_p38_8db968": "पतन्ति धावयन्त्यश्वान् नरादींश्च नरादयः",
 "ait_seq12_u01_padya_p42_35a330": "पतितं सर्वमेवात्ति तथा दिवि च संस्थितः",
 "ait_seq12_u01_padya_p46_ad5212": "आद्यो भवति चान्येषां नोपजीव्यो भवेद् यथा",
 "ait_seq16_u01_padya_p02_79ab89": "वासुदेवाभिधं ब्रह्म प्राप प्रपदयोः पुरा",
 "ait_seq16_u01_padya_p06_400cc5": "प्रपदाख्या वर्ततेऽतो नतु पश्वादिनां क्वचित्",
 "ait_seq16_u01_padya_p10_4fab78": "वायुमाहोरुगरणं कुर्वत्र स्थित इत्यपि",
 "ait_seq16_u01_padya_p14_5658b7": "तथाऽकरोत् स वायुश्च तदुरोऽभूदुरुत्वतः",
 "ait_seq16_u01_padya_p18_e3542d": "हृत्स्थमेव परं विष्णुं ध्यायन्त्यारुणयः सदा",
 "ait_seq16_u01_padya_p22_d02085": "स्थितो मूर्धनि देवेशः श्रितोऽसाविति तच्छिरः",
 "ait_seq16_u01_padya_p26_27b1ca": "वैदिकं गरुडश्चेन्द्रो यज्ञादिविषयं मनः",
 "ait_seq16_u01_padya_p30_2057d2": "वाचा हिंसामकुर्वंस्ते विनिन्दन्तः परस्परम्",
 "ait_seq16_u01_padya_p34_dee28d": "ततः क्रमेण चाग्न्याद्या निष्क्रान्तास्तेषु सर्वशः",
 "ait_seq16_u01_padya_p38_1439c9": "तेषां बलपरीक्षार्थं वाय्वादीनां च सर्वशः",
 "ait_seq16_u01_padya_p42_6af8e5": "उच्चैः स्थितत्वादुक्थोऽभूद् वायुरेव ततः प्रभुः",
 "ait_seq16_u01_padya_p46_7e8412": "इत्यूचुर्वीन्द्रशेषेशशक्रचन्द्रादिकाः पृथक्",
 "ait_seq18_u01_padya_p03_c9bcc8": "वायुमप्यनयन् सर्वे यशसा तद्गुणोक्तितः",
 "ait_seq18_u01_padya_p07_47373d": "सङ्गतश्चाभवज्जीवचिता रूपान्तरेण सः",
 "ait_seq18_u01_padya_p11_488711": "यज्ञादिसाधने यत् तु मनश्चन्द्रः प्रकीर्तितः",
 "ait_seq18_u01_padya_p15_7f91c2": "यम एव षडङ्गानां विषयश्रवणोचितम्",
 "ait_seq18_u01_padya_p19_add80f": "शिवादीनां च सर्वेषां मनस्त्वं कथितं पुरा",
 "ait_seq18_u01_padya_p23_f6db5a": "अधिदैवं स एवैक आधिक्यात् पुरुषोत्तमः",
 "ait_seq18_u01_padya_p27_2e9438": "हिरण्यदन्नाम बैदो भूतेषु हि सुरानृते",
 "ait_seq18_u01_padya_p31_c37ea0": "स्यान्नैवात्रास्ति सन्देहः स्वेच्छाविहृतिरेव च",
 "ait_seq18_u01_padya_p35_929ab6": "विष्णुप्रहितदेवानां योगमध्यात्ममञ्जसा",
 "ait_seq18_u01_padya_p39_88e14e": "मुक्तस्य वैष्णवे लोके मुक्तानि च न संशयः",
 "ait_seq18_u01_padya_p43_640287": "स एष भगवान् विष्णुः सत्यमित्यभिधीयते",
 "ait_seq18_u01_padya_p47_3d1682": "वायुः सदिति सम्प्रोक्तो जीवेषु तु सुपूर्णतः",
 "ait_seq18_u01_padya_p51_79ac93": "यमित्यादित्य उद्दिष्टो यमयेद् यत् प्रकाशनात्",
 "ait_seq18_u01_padya_p55_c82801": "योग्यस्तस्या उपासाया नैवासत्येन दुष्यति",
 "ait_seq20_u01_padya_p02_7407b5": "तन्तिरूपा जगद्बन्धे नाम ब्रह्मादिकं च यत्",
 "ait_seq20_u01_padya_p06_9c305e": "वेदात्मिक्या यतो वाचा विष्णुर्वदति सोऽखिलम्",
 "ait_seq20_u01_padya_p10_69c3fd": "बलिं हरन्ति पञ्चाथ भूतान्येनं वहन्ति च",
 "ait_seq20_u01_padya_p14_ceac9e": "स्वावरैः सेव्यतैव स्यात् कैश्चिदेव क्वचित्क्वचित्",
 "ait_seq20_u01_padya_p18_85b68b": "विष्णोर्विमुक्तवायोश्च लोमाद्यं तु चिदात्मकम्",
 "ait_seq20_u01_padya_p22_f5eae3": "निवारयन्ति पापेभ्यश्छन्दांसि किमु केशवः",
 "ait_seq20_u01_padya_p26_6dcb96": "एष गोप्ता हि सर्वस्य वायुस्थः पुरुषोत्तमः",
 "ait_seq20_u01_padya_p30_edeb72": "चोदितः केशवेनैव तत्स्थेनामितशक्तिना",
 "ait_seq20_u01_padya_p34_dddfef": "नित्यदा वसतः कोणदिक्ष्वथासु विषूचिषु",
 "ait_seq20_u01_padya_p38_896073": "वायोराधारभूतस्य ताभ्यां हि क्रतुनामकाः",
 "ait_seq20_u01_padya_p42_5199c7": "विष्टब्धाश्चैव सर्वेऽपि जीवा आकाश एव च",
 "ait_seq20_u01_padya_p46_ace684": "विशेषतो बृहत्प्राणो भगवांस्तत्र केशवः",
 "ait_seq24_u01_padya_p03_323d7a": "आप इत्येव नामैषां भवतीत्याह स प्रभुः",
 "ait_seq24_u01_padya_p07_733fc1": "पुत्रा ब्रह्मादयः सर्वे नैवायं वृक्षमूलवत्",
 "ait_seq24_u01_padya_p11_658962": "पुत्रनाम पितुश्च स्यात् तत्तन्त्रत्वात् सुतस्य हि",
 "ait_seq24_u01_padya_p15_38b334": "स्वकीयमेवमन्यानि पृथक्पृथगदात् प्रभुः",
 "ait_seq24_u01_padya_p19_c55eca": "देवपर्यन्तमा व्याप्तिं वेदाहं मम सर्वदा",
 "ait_seq24_u01_padya_p23_5348a0": "अधितिष्ठन्ति सत्ताद्या अप्येतेषां मदाज्ञया",
 "ait_seq24_u01_padya_p27_c9a76a": "सर्वश्रोतृत्वतः श्रोत्रं मनो मन्तृत्वहेतुतः",
 "ait_seq24_u01_padya_p31_5d0c28": "गिरत्येवाखिलं पापं भ्रातृवत् सह संस्थितम्",
 "ait_seq24_u01_padya_p35_7308bb": "स एष भूतिनामाऽपि ज्ञानैश्वर्यादिभूतिदः",
 "ait_seq24_u01_padya_p39_1aa035": "बभूवुः सुखसज्ज्ञानपूर्वैः सर्वगुणैर्युताः",
 "ait_seq24_u01_padya_p43_20a39b": "अभूतिकारकोऽस्माकमैश्वर्यादिगुणोज्झितः",
 "ait_seq24_u01_padya_p47_6ac02c": "भावाभावं च देवानां दैत्यानां चैवमेव तु",
 "ait_seq24_u01_padya_p51_232024": "स एव जीवनकरो यदाऽपानेन संयुतम्",
 "ait_seq24_u01_padya_p55_6ceec4": "प्राणादेव हि तत्रापि प्राणाधारो जनार्दनः",
 "ait_seq24_u01_padya_p59_6de96d": "अमर्त्यस्तत्प्रसादेन वायुर्देहैः सह स्थितः",
 "ait_seq24_u01_padya_p63_a1c1f1": "शरीरं तु विनष्टं स्यात् पञ्चत्वमुपगच्छति",
 "ait_seq24_u01_padya_p67_34f7a3": "दृश्यमेतच्छरीरं चाप्यदृश्या वायुदेवता",
 "ait_seq24_u01_padya_p71_72930f": "” इति च",
 "ait_seq24_u01_padya_p75_04be6c": "विनतमिव किञ्चिन्नतस्थानं तत् सूर्यलोकस्थानीयं विद्यात्",
 "ait_seq24_u03_padya_p01_1c9d6b": "इति शब्दनिर्णये",
 "ait_seq24_u04_padya_p03_cf79b3": "केवलैश्वर्ययोगेन यत्र सङ्ख्यादिवद् भवेत्",
 "ait_seq24_u04_padya_p07_24fff6": "न विशेषो हि रूपाणां मत्स्यादीनां कथञ्चन",
 "ait_seq24_u06_padya_p02_6ef77d": "उक्तार्थस्य महाधिक्यं श्रुतेस्तत्र विवक्षितम्",
 "ait_seq24_u07_padya_p04_68365c": "मुख्याधिदैवतं नारायण एव",
 "ait_seq24_u11_gadya_p01_7092d6": "इत्याद्यर्थे",
 "ait_seq24_u15_gadya_p01_4f5735": "इति वाक्यशेषात्",
 "ait_seq24_u18_padya_p02_fed651": "तद्वशा नियता नित्यं नमस्तस्मै परात्मने",
 "ait_seq24_u19_padya_p04_23385a": "तैर्हि स्तुत्यादिकर्माणि कृतानि श्रोत्रेण शृणोति भगवान्",
 "ait_seq24_u20_padya_p01_280f97": "मुखादिन्द्रश्चाग्निश्च",
 "ait_seq24_u21_padya_p04_da45f3": "अतिप्रसङ्गात्",
 "ait_seq24_u23_gadya_p01_087235": "इत्यादिना",
 "ait_seq24_u24_padya_p04_94c7d9": "प्रधानत्वान्न देवानां नृकर्मोत्पत्तिकारणम्",
 "ait_seq24_u27_padya_p02_c71634": "नतु सन्निहितस्यैव",
 "ait_seq24_u29_padya_p02_ff8675": "यथा च",
 "ait_seq71_u01_padya_p01_17c69a": "बृहतीसम्पादनेऽनुष्टुप्शंसनामात्रात् पञ्चविंशोत्तरशतानुष्टुबाधिक्यं च भवति",
 "ait_seq71_u03_padya_p01_23bc34": "इत्यनुष्टुभो बृहतीसम्पादनवचनाच्च",
 "ait_seq71_u03_padya_p05_0c172b": "इन्द्रस्य परमेश्वरस्य विष्णोः सम्बन्धी नितरां प्रियत्वाद् यः प्राणदेवता",
 "ait_seq71_u03_padya_p09_29b62f": "तस्मात् तस्यैव बृहतीसहस्रत्वेन सम्पन्नस्य पञ्चविंशोत्तरैकादशशतानुष्टुप्त्वेन सम्पादने बृहतीदैवतप्राणरूपाद् वायोरनुष्टुब्देवताया",
 "ait_seq71_u03_padya_p13_bcaf83": "प्रतिमाधिष्ठितदेवतावत्",
 "ait_seq71_u03_padya_p17_bc517a": "स हि तस्याः षट्त्रिंशदक्षरादित्वमपि नियमयति तत्प्रसादाद् वायुश्च",
 "ait_seq71_u11_padya_p01_c6e93b": "इति शब्दनिर्णये",
 "ait_seq71_u13_padya_p02_b3de1d": "परमविकारेण सह विकारमात्रस्यापि प्रस्तुतत्वात् तदेतत् पञ्चविधमिति परामर्शः",
 "ait_seq71_u15_padya_p04_968140": "नायोग्यानां सम्यग् वाच्य इति स्वल्प एव प्रकाशितोऽस्माभिः",
 "ait_seq71_u15_padya_p08_7d42b8": "अकारस्योङ्कारता त्वकारलोपेनैव जातेति सत्यमोङ्कारः",
 "ait_seq71_u15_padya_p12_53aa38": "अतश्च सत्यमोङ्कारः",
 "ait_seq71_u15_padya_p16_4aecab": "तस्मादकारस्यैतद् वृथा वागादिकमपि व्याख्यानम्",
 "ait_seq73_u03_padya_p03_15bc01": "यस्य नारायणस्यैतद् यशः स भगवानेवेन्द्रनामा",
 "ait_seq73_u05_padya_p02_a1bc8b": "अन्येषां तु द्वादशानां तेन दत्तमेवेन्द्रत्वं नतु मुख्यतः",
 "ait_seq73_u07_padya_p03_42f790": "तदा वरुणादिषु पृथक्पृथङ् मत्सिशब्ददर्शनादत्रापि पृथङ् मत्सिशब्दो दृश्येत",
 "ait_seq73_u09_padya_p01_12657e": "इत्याद्यप्येकस्यैव विष्णोर्विशेषणम्",
 "ait_seq73_u11_padya_p02_c1ecac": "बहुरूपत्वाद् बहुवचनं च विष्णोरेव युज्यते",
 "ait_seq73_u17_padya_p01_c0c46d": "इति धातोः",
 "ait_seq73_u19_padya_p03_9f678a": "तस्मात् तत्प्रसादादवताराग्रजत्वमेव तस्य महत्त्वम्",
 "ait_seq73_u21_padya_p03_846c9c": "विष्णुस्तु",
 "ait_seq73_u27_padya_p02_910d30": "स एव महिदास इन्द्रनामा प्राप्येमं लोकमत्र भूत्वा प्रादुर्भूय",
 "ait_seq73_u29_padya_p01_21c94c": "इत्यादिवत् प्राप्तिवाच्येव",
 "ait_seq73_u33_padya_p01_a9f3ed": "इति स्कान्दे",
 "ait_seq73_u35_padya_p01_9f55ce": "इतिवत्",
 "ait_seq73_u37_padya_p02_757a2b": "रङ्गस्तु प्रश्नविषयस्य दुरवगमत्वं प्रकाशयति",
 "ait_seq73_u39_padya_p04_5ce447": "सोऽयं महिदासादिप्रादुर्भावरूप इदं भूमिष्ठस्त्रीरूपं लोहितगतं च स्वकीयमेव रूपममुष्मै",
 "ait_seq73_u39_padya_p08_21812f": "अग्नेस्तद्रूपमग्निनाम्नो विष्णोः प्रतिमा तत्सन्निधानात्",
 "ait_seq73_u39_padya_p12_13de50": "अप्रस्तुतत्वात् तस्य",
 "ait_seq73_u43_padya_p03_24d354": "सत्यस्य सत्यमनु यत्र युज्यत इत्यादिनोक्तार्थविषयोदाहृतैः श्लोकैरपि भगवत एव स्वरूपाणां परस्परयोगस्योक्तत्वात्",
 "ait_seq75_u01_padya_p04_e21d3d": "एव स्त्रीपुंरूपेण युज्यते",
 "ait_seq75_u01_padya_p08_4a4e76": "किन्त्वेकस्थाने वासोऽत्यनुकूलचित्तता च",
 "ait_seq75_u04_padya_p04_5cd35a": "स्वरूपैक्यस्य पूर्वमेव सिद्धत्वात्",
 "ait_seq75_u04_padya_p08_fc0fce": "नहि पूर्वं भिन्नस्य पश्चात् स्वरूपैक्यं भवति",
 "ait_seq75_u08_padya_p02_be976a": "तत्र देवाः सर्व एकं भवन्तीत्युच्यते",
 "ait_seq75_u08_padya_p06_a90f24": "वियूय विचार्य नामायत्तान्येव नामार्थभूतान्येव विष्णोर्माहात्म्यादीन्यन्वविन्दन्",
 "ait_seq75_u08_padya_p10_18747a": "तस्मिन्नेव देवाः सर्वयुजो भवन्तीत्यवधारणार्थं पुनर्वचनम्",
 "ait_seq75_u14_padya_p01_a02b46": "इति च",
 "ait_seq75_u14_padya_p05_982247": "भवत्येव हि भगवान् स्त्रीरूपः पुंरूपश्च",
 "ait_seq75_u22_padya_p02_d6d982": "एवं सर्वे शब्दा भगवद्वाचका इत्युक्त्वा",
 "ait_seq75_u24_padya_p03_b22234": "यस्माद इत्ययं शब्दः प्रस्तुतस्याभावं विरोधिनमन्यं च वदति तस्मात्",
 "ait_seq75_u24_padya_p07_75c24d": "भगवांस्त्व इति पृथग् विवक्षितत्वादेव न प्रस्तुतसमुदाये",
 "ait_seq75_u24_padya_p11_e24de8": "तस्मादकारस्य भगवानेव मुख्यार्थो न शून्यम्",
 "ait_seq75_u24_padya_p15_834b68": "नच तथा प्रयोगोऽस्ति",
 "ait_seq75_u24_padya_p19_799d35": "नच जीवजडाद्यपूर्णवस्त्वभिन्नस्य पूर्णत्वं भवति",
 "ait_seq75_u26_padya_p01_6b9b70": "इति शब्दनिर्णये",
 "ait_seq75_u26_padya_p05_034603": "अहमेक एव परिपूर्णः",
 "ait_seq75_u26_padya_p09_5d891c": "तच्चोक्तं वाक्यनिर्णये",
 "ait_seq75_u28_padya_p04_dee5f4": "उक्तं हि शब्दनिर्णये",
 "ait_seq75_u34_padya_p02_a04081": "वायोरुत्पत्तिकामो मायां रमायां रमत इत्यनकाममारः",
 "ait_seq75_u36_padya_p03_b2a443": "अस्त्रीपुमानिति ब्रुवन्नपि न वदतीत्युक्तत्वाच्च स्त्रीत्वं पुंस्त्वं च प्रतीयते विष्णोः",
 "ait_seq75_u36_padya_p07_c4c281": "नपुंसकरूपे प्रमाणाभावादेव लौकिकस्त्रीपुंविलक्षणत्वादस्त्रीपुमानित्यपि वदन्निति भवति",
 "ait_seq75_u40_padya_p01_8ebd2c": "इत्यादि प्रमाणविवेके",
 "ait_seq75_u44_padya_p02_ea1a2e": "सुखं ददत इति सुदिने",
 "ait_seq75_u44_padya_p06_8b6047": "नचाहोरात्रे अहनी इत्युच्येते",
 "ait_seq75_u46_padya_p01_8e7866": "इत्यध्यात्मसम्बन्धाच्च",
 "ait_seq75_u46_padya_p05_aaa34a": "जीवन्मुक्तिश्च मुक्तिश्च हि मुख्ये सुदिने",
 "ait_seq75_u50_padya_p02_9f09c7": "अतो ज्ञानोत्पत्तिसमनन्तरमेव मुक्तौ न पुनरार्जनमस्तीति किञ्चित् कालं ज्ञानित्वेनावस्थानमपि सुदिनमेव",
 "ait_seq75_u50_padya_p06_6de862": "एकरासभयुक्तो हि तद्रथः",
 "ait_seq75_u56_padya_p02_6ca73d": "अतो विष्णुरेव मुख्यतः सर्वनामोक्त इति सिद्धम्",
 "ait_seq186_u01_padya_p04_24699a": "आत्मनो ज्ञानसामर्थ्यानुसारेण वक्तव्यत्वादनुव्याहारः",
 "ait_seq186_u03_padya_p04_dbd947": "नाशकः सन्धातुं मया सह सन्धानं कर्तुं नाशकः",
 "vtn_seq40_u06_padya_p02_486519": "नच नित्यत्वं विना वेदानां दर्शनव्यवहारो युज्यते",
 "vtn_seq40_u06_padya_p06_04c282": "प्रत्यभिज्ञाविरोधस्योक्तत्वात्",
 "vtn_seq73_u01_padya_p03_eb0f42": "बलवत्प्रमाणतश्चैव ज्ञेया दोषा नचान्यथा",
 "vtn_seq73_u01_padya_p07_698090": "ज्ञानं च द्विविधं बाह्यं तथाऽनुभवरूपकम्",
 "vtn_seq73_u01_padya_p11_5451d1": "उपजीव्यविरोधे तु न प्रामाण्यममुष्य च",
 "vtn_seq76_u01_padya_p04_9acce8": "युक्तिः प्रतिज्ञारूपा च हेतुदृष्टान्तरूपिका",
 "vtn_seq76_u01_padya_p08_236689": "सिद्धत्वेन प्रतिज्ञाया हेतुर्मानं पृथग् भवेत्",
 "vtn_seq76_u01_padya_p12_82cae4": "तथा निगमनं चोपसंहारैकस्वरूपतः",
 "vtn_seq78_u01_padya_p03_7eebf1": "जनकस्यात्ययो जातिः स्वस्य वाऽन्यस्य वा भवेत्",
 "vtn_seq80_u01_padya_p02_527dc1": "दृष्ट्वा सदृशमेवान्यं पूर्वदृष्टे तु वस्तुनि",
 "vtn_seq80_u01_padya_p06_d23f0d": "द्वितीयमपि विज्ञेयं सुखाद्ये च घटादिके",
 "vtn_seq80_u01_padya_p10_5303ab": "अर्थापत्तिश्चोपमा च ह्यनुमाभेद एव तु",
 "vtn_seq170_u04_padya_p04_93f8dd": "सति सम्पद्य न विदुः सति सम्पत्स्यामह इति",
 "vtn_seq170_u05_padya_p03_39ee85": "ता यथा तत्र न विदुरियमहमस्मीयमहस्मीत्येवमेव खलु सोम्येमाः सर्वाः",
 "vtn_seq170_u05_padya_p07_e6665c": "मशको वा यद्यद् भवन्ति तत् तदा भवन्ति",
 "vtn_seq170_u07_padya_p04_9e7a35": "तं होवाच यं वै सोम्यैतमणिमानं न निभालयसे अस्य",
 "vtn_seq172_u01_padya_p01_667782": "सति सम्पद्य न विदुः सति सम्पत्स्यामह इति त",
 "vtn_seq174_u02_padya_p01_96f2f3": "इत्यत्रापि",
 "vtn_seq174_u08_padya_p01_a13df7": "इति द्वितीयानिर्देशात्",
 "vtn_seq186_u02_padya_p03_b1e232": "नहि स्वकीयं परित्यजंस्तेनो भवति",
 "vtn_seq222_u06_padya_p01_0ed156": "इति ह्याक्षेप एव",
 "vtn_seq250_u02_padya_p03_1c820d": "तर्हि निवर्तेत",
 "vtn_seq250_u02_padya_p07_f644a4": "नचाविद्यमानोऽयम्",
 "vtn_seq250_u02_padya_p11_32947b": "परमेश्वरेण ज्ञातत्वाद् रक्षितत्वाच्च न द्वैतं भ्रान्तिकल्पितमित्यर्थः",
 "vtn_seq250_u04_padya_p02_24bf1d": "परमार्थापेक्षया ह्यद्वैतम्",
 "vtn_seq250_u06_padya_p02_40509e": "सर्वभावानां मध्ये तस्यैकस्यैवाद्वैतत्वमित्युक्ते समाधिकराहित्यमेवोक्तं स्यात्",
 "vtn_seq250_u08_padya_p03_279048": "च न युज्यन्ते",
 "vtn_seq250_u08_padya_p07_91adf7": "अज्ञात एव द्वैतं न विद्यते",
 "vtn_seq252_u05_padya_p03_40f603": "भ्राम्यल्ँलोको न जानाति वेदविद्यान्तरं तु यत्",
 "gb_2_14d_u01_padya_p03_1c1b44": "सन्निति व्यवह्नियमाणमेव पदार्थस्वरूपमुत्पत्तेः प्राङ् नाशोत्तरं च नास्तीति सर्वलोको व्यवहरति",
 "gb_2_17b_u16_padya_p02_214604": "नच जीवेश्वरैक्यं मुक्तावपि",
 "gb_2_17b_u40_padya_p02_159f4d": "एकपिण्डनामधेयेतिशब्दानां वैयर्थ्यं चान्यथा",
 "gb_2_17b_u40_padya_p06_c01183": "तस्मादतत्त्वमसीत्येवोच्यते",
 "gb_2_17b_u44_padya_p01_a7c7df": "इति लिङ्गसाम्यं चात्र",
 "gb_2_17b_u46_padya_p02_009bef": "अतिप्रसङ्गश्चान्यथा",
 "gb_2_17b_u53_padya_p03_626df4": "तत्पक्षे त्वैक्यादेरपि मिथ्यात्वात् स्वरूपस्य च सिद्धत्वाद् व्यर्थैव श्रुतिः",
 "gb_2_17b_u53_padya_p07_043e26": "मिथ्यात्वं च मिथ्यैव तेषाम्",
 "gb_2_17b_u53_padya_p11_e39f45": "अचेतनानामनुभवाभावान्न तत्साम्यम्",
 "gb_2_39_u06_padya_p01_df3aa9": "इत्यन्यसाङ्ख्ययोगयोर्निषिद्धत्वान्नारदीये",
 "gb_2_39_u06_padya_p05_ef7d45": "मोक्षार्थत्वेनैव",
 "gb_3_17_u10_padya_p02_247f64": "यस्मादमुक्तस्य कार्यमस्त्येव तस्मादसक्तः",
 "gb_3_17_u12_gadya_p01_5efc70": "इत्युपसंहारविरोधश्चान्यथा",
 "gb_3_17_u15_padya_p01_a90b04": "आत्मरतिरेव स्यात्",
 "gb_7_7_u18_padya_p02_41331e": "परतरस्त्वहमेवेत्यर्थः",
 "gb_7_7_u31_padya_p01_6e92eb": "इत्यादिवाक्यशेषाच्च",
 "gb_7_7_u31_padya_p05_bd4cf5": "जानन्",
 "gb_7_27_u04_padya_p04_cc1c9c": "सम्मोहः = तदाग्रहः",
 "gb_10_42b_u02_padya_p02_0b602d": "अन्यथोक्तेरेव वैयर्थ्यात्",
 "gb_11_1_u29_padya_p01_28d2ab": "इत्यादि ब्रह्मतर्के",
 "gb_11_1_u31_gadya_p01_ef43ea": "इति पाद्मे",
 "gb_13_13_u08_padya_p02_7c3c76": "अन्यज्ञेयत्वस्य",
 "gt_2_55_u02_padya_p02_9edc2a": "मत्तादिप्रवृत्तिवदिति",
 "gt_2_55_u04_padya_p04_fc3776": "प्रायः सर्वान् प्रजहाति",
 "gt_2_55_u06_padya_p02_e7153b": "यदा त्विन्द्रादीनामाग्रहो दृश्यते तदाभिभूतं तेषां ज्ञानम्",
 "gt_2_55_u08_padya_p01_4f245b": "इति",
 "gt_2_55_u09_padya_p01_c5dc93": "यः सर्वत्रानभिस्नेहः",
 "gt_2_55_u10_padya_p04_37c442": "सम्प्रज्ञाते त्वविरोधः",
 "gt_2_55_u12_padya_p01_fa8e13": "इति स्मृतेः",
 "gt_2_55_u13_padya_p01_ddd51b": "रसोऽप्यस्य परं दृष्ट्वा निवर्तते",
 "gt_2_55_u14_padya_p04_ccd2d9": "आत्मना परमात्मना",
 "gt_2_55_u15_padya_p02_30987c": "देवाद् भवति वै तुष्टिर्नान्यथा तु कथञ्चन",
 "gt_3_34_u02_padya_p02_4012bc": "निग्रहात् सद्यः प्रयोजनाभावेऽपि भवत्येवातिप्रयत्नत इत्याशयवानाह- इन्द्रियस्येति",
 "gt_3_34_u04_gadya_p01_dcf9fe": "इति",
 "gt_13_0_u01_padya_p01_8141c2": "अर्जुन उवाच",
 "gt_16_1_u05_padya_p01_7418f0": "ब्रह्मचर्यादिकं तपः",
 "gt_16_1_u07_padya_p02_3730b4": "राजादेस्तु मदाद् भीतेरदृष्टिर्दर्प उच्यते",
 "gt_16_1_u10_padya_p01_ef2b82": "इत्यभिधानात्",
 "gt_16_1_u12_padya_p02_9cf042": "क्षमा तु क्रोधाभावेन सहापकर्तुरनपकृतिः",
 "gt_16_11_u09_padya_p02_da775c": "न कस्यचिद् विष्णुः कारयिता",
 "gt_16_11_u11_gadya_p01_f5934d": "इति सामवेदे यास्कश्रुतिः",
 "tvk_seq14_u01_padya_p01_8be3aa": "द्विधैवाचेतनं मतम्",
 "tvk_seq18_u01_padya_p01_f891ca": "गुणक्रियाजातिपूर्वा धर्माः सर्वेऽपि वस्तुनः",
 "tvk_seq18_u01_padya_p05_c718f3": "कार्यकारणयोश्चैव तथैव गुणतद्वतोः",
 "uk_seq5_u01_padya_p04_6f957e": "अन्यत्वं स्वात्मनस्तस्मात् सर्वैरेवानुभूयते",
 "uk_seq5_u02_padya_p01_be7026": "सत्यः सो अस्य महिमा",
 "uk_seq11_u05_padya_p02_5fbbc3": "भिन्नत्वेनात्मसादृश्यदो",
 "tdy_seq72_u01_padya_p02_4377be": "हस्तपादाद्युपाधिभेदेऽपि भोक्तुरेकत्वानुभवात्",
 "tsk_seq12_u01_padya_p04_f01579": "दुःखसंस्था मुक्तियोग्या अयोग्या इति च द्विधा",
 "tsk_seq12_u01_padya_p08_e67855": "मर्त्याधमाश्चतुर्धैव तमोयोग्याः प्रकीर्तिताः",
 "man_seq1_u02_padya_p02_29a9c5": "मण्डूकरूपी वरुणस्तुष्टाव हरिमव्ययम्",
 "kat_seq11_u09_padya_p01_ef43ea": "इति पाद्मे",
 "kat_seq11_u11_padya_p03_8b57f9": "गुहानिहितत्वं च तस्यैव विशेषतः प्रसिद्धम्",
 "kan_seq288_u02_padya_p01_87625b": "भगवतो रूपंरूपं प्रति जीवाख्यः प्रतिबिम्बो बभूव",
 "kan_seq288_u06_padya_p03_1c7fc3": "ऋतायन् सत्यं कुर्वन्",
 "kan_seq288_u06_padya_p07_6c5abf": "दंसः कर्म",
 "kan_seq288_u06_padya_p11_fd877b": "तेन विद्यायामुक्तायां तस्मिन्निन्द्रेण छिन्ने पूर्वशिरः सन्धितम्",
 "knr_seq35_u04_padya_p01_567763": "इति च सूत्रम्",
 "knr_seq35_u04_padya_p05_8f6bb1": "अयं त्वान्तरमप्यापरोक्ष्येण पश्यति",
 "knr_seq35_u06_padya_p03_207019": "एवंविधं मद्गतं त्वामुद्दिश्यैव उपेहि",
 "knr_seq81_u01_gadya_p03_03d7fb": "खण्डार्थनिर्णयापरनामा सम्पूर्णः",
 "bt_1_8_5_u01_padya_p01_7087c4": "यः पदातिं हन्ति स भवति चातुर्मास्ययाजी यः सादिनं",
 "bt_10_21_50_u02_padya_p33_098ba9": "अथैष एव परमानन्दो योऽसौ हरिर्विश्वो विनोदोऽपनोदः संस्कारकोऽविकारकोऽधिकारक एतस्यैवानन्दस्य",
 "bt_10_40_15_u04_padya_p03_e729b5": "अजित परम रमेशान वासुदेव वैकुण्ठ नारायण हृषिकेशानया हि",
 "bt_10_40_15_u04_padya_p07_ac7c1d": "त्वं स्वतोऽसि त्वं रमायाः त्वं विरिञ्चिस्य रुद्रेन्द्रसूर्यसोममुखानामदभ्रशक्तिदोऽसि प्रवर्तकोऽसिनिवर्तकोऽसि",
 "bt_10_40_15_u04_padya_p11_03cead": "सन्धिनु सन्धिनु मा ते क्षणोत्यागान्मते क्षणोत्यगात्",
 "bt_10_40_19_u10_padya_p01_534d01": "प्राण एवैनमनुप्रविशति प्राणमितरा देवताः न प्राणादपरः परमनु प्रविशति",
 "bt_10_40_19_u13_padya_p01_7c45e3": "तं प्रपदाभ्यां प्रापद्यत ब्रह्मेमं पुरुषं यत्प्रपदाभ्यां प्रापद्यत ब्रह्मेमं",
 "bt_10_40_19_u13_padya_p05_a962c2": "हृदयं ब्रह्मेत्यारुणयो ब्रह्मा हैव ता ई",
 "bt_11_9_25_u04_padya_p01_4f790e": "तं भूतिरिति देवा उपासाञ्चक्रिरे ते बभूवुस्तस्माद्धाप्येतर्हि सुप्तो भूर्भूरित्येव",
 "bt_11_17_5_u03_padya_p03_b90bb1": "..... ता इमाः षोडशकलाः पुरुषायणाः"
}