{
 "bsb_1_1_3_u05_padya_p02_be13f2": "नचानुमानस्य नियतप्रामाण्यम्",
 "bsb_1_1_3_u11_padya_p02_8f76e4": "दर्शनाच्च तपआदिफलस्य",
 "bsb_1_1_6_u02_padya_p02_92d7df": "नच",
 "bsb_1_1_6_u08_padya_p02_a69d7a": "नच मुख्ये सत्यमुख्यं युज्यते",
 "bsb_1_1_26_u06_padya_p04_1c3924": "स हि पुरुषसूक्ताभिधेयः",
 "bsb_1_1_31_u04_padya_p04_9319c9": "न",
 "bsb_1_1_31_u10_padya_p02_782241": "तत्तदुपासनायोग्यतया च पुरुषाणाम्",
 "bsb_1_3_28_u07_gadya_p01_8be476": "इत्यादेरत एव शब्दात् तेषां प्रभवनियमात्",
 "bsb_2_1_14_u04_padya_p02_d97133": "अतस्तयोरविभागः",
 "bsb_2_1_14_u04_padya_p06_b11bf7": "यथा लोके उदके उदकान्तरस्यैकीभावव्यवहारेऽप्यन्तर्भेदोऽस्त्येव",
 "bsb_2_1_14_u06_padya_p02_d0ddf0": "स्कान्दे च–",
 "bsb_2_1_24_u02_padya_p02_d0875d": "चेतनत्वेऽप्यश्मादिवदस्वतन्त्रत्वात् स्वतः कर्तृत्वानुपपत्तिर्जीवस्य",
 "bsb_2_1_26_u02_padya_p04_e3b79c": "लोकेऽपि पिशाचादीनां तादृशी शक्तिर्दृष्टा",
 "bsb_2_1_29_u02_padya_p03_a1a7d1": "नान्येषाम्",
 "bsb_2_2_5_u02_padya_p02_8b387a": "यथा पृथिव्या एव पर्जन्यानुगृहीतं तृणादिकमुत्पद्यते",
 "bsb_2_2_5_u10_padya_p02_264e0d": "चशब्देन प्रकृतिसत्तादिप्रदत्वं चाङ्गीकृतम्",
 "bsb_2_3_43_u11_gadya_p01_658c18": "इत्यादिना नानाव्यपदेशादंशो जीवः",
 "bsb_2_4_4_u03_padya_p01_a6d6fa": "इति गौपवनश्रुतौ मनसोऽनुत्पत्तिः सयुक्तिका श्रूयते",
 "bsb_3_1_4_u04_padya_p03_a94738": "भागतोऽग्न्यादिप्राप्तेः",
 "bsb_3_1_27_u02_padya_p02_f0dbfe": "हिंसारूपत्वात् पापस्यापि सम्भवाद् दुःखं च भवत्विति चेत्",
 "bsb_3_2_13_u02_padya_p02_5c45ae": "एवमभेदेनैव",
 "bsb_3_2_13_u04_padya_p03_80a0ef": "ब्रह्मतर्के च–",
 "bsb_3_2_22_u04_padya_p01_aa7892": "इति",
 "bsb_3_3_4_u02_padya_p03_2637dc": "एवं सर्वाणि वचनानि ब्रह्मज्ञानार्थानीति नियमः",
 "bsb_3_3_40_u02_padya_p03_c6884a": "स्वेच्छयैव मूलस्थाने स्थिताऽन्यत्रावतारान् करोतीश्वरेच्छानुसारेण",
 "bsb_3_3_56_u02_padya_p04_3ff82a": "परमसंहितायां च",
 "bsb_3_3_59_u02_padya_p01_be2dcb": "भूम्नः क्रतुवज्ज्यायस्त्वं तथाच दर्शयति",
 "bsb_3_4_1_u02_padya_p02_9d9364": "पुरुषार्थोऽतः शब्दादिति बादरायणः",
 "bsb_3_4_27_u08_padya_p01_bd2c9a": "इत्याग्नेये",
 "bsb_3_4_41_u02_padya_p03_1a9fac": "ब्रह्मादीनामपि नाकाङ्क्ष्यं",
 "bsb_3_4_41_u02_padya_p07_7a8a19": "एवमयोग्यस्य परमात्मैश्वर्यस्य ब्रह्मादिपदस्य चाकाङ्क्षायां पतनमनुमीयते",
 "bsb_4_1_4_u04_padya_p01_14f6fc": "इत्यादिना शब्दभ्रान्त्या न प्रतीके ब्रह्मदृष्टिः कार्या",
 "bsb_4_1_6_u04_padya_p02_8163ac": "स्वोत्पत्तिस्थानत्वात् स्वाश्रयत्वान्मुक्तौ तत्र लयस्यापेक्षितत्वाच्चोपपन्नं तेषां तथोपासनम्",
 "bsb_4_1_17_u02_padya_p03_925625": "अप्रारब्धमनभीष्टं च",
 "bsb_4_4_16_u04_padya_p03_7eb34c": "सुप्तौ मोक्षे वा तदुच्यते",
 "bsb_4_4_23_u07_padya_p01_6d00ca": "नित्यानन्दो हरिः पूर्णो नित्यदा प्रीयतां मम",
 "nvv_seq137_u02_padya_p04_29e6c5": "नहि स्वतन्त्रोऽपूर्णतां कामयीत पूर्णो यदि स्यादस्वतन्त्रः कुतः सः",
 "nvv_seq143_u02_padya_p03_42da42": "अवकाशमात्रस्याव्याकृतात्मकत्वाद् अनुत्पत्तिवचनानां तद्विषयत्वम्",
 "nvv_seq143_u02_padya_p07_462ce2": "इति पैङ्गिश्रुतिः",
 "nvv_seq157_u02_padya_p04_26bd41": "सृष्टावन्यो लये चान्य इति वेदविदो विदुः",
 "nvv_seq193_u02_padya_p03_5c9dc0": "इत्यादिमाहात्म्यवचनान्मुख्यप्राणस्य नोत्पत्तिरिति वाच्यम्",
 "nvv_seq195_u02_padya_p01_baca1d": "नच प्राणादिपञ्चकस्य व्यक्तसद्गुणत्वान्मुख्यप्राणवृत्तित्वमेव",
 "nvv_seq203_u02_padya_p01_4f30d0": "नच विरिञ्चस्यापि कर्तृत्वशक्तेः स एव शरीरादिस्रष्टा",
 "nvv_seq203_u02_padya_p05_9e3cc2": "हरिरेव यतः कर्ता पिताऽतो भगवान् प्रभुः",
 "nvv_seq248_u02_padya_p03_fb91f2": "विशेषकारणादेव विशेषाज्जनिरिष्यते",
 "nvv_seq262_u02_padya_p02_6b89c8": "देशकालविशेषेऽपि स्वप्नादीनां स एव हि",
 "nvv_seq282_u02_padya_p02_ab1e09": "अलौकिकास्तस्य शब्दास्तथाऽर्था अलौकिको ह्येष विष्णुः परत्वात्",
 "nvv_seq288_u02_padya_p02_518fb2": "सर्वत्र सर्वमेतस्मात् इत्यादिश्रुत्या क्रीडायामपि स्वातन्त्र्यात्",
 "nvv_seq288_u02_padya_p06_f4ecd8": "अस्वतन्त्रो हि चलति चलचित्तादशक्तितः",
 "nvv_seq290_u02_padya_p02_9a44b0": "तस्यैव स्वातन्त्र्यात्",
 "nvv_seq290_u02_padya_p06_16a845": "अतो हि स स्वेच्छया किञ्चिदेव फलं कुर्याद् विफलं प्रायशश्च",
 "nvv_seq290_u02_padya_p10_4196c5": "अत ईशत्वमीशस्य न हीशोऽन्यः कथञ्चन",
 "nvv_seq298_u02_padya_p02_f4d88d": "अनेनोपसंहर्तव्या अनेनोपसंहर्तव्या इत्यनिर्णीतेरिति न मन्तव्यम्",
 "nvv_seq298_u02_padya_p06_2bf3cc": "तदन्येषां यथायोग्यं स्वमाहात्म्यानुसारतः",
 "nvv_seq304_u02_padya_p03_14f5fe": "नित्यैकाग्र्यव्यङ्ग्यताहेतुतश्च साक्षाद्दृशिर्नो तद्विशेषैः स्मृतैश्च",
 "nvv_seq316_u02_padya_p03_944d2f": "यथाशक्ति स्मृतान् धात्रा गुणान् विष्णोः सरस्वती",
 "nvv_seq316_u02_padya_p07_c94417": "इत्यध्यात्मवचनाद् यथाशक्ति क्रिया देव्याः",
 "nvv_seq320_u02_padya_p04_1e4521": "गुण्याकारस्मृतेरेव द्युतिमात्रं प्रतीयते",
 "nvv_seq320_u02_padya_p08_3e9d02": "इत्यादिप्रमाणबलात्",
 "nvv_seq330_u02_padya_p04_42a7ee": "स्वाधिकाराधिको यत्नः प्रायशो नोपपद्यते",
 "nvv_seq336_u02_padya_p02_10df10": "सत्यं पूर्णं विज्ञानं पूर्णं कृतिः पूर्णा निष्ठा पूर्णा",
 "nvv_seq336_u02_padya_p06_ae21c6": "तदेष श्लोको भवति",
 "nvv_seq336_u02_padya_p10_6715d8": "सत्याद्या अहमात्मान्ता यद्गुणाः समुदीरिताः",
 "nvv_seq382_u02_padya_p02_7c7d1a": "एतावतोऽधिका नास्ति प्राप्तिरित्यन्ततः स्थिता",
 "nvv_seq388_u02_padya_p01_6208b6": "नच गृहस्थानामशेषकर्मविशेषयोग्यत्वादाधिक्यं मुक्तौ",
 "nvv_seq388_u02_padya_p05_96f16b": "विहाय रागं मनसश्चोपरिष्ठं ततोऽभवत् परमेष्ठी स मुक्ताविति",
 "nvv_seq388_u02_padya_p09_9b55db": "बहुकालसाधनाद् बहुकर्माधिकारमात्रस्य दुर्बलत्वात्",
 "nvv_seq411_u02_padya_p04_fea2d0": "कर्माणि क्षपयेद् विष्णुरप्रारब्धानि विद्यया",
 "nvv_seq417_u02_padya_p02_1196a1": "इन्द्रियस्थैः स्वरूपैस्तु ज्ञानानि जनयत्यसौ",
 "nvv_seq417_u02_padya_p06_0977a7": "प्राण एको वशी नित्यं बाह्यान्तःकरणेश्वरः",
 "nvv_seq417_u02_padya_p10_dd50da": "इत्यादिश्रुतेः प्राणस्यैवाढ्यतावगमात्",
 "nvv_seq431_u02_padya_p04_25cb95": "इति श्रुतेस्तदनुसार्यनुवृत्तेर्लौकिकवैदिकयोः साम्यात्",
 "nvv_seq449_u02_padya_p02_177959": "ईश्वरस्य स्वत एव पूर्णानन्दत्वादभोगस्यापि सम्भवादिति वाच्यम्",
 "nvv_seq449_u02_padya_p06_cc150d": "सावकाशोपपत्तिमात्रान्निरवकाशश्रुतियुक्तोपपत्तेरेव बलवत्त्वात्",
 "nvv_seq457_u02_padya_p04_8fe789": "यान्त्यमुक्ता नोभयं च मुक्तानां वशिता यतः",
 "nvv_seq459_u02_padya_p03_011661": "नहि स्वर्णं शुद्धमपि वह्निकार्यकरं भवेत्",
 "nvv_seq459_u02_padya_p07_71ea2e": "इति श्रुत्या विशेषकॢप्तेरेव",
 "ait_seq12_u01_padya_p01_fee597": "उत्थापनादुक्थनामा स एव पृथिवीस्थितः",
 "ait_seq12_u01_padya_p05_daf299": "पूर्षु स्थितत्वात् स महान् प्रजानां पतिरेव च",
 "ait_seq12_u01_padya_p09_a4d8f2": "वदनं नासिका नेत्रमित्येतानि परात्मनः",
 "ait_seq12_u01_padya_p13_0e04d8": "सोम एव ततश्चान्नमशीतय इतीरितम्",
 "ait_seq12_u01_padya_p17_8081ae": "श्येन एव तदाकारा चितिरर्कपदोदिता",
 "ait_seq12_u01_padya_p21_736a2a": "तथा वाक्प्राणचक्षुष्षु तस्मात् तेऽर्काः प्रकीर्तिताः",
 "ait_seq12_u01_padya_p25_306b1b": "नासयोर्नासिके विष्णोरक्ष्णोरेव तदक्षिणी",
 "ait_seq12_u01_padya_p29_263c0f": "जीववागादिसंस्थं च सुपर्णमधिसंस्थिताः",
 "ait_seq12_u01_padya_p33_3d09d4": "सुपर्णनामा भगवान् सुपर्णे च व्यवस्थितः",
 "ait_seq12_u01_padya_p37_9430f5": "तस्यान्तरिक्षगस्यैव नियमादनुपक्षिणः",
 "ait_seq12_u01_padya_p41_7eab44": "पृथिव्यां संस्थितो विष्णुः स्त्रीरूपेण द्युलोकतः",
 "ait_seq12_u01_padya_p45_5b128b": "एक एव परो विष्णुरत्ताऽन्यैरुपजीव्यतः",
 "ait_seq16_u01_padya_p01_a22e6f": "तमिमं प्रथमज्ञानिपुरुषं चतुराननम्",
 "ait_seq16_u01_padya_p05_f4873a": "चतुर्मुखाकारवतां नृणां पादतलोपरि",
 "ait_seq16_u01_padya_p09_114223": "किञ्चिदूर्ध्वं ततो गत्वा वायुना सह केशवः",
 "ait_seq16_u01_padya_p13_a04c8a": "उरु स्थानं निवासं मे कुरु विस्तारसंयुतम्",
 "ait_seq16_u01_padya_p17_089a82": "उदरे ते परं ब्रह्म वासुदेवमुपासते",
 "ait_seq16_u01_padya_p21_b7bb73": "तत ऊर्ध्वं गतो विष्णुर्वायुना सह दैवतैः",
 "ait_seq16_u01_padya_p25_2f16c0": "अहम्भावमनो रुद्रः शेषोऽसौ पाञ्चरात्रकम्",
 "ait_seq16_u01_padya_p29_51f196": "उपासते महाविष्णुं परमात्मानमच्युतम्",
 "ait_seq16_u01_padya_p33_bce795": "शरीरं पद्यते श्रेयान् स न इत्यवधार्यताम्",
 "ait_seq16_u01_padya_p37_4dfa68": "उदासीनवदास्तां तौ केशवश्चाब्जसम्भवः",
 "ait_seq16_u01_padya_p41_28441e": "वायौ प्रविष्टे तूत्थानं कायस्यासीत् तदैव च",
 "ait_seq16_u01_padya_p45_cdf389": "स्पर्धामहे त्वद्बलेन त्वया नान्येन केनचित्",
 "ait_seq18_u01_padya_p02_fabf9b": "शिष्यप्रशिष्यादिषु च तेऽनयन् वायुनोदितम्",
 "ait_seq18_u01_padya_p06_680ec4": "प्रततत्वात् प्रातरिति तस्य नामाभवद् विभोः",
 "ait_seq18_u01_padya_p10_2bdd27": "अध्यात्ममग्निर्वागाख्यश्चक्षुः सूर्यः प्रकीर्तितः",
 "ait_seq18_u01_padya_p14_3e17f3": "श्रोत्रं चन्द्रस्तथा स्मार्ततान्त्रिकश्रवणोचितम्",
 "ait_seq18_u01_padya_p18_a1d878": "विष्णुना प्रहितानां हि संयोगोऽध्यात्ममेष हि",
 "ait_seq18_u01_padya_p22_2e8168": "अग्निश्च मित्रावरुणौ कुबेराद्याश्च सर्वशः",
 "ait_seq18_u01_padya_p26_44a4b1": "तात्पर्यात् सर्ववेदैश्च तज्जानन्नवदन् मुनिः",
 "ait_seq18_u01_padya_p30_c27cfa": "वेद संयोगमध्यात्मं ततो मुक्तौ यथेष्टभुक्",
 "ait_seq18_u01_padya_p34_4bd7a0": "एतद्धि तेन कथितं मुनिना तत्त्ववेदिना",
 "ait_seq18_u01_padya_p38_f0a512": "स्वस्वाम्यन्यानि भूतानि हरेयुर्बलिमस्य हि",
 "ait_seq18_u01_padya_p42_baa5cc": "मुक्तामुक्तैर्मुक्तियोग्या इति शास्त्रस्य निर्णयः",
 "ait_seq18_u01_padya_p46_5f6e8b": "शेषवीन्द्रशिवादिभ्य उत्तमत्वात् सदैव हि",
 "ait_seq18_u01_padya_p50_94ea8e": "अतिनादात् सदा वेदैरप्यन्नं स चतुर्मुखः",
 "ait_seq18_u01_padya_p54_4df950": "एवं सत्यपदार्थं हि विज्ञायोपास्त आदरात्",
 "ait_seq20_u01_padya_p01_33499a": "तस्य नारायणस्यैव सर्ववेदात्मिका हि वाक्",
 "ait_seq20_u01_padya_p05_370457": "सर्वे हि नामवन्तोऽत्र सर्वे वेदोदिता अपि",
 "ait_seq20_u01_padya_p09_b8b06a": "तं प्रत्येवाखिलान्येव भूतानि सह दैवतैः",
 "ait_seq20_u01_padya_p13_8e9494": "मुक्तः संश्च तदन्येषां ज्ञानमात्राद् विमुक्तिगैः",
 "ait_seq20_u01_padya_p17_b892c4": "विष्णोर्वायोश्च लोमादौ छन्दांस्येवाश्रितानि च",
 "ait_seq20_u01_padya_p21_b3d8ff": "छन्दांसीत्येव तेषां हि य एवंविदुपासकः",
 "ait_seq20_u01_padya_p25_e6e779": "मन्त्रोऽप्यर्थमिमं प्राहापश्यं गोपामिति स्म ह",
 "ait_seq20_u01_padya_p29_97577b": "वायुर्हि नित्यसञ्चारी सदा सर्वप्रवृत्तिमान्",
 "ait_seq20_u01_padya_p33_4b9405": "सध्रीचीनासु पूर्वादिदिक्ष्वेतौ चतसृष्वपि",
 "ait_seq20_u01_padya_p37_e84eb8": "तद्ध्यसह्यं बलं वायोरनन्तं किमु तद्धरेः",
 "ait_seq20_u01_padya_p41_8178d0": "आवृता महदाद्यास्तु देहे तिष्ठन्ति चैतयोः",
 "ait_seq20_u01_padya_p45_0239bd": "वायुकेशवयोः प्राणनाम सर्वप्रणायनात्",
 "ait_seq24_u01_padya_p02_b07bb6": "नामेत्यपृच्छल्लक्ष्मीस्तं महिदासं जनार्दनम्",
 "ait_seq24_u01_padya_p06_9dec92": "तूलभूतं तदन्यत् तु पिता ह्येष जनार्दनः",
 "ait_seq24_u01_padya_p10_14c897": "यथा यदव इत्येव रघवः कुरवस्तथा",
 "ait_seq24_u01_padya_p14_2d0727": "आप इत्येव देवानां सर्वेषां प्रददौ हरिः",
 "ait_seq24_u01_padya_p18_710111": "जानन् नित्योदितज्ञानादाह देवीमिदं वचः",
 "ait_seq24_u01_padya_p22_2429aa": "मयैतानि प्रदत्तानि पदानि ब्रह्मपूर्वकाः",
 "ait_seq24_u01_padya_p26_059cc9": "गिरणात् सर्वभूतानां चक्षुर्नामास्य दर्शनात्",
 "ait_seq24_u01_padya_p30_3905b1": "य एवं वेद तं विष्णुमापरोक्ष्येण शाश्वतम्",
 "ait_seq24_u01_padya_p34_ab8184": "प्रकृष्टानन्दरूपत्वात् प्राण इत्यभिधीयते",
 "ait_seq24_u01_padya_p38_cbdc1d": "उपासते तं वाय्वाद्या देवास्तस्माच्च तेऽखिलाः",
 "ait_seq24_u01_padya_p42_a2b3e8": "भूःशब्दार्थो भूतिरिति वैपरीत्येन चासुराः",
 "ait_seq24_u01_padya_p46_fe6bc0": "य एवं वेद तं विष्णुं भूतिदं भूतिरूपिणम्",
 "ait_seq24_u01_padya_p50_0887a4": "स एष भगवान् विष्णुर्मृत्युदो मोक्षदस्तथा",
 "ait_seq24_u01_padya_p54_2b0ed5": "तदा मृत्युप्रदश्चायं मुक्तानामपि जीवनम्",
 "ait_seq24_u01_padya_p58_9193b3": "अनेन हरिणा यस्मान्नियतो न पराग् भवेत्",
 "ait_seq24_u01_padya_p62_a4f35a": "नानागती तु तावेतौ वायुः प्राप्नोति केशवम्",
 "ait_seq24_u01_padya_p66_0a0e38": "ऊर्ध्वं गच्छति देवः स देहोऽधः पतति क्षितौ",
 "ait_seq24_u01_padya_p70_ddbb80": "स मुक्तो लोकमाप्नोति विष्णोर्मुक्तैश्च दृश्यते",
 "ait_seq24_u01_padya_p74_de7694": "नासिकायां यन्नेत्रयोर्मध्ये",
 "ait_seq24_u02_padya_p01_f55792": "दैर्घ्यं प्लुतं च हिङ्कारो बिन्दुरप्यवधारणे",
 "ait_seq24_u04_padya_p02_2341ed": "स्वरूपतोऽपि नैव स्याद् भेदोऽत्यल्पोऽपि यत्र हि",
 "ait_seq24_u04_padya_p06_86166d": "प्रकाशयेद् यतो विष्णुः सर्वत्राप्यविशेषवान्",
 "ait_seq24_u06_padya_p01_a20f6b": "संहितायां यत्र दैर्घ्यं पदे यत्र न विद्यते",
 "ait_seq24_u07_padya_p03_ae955f": "स्थानान्तरेऽन्येषामप्यधिदैवत्वकथनं कर्मजदेवाद्यपेक्षया",
 "ait_seq24_u10_padya_p01_febf0b": "लोमसूष्णिक्",
 "ait_seq24_u14_padya_p01_7680dd": "स च्छन्दोभिश्छन्नः",
 "ait_seq24_u18_padya_p01_397900": "अङ्गेषु यस्य च्छन्दांसि देवा लोका मखा अपि",
 "ait_seq24_u19_padya_p03_da12fa": "एतमुद्दिश्य जीवानां पुण्यकर्म कर्तुम्",
 "ait_seq24_u19_padya_p07_66a159": "नच जीववागादिना पृथिव्यग्न्यादिकं सृष्टमित्यत्र किञ्चिन्मानमस्ति",
 "ait_seq24_u21_padya_p03_f11341": "नच मुख्यकारणाङ्गीकारेऽविरोध औपचारिकं कारणमङ्गीकर्तुं युक्तम्",
 "ait_seq24_u22_padya_p01_a74784": "वाचं पितरम्",
 "ait_seq24_u24_padya_p03_ab7280": "देवानां कर्मणैवैते जायन्ते सर्वमानुषाः",
 "ait_seq24_u27_padya_p01_97a524": "इति तु सर्वस्य वचनस्य तदीयत्वज्ञापनार्थम्",
 "ait_seq24_u29_padya_p01_9b13e3": "इत्यादि",
 "ait_seq65_u01_gadya_p03_8c2296": "स जीवो यद्यपि भगवत्प्रसादात् सर्वलोकाधिपो भवति",
 "ait_seq71_u01_padya_p04_7d7c6e": "जगत्यादिकं त्वधिकत्वेऽपि बृहतीवन्माहात्म्याभावादेवोपेक्ष्यते",
 "ait_seq71_u03_padya_p04_813621": "ऋचा वाक् ऋग्रूपेण वाग् ऋतं स्पृष्टा सत्यरूपं विष्णुं स्पृष्टा भवति",
 "ait_seq71_u03_padya_p08_dec32a": "तस्माद् विष्णोरेव प्रतिमा बृहतीसहस्रम्",
 "ait_seq71_u03_padya_p12_60834a": "विष्णुरेव बृहत्याः प्राणस्याधिष्ठातृदेवता",
 "ait_seq71_u03_padya_p16_f21fcf": "बृहतीस्थविष्णोर्बलादेव तत् सम्पद्यते",
 "ait_seq71_u09_padya_p02_afbd44": "स्रक्तयो विभागाः",
 "ait_seq71_u13_padya_p01_4d6599": "इत्यादि ब्रह्मसारे",
 "ait_seq71_u15_padya_p03_62cddd": "तस्मान्मूलत्वादकारार्थोऽपि ज्ञेय एव",
 "ait_seq71_u15_padya_p07_6c0642": "तस्माद् द्रव्यदानं ज्ञानदानं वा काले पात्राद्यनुसारेणैव कुर्यात्",
 "ait_seq71_u15_padya_p11_de2222": "अकारस्यार्थरूपः सन्नेव च भगवांस्तमेवोङ्कारो वक्ति",
 "ait_seq71_u15_padya_p15_ad567a": "तथाऽप्यकारस्य नकारस्य चैकार्थत्वान्मूलभूतश्च",
 "ait_seq73_u03_padya_p02_401288": "तदिदं बृहतीसहस्रं तद्यशः तस्य नारायणस्य यशः",
 "ait_seq73_u05_padya_p01_4cd9aa": "इति धातोश्च तस्यैव हि परमैश्वर्यम्",
 "ait_seq73_u07_padya_p02_b6d946": "नचेन्द्रं विष्णुं चेति पृथगन्वयः क्रियते",
 "ait_seq73_u07_padya_p06_1f820c": "तस्मात्",
 "ait_seq73_u11_padya_p01_080568": "इति चोक्तम्",
 "ait_seq73_u15_padya_p02_f53089": "महत्त्वं च तस्यादितिपुत्रत्वेऽग्रजत्वमात्रं नतु सामर्थ्यतः",
 "ait_seq73_u19_padya_p02_5b4471": "इन्द्रश्च यजमानः",
 "ait_seq73_u21_padya_p02_b47225": "वायुना सह ग्रहमाप",
 "ait_seq73_u27_padya_p01_6b6cf5": "इत्यादि च",
 "ait_seq73_u27_padya_p05_e33e75": "किन्तु",
 "ait_seq73_u29_padya_p04_0d12f6": "भिन्नपदार्थत्वात्",
 "ait_seq73_u33_padya_p04_325a02": "लोक्यत इति स्वरूपवाची लोकशब्दः",
 "ait_seq73_u37_padya_p01_476b6a": "इत्यादिवत्",
 "ait_seq73_u39_padya_p03_7f9943": "केन स्वरूपेण भूमिष्ठेनात्मन एव स्त्रीरूपेण विष्णुः सम्बध्यते",
 "ait_seq73_u39_padya_p07_fa150f": "तानि भूमिष्ठत्वेन दिविष्ठत्वेन द्विविधत्वात् तावित्युच्यन्ते",
 "ait_seq73_u39_padya_p11_d28feb": "नच लौकिकस्त्रीपुरुषसम्बन्धमात्रमत्रोच्यते",
 "ait_seq73_u43_padya_p02_68cb8a": "यदक्षरं पञ्चविधं समेति",
 "ait_seq75_u01_padya_p03_59b27d": "तदेतत् सत्यस्य सत्यं नारायणाख्यं ब्रह्म यत्रानुयुज्यते यस्मिन् स्वरूप",
 "ait_seq75_u01_padya_p07_aac0e6": "नायमेकीभावो नाम स्वरूपैक्यम्",
 "ait_seq75_u04_padya_p03_28491f": "एकः पुरुषोऽपि यदा द्विधा भूत्वा एकीभवतीत्युच्यते तदाऽपि स्थानैक्यमेव",
 "ait_seq75_u04_padya_p07_67a86b": "तस्माद् भावसहित एकशब्दो न स्वरूपवाची",
 "ait_seq75_u08_padya_p01_ebbdb1": "इति परामर्शं कृत्वा",
 "ait_seq75_u08_padya_p05_90f38a": "तात्पर्यार्थं तस्यैवार्थस्य पुनरभ्यासः",
 "ait_seq75_u08_padya_p09_51a226": "यस्मिन् विष्णौ नामानि ज्ञात्वा तस्मिन् ज्ञाने परिपक्वे समतृप्यन्",
 "ait_seq75_u10_padya_p02_34fc66": "अस्त्री पुमान् ब्रुवन् अस्त्री पुमांसं ब्रुवन्",
 "ait_seq75_u14_padya_p04_5c3853": "वदन्नेव न वदति",
 "ait_seq75_u22_padya_p01_6087b1": "इत्याद्यर्धनारीनारायणतन्त्रे",
 "ait_seq75_u24_padya_p02_873a0f": "तत्रागतमहमिति",
 "ait_seq75_u24_padya_p06_1090bb": "दृष्टसम्बन्धित्वाददृष्टं सर्वमपि प्रस्तुतं भवति",
 "ait_seq75_u24_padya_p10_3e3f52": "विष्णोरङ्गीकारे त्वभावताऽन्यता विरोधितेति त्रयोऽप्यर्थाः सम्यगेव सिद्ध्यन्ति",
 "ait_seq75_u24_padya_p14_c605ae": "नत्व इत्येव केनचित् क्वचित्",
 "ait_seq75_u24_padya_p18_05ed23": "नच दोषयुक्तस्य पूर्णता",
 "ait_seq75_u24_padya_p22_1dc666": "अः इति पृथक्त्वेन वचनं तत्सममधिकं वा किमपि नास्तीति दर्शयितुम्",
 "ait_seq75_u26_padya_p04_9f74eb": "तत्राकारस्य पूर्णवाचित्वेऽहमेव सोऽकारवाच्य इत्याह महिदासरूपो भगवान् नारायणः",
 "ait_seq75_u26_padya_p08_0c8cda": "दर्शयितुं च अः इति पृथग् वचनम्",
 "ait_seq75_u28_padya_p03_420d42": "तदाऽर्थत्रयकल्पनस्य वैयर्थ्यात्",
 "ait_seq75_u34_padya_p01_9e8495": "इत्यर्धनारीनारायणतन्त्रे",
 "ait_seq75_u36_padya_p02_7510d6": "पुमांसं स्त्रियं च वदन्नेव न वदतीत्युक्तत्वादुभयात्मकं रूपं प्रतीयते",
 "ait_seq75_u36_padya_p06_51638b": "अतो नपुंसके वदन्नपि न वदतीति न तद्वदनुषज्यते",
 "ait_seq75_u38_padya_p03_bc4400": "भवतीतिपदाभावादनकाममार इति भगवन्नामैवेति ज्ञायते",
 "ait_seq75_u44_padya_p01_9c1d36": "इत्याद्यैतरेयसंहितायाम्",
 "ait_seq75_u44_padya_p05_c511f4": "नच सूर्यरथोऽत्र वर्ण्यते",
 "ait_seq75_u44_padya_p09_9eebd7": "चतुरश्वत्वं चात्रोच्यते",
 "ait_seq75_u46_padya_p04_3c674b": "अस्मिन् पक्षे तु लौकिकाहर्व्यावृत्त्यर्थं सुदिने इति युज्यते",
 "ait_seq75_u50_padya_p01_10a562": "इति वचनात्",
 "ait_seq75_u50_padya_p05_6090a8": "नह्यश्विरथयोगादहनी जायेते",
 "ait_seq75_u56_padya_p01_6b5c51": "इत्यादिना तस्यैव प्रस्तावाच्च",
 "ait_seq186_u01_padya_p03_797130": "निर्भुजं वदन्तमित्यादि त्ववस्थामात्रदर्शनम्",
 "ait_seq186_u03_padya_p03_c79750": "प्राणस्य विष्णोः प्रियत्वं तव न प्राप्स्यतीति",
 "vtn_seq40_u06_padya_p01_ea9494": "इति महावाराहे",
 "vtn_seq40_u06_padya_p05_8fb0b0": "नच घटादिवत् संस्कारमात्रत्वं वक्तुं युक्तम्",
 "vtn_seq73_u01_padya_p02_b94432": "आगमोऽदुष्टवाक्यं च स्वदृक् चानुभवः स्मृतः",
 "vtn_seq73_u01_padya_p06_c9481f": "याथार्थ्यमेव प्रामाण्यं तन्मुख्यं ज्ञानशब्दयोः",
 "vtn_seq73_u01_padya_p10_8c072a": "प्राबल्यमागमस्यैव जात्या तेषु त्रिषु स्मृतम्",
 "vtn_seq76_u01_padya_p03_68fbf5": "यात्यतो युक्तिरेवैका प्रमाणमनुमात्मकम्",
 "vtn_seq76_u01_padya_p07_9f7cbf": "प्रतिज्ञा हेतुगर्भैव पृथक् प्रामाण्यमेष्यति",
 "vtn_seq76_u01_padya_p11_d93540": "व्याप्तिस्तु केवलाऽपि स्यात् प्रमाणं नियमाश्रयात्",
 "vtn_seq78_u01_padya_p02_3d82ff": "उपपत्तिदोषा विज्ञेया विरोधश्च स्वतोऽन्यतः",
 "vtn_seq80_u01_padya_p01_8a8e34": "अर्थतः प्राप्तिरेवार्थापत्तिरित्यभिधीयते",
 "vtn_seq80_u01_padya_p05_4609e0": "एकं तत्रानुभवतो योग्यस्यानुपलब्धितः",
 "vtn_seq80_u01_padya_p09_76d004": "झटित्येव परिज्ञानान्न लिङ्गोद्भवता मता",
 "vtn_seq170_u04_padya_p03_22e2de": "वृक्षस्य रसोऽस्म्यमुष्याहं वृक्षस्य रसोऽस्मीत्येवमेव खलु सोम्येमाः सर्वाः प्रजाः",
 "vtn_seq170_u04_padya_p07_fa1c23": "मशको वा यद्यद् भवन्ति तत् तदा भवन्ति",
 "vtn_seq170_u05_padya_p06_3c0c46": "वराहो वा कीटो वा पतङ्गो वा दंशो वा",
 "vtn_seq170_u07_padya_p03_d6548e": "भगव इति किमत्र पश्यसीति न किञ्चन भगव इति",
 "vtn_seq170_u10_padya_p02_691211": "तेजः परस्यां देवतायां तावन्न जानाति",
 "vtn_seq172_u03_padya_p02_d850e0": "इह व्याघ्रो वा सिंहो वा",
 "vtn_seq174_u06_padya_p02_c248c6": "अपीत इत्यपि प्रवेशमात्रम्",
 "vtn_seq186_u02_padya_p02_bad483": "अन्यं सन्तं परमात्मानं स्वयमिति मन्यमानः स्तेन एवेति",
 "vtn_seq219_u07_padya_p03_300d6d": "सर्वं विजानाति तं च केन विजानीयाद् विज्ञातारमरे केन विजानीयात्",
 "vtn_seq250_u02_padya_p02_6210fb": "प्रपञ्चो यदि विद्येत भवेत उत्पद्येत",
 "vtn_seq250_u02_padya_p06_a865d1": "प्रकृष्टः पञ्चविधो भेदः प्रपञ्चः",
 "vtn_seq250_u02_padya_p10_e4e301": "सैव मानत्राणकर्त्री यस्य तन्मायामात्रम्",
 "vtn_seq250_u04_padya_p01_c735bc": "इति व्यपदेशः कथम्? इत्यत आह- अद्वैतं परमार्थत इति",
 "vtn_seq250_u06_padya_p01_115d5a": "इति व्यर्थं स्यात्",
 "vtn_seq250_u08_padya_p02_5a7969": "निवर्तत इत्यङ्गीकारे निवर्तेत विद्येतेति च प्रसङ्गरूपेण कथनं यदिशब्दौ",
 "vtn_seq250_u08_padya_p06_ebb99f": "अत उपदेशादयं वादोऽज्ञाते द्वैतं न विद्यत इत्याह",
 "vtn_seq252_u05_padya_p02_a7f040": "न संवसेत् प्राकाश्या ह्येते तस्करा अर्स्वग्या इति ह्याह- ‘नैरात्म्यवादकुहकैर्मिथ्यादृष्टान्तहेतुभिः",
 "gb_2_14d_u01_padya_p02_eae89c": "प्रत्यक्षविरोधात्",
 "gb_2_17b_u16_padya_p01_295072": "इति परमश्रुतिः",
 "gb_2_17b_u40_padya_p01_f0dbf9": "इत्यादिश्रुतिभ्योऽर्थान्तरस्यैवावगतत्वात्",
 "gb_2_17b_u40_padya_p05_6267b1": "नवकृत्वोऽपि भेद एव दृष्टान्तोक्तेश्च",
 "gb_2_17b_u42_padya_p03_933018": "त्वमपि तदैतदात्म्यमेवासि न सोऽसीति वा",
 "gb_2_17b_u46_padya_p01_5d57d7": "इत्यादिवाक्यं परिहारे विशेषयुक्तिं च विना न दृष्टः",
 "gb_2_17b_u53_padya_p02_9e7e03": "नचेश्वरस्तद्भेदो वा प्रत्यक्षादिसिद्धः",
 "gb_2_17b_u53_padya_p06_9c1b00": "मिथ्याविशेषोक्तौ चाप्रामाण्यं श्रुतेः",
 "gb_2_17b_u53_padya_p10_593c22": "सत्योपाधिपक्षेऽपि हस्तपादाद्युपाधिभेदेऽपि भोक्तुरेकत्वदृष्टेरेकेनैवेश्वरेण सर्वोपाधिगतं सुखं दुःखं भुज्येतेत्येवमादयो दोषाः समा एव",
 "gb_2_39_u02_padya_p02_0a4310": "युज्यतेऽनेनेति योगस्तदुपायः",
 "gb_2_39_u06_padya_p04_9eb4ec": "अत्र तु युद्धविधानाच्च",
 "gb_3_17_u10_padya_p01_cc313a": "इत्यभिधानम्",
 "gb_3_17_u11_padya_p01_0b8c51": "तस्मात् कर्म समाचर",
 "gb_3_17_u14_gadya_p01_a7d561": "इति भविष्यत्पर्ववचनाच्च नार्जुनस्यामुख्याधिकारिता",
 "gb_7_7_u18_padya_p01_e7cdda": "मत्तोऽन्यत् परतरं नास्ति",
 "gb_7_7_u26_padya_p02_fca9fa": "आप्नोति विष्णुमित्येवात्मशब्दो ज्ञानिनि",
 "gb_7_7_u31_padya_p04_de9434": "वासुदेवः सर्वमिति पूर्णमिति",
 "gb_7_27_u04_padya_p03_461317": "तद्विषयो मोहो द्वन्द्वमोहः",
 "gb_10_42b_u02_padya_p01_2c6f7d": "इति वक्ष्यमाणस्याधिकफलत्वज्ञापकमेव",
 "gb_11_1_u20_padya_p03_b29e2d": "तत एव चिदानन्दाद्यात्मकत्वं च सिद्धम्",
 "gb_11_1_u30_padya_p02_7b8e16": "हरस्याङ्गविशेषेषु देवाः सर्वेऽपि संस्थिताः",
 "gb_13_13_u08_padya_p01_0a6973": "इति स्वज्ञेयत्वाज्ज्ञेयम्",
 "gt_2_55_u02_padya_p01_cbdbfd": "गमनादिप्रवृत्तिर्नात्यभिसन्धिपूर्विका",
 "gt_2_55_u04_padya_p03_3393cc": "प्रारब्धकर्मणेषत्तिरोहितब्रह्मणो वासनया प्रायोऽल्पाभिसन्धिपूर्विका प्रवृत्तिः सम्भवतीत्याशयवान् परिहरति",
 "gt_2_55_u06_padya_p01_e90db8": "इत्युक्तेस्तामिच्छन्ति",
 "gt_2_55_u07_padya_p02_bf63aa": "उद्भवाभिभवौ ज्ञाने ततोऽन्येभ्यो विलक्षणाः",
 "gt_2_55_u08_padya_p04_f89694": "नचात्र समाधिं कुर्वतो लक्षणमुच्यते",
 "gt_2_55_u10_padya_p03_6c872e": "असम्प्रज्ञातसमाधेः",
 "gt_2_55_u11_padya_p02_c396cb": "ज्ञानिनां ज्ञाननिर्धूतमलानां देवसंश्रयात्",
 "gt_2_55_u12_padya_p04_0c7a2c": "विरोधश्चोच्यते",
 "gt_2_55_u14_padya_p03_ed52bc": "पुरुषवैशेष्यात्",
 "gt_2_55_u15_padya_p01_8d55a8": "विषयांस्तु परित्यज्य रामे स्थितिमतस्ततः",
 "gt_3_34_u02_padya_p01_b1025b": "तथाऽपि शक्तितो निग्रहः कार्यः",
 "gt_3_34_u03_padya_p02_72baa3": "तथाऽपि सोऽन्यथा कर्तुं शक्यतेऽतिप्रयत्नतः",
 "gt_12_1_u14_padya_p01_d7bc56": "चतुःशिखण्डा युवतिः सुपेशा घृतप्रतीका वयुनानि वस्ते",
 "gt_16_1_u04_padya_p02_a5fb88": "तपः ब्रह्मचर्यादि",
 "gt_16_1_u07_padya_p01_141a83": "परोपद्रवहेतूनां दोषाणां पैशुनं वचः",
 "gt_16_1_u09_padya_p01_7290d2": "रागो लौल्यं तथा रक्तिः",
 "gt_16_1_u12_padya_p01_cabd34": "इत्यभिधानात्",
 "gt_16_11_u09_padya_p01_e3e06b": "मामात्मपरदेहेष्विति",
 "gt_16_11_u10_padya_p02_dae0f8": "अद्येति वादिनं ब्रूयात् सदाऽधो यास्यसीति ह",
 "gt_18_67b_u01_padya_p01_4245c2": "पूर्णादोषमहाविष्णोर्गीतामाश्रित्य लेशतः",
 "tvk_seq14_u01_padya_p04_e875c0": "एषां विकारोऽनित्यः स्यात्",
 "tvk_seq18_u01_padya_p04_018a2e": "खण्डितं रूपमेवात्र विकारोऽपि विकारिणः",
 "uk_seq5_u01_padya_p03_0e60dd": "चेष्टालिङ्गेन सात्मत्वे परदेहस्य साधिते",
 "uk_seq5_u01_padya_p07_3c736a": "सार्वज्ञादिगुणा विष्णोः श्रुतिषु प्रतिपादिताः",
 "uk_seq11_u05_padya_p01_41e35d": "इति श्रुत्या भिन्नजीवदृशं गतः",
 "tdy_seq72_u01_padya_p01_e139c1": "नचोपाधिभेदमात्रेणेश्वरस्य दुःखाभावः",
 "tsk_seq12_u01_padya_p03_f3ee76": "स्पृष्टदुःखा विमुक्ताश्च दुःखसंस्था इति द्विधा",
 "tsk_seq12_u01_padya_p07_a61bff": "इति द्विधा मुक्त्ययोग्या दैत्यरक्षःपिशाचकाः",
 "man_seq1_u02_padya_p01_856792": "ध्यायन् नारायणं देवं प्रणवेन समाहितः",
 "kat_seq11_u05_padya_p02_7f8dbc": "अनेकरूपां सुवर्णमयीम्",
 "kat_seq11_u11_padya_p02_ca1817": "भगवतो ह्युरुगायनाम प्रसिद्धम्",
 "kat_seq11_u13_padya_p02_cd6c70": "नच मुख्ये सत्यमुख्यार्थो युज्यते",
 "kan_seq288_u06_padya_p02_28c751": "प्रत्यैरयतं प्रतिसमधत्तम्",
 "kan_seq288_u06_padya_p06_229b40": "सनये लाभाय",
 "kan_seq288_u06_padya_p10_9e82be": "तदाऽश्विभ्यां पाव इत्युक्त्वा तच्छिरश्छित्वाऽन्यत्र निधायाश्वशिरः सन्धितम्",
 "knr_seq35_u02_padya_p02_24aaac": "उपो इतिवदतिशयार्थ ओकारः",
 "knr_seq35_u04_padya_p04_c9530b": "अन्येषामिन्द्रियाणां पराङ्मुखत्वान्नह्यान्तरं जानन्ति",
 "knr_seq35_u06_padya_p02_cce7c4": "बाह्यज्ञाय ज्ञानिने आन्तरज्ञाय ज्ञानिने इत्यभ्यासो हि तात्पर्यार्थः",
 "knr_seq35_u06_padya_p06_5e6f08": "उपेहि इति वा",
 "isa_seq20_u01_padya_p05_b45b25": "तेऽनिन्दयाऽयथार्थस्य दुःखाज्ञानादिरूपिणः",
 "bt_3_11_12_u04_padya_p11_5a63e7": "इत्याचक्षते काल इत्याचक्षते",
 "bt_10_40_15_u04_padya_p02_3eb631": "भिन्धि दुःखं तमोऽरतिम्",
 "bt_10_40_15_u04_padya_p06_1a1693": "परशक्तिः परश्रीः परयशाः परप्रवृत्तिः नित्यमेव",
 "bt_10_40_15_u04_padya_p10_0630e0": "ते स्युः प्रभो विभो समास्व व्यास्वोत्तिष्ठ प्रचर विचर",
 "bt_10_40_17_u03_padya_p03_8a3bfb": "परावरेशेश पदं भजन्तः परं परानन्दमनारतं ते",
 "bt_10_40_19_u10_padya_p04_4fd93f": "प्राणमितरा देवताः न प्राणादपरः परमानन्दी भवति तस्मादाहुः प्राणः पद्धतिः",
 "bt_10_40_19_u13_padya_p04_64bc7b": "तदूर्ध्वमुदसर्पत्ता ऊरू अभवतामुरु गृणीहित्यब्रवीत्तदुदरमभवदुर्वेव मे कुर्वित्यब्रवीत्तदुरोऽभवदुदरं ब्रह्मेति शार्कराक्ष्या उपासते",
 "bt_10_40_19_u13_padya_p08_e1a4c2": "एवमेतच्छिरसः शिरस्त्वं वेद",
 "bt_11_17_5_u03_padya_p02_16827c": "मन्त्राः कर्म लोकाः लोकेषु नाम च"
}