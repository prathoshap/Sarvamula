  "units": [
   {
    "type": "padya",
    "padas": [
     "दुःखस्पृष्टं तदस्पृष्टमिति द्वेधैव चेतनम्",
     "नित्यादुःखा रमाऽन्ये तु स्पृष्टदुःखाः समस्तशः",
     "स्पृष्टदुःखा विमुक्ताश्च दुःखसंस्था इति द्विधा",
     "दुःखसंस्था मुक्तियोग्या अयोग्या इति च द्विधा",
     "देवर्षिपितृपनरा इति मुक्तास्तु पञ्चधा",
     "एवं विमुक्तियोग्याश्च तमोगाः सृतिसंस्थिताः",
     "इति द्विधा मुक्त्ययोग्या दैत्यरक्षःपिशाचकाः",
     "मर्त्याधमाश्चतुर्धैव तमोयोग्याः प्रकीर्तिताः",
     "ते च प्राप्तान्धतमसः सृतिसंस्था इति द्विधा"
    ],
    "text": "दुःखस्पृष्टं तदस्पृष्टमिति द्वेधैव चेतनम् नित्यादुःखा रमाऽन्ये तु स्पृष्टदुःखाः समस्तशः स्पृष्टदुःखा विमुक्ताश्च दुःखसंस्था इति द्विधा दुःखसंस्था मुक्तियोग्या अयोग्या इति च द्विधा देवर्षिपितृपनरा इति मुक्तास्तु पञ्चधा एवं विमुक्तियोग्याश्च तमोगाः सृतिसंस्थिताः इति द्विधा मुक्त्ययोग्या दैत्यरक्षःपिशाचकाः मर्त्याधमाश्चतुर्धैव तमोयोग्याः प्रकीर्तिताः ते च प्राप्तान्धतमसः सृतिसंस्था इति द्विधा",
    "opens_pranava": false,
    "raw": "दुःखस्पृष्टं तदस्पृष्टमिति द्वेधैव चेतनम्। नित्यादुःखा रमाऽन्ये तु स्पृष्टदुःखाः समस्तशः॥ ॥ स्पृष्टदुःखा विमुक्ताश्च दुःखसंस्था इति द्विधा। दुःखसंस्था मुक्तियोग्या अयोग्या इति च द्विधा॥ ॥ देवर्षिपितृपनरा इति मुक्तास्तु पञ्चधा। एवं विमुक्तियोग्याश्च तमोगाः सृतिसंस्थिताः॥ ॥ इति द्विधा मुक्त्ययोग्या दैत्यरक्षःपिशाचकाः। मर्त्याधमाश्चतुर्धैव तमोयोग्याः प्रकीर्तिताः॥ ॥ ते च प्राप्तान्धतमसः सृतिसंस्था इति द्विधा।",
