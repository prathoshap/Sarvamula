{
 "uk_seq5_u01_padya_p04_6f957e": "अन्यत्वं स्वात्मनस्तस्मात् सर्वैरेवानुभूयते",
 "uk_seq5_u02_padya_p01_be7026": "सत्यः सो अस्य महिमा",
 "uk_seq11_u05_padya_p02_5fbbc3": "भिन्नत्वेनात्मसादृश्यदो",
 "uk_seq5_u01_padya_p05_250fd5": "अज्ञता चाल्पशक्तित्वं दुःखित्वं स्वल्पकर्तृता",
 "uk_seq5_u03_padya_p01_96a029": "इत्यादिवाक्यान्मृषा नच",
 "uk_seq11_u07_gadya_p01_11ef1e": "इति श्रुतेः सदा",
 "uk_seq5_u01_padya_p06_f5b65d": "सर्वज्ञतादीशगुणविरुद्धा ह्यनुभूतिगाः",
 "uk_seq5_u03_padya_p02_8626c8": "नच वेदोक्तमिथ्यात्वे मानं तन्मानताऽपि न",
 "uk_seq14_u01_gadya_p03_af5386": "तत्त्वप्रकाशिकापरनामकं सम्पूर्णम्",
 "uk_seq5_u01_padya_p03_0e60dd": "चेष्टालिङ्गेन सात्मत्वे परदेहस्य साधिते",
 "uk_seq5_u01_padya_p07_3c736a": "सार्वज्ञादिगुणा विष्णोः श्रुतिषु प्रतिपादिताः",
 "uk_seq11_u05_padya_p01_41e35d": "इति श्रुत्या भिन्नजीवदृशं गतः"
}