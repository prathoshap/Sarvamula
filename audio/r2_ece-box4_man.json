{
 "gt_12_13_u08_padya_p02_6abf57": "हर्षादिभिर्मुक्त इत्युक्ते कादाचित्कमपि भवतीति",
 "gt_12_13_u10_padya_p03_342b56": "आधिक्यज्ञापनार्थं भक्त्यभ्यासः",
 "gt_14_9_u09_padya_p02_b21f5e": "अल्पसुखं दुःखम्",
 "gt_14_9_u10_padya_p02_8f1465": "सुखिनो दुःखिन इत्याचक्षते",
 "nvv_seq342_u02_padya_p01_5aa574": "नच गुर्वधीनत्वे ज्ञानमोक्षयोर्ज्ञानिनोऽपि कदाचित् गुरुकोपाज्ज्ञानपराभावेनामुक्तिप्रसङ्गान्न गुर्वधीनत्वमिति",
 "nvv_seq342_u02_padya_p04_2245fa": "इति वचनान्मुक्तिदूषणेनैव गुरुकोपादेः कृतार्थत्वात्",
 "nvv_seq358_u02_padya_p02_f75a5c": "अनादितो गुणाः सन्तो भक्त्याद्या नह्यमूमुचन्",
 "nvv_seq358_u02_padya_p05_68cb11": "भक्तिवाक् करणत्वेन सावकाशेशवागथ",
 "nvv_seq427_u02_padya_p01_e29513": "नच सत्यसङ्कल्पत्वादेरीश्वरसङ्कल्पाद्यनुसारित्वनियमे संसारसमानधर्मत्वं मुक्तेरिति वाच्यम्",
 "nvv_seq427_u02_padya_p04_ca3154": "मुक्तस्य पारतन्त्र्येऽपि तारतम्येऽप्यतः सुखी",
 "nvv_seq439_u02_padya_p02_69525c": "यान्ति देवं परं केचित् पूर्वं केचिल्लये विभुम्",
 "nvv_seq439_u02_padya_p05_a6752b": "नच परब्रह्मण एव ब्रह्मशब्दमुख्यार्थत्वेन प्रथमप्राप्तत्वादपोहायुक्तेस्तस्यैव प्राप्तिनियमः",
 "nvv_seq439_u02_padya_p08_1d1b82": "क्रमानुरागी भगवान् क्रमात् पुम्भिरवाप्यते",
 "nvv_seq439_u02_padya_p11_1a77cc": "इति भगवतः क्रमानुरागित्वश्रुतेः",
 "nvv_seq439_u02_padya_p14_c00a86": "सप्रतीकाश्चतुर्मुखमप्रतीकाः परममु हैते गच्छन्त्यागच्छन्ति च चतुर्मुखात् परमं पराच्चतुर्मुखं",
 "spr_seq8_u02_padya_p01_9019b2": "तस्मै स होवाच",
 "spr_seq8_u02_padya_p04_c6e352": "वयमेतद् बाणमवष्टभ्य विधारयाम इति",
 "bsb_2_1_27_u02_padya_p01_21f44c": "कृत्स्नप्रसक्तिर्निरवयवत्वशब्दकोपो वा",
 "bsb_2_1_27_u02_padya_p04_1a1792": "नच तद् युज्यते",
 "bsb_2_1_27_u02_padya_p07_7fe311": "निरवयवत्वात्",
 "bsb_2_1_27_u04_padya_p03_4fe18c": "स एवांश उपहित इति द्वित्वापेक्षत्वात्",
 "vtn_seq127_u01_padya_p02_a26ed4": "तदा पदार्थे दृष्टे प्रायः सर्वतो वैलक्षण्यं तस्य न ज्ञायेत",
 "mbtn_gap0021_h0": "इत्येतत् पञ्चरात्रोक्तं पुराणेष्वनुमोदितम्",
 "mbtn_gap0180_h0": "ओमित्युवाच भगवांस्तदशेषमेव श्रुत्वा रहसि",
 "mbtn_gap0441_h0": "जित्वाऽवन्त्यौ नृपतींश्‍चैव सर्वानादाय तां प्रययौ वासुदेवः",
 "mbtn_gap0560_h0": "विप्रापहासात् कुत्सितयोनितस्ताः कन्यातीर्थे पाण्डवः सम्प्रमोच्य",
 "mbtn_gap0721_h0": "निहत्य तौ केशवो रौक्मिणेयं पुनर्वैदर्भ्यां जनयामास सद्यः",
 "mbtn_gap0872_h0": "तदैव कृष्णातनयाः समेता जघ्नुः शलं संयति सौमदत्तिम्",
 "mbtn_gap0976_h0": "इत्युक्तो द्रौणिरासीत् स तूष्णीं कर्णधनञ्जयौ",
 "mbtn_gap1153_h0": "प्रपेदिवान् पाण्डुसुताश्‍च कृष्णं प्रतीक्षमाणाः पृथिवीमशासन्",
 "bsb_seq76_u01_gadya_p03_e50581": "पादः",
 "bsb_seq149_u01_gadya_p03_e50581": "पादः",
 "bsb_seq251_u01_gadya_p03_e50581": "पादः",
 "bsb_seq318_u01_gadya_p03_e50581": "पादः",
 "bsb_seq408_u01_gadya_p03_e50581": "पादः",
 "bsb_seq512_u01_gadya_p03_e50581": "पादः",
 "bsb_seq639_u01_gadya_p03_e50581": "पादः",
 "bsb_seq780_u01_gadya_p03_e50581": "पादः",
 "bsb_seq886_u01_gadya_p03_e50581": "पादः",
 "bsb_seq1066_u01_gadya_p03_e50581": "पादः",
 "bsb_seq1114_u02_gadya_p01_d996fd": "इति ब्रह्मतर्के",
 "bsb_seq1117_u02_gadya_p01_041180": "इति च तुरश्रुतौ",
 "bsb_seq1183_u01_gadya_p03_e50581": "पादः",
 "bsb_seq1194_u02_gadya_p01_552f82": "इति भविष्यत्पर्वणि",
 "bsb_seq1194_u03_padya_p03_3449db": "कर्तव्यो नास्य हानेन कस्यचिन्मोक्ष इष्यते",
 "bsb_seq1233_u01_gadya_p02_16deef": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते चतुर्थाध्यायस्य प्रथमः",
 "bsb_seq1289_u01_gadya_p02_dc7abb": "किन्तु ज्ञानयोगिनः कर्मयोगिनश्च",
 "bsb_seq1289_u02_padya_p03_2972a9": "धूमो रात्रिस्तथा कृष्णः षण्मासा दक्षिणायनम्",
 "bsb_seq1289_u04_padya_p01_992ee2": "गत्यनुस्मरणाद् ब्रह्म चन्द्रं वा गच्छति ध्रुवम्",
 "bsb_seq1290_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_seq1330_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_seq1389_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_1_1_3_u02_padya_p02_eb153c": "शास्त्रयोनित्वात्",
 "bsb_2_1_14_u04_padya_p04_ddd345": "नह्यन्यस्यान्यत्वं युज्यत इति चेत्",
 "bsb_3_1_4_u04_padya_p01_21f586": "इत्यादिश्रुतेर्न प्राणानां जीवेन सह गतिरिति चेत्",
 "bsb_3_3_59_u02_padya_p03_f6e23a": "दीक्षाप्रायणीयोदयनीयसवनत्रयावभृथात्मकः क्रतुः",
 "nvv_seq137_u02_padya_p02_a3b1d7": "स्वतन्त्रस्य च पूर्णगुणत्वनियमात्",
 "nvv_seq248_u02_padya_p05_4e4919": "इति वचनाच्च",
 "nvv_seq304_u02_padya_p01_5be4ef": "प्रियशिरस्त्वादीनामानन्दादिविशेषत्वेनैव दर्शनात् तेषामपि सर्वोपसंहार्यत्वमिति न मन्तव्यम्",
 "nvv_seq336_u02_padya_p12_4e4919": "इति वचनाच्च",
 "nvv_seq431_u02_padya_p06_aae660": "वचनप्रामाण्यात्",
 "ait_seq12_u01_padya_p15_e70623": "मुखनासाचक्षुषां तद्भोग्यमन्नं हरेः श्रुतम्",
 "ait_seq16_u01_padya_p03_b3d46f": "यस्मात् प्रपेदे भगवान् प्रपदाच्चतुराननम्",
 "ait_seq16_u01_padya_p39_9eca65": "पुनस्ते प्राविशन् सर्वे वह्निसूर्यो शशी शिवः",
 "ait_seq18_u01_padya_p28_3b0028": "मदभीष्टं ममादातुं नैवेष्टे कश्चनाञ्जसा",
 "ait_seq20_u01_padya_p07_b4da4b": "य एतद् विष्णुवाचैव बद्धं नामाख्यदामभिः",
 "ait_seq20_u01_padya_p43_05250f": "स वायुः प्रकृतिश्चैव विष्टब्धौ केशवेन हि",
 "ait_seq24_u01_padya_p32_54e7af": "पराभवति पाप्माऽस्य द्वेष्टा निरयगः सदा",
 "ait_seq24_u01_padya_p68_cca215": "य एवं वेद तं वायुममृतं सर्वनायकम्",
 "ait_seq24_u16_padya_p01_efd91e": "ब्राह्मणोऽस्य मुखमासीत्",
 "ait_seq71_u01_padya_p02_67f74c": "अत आधिक्यात् बृहतीसम्पादनमेव वरम्",
 "ait_seq71_u15_padya_p09_9c7d3b": "अकारस्यादौ स्थितत्वेन च यथार्थरूपत्वात्",
 "ait_seq73_u19_padya_p04_b0dd5d": "अन्येन्द्रो हि",
 "ait_seq73_u39_padya_p13_d2100f": "भगवानेव ह्यत्र प्रस्तुतः",
 "ait_seq75_u14_padya_p02_3d41e1": "स्वतन्त्रो हि भगवान् तत्प्रेरित एव तं वदतीत्यभिप्रायः",
 "ait_seq75_u26_padya_p06_9c30cc": "अन्येषां सर्वेषां मदधीनत्वादल्पत्वादिति",
 "ait_seq75_u46_padya_p02_ac44c8": "नच रात्रौ सुदिनमिति प्रयोगो दृष्टः",
 "vtn_seq73_u01_padya_p04_a3c8b0": "द्विविधं बलवत्त्वं च बहुत्वाच्च स्वभावतः",
 "vtn_seq170_u04_padya_p01_ae01e4": "यथा सोम्य मधु मधुकृतो निस्तिष्ठन्ति नानात्ययानां वृक्षाणां रसानां",
 "vtn_seq222_u06_padya_p02_19dddb": "नहि भोगाभावो",
 "gb_2_14d_u01_padya_p04_b05595": "नच विपर्यये किञ्चिन्मानम्",
 "gb_2_39_u06_padya_p02_6843a8": "साङ्ख्यस्य निरीश्वरत्वादुक्तत्वाच्चेश्वरस्य",
 "gb_11_1_u20_padya_p01_1c1f2b": "इत्यादिरूपविशेषणाच्च रूपस्येश्वरसाक्षात्स्वरूपत्वम्",
 "gt_2_55_u10_padya_p05_8a444b": "तथाऽपि न तत्रैवेति नियमः",
 "gt_16_1_u08_padya_p01_d26b1e": "इत्यभिधानम्",
 "uk_seq5_u03_padya_p01_96a029": "इत्यादिवाक्यान्मृषा नच",
 "kan_seq288_u06_padya_p04_7fa0e1": "कक्ष्यं नारायणकवचम्",
 "bt_10_40_15_u04_padya_p04_3938bc": "जीवगुणा विसंवृताः अधिसंवृताः",
 "bsb_1_1_3_u07_padya_p02_86e29c": "शक्यत्वाच्चानुमानां सर्वत्र",
 "bsb_2_1_14_u04_padya_p08_802161": "तथाच श्रुतिः",
 "bsb_3_1_4_u06_padya_p02_daefdb": "ब्रह्माण्डे च",
 "bsb_3_4_27_u02_padya_p01_ee3945": "शमदमाद्युपेतः स्यात् तथाऽपि तु तद्विधेस्तदङ्गतया तेषामवश्यानुष्ठेयत्वात्",
 "nvv_seq143_u02_padya_p01_6a8a0c": "नच वियत उत्पत्तिमत्वेऽनुभूतियुक्तिबहुवाग्विरोधोऽस्ति",
 "nvv_seq262_u02_padya_p04_6bdb99": "इति श्रुतिमानात्",
 "nvv_seq316_u02_padya_p01_c93f81": "ब्रह्मणश्च ब्रह्माण्याश्च स्थानैक्यं गुणतारतम्यं च यथागुणोपासनं मुक्तावाधिक्यं न भवतीत्यत्र लिङ्गम्",
 "nvv_seq382_u02_padya_p04_99bab9": "विपरीतप्रवृत्तेस्तु तस्य ह्रासोऽधिकं भवेत्",
 "nvv_seq449_u02_padya_p04_9b38ec": "पूर्णैश्वर्याद् भगवान् वासुदेवो विरुद्धशक्तिर्नच दोषस्पृगीशः",
 "ait_seq12_u01_padya_p19_bae3b1": "तस्मात् तस्यार्क इति सा प्रोच्यते वैदिकैः पदैः",
 "ait_seq16_u01_padya_p07_b574b0": "अयादूर्ध्वं ततो विष्णुः प्रपदादूरुमत्र च",
 "ait_seq16_u01_padya_p43_2aa3d2": "उच्चत्वं च गुणाधिक्यं त्वमुच्चोऽसीति तेऽब्रुवन्",
 "ait_seq18_u01_padya_p32_b9a213": "मन्निषेधे न शक्तोऽस्ति प्रीता देवा हि मे सदा",
 "ait_seq20_u01_padya_p11_85b1fe": "योग्यश्चास्या उपासाया योग्यो ब्रह्मपदस्य यः",
 "ait_seq20_u01_padya_p47_845783": "इति विद्यात्",
 "ait_seq24_u01_padya_p36_f74012": "अज्ञानादिप्रदातृत्वात् स एवाभूतिनामकः",
 "ait_seq24_u01_padya_p72_6134c0": "ब्रह्म पन्थाः सत्यं कर्म इति तस्य नारायणस्य वासुदेवाद्याः",
 "ait_seq24_u19_padya_p01_1ad601": "इति च स्कान्दे",
 "ait_seq71_u03_padya_p02_53e904": "अष्टचतुरक्षराण्यनुष्टुप्",
 "ait_seq71_u15_padya_p13_a3b2c3": "यमर्थमकारो वक्ति तमेव वक्तीति",
 "ait_seq73_u25_padya_p01_bd5601": "इति धातोर्विशेषेण धारणपोषणकर्ता हि वेधाः",
 "ait_seq75_u01_padya_p01_00959d": "यन्नारायणादिरूपेण पञ्चविधमक्षरं परं ब्रह्म तत् स्वस्मिन्नेव स्त्रीपुंरूपेण समेति",
 "ait_seq75_u14_padya_p06_12b084": "तस्माद् वदत्येव",
 "ait_seq75_u28_padya_p01_1028a2": "इति",
 "ait_seq75_u48_padya_p01_415f84": "इति ज्ञानावस्थायां मुक्तौ भोगबाहुल्यकारणत्वात् साऽपि मुक्तिवत् सुदिनम्",
 "vtn_seq73_u01_padya_p08_196f82": "बल्येवानुभवस्तत्र निर्दोषं त्वक्षजादिकम्",
 "vtn_seq170_u04_padya_p05_747666": "त इह व्याघ्रो वा सिंहो वा वृको वा",
 "vtn_seq250_u02_padya_p04_877bc8": "नच निवर्तते",
 "gb_2_17b_u26_padya_p01_475266": "इत्यादि मोक्षानन्तरमपि भेदवचनेभ्यः",
 "gb_2_39_u08_padya_p01_b715db": "इति",
 "gb_11_1_u29_padya_p02_6e91e3": "कमलासने ब्रह्मणि स्थितं रुद्रम्",
 "gt_2_55_u12_padya_p02_6bd57c": "मनोगता हि कामाः",
 "gt_16_1_u10_padya_p02_8d0034": "अचापलं स्थैर्यम्",
 "uk_seq11_u07_gadya_p01_11ef1e": "इति श्रुतेः सदा",
 "kan_seq288_u06_padya_p08_f94f62": "स्तनयित्नुर्वृष्टिमिव",
 "bt_10_40_15_u04_padya_p08_85a627": "अनोऽस्यनन्तोऽसि सृजतो हि ते श्रुतयोऽनुवर्तन्ते नैवासृजतः",
 "bsb_1_1_31_u04_padya_p02_791a2b": "प्राणसंवादादि मुख्यप्राणलिङ्गम्",
 "bsb_2_1_32_u02_padya_p02_c815fc": "नच करणाभावादनुपपत्तिरिति युक्तम्",
 "bsb_3_3_4_u02_padya_p01_e172fe": "सलिलवच्च तन्नियमः",
 "bsb_4_1_4_u04_padya_p03_63283b": "ब्रह्मतर्के च",
 "nvv_seq193_u02_padya_p05_1321c9": "किं नाम न सृजेदेष येन शक्त्येदमावृतम्",
 "nvv_seq290_u02_padya_p04_5c1e32": "क्वचिद् ददाति क्वच नो ददाति नह्यानन्त्यात् कर्मणां भोगनाशः",
 "nvv_seq330_u02_padya_p02_2f7f73": "अधिकारानुसारित्वात् प्रयत्नस्य",
 "nvv_seq411_u02_padya_p06_4e4919": "इति वचनाच्च",
 "nvv_seq459_u02_padya_p09_d6812d": "मुक्तानां तु नियन्तारस्तेषां ब्रह्माऽस्य वै हरिः",
 "ait_seq12_u01_padya_p35_672dbe": "अन्ननामा स एवान्ने चेष्टयन् सर्वमास्थितः",
 "ait_seq16_u01_padya_p23_f8a7d5": "तत्र प्राणात्मना वायुर्मनोरूपेण शङ्करः",
 "ait_seq18_u01_padya_p12_ed341e": "मित्रो यमश्च वरुणः कुबेरश्च दिगीश्वराः",
 "ait_seq18_u01_padya_p48_ff235d": "तीति ब्रह्मा समुद्धिष्टः स एवान्नाभिमानवान्",
 "ait_seq20_u01_padya_p27_d934a1": "छन्दस्सु संस्थितो वायुर्वायौ च स जनार्दनः",
 "ait_seq24_u01_padya_p16_d28e05": "नारायणादिनामानि ददौ नान्यस्य केशवः",
 "ait_seq24_u01_padya_p52_6a12a8": "प्राणं नियमयत्यस्मिन् शरीरे पुरुषोत्तमः",
 "ait_seq24_u04_padya_p08_a24fd4": "नैश्वर्ये न बले चैव नानन्दादिगुणेष्वपि",
 "ait_seq24_u24_padya_p01_6ff10c": "मनुष्याणां तु यत् कर्म न देवोत्पत्तिकारणम्",
 "ait_seq71_u03_padya_p18_2d3f79": "वायुरेव यद् भगवन्नियतो नियामयति तस्मात्",
 "ait_seq73_u07_padya_p04_3ca048": "नहि सर्वेषां पृथङ् मत्सिशब्ददर्शन एकस्यैवान्यथात्वं युज्यते",
 "ait_seq73_u35_padya_p02_e1200f": "यच्छब्दः किंशब्दार्थे",
 "ait_seq75_u04_padya_p09_f45189": "किन्तु संसर्ग एव भवति",
 "ait_seq75_u24_padya_p12_afa51a": "एकदेशार्थत्वात्",
 "ait_seq75_u38_padya_p01_6bc841": "इति ब्रह्माण्डे",
 "ait_seq186_u03_padya_p01_1fe17e": "इति च",
 "vtn_seq76_u01_padya_p13_6a3b9e": "प्रामाण्यं यात्यनुभवो ज्ञापयत्युपपत्तिताम्",
 "vtn_seq172_u01_padya_p02_d850e0": "इह व्याघ्रो वा सिंहो वा",
 "vtn_seq250_u06_padya_p03_a57784": "अन्येषां समाधिकभावः",
 "gb_2_17b_u46_padya_p03_157679": "अभेदानुवादेन भेदोपदेशः किमिति न स्यात्? सर्वशाखान्ते भेदोक्तेश्चैतदेव युक्तम्",
 "gb_7_7_u18_padya_p03_4bf2a2": "अन्यथा",
 "gt_2_55_u04_padya_p05_9ced3d": "शुकादीनामपीषद्दर्शनात्",
 "gt_3_34_u02_padya_p03_1f4bb5": "तथाह्युक्तम्",
 "tvk_seq14_u01_padya_p02_8cc65f": "नित्यानित्यत्वभेदेन देशः कालः श्रुतिस्तथा",
 "man_seq1_u03_gadya_p01_ef43ea": "इति पाद्मे",
 "knr_seq35_u06_padya_p04_64f69e": "विश्वध विश्वधारक",
 "bt_10_40_19_u13_padya_p06_855743": "ऊर्ध्वं त्वेवोदसर्प-त्तच्छिरोऽश्रयत यच्छिरोऽश्रयत तच्छिरोऽभवत्तच्छिरसः शिरस्त्वं ता एता शिर्षञ्च्छ्रियः"
}