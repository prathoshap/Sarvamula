{
 "gb_2_14d_u01_padya_p03_1c1b44": "सन्निति व्यवह्नियमाणमेव पदार्थस्वरूपमुत्पत्तेः प्राङ् नाशोत्तरं च नास्तीति सर्वलोको व्यवहरति",
 "gb_2_17b_u16_padya_p02_214604": "नच जीवेश्वरैक्यं मुक्तावपि",
 "gb_2_17b_u40_padya_p02_159f4d": "एकपिण्डनामधेयेतिशब्दानां वैयर्थ्यं चान्यथा",
 "gb_2_17b_u40_padya_p06_c01183": "तस्मादतत्त्वमसीत्येवोच्यते",
 "gb_2_17b_u44_padya_p01_a7c7df": "इति लिङ्गसाम्यं चात्र",
 "gb_2_17b_u46_padya_p02_009bef": "अतिप्रसङ्गश्चान्यथा",
 "gb_2_17b_u53_padya_p03_626df4": "तत्पक्षे त्वैक्यादेरपि मिथ्यात्वात् स्वरूपस्य च सिद्धत्वाद् व्यर्थैव श्रुतिः",
 "gb_2_17b_u53_padya_p07_043e26": "मिथ्यात्वं च मिथ्यैव तेषाम्",
 "gb_2_17b_u53_padya_p11_e39f45": "अचेतनानामनुभवाभावान्न तत्साम्यम्",
 "gb_2_39_u06_padya_p01_df3aa9": "इत्यन्यसाङ्ख्ययोगयोर्निषिद्धत्वान्नारदीये",
 "gb_2_39_u06_padya_p05_ef7d45": "मोक्षार्थत्वेनैव",
 "gb_3_17_u10_padya_p02_247f64": "यस्मादमुक्तस्य कार्यमस्त्येव तस्मादसक्तः",
 "gb_3_17_u12_gadya_p01_5efc70": "इत्युपसंहारविरोधश्चान्यथा",
 "gb_3_17_u15_padya_p01_a90b04": "आत्मरतिरेव स्यात्",
 "gb_7_7_u18_padya_p02_41331e": "परतरस्त्वहमेवेत्यर्थः",
 "gb_7_7_u31_padya_p01_6e92eb": "इत्यादिवाक्यशेषाच्च",
 "gb_7_7_u31_padya_p05_bd4cf5": "जानन्",
 "gb_7_27_u04_padya_p04_cc1c9c": "सम्मोहः = तदाग्रहः",
 "gb_10_42b_u02_padya_p02_0b602d": "अन्यथोक्तेरेव वैयर्थ्यात्",
 "gb_11_1_u29_padya_p01_28d2ab": "इत्यादि ब्रह्मतर्के",
 "gb_11_1_u31_gadya_p01_ef43ea": "इति पाद्मे",
 "gb_13_13_u08_padya_p02_7c3c76": "अन्यज्ञेयत्वस्य",
 "gb_2_14d_u01_padya_p04_b05595": "नच विपर्यये किञ्चिन्मानम्",
 "gb_2_17b_u26_padya_p01_475266": "इत्यादि मोक्षानन्तरमपि भेदवचनेभ्यः",
 "gb_2_17b_u40_padya_p03_8cb2f8": "नचैकविज्ञानेन सर्वविज्ञानं तत्पक्षे",
 "gb_2_17b_u42_padya_p01_07ddc8": "इत्येतदात्मसम्बन्धि",
 "gb_2_17b_u44_padya_p02_bf4541": "अविद्यमानमेवेश्वरं सृष्ट्यादिकं चाप्राप्तमेवात्मनो भिन्नत्वेन प्रापयित्वा तन्निषेधे कथं श्रुतेरुन्मत्तवाक्यत्वं",
 "gb_2_17b_u46_padya_p03_157679": "अभेदानुवादेन भेदोपदेशः किमिति न स्यात्? सर्वशाखान्ते भेदोक्तेश्चैतदेव युक्तम्",
 "gb_2_17b_u53_padya_p04_0ef4e8": "लक्षितस्वरूपस्यापि न स्वरूपाद् विशेषः",
 "gb_2_17b_u53_padya_p08_d7b057": "अतः सत्यत्वं सत्यं स्यात्",
 "gb_2_17b_u53_padya_p12_22dccb": "अतो जीवेश्वरयोर्भेद एवेति सिद्धम्",
 "gb_2_39_u06_padya_p02_6843a8": "साङ्ख्यस्य निरीश्वरत्वादुक्तत्वाच्चेश्वरस्य",
 "gb_2_39_u08_padya_p01_b715db": "इति",
 "gb_3_17_u10_padya_p03_1d1a0a": "असक्त आचरन्नेव यस्मात् परमाप्नोति",
 "gb_3_17_u13_padya_p01_ca0a7a": "ब्रह्मनिष्ठा ब्रह्मरता ब्रह्मज्ञानसुतर्पिताः",
 "gb_3_17_u16_padya_p01_eb7e37": "इत्येवशब्देन मुक्तानामेभ्यो विशेषो दर्शितः",
 "gb_7_7_u18_padya_p03_4bf2a2": "अन्यथा",
 "gb_7_7_u31_padya_p02_51f1ed": "बहूनां जन्मनामन्ते ज्ञानवान् भवति",
 "gb_7_27_u04_padya_p01_7446a9": "इति च भारते",
 "gb_7_27_u06_padya_p01_db7233": "इत्युक्तत्वात्",
 "gb_11_1_u20_padya_p01_1c1f2b": "इत्यादिरूपविशेषणाच्च रूपस्येश्वरसाक्षात्स्वरूपत्वम्",
 "gb_11_1_u29_padya_p02_6e91e3": "कमलासने ब्रह्मणि स्थितं रुद्रम्",
 "gb_13_0_u01_padya_p01_8141c2": "अर्जुन उवाच",
 "gb_13_13_u10_padya_p01_93b096": "इति पूर्वमेव सिद्धत्वात्",
 "gb_2_14d_u01_padya_p01_7f3ec7": "नचाविद्यामानविद्यमानयोरुत्पत्तिनाशनिषेधकोऽयं श्लोकः",
 "gb_2_14d_u01_padya_p05_90617a": "इदं तु वाक्यमन्यथासिद्धम्",
 "gb_2_17b_u26_padya_p02_e5fba3": "नच",
 "gb_2_17b_u40_padya_p04_95c1e3": "नहि शुक्तिज्ञो रजतज्ञ इति व्यवहारः",
 "gb_2_17b_u42_padya_p02_7ea35e": "तत्स्वामिकम्",
 "gb_2_17b_u44_padya_p03_c067aa": "न स्यात्? अनुवादोऽपि",
 "gb_2_17b_u53_padya_p01_9b13e3": "इत्यादि",
 "gb_2_17b_u53_padya_p05_4f4757": "निर्विशेषत्वोक्तेः",
 "gb_2_17b_u53_padya_p09_3786e5": "उपाधिकृतभेदेऽप्युपाधेर्मिथ्यात्वे त्वप्राप्तमेवोपाधिभेदं प्रापयित्वा पुनर्निषिध्यत इति स एव दोषः",
 "gb_2_39_u02_padya_p01_cce438": "सम्यक् ख्यातिर्ज्ञानं साङ्ख्यम्",
 "gb_2_39_u06_padya_p03_43b25b": "साङ्ख्यैर्योगैश्च विहितहिंसाया अप्यनर्थहेतुत्वाङ्गीकारात्",
 "gb_2_39_u08_padya_p02_cf67f6": "परमसाड्ख्ययोगयोश्चोक्तार्थत्वेनैव न विरोधः",
 "gb_3_17_u10_padya_p04_7a3560": "मुक्तस्यैव कार्यं नास्तीत्येवकारार्थोऽपि यस्त्विति तुशब्देनावगतः",
 "gb_3_17_u13_padya_p02_903123": "पाण्डवानां च मुक्तानामन्तरं किञ्चिदेव हि",
 "gb_3_17_u16_padya_p02_2133c0": "एषां कदाचिद् दुःखाभासस्यापि भावात्",
 "gb_7_7_u26_padya_p01_1effff": "इति भेदेनैवोपक्रमाच्च",
 "gb_7_7_u31_padya_p03_e4aaa4": "ततो मां प्रपद्यते",
 "gb_7_27_u04_padya_p02_7c336d": "जीवेश्वरादिकं द्वन्द्वम्",
 "gb_7_27_u06_padya_p02_67c287": "सर्गे सर्गकाल एव",
 "gb_11_1_u20_padya_p02_56d212": "नित्यत्वम्",
 "gb_11_1_u30_padya_p01_3c989b": "विष्णुं समाश्रितो ब्रह्मा ब्रह्मणोऽङ्कगतो हरः",
 "gb_13_0_u02_padya_p01_2bd347": "श्रीभगवानुवाच- इदं शरीरं कौन्तेय क्षेत्रमित्यभिधीयते",
 "gb_13_13_u10_padya_p02_77eaa8": "कर्तृकर्मविरोधवादिमतं निराकरोत्युत्तरज्ञेयशब्देन",
 "gb_2_14d_u01_padya_p02_eae89c": "प्रत्यक्षविरोधात्",
 "gb_2_17b_u16_padya_p01_295072": "इति परमश्रुतिः",
 "gb_2_17b_u40_padya_p01_f0dbf9": "इत्यादिश्रुतिभ्योऽर्थान्तरस्यैवावगतत्वात्",
 "gb_2_17b_u40_padya_p05_6267b1": "नवकृत्वोऽपि भेद एव दृष्टान्तोक्तेश्च",
 "gb_2_17b_u42_padya_p03_933018": "त्वमपि तदैतदात्म्यमेवासि न सोऽसीति वा",
 "gb_2_17b_u46_padya_p01_5d57d7": "इत्यादिवाक्यं परिहारे विशेषयुक्तिं च विना न दृष्टः",
 "gb_2_17b_u53_padya_p02_9e7e03": "नचेश्वरस्तद्भेदो वा प्रत्यक्षादिसिद्धः",
 "gb_2_17b_u53_padya_p06_9c1b00": "मिथ्याविशेषोक्तौ चाप्रामाण्यं श्रुतेः",
 "gb_2_17b_u53_padya_p10_593c22": "सत्योपाधिपक्षेऽपि हस्तपादाद्युपाधिभेदेऽपि भोक्तुरेकत्वदृष्टेरेकेनैवेश्वरेण सर्वोपाधिगतं सुखं दुःखं भुज्येतेत्येवमादयो दोषाः समा एव",
 "gb_2_39_u02_padya_p02_0a4310": "युज्यतेऽनेनेति योगस्तदुपायः",
 "gb_2_39_u06_padya_p04_9eb4ec": "अत्र तु युद्धविधानाच्च",
 "gb_3_17_u10_padya_p01_cc313a": "इत्यभिधानम्",
 "gb_3_17_u11_padya_p01_0b8c51": "तस्मात् कर्म समाचर",
 "gb_3_17_u14_gadya_p01_a7d561": "इति भविष्यत्पर्ववचनाच्च नार्जुनस्यामुख्याधिकारिता",
 "gb_7_7_u18_padya_p01_e7cdda": "मत्तोऽन्यत् परतरं नास्ति",
 "gb_7_7_u26_padya_p02_fca9fa": "आप्नोति विष्णुमित्येवात्मशब्दो ज्ञानिनि",
 "gb_7_7_u31_padya_p04_de9434": "वासुदेवः सर्वमिति पूर्णमिति",
 "gb_7_27_u04_padya_p03_461317": "तद्विषयो मोहो द्वन्द्वमोहः",
 "gb_10_42b_u02_padya_p01_2c6f7d": "इति वक्ष्यमाणस्याधिकफलत्वज्ञापकमेव",
 "gb_11_1_u20_padya_p03_b29e2d": "तत एव चिदानन्दाद्यात्मकत्वं च सिद्धम्",
 "gb_11_1_u30_padya_p02_7b8e16": "हरस्याङ्गविशेषेषु देवाः सर्वेऽपि संस्थिताः",
 "gb_13_13_u08_padya_p01_0a6973": "इति स्वज्ञेयत्वाज्ज्ञेयम्"
}