{
 "ait_seq12_u01_padya_p02_5fd0a2": "प्रथितः पृथिवीनामा सोऽन्तरिक्षाभिधोऽत्रगः",
 "ait_seq12_u01_padya_p06_bc9ab0": "अहमुक्थमिति ह्येतां विद्यामनुभवत्यसौ",
 "ait_seq12_u01_padya_p10_53817d": "तृचाशीतिविभिन्नस्य शस्त्रस्यान्नत्वहेतुतः",
 "ait_seq12_u01_padya_p14_dfa5e9": "अदनाघ्राणदृष्ट्याख्यभोगत्रयविभागतः",
 "ait_seq12_u01_padya_p18_80b877": "सुपर्णप्रतिमा सा यत् तदारूढो जनार्दनः",
 "ait_seq12_u01_padya_p22_e3bd8a": "तेषु स्थिते सुपर्णे च रूपभेदैः पृथक्पृथक्",
 "ait_seq12_u01_padya_p26_8b97ec": "जीववाक्प्राणचक्षुष्षु तद्वागाद्यास्ततः स्थिताः",
 "ait_seq12_u01_padya_p30_947eb3": "अविशेषोऽपि भगवान् पूर्णैश्वर्यस्वरूपतः",
 "ait_seq12_u01_padya_p34_07771e": "अग्न्यादिषु च तन्नामा वासुदेवः स संस्थितः",
 "ait_seq12_u01_padya_p38_8db968": "पतन्ति धावयन्त्यश्वान् नरादींश्च नरादयः",
 "ait_seq12_u01_padya_p42_35a330": "पतितं सर्वमेवात्ति तथा दिवि च संस्थितः",
 "ait_seq12_u01_padya_p46_ad5212": "आद्यो भवति चान्येषां नोपजीव्यो भवेद् यथा",
 "ait_seq16_u01_padya_p02_79ab89": "वासुदेवाभिधं ब्रह्म प्राप प्रपदयोः पुरा",
 "ait_seq16_u01_padya_p06_400cc5": "प्रपदाख्या वर्ततेऽतो नतु पश्वादिनां क्वचित्",
 "ait_seq16_u01_padya_p10_4fab78": "वायुमाहोरुगरणं कुर्वत्र स्थित इत्यपि",
 "ait_seq16_u01_padya_p14_5658b7": "तथाऽकरोत् स वायुश्च तदुरोऽभूदुरुत्वतः",
 "ait_seq16_u01_padya_p18_e3542d": "हृत्स्थमेव परं विष्णुं ध्यायन्त्यारुणयः सदा",
 "ait_seq16_u01_padya_p22_d02085": "स्थितो मूर्धनि देवेशः श्रितोऽसाविति तच्छिरः",
 "ait_seq16_u01_padya_p26_27b1ca": "वैदिकं गरुडश्चेन्द्रो यज्ञादिविषयं मनः",
 "ait_seq16_u01_padya_p30_2057d2": "वाचा हिंसामकुर्वंस्ते विनिन्दन्तः परस्परम्",
 "ait_seq16_u01_padya_p34_dee28d": "ततः क्रमेण चाग्न्याद्या निष्क्रान्तास्तेषु सर्वशः",
 "ait_seq16_u01_padya_p38_1439c9": "तेषां बलपरीक्षार्थं वाय्वादीनां च सर्वशः",
 "ait_seq16_u01_padya_p42_6af8e5": "उच्चैः स्थितत्वादुक्थोऽभूद् वायुरेव ततः प्रभुः",
 "ait_seq16_u01_padya_p46_7e8412": "इत्यूचुर्वीन्द्रशेषेशशक्रचन्द्रादिकाः पृथक्",
 "ait_seq18_u01_padya_p03_c9bcc8": "वायुमप्यनयन् सर्वे यशसा तद्गुणोक्तितः",
 "ait_seq18_u01_padya_p07_47373d": "सङ्गतश्चाभवज्जीवचिता रूपान्तरेण सः",
 "ait_seq18_u01_padya_p11_488711": "यज्ञादिसाधने यत् तु मनश्चन्द्रः प्रकीर्तितः",
 "ait_seq18_u01_padya_p15_7f91c2": "यम एव षडङ्गानां विषयश्रवणोचितम्",
 "ait_seq18_u01_padya_p19_add80f": "शिवादीनां च सर्वेषां मनस्त्वं कथितं पुरा",
 "ait_seq18_u01_padya_p23_f6db5a": "अधिदैवं स एवैक आधिक्यात् पुरुषोत्तमः",
 "ait_seq18_u01_padya_p27_2e9438": "हिरण्यदन्नाम बैदो भूतेषु हि सुरानृते",
 "ait_seq18_u01_padya_p31_c37ea0": "स्यान्नैवात्रास्ति सन्देहः स्वेच्छाविहृतिरेव च",
 "ait_seq18_u01_padya_p35_929ab6": "विष्णुप्रहितदेवानां योगमध्यात्ममञ्जसा",
 "ait_seq18_u01_padya_p39_88e14e": "मुक्तस्य वैष्णवे लोके मुक्तानि च न संशयः",
 "ait_seq18_u01_padya_p43_640287": "स एष भगवान् विष्णुः सत्यमित्यभिधीयते",
 "ait_seq18_u01_padya_p47_3d1682": "वायुः सदिति सम्प्रोक्तो जीवेषु तु सुपूर्णतः",
 "ait_seq18_u01_padya_p51_79ac93": "यमित्यादित्य उद्दिष्टो यमयेद् यत् प्रकाशनात्",
 "ait_seq18_u01_padya_p55_c82801": "योग्यस्तस्या उपासाया नैवासत्येन दुष्यति",
 "ait_seq20_u01_padya_p02_7407b5": "तन्तिरूपा जगद्बन्धे नाम ब्रह्मादिकं च यत्",
 "ait_seq20_u01_padya_p06_9c305e": "वेदात्मिक्या यतो वाचा विष्णुर्वदति सोऽखिलम्",
 "ait_seq20_u01_padya_p10_69c3fd": "बलिं हरन्ति पञ्चाथ भूतान्येनं वहन्ति च",
 "ait_seq20_u01_padya_p14_ceac9e": "स्वावरैः सेव्यतैव स्यात् कैश्चिदेव क्वचित्क्वचित्",
 "ait_seq20_u01_padya_p18_85b68b": "विष्णोर्विमुक्तवायोश्च लोमाद्यं तु चिदात्मकम्",
 "ait_seq20_u01_padya_p22_f5eae3": "निवारयन्ति पापेभ्यश्छन्दांसि किमु केशवः",
 "ait_seq20_u01_padya_p26_6dcb96": "एष गोप्ता हि सर्वस्य वायुस्थः पुरुषोत्तमः",
 "ait_seq20_u01_padya_p30_edeb72": "चोदितः केशवेनैव तत्स्थेनामितशक्तिना",
 "ait_seq20_u01_padya_p34_dddfef": "नित्यदा वसतः कोणदिक्ष्वथासु विषूचिषु",
 "ait_seq20_u01_padya_p38_896073": "वायोराधारभूतस्य ताभ्यां हि क्रतुनामकाः",
 "ait_seq20_u01_padya_p42_5199c7": "विष्टब्धाश्चैव सर्वेऽपि जीवा आकाश एव च",
 "ait_seq20_u01_padya_p46_ace684": "विशेषतो बृहत्प्राणो भगवांस्तत्र केशवः",
 "ait_seq24_u01_padya_p03_323d7a": "आप इत्येव नामैषां भवतीत्याह स प्रभुः",
 "ait_seq24_u01_padya_p07_733fc1": "पुत्रा ब्रह्मादयः सर्वे नैवायं वृक्षमूलवत्",
 "ait_seq24_u01_padya_p11_658962": "पुत्रनाम पितुश्च स्यात् तत्तन्त्रत्वात् सुतस्य हि",
 "ait_seq24_u01_padya_p15_38b334": "स्वकीयमेवमन्यानि पृथक्पृथगदात् प्रभुः",
 "ait_seq24_u01_padya_p19_c55eca": "देवपर्यन्तमा व्याप्तिं वेदाहं मम सर्वदा",
 "ait_seq24_u01_padya_p23_5348a0": "अधितिष्ठन्ति सत्ताद्या अप्येतेषां मदाज्ञया",
 "ait_seq24_u01_padya_p27_c9a76a": "सर्वश्रोतृत्वतः श्रोत्रं मनो मन्तृत्वहेतुतः",
 "ait_seq24_u01_padya_p31_5d0c28": "गिरत्येवाखिलं पापं भ्रातृवत् सह संस्थितम्",
 "ait_seq24_u01_padya_p35_7308bb": "स एष भूतिनामाऽपि ज्ञानैश्वर्यादिभूतिदः",
 "ait_seq24_u01_padya_p39_1aa035": "बभूवुः सुखसज्ज्ञानपूर्वैः सर्वगुणैर्युताः",
 "ait_seq24_u01_padya_p43_20a39b": "अभूतिकारकोऽस्माकमैश्वर्यादिगुणोज्झितः",
 "ait_seq24_u01_padya_p47_6ac02c": "भावाभावं च देवानां दैत्यानां चैवमेव तु",
 "ait_seq24_u01_padya_p51_232024": "स एव जीवनकरो यदाऽपानेन संयुतम्",
 "ait_seq24_u01_padya_p55_6ceec4": "प्राणादेव हि तत्रापि प्राणाधारो जनार्दनः",
 "ait_seq24_u01_padya_p59_6de96d": "अमर्त्यस्तत्प्रसादेन वायुर्देहैः सह स्थितः",
 "ait_seq24_u01_padya_p63_a1c1f1": "शरीरं तु विनष्टं स्यात् पञ्चत्वमुपगच्छति",
 "ait_seq24_u01_padya_p67_34f7a3": "दृश्यमेतच्छरीरं चाप्यदृश्या वायुदेवता",
 "ait_seq24_u01_padya_p71_72930f": "” इति च",
 "ait_seq24_u01_padya_p75_04be6c": "विनतमिव किञ्चिन्नतस्थानं तत् सूर्यलोकस्थानीयं विद्यात्",
 "ait_seq24_u03_padya_p01_1c9d6b": "इति शब्दनिर्णये",
 "ait_seq24_u04_padya_p03_cf79b3": "केवलैश्वर्ययोगेन यत्र सङ्ख्यादिवद् भवेत्",
 "ait_seq24_u04_padya_p07_24fff6": "न विशेषो हि रूपाणां मत्स्यादीनां कथञ्चन",
 "ait_seq24_u06_padya_p02_6ef77d": "उक्तार्थस्य महाधिक्यं श्रुतेस्तत्र विवक्षितम्",
 "ait_seq24_u07_padya_p04_68365c": "मुख्याधिदैवतं नारायण एव",
 "ait_seq24_u11_gadya_p01_7092d6": "इत्याद्यर्थे",
 "ait_seq24_u15_gadya_p01_4f5735": "इति वाक्यशेषात्",
 "ait_seq24_u18_padya_p02_fed651": "तद्वशा नियता नित्यं नमस्तस्मै परात्मने",
 "ait_seq24_u19_padya_p04_23385a": "तैर्हि स्तुत्यादिकर्माणि कृतानि श्रोत्रेण शृणोति भगवान्",
 "ait_seq24_u20_padya_p01_280f97": "मुखादिन्द्रश्चाग्निश्च",
 "ait_seq24_u21_padya_p04_da45f3": "अतिप्रसङ्गात्",
 "ait_seq24_u23_gadya_p01_087235": "इत्यादिना",
 "ait_seq24_u24_padya_p04_94c7d9": "प्रधानत्वान्न देवानां नृकर्मोत्पत्तिकारणम्",
 "ait_seq24_u27_padya_p02_c71634": "नतु सन्निहितस्यैव",
 "ait_seq24_u29_padya_p02_ff8675": "यथा च",
 "ait_seq71_u01_padya_p01_17c69a": "बृहतीसम्पादनेऽनुष्टुप्शंसनामात्रात् पञ्चविंशोत्तरशतानुष्टुबाधिक्यं च भवति",
 "ait_seq71_u03_padya_p01_23bc34": "इत्यनुष्टुभो बृहतीसम्पादनवचनाच्च",
 "ait_seq71_u03_padya_p05_0c172b": "इन्द्रस्य परमेश्वरस्य विष्णोः सम्बन्धी नितरां प्रियत्वाद् यः प्राणदेवता",
 "ait_seq71_u03_padya_p09_29b62f": "तस्मात् तस्यैव बृहतीसहस्रत्वेन सम्पन्नस्य पञ्चविंशोत्तरैकादशशतानुष्टुप्त्वेन सम्पादने बृहतीदैवतप्राणरूपाद् वायोरनुष्टुब्देवताया",
 "ait_seq71_u03_padya_p13_bcaf83": "प्रतिमाधिष्ठितदेवतावत्",
 "ait_seq71_u03_padya_p17_bc517a": "स हि तस्याः षट्त्रिंशदक्षरादित्वमपि नियमयति तत्प्रसादाद् वायुश्च",
 "ait_seq71_u11_padya_p01_c6e93b": "इति शब्दनिर्णये",
 "ait_seq71_u13_padya_p02_b3de1d": "परमविकारेण सह विकारमात्रस्यापि प्रस्तुतत्वात् तदेतत् पञ्चविधमिति परामर्शः",
 "ait_seq71_u15_padya_p04_968140": "नायोग्यानां सम्यग् वाच्य इति स्वल्प एव प्रकाशितोऽस्माभिः",
 "ait_seq71_u15_padya_p08_7d42b8": "अकारस्योङ्कारता त्वकारलोपेनैव जातेति सत्यमोङ्कारः",
 "ait_seq71_u15_padya_p12_53aa38": "अतश्च सत्यमोङ्कारः",
 "ait_seq71_u15_padya_p16_4aecab": "तस्मादकारस्यैतद् वृथा वागादिकमपि व्याख्यानम्",
 "ait_seq73_u03_padya_p03_15bc01": "यस्य नारायणस्यैतद् यशः स भगवानेवेन्द्रनामा",
 "ait_seq73_u05_padya_p02_a1bc8b": "अन्येषां तु द्वादशानां तेन दत्तमेवेन्द्रत्वं नतु मुख्यतः",
 "ait_seq73_u07_padya_p03_42f790": "तदा वरुणादिषु पृथक्पृथङ् मत्सिशब्ददर्शनादत्रापि पृथङ् मत्सिशब्दो दृश्येत",
 "ait_seq73_u09_padya_p01_12657e": "इत्याद्यप्येकस्यैव विष्णोर्विशेषणम्",
 "ait_seq73_u11_padya_p02_c1ecac": "बहुरूपत्वाद् बहुवचनं च विष्णोरेव युज्यते",
 "ait_seq73_u17_padya_p01_c0c46d": "इति धातोः",
 "ait_seq73_u19_padya_p03_9f678a": "तस्मात् तत्प्रसादादवताराग्रजत्वमेव तस्य महत्त्वम्",
 "ait_seq73_u21_padya_p03_846c9c": "विष्णुस्तु",
 "ait_seq73_u27_padya_p02_910d30": "स एव महिदास इन्द्रनामा प्राप्येमं लोकमत्र भूत्वा प्रादुर्भूय",
 "ait_seq73_u29_padya_p01_21c94c": "इत्यादिवत् प्राप्तिवाच्येव",
 "ait_seq73_u33_padya_p01_a9f3ed": "इति स्कान्दे",
 "ait_seq73_u35_padya_p01_9f55ce": "इतिवत्",
 "ait_seq73_u37_padya_p02_757a2b": "रङ्गस्तु प्रश्नविषयस्य दुरवगमत्वं प्रकाशयति",
 "ait_seq73_u39_padya_p04_5ce447": "सोऽयं महिदासादिप्रादुर्भावरूप इदं भूमिष्ठस्त्रीरूपं लोहितगतं च स्वकीयमेव रूपममुष्मै",
 "ait_seq73_u39_padya_p08_21812f": "अग्नेस्तद्रूपमग्निनाम्नो विष्णोः प्रतिमा तत्सन्निधानात्",
 "ait_seq73_u39_padya_p12_13de50": "अप्रस्तुतत्वात् तस्य",
 "ait_seq73_u43_padya_p03_24d354": "सत्यस्य सत्यमनु यत्र युज्यत इत्यादिनोक्तार्थविषयोदाहृतैः श्लोकैरपि भगवत एव स्वरूपाणां परस्परयोगस्योक्तत्वात्",
 "ait_seq75_u01_padya_p04_e21d3d": "एव स्त्रीपुंरूपेण युज्यते",
 "ait_seq75_u01_padya_p08_4a4e76": "किन्त्वेकस्थाने वासोऽत्यनुकूलचित्तता च",
 "ait_seq75_u04_padya_p04_5cd35a": "स्वरूपैक्यस्य पूर्वमेव सिद्धत्वात्",
 "ait_seq75_u04_padya_p08_fc0fce": "नहि पूर्वं भिन्नस्य पश्चात् स्वरूपैक्यं भवति",
 "ait_seq75_u08_padya_p02_be976a": "तत्र देवाः सर्व एकं भवन्तीत्युच्यते",
 "ait_seq75_u08_padya_p06_a90f24": "वियूय विचार्य नामायत्तान्येव नामार्थभूतान्येव विष्णोर्माहात्म्यादीन्यन्वविन्दन्",
 "ait_seq75_u08_padya_p10_18747a": "तस्मिन्नेव देवाः सर्वयुजो भवन्तीत्यवधारणार्थं पुनर्वचनम्",
 "ait_seq75_u14_padya_p01_a02b46": "इति च",
 "ait_seq75_u14_padya_p05_982247": "भवत्येव हि भगवान् स्त्रीरूपः पुंरूपश्च",
 "ait_seq75_u22_padya_p02_d6d982": "एवं सर्वे शब्दा भगवद्वाचका इत्युक्त्वा",
 "ait_seq75_u24_padya_p03_b22234": "यस्माद इत्ययं शब्दः प्रस्तुतस्याभावं विरोधिनमन्यं च वदति तस्मात्",
 "ait_seq75_u24_padya_p07_75c24d": "भगवांस्त्व इति पृथग् विवक्षितत्वादेव न प्रस्तुतसमुदाये",
 "ait_seq75_u24_padya_p11_e24de8": "तस्मादकारस्य भगवानेव मुख्यार्थो न शून्यम्",
 "ait_seq75_u24_padya_p15_834b68": "नच तथा प्रयोगोऽस्ति",
 "ait_seq75_u24_padya_p19_799d35": "नच जीवजडाद्यपूर्णवस्त्वभिन्नस्य पूर्णत्वं भवति",
 "ait_seq75_u26_padya_p01_6b9b70": "इति शब्दनिर्णये",
 "ait_seq75_u26_padya_p05_034603": "अहमेक एव परिपूर्णः",
 "ait_seq75_u26_padya_p09_5d891c": "तच्चोक्तं वाक्यनिर्णये",
 "ait_seq75_u28_padya_p04_dee5f4": "उक्तं हि शब्दनिर्णये",
 "ait_seq75_u34_padya_p02_a04081": "वायोरुत्पत्तिकामो मायां रमायां रमत इत्यनकाममारः",
 "ait_seq75_u36_padya_p03_b2a443": "अस्त्रीपुमानिति ब्रुवन्नपि न वदतीत्युक्तत्वाच्च स्त्रीत्वं पुंस्त्वं च प्रतीयते विष्णोः",
 "ait_seq75_u36_padya_p07_c4c281": "नपुंसकरूपे प्रमाणाभावादेव लौकिकस्त्रीपुंविलक्षणत्वादस्त्रीपुमानित्यपि वदन्निति भवति",
 "ait_seq75_u40_padya_p01_8ebd2c": "इत्यादि प्रमाणविवेके",
 "ait_seq75_u44_padya_p02_ea1a2e": "सुखं ददत इति सुदिने",
 "ait_seq75_u44_padya_p06_8b6047": "नचाहोरात्रे अहनी इत्युच्येते",
 "ait_seq75_u46_padya_p01_8e7866": "इत्यध्यात्मसम्बन्धाच्च",
 "ait_seq75_u46_padya_p05_aaa34a": "जीवन्मुक्तिश्च मुक्तिश्च हि मुख्ये सुदिने",
 "ait_seq75_u50_padya_p02_9f09c7": "अतो ज्ञानोत्पत्तिसमनन्तरमेव मुक्तौ न पुनरार्जनमस्तीति किञ्चित् कालं ज्ञानित्वेनावस्थानमपि सुदिनमेव",
 "ait_seq75_u50_padya_p06_6de862": "एकरासभयुक्तो हि तद्रथः",
 "ait_seq75_u56_padya_p02_6ca73d": "अतो विष्णुरेव मुख्यतः सर्वनामोक्त इति सिद्धम्",
 "ait_seq186_u01_padya_p04_24699a": "आत्मनो ज्ञानसामर्थ्यानुसारेण वक्तव्यत्वादनुव्याहारः",
 "ait_seq186_u03_padya_p04_dbd947": "नाशकः सन्धातुं मया सह सन्धानं कर्तुं नाशकः",
 "ait_seq12_u01_padya_p03_d4045a": "अन्तरीक्ष्यो यतो द्युस्थो द्युनामाऽतिप्रकाशनात्",
 "ait_seq12_u01_padya_p07_74b2b0": "पृथक्पृथक् च तस्याङ्गान्युक्थानि जगदीशितुः",
 "ait_seq12_u01_padya_p11_b29f0d": "विष्णोस्तृचाशीतिवत् स्यात् प्रसिद्धान्नमिति स्फुटम्",
 "ait_seq12_u01_padya_p15_e70623": "मुखनासाचक्षुषां तद्भोग्यमन्नं हरेः श्रुतम्",
 "ait_seq12_u01_padya_p19_bae3b1": "तस्मात् तस्यार्क इति सा प्रोच्यते वैदिकैः पदैः",
 "ait_seq12_u01_padya_p23_90d76b": "स्थितो विष्णुस्तदर्कास्ते तस्मादेव प्रकीर्तिताः",
 "ait_seq12_u01_padya_p27_473032": "विष्णोर्वाग् भार्गवो रामः प्राणोऽस्य नरकेसरी",
 "ait_seq12_u01_padya_p31_2c2709": "अङ्गाङ्गित्वेनैक एव स्वानन्दानुभवे स्थितः",
 "ait_seq12_u01_padya_p35_672dbe": "अन्ननामा स एवान्ने चेष्टयन् सर्वमास्थितः",
 "ait_seq12_u01_padya_p39_9ee2cb": "परस्य विष्णोर्धामत्वात् सूर्यो ब्रध्न इतीरितः",
 "ait_seq12_u01_padya_p43_b498e3": "इतो गतं सर्वमत्ति द्युनामा भगवान् परः",
 "ait_seq12_u01_padya_p47_08dfee": "हरिः स सर्वजीवानां न भुज्यन्ते यथाऽमुना",
 "ait_seq16_u01_padya_p03_b3d46f": "यस्मात् प्रपेदे भगवान् प्रपदाच्चतुराननम्",
 "ait_seq16_u01_padya_p07_b574b0": "अयादूर्ध्वं ततो विष्णुः प्रपदादूरुमत्र च",
 "ait_seq16_u01_padya_p11_453235": "उर्वेव गरणं चक्रे वायुर्यत्र स्थितः सदा",
 "ait_seq16_u01_padya_p15_15cddf": "उरोमध्ये च हृदयं तत्रावासो हरेः सदा",
 "ait_seq16_u01_padya_p19_f40f3a": "उदरस्थं च हृद्गं च ते उभे ब्रह्म तत् परम्",
 "ait_seq16_u01_padya_p23_f8a7d5": "तत्र प्राणात्मना वायुर्मनोरूपेण शङ्करः",
 "ait_seq16_u01_padya_p27_b916d3": "श्रोत्रं चन्द्रो रविश्चक्षुर्वागग्निः परिकीर्तितः",
 "ait_seq16_u01_padya_p31_81a372": "ते विष्णोराज्ञयाऽवोचन्नुत्क्रमाम पृथक्पृथक्",
 "ait_seq16_u01_padya_p35_c7d15b": "निष्क्रान्तेषु न वै पातः शरीरस्याभवत् क्वचित्",
 "ait_seq16_u01_padya_p39_9eca65": "पुनस्ते प्राविशन् सर्वे वह्निसूर्यो शशी शिवः",
 "ait_seq16_u01_padya_p43_2aa3d2": "उच्चत्वं च गुणाधिक्यं त्वमुच्चोऽसीति तेऽब्रुवन्",
 "ait_seq16_u01_padya_p47_193bb7": "वायुः स संस्तुतस्तैश्च प्रसन्नोऽभूद् दिवौकसाम्",
 "ait_seq18_u01_padya_p04_f51250": "येये गुणान् विजानन्ति वायोस्तानाविशन्मरुत्",
 "ait_seq18_u01_padya_p08_7c3a1a": "सङ्गतत्वात् सायमिति तद् रूपं नामतोऽभवत्",
 "ait_seq18_u01_padya_p12_ed341e": "मित्रो यमश्च वरुणः कुबेरश्च दिगीश्वराः",
 "ait_seq18_u01_padya_p16_303226": "श्रोत्रं तु वरुणः काम्यशास्त्रार्थं मित्र एव च",
 "ait_seq18_u01_padya_p20_23865d": "एताः सर्वा देवता हि ब्रह्मवायुसुपर्णकाः",
 "ait_seq18_u01_padya_p24_ad2c8b": "देवमात्रास्तदन्ये तु स आविः पुरुषोत्तमः",
 "ait_seq18_u01_padya_p28_3b0028": "मदभीष्टं ममादातुं नैवेष्टे कश्चनाञ्जसा",
 "ait_seq18_u01_padya_p32_b9a213": "मन्निषेधे न शक्तोऽस्ति प्रीता देवा हि मे सदा",
 "ait_seq18_u01_padya_p36_fea68c": "वेद तं च नियोक्तारमुपास्ते विष्णुमव्ययम्",
 "ait_seq18_u01_padya_p40_3e212e": "इत्येतद्ध्यानयोग्याश्च मुनयो देवतास्तथा",
 "ait_seq18_u01_padya_p44_3c22e3": "सर्वोत्तमत्वात् पूर्णत्वात् सर्वज्ञत्वात् तथैव च",
 "ait_seq18_u01_padya_p48_ff235d": "तीति ब्रह्मा समुद्धिष्टः स एवान्नाभिमानवान्",
 "ait_seq18_u01_padya_p52_121b82": "देवतात्रयमेतत् तु सहितं सत्यमुच्यते",
 "ait_seq18_u01_padya_p56_c7ce9c": "देवता मुनयश्चैव योग्या अस्या अपि स्फुटम्",
 "ait_seq20_u01_padya_p03_74a778": "विप्रक्षत्रियवैश्यादिरूपं चाखिलमेव तु",
 "ait_seq20_u01_padya_p07_b4da4b": "य एतद् विष्णुवाचैव बद्धं नामाख्यदामभिः",
 "ait_seq20_u01_padya_p11_85b1fe": "योग्यश्चास्या उपासाया योग्यो ब्रह्मपदस्य यः",
 "ait_seq20_u01_padya_p15_8bad52": "तथैव वायुना बद्धं जगदेतत् ततोऽवरम्",
 "ait_seq20_u01_padya_p19_64dbf9": "लोमप्राणादिभेदश्च नैव कश्चिच्चिदात्मनि",
 "ait_seq20_u01_padya_p23_158788": "योग्या अस्याश्च विद्याया भृग्वाद्या देवतास्तथा",
 "ait_seq20_u01_padya_p27_d934a1": "छन्दस्सु संस्थितो वायुर्वायौ च स जनार्दनः",
 "ait_seq20_u01_padya_p31_95e927": "आ समन्तात् पराक् चापि पञ्चभूतेभ्य ईश्वरः",
 "ait_seq20_u01_padya_p35_7a9f5f": "अन्तश्च सर्वलोकेषु चरतो लोकसाक्षिणौ",
 "ait_seq20_u01_padya_p39_6c1646": "आवृताः सर्वजीवा हि यथैव कनकावटाः",
 "ait_seq20_u01_padya_p43_05250f": "स वायुः प्रकृतिश्चैव विष्टब्धौ केशवेन हि",
 "ait_seq20_u01_padya_p47_845783": "इति विद्यात्",
 "ait_seq24_u01_padya_p04_f6d595": "इदं मदाख्यं यद् ब्रह्म ह्याप इत्यभिधीयते",
 "ait_seq24_u01_padya_p08_3b25f1": "स्वतन्त्रत्वाज्जगन्नाथः पितृत्वात् परमेशितुः",
 "ait_seq24_u01_padya_p12_18c193": "यथा पितामहाद्याश्च पितरो नाम कीर्तिताः",
 "ait_seq24_u01_padya_p16_d28e05": "नारायणादिनामानि ददौ नान्यस्य केशवः",
 "ait_seq24_u01_padya_p20_50d0c7": "मत्पर्यन्तं तथा व्याप्तिं देवानामपि सर्वशः",
 "ait_seq24_u01_padya_p24_07a967": "ज्ञानकर्मबलेहाद्या मद्दता इति किं वदे",
 "ait_seq24_u01_padya_p28_2cb4c0": "प्राणनामा प्रणेतृत्वात् तमेनं गुणपूर्तितः",
 "ait_seq24_u01_padya_p32_54e7af": "पराभवति पाप्माऽस्य द्वेष्टा निरयगः सदा",
 "ait_seq24_u01_padya_p36_f74012": "अज्ञानादिप्रदातृत्वात् स एवाभूतिनामकः",
 "ait_seq24_u01_padya_p40_64c211": "देवानामपि सर्वेषां प्रधानोऽद्यापि मारुतः",
 "ait_seq24_u01_padya_p44_579055": "इत्येवोपासते तस्मात् पराभूताश्च सर्वशः",
 "ait_seq24_u01_padya_p48_3c3009": "ज्ञानैश्वर्यादिभिः सोऽपि भवेत् तस्य परात्मनः",
 "ait_seq24_u01_padya_p52_6a12a8": "प्राणं नियमयत्यस्मिन् शरीरे पुरुषोत्तमः",
 "ait_seq24_u01_padya_p56_4e41e6": "अवाक् प्राक् च सदा गच्छेद् वायुरानन्दरूपिणा",
 "ait_seq24_u01_padya_p60_132f5d": "अनित्या अपि देहास्ते शश्वत् सन्त्या विमोक्षतः",
 "ait_seq24_u01_padya_p64_05624b": "जडं तज्जडतामेति चेतना वायुदेवता",
 "ait_seq24_u01_padya_p68_cca215": "य एवं वेद तं वायुममृतं सर्वनायकम्",
 "ait_seq24_u01_padya_p72_6134c0": "ब्रह्म पन्थाः सत्यं कर्म इति तस्य नारायणस्य वासुदेवाद्याः",
 "ait_seq24_u01_padya_p76_9aff9c": "तथा इति निर्णयः",
 "ait_seq24_u03_padya_p02_c0d23d": "ब्रह्मा हैव ताइ ते",
 "ait_seq24_u04_padya_p04_4a5532": "स्वरस्पर्शविभागेन तत्रोक्तिः स्याद् विभक्तिषु",
 "ait_seq24_u04_padya_p08_a24fd4": "नैश्वर्ये न बले चैव नानन्दादिगुणेष्वपि",
 "ait_seq24_u07_padya_p01_a71816": "इत्यतो ब्रह्मा ह इति दैर्घ्यमपि परब्रह्मत्वविवक्षया",
 "ait_seq24_u08_padya_p01_61dc95": "तस्योष्णिग् लोमानि",
 "ait_seq24_u12_padya_p01_ff0d5d": "सप्तसु प्रथमा",
 "ait_seq24_u16_padya_p01_efd91e": "ब्राह्मणोऽस्य मुखमासीत्",
 "ait_seq24_u19_padya_p01_1ad601": "इति च स्कान्दे",
 "ait_seq24_u19_padya_p05_c8d8eb": "दिग्भ्योऽप्यन्य एव विशृणोति जीवः",
 "ait_seq24_u21_padya_p01_ded6e4": "इत्यादिना भगवतः सकाशाद्धि सर्वेषां सृष्टिः प्रसिद्धा",
 "ait_seq24_u21_padya_p05_ab4664": "नहि यत्किञ्चित् कारणत्वमस्तीत्येतावता ब्राह्मणस्य चण्डालः पितेत्युच्यते",
 "ait_seq24_u24_padya_p01_6ff10c": "मनुष्याणां तु यत् कर्म न देवोत्पत्तिकारणम्",
 "ait_seq24_u25_gadya_p01_7e4c84": "इति च ब्रह्माण्डे",
 "ait_seq24_u27_padya_p03_c8ffea": "यथा",
 "ait_seq24_u30_padya_p01_27c148": "पूर्वं तु बादरायणो हेतुव्यपदेशात्",
 "ait_seq71_u01_padya_p02_67f74c": "अत आधिक्यात् बृहतीसम्पादनमेव वरम्",
 "ait_seq71_u03_padya_p02_53e904": "अष्टचतुरक्षराण्यनुष्टुप्",
 "ait_seq71_u03_padya_p06_febf10": "वायुस्तस्य प्रतिमारूपमिदं बृहतीसहस्रम्",
 "ait_seq71_u03_padya_p10_5da9dc": "वाग्रूपाया उमाया उत्पत्तिः संस्मृता भवत्येवं जानतः",
 "ait_seq71_u03_padya_p14_2e4b30": "तस्माद् बृहत्याः सकाशादनुष्टुप्सम्पादने तस्यैव विष्णोः प्रतिमान्तरं तस्मादेव निर्मितं भवति",
 "ait_seq71_u03_padya_p18_2d3f79": "वायुरेव यद् भगवन्नियतो नियामयति तस्मात्",
 "ait_seq71_u11_padya_p02_0f27b0": "स वा एष वाचः परमो विकारः",
 "ait_seq71_u15_padya_p01_e7580d": "इत्यादि शब्दनिर्णये",
 "ait_seq71_u15_padya_p05_e1fb50": "वाच उद्वर्तनाशक्तेः स्वयमेवोद्वर्तते",
 "ait_seq71_u15_padya_p09_9c7d3b": "अकारस्यादौ स्थितत्वेन च यथार्थरूपत्वात्",
 "ait_seq71_u15_padya_p13_a3b2c3": "यमर्थमकारो वक्ति तमेव वक्तीति",
 "ait_seq71_u15_padya_p17_605b25": "तस्माद् विजानतः सर्वमपि भगवन्नामैव",
 "ait_seq73_u03_padya_p04_c928c2": "स हि यत् प्रथमत इन्द्रो बभूव स्वेच्छया यज्ञनामा",
 "ait_seq73_u05_padya_p03_80d981": "अतो विष्णावेवेन्द्रशब्दं प्रयुङ्क्ते श्रुतिः",
 "ait_seq73_u07_padya_p04_3ca048": "नहि सर्वेषां पृथङ् मत्सिशब्ददर्शन एकस्यैवान्यथात्वं युज्यते",
 "ait_seq73_u09_padya_p02_942f8f": "यत्र चैवं भूतेष्वेकत्वे विरोधो दृश्यते तत्र तेनैव विरोधेन द्वित्वं भवति",
 "ait_seq73_u11_padya_p03_418f3a": "तस्मान्मुख्यतो विष्णावेवेन्द्रादिशब्दा अन्येषामुपचारतः",
 "ait_seq73_u17_padya_p02_cb4ce1": "पूज्यो ह्यग्रजो भवति",
 "ait_seq73_u19_padya_p04_b0dd5d": "अन्येन्द्रो हि",
 "ait_seq73_u25_padya_p01_bd5601": "इति धातोर्विशेषेण धारणपोषणकर्ता हि वेधाः",
 "ait_seq73_u27_padya_p03_7f421a": "मनुष्यदृष्टिगोचरतां प्राप्यैषु लोकेषु राजति",
 "ait_seq73_u29_padya_p02_f9bf1a": "नहि मृतः पुनरेषु लोकेष्वेव राजति",
 "ait_seq73_u33_padya_p02_f66615": "यदनेन रूपेणामुं लोकमभिसम्भवति",
 "ait_seq73_u35_padya_p02_e1200f": "यच्छब्दः किंशब्दार्थे",
 "ait_seq73_u39_padya_p01_8db353": "इति शब्दनिर्णये",
 "ait_seq73_u39_padya_p05_e509a7": "दिविष्ठाय स्वपुरुषरूपाय प्रयच्छति देवरेतःस्थिताय च",
 "ait_seq73_u39_padya_p09_41c90d": "एवमादित्यनाम्नो विष्णोः",
 "ait_seq73_u39_padya_p13_d2100f": "भगवानेव ह्यत्र प्रस्तुतः",
 "ait_seq75_u01_padya_p01_00959d": "यन्नारायणादिरूपेण पञ्चविधमक्षरं परं ब्रह्म तत् स्वस्मिन्नेव स्त्रीपुंरूपेण समेति",
 "ait_seq75_u01_padya_p05_5b4ee1": "तत्र तस्मिन्नेव परे ब्रह्मणि नारायणाख्ये सर्वदेवा एकीभवन्ति मुक्ताः",
 "ait_seq75_u04_padya_p01_13a707": "इत्यादिवत्",
 "ait_seq75_u04_padya_p05_226a04": "नचाज्ञात एकत्वे पुनर्ज्ञाते ऐक्यं प्राप्त इति प्रयोगो दृश्यते",
 "ait_seq75_u04_padya_p09_f45189": "किन्तु संसर्ग एव भवति",
 "ait_seq75_u08_padya_p03_b97e16": "तस्मान्न पुनरुक्तिः",
 "ait_seq75_u08_padya_p07_38a2ed": "ततश्चाधिकं समतृप्यन्",
 "ait_seq75_u08_padya_p11_b86af4": "सर्वयुजो भवन्ति मनोवाक्कर्मभिस्तत्रैव युक्ता भवन्ति",
 "ait_seq75_u14_padya_p02_3d41e1": "स्वतन्त्रो हि भगवान् तत्प्रेरित एव तं वदतीत्यभिप्रायः",
 "ait_seq75_u14_padya_p06_12b084": "तस्माद् वदत्येव",
 "ait_seq75_u22_padya_p03_20ce0f": "अकारो विशेषतो नारायणवाचक इत्याह- अः इति ब्रह्मेति",
 "ait_seq75_u24_padya_p04_3361f3": "प्रत्यक्षत्वाज्जीवजडात्मकस्य जगत एवानुक्तावपि प्रस्तुतरूपत्वात् तदन्यस्तद्विरोधी तत्र दृश्यमानदोषवर्जितश्चाकारशब्दार्थ इति सिद्ध्यति",
 "ait_seq75_u24_padya_p08_a02d5b": "नच शून्यस्याशब्दार्थता",
 "ait_seq75_u24_padya_p12_afa51a": "एकदेशार्थत्वात्",
 "ait_seq75_u24_padya_p16_bb6277": "तस्मात् पारतन्त्र्याल्पगुणत्वादिसर्ववस्तुस्वभावविरुद्धस्वभावं स्वतन्त्रं पूर्णगुणं सर्वजीवजडेभ्योऽन्यद् अज्ञानदुःखाल्पत्वपारतन्त्र्योत्पत्तिनाशादिसर्वदोषविवर्जितं ब्रह्मैवाशब्दार्थः",
 "ait_seq75_u24_padya_p20_441afe": "तस्मादकारशब्दार्थ एव ब्रह्मशब्दार्थः",
 "ait_seq75_u26_padya_p02_b40964": "अः इति ब्रह्म पूर्णं वस्तूच्यते",
 "ait_seq75_u26_padya_p06_9c30cc": "अन्येषां सर्वेषां मदधीनत्वादल्पत्वादिति",
 "ait_seq75_u28_padya_p01_1028a2": "इति",
 "ait_seq75_u30_padya_p01_dcf9fe": "इति",
 "ait_seq75_u34_padya_p03_98e323": "जीवस्थितेनाक्षरगेनाक्षरनाम्ना स्वरूपेण जीवाख्यसूर्यस्थितमहराख्यं स्वरूपमाप्नोति तेन चाक्षराख्यं स्वरूपमाप्नोति",
 "ait_seq75_u36_padya_p04_b2a0bb": "नच नपुंसकरूपं भगवतः कुत्रचिदुक्तम्",
 "ait_seq75_u38_padya_p01_6bc841": "इति ब्रह्माण्डे",
 "ait_seq75_u40_padya_p02_36ef93": "तेन रथेनाध्यात्मं शरीराख्येनाधिदैवं रथरूपेण",
 "ait_seq75_u44_padya_p03_59e013": "विवस्वतो विष्णोः सकाशाद् दिवोदुहिता अहनी च जायन्ते",
 "ait_seq75_u44_padya_p07_376c39": "सूर्यस्याश्विनामाभावात्",
 "ait_seq75_u46_padya_p02_ac44c8": "नच रात्रौ सुदिनमिति प्रयोगो दृष्टः",
 "ait_seq75_u48_padya_p01_415f84": "इति ज्ञानावस्थायां मुक्तौ भोगबाहुल्यकारणत्वात् साऽपि मुक्तिवत् सुदिनम्",
 "ait_seq75_u50_padya_p03_771c13": "ज्ञानात् पूर्वं तु पतनसंशयादेव न सुदिनम्",
 "ait_seq75_u52_padya_p01_10a562": "इति वचनात्",
 "ait_seq186_u01_padya_p01_737262": "भगवदुपासकस्य यस्मिन् कस्मिंश्चिद् दोष उक्ते तं प्रत्युक्तिप्रकारः पूर्वं दर्शितः",
 "ait_seq186_u03_padya_p01_1fe17e": "इति च",
 "ait_seq186_u03_padya_p05_b6eb15": "मम प्रीतिं कर्तुं नाशकः",
 "ait_seq12_u01_padya_p04_3a85ee": "अध्यात्मे च निविष्टोऽसौ पुरुषाख्यो जनार्दनः",
 "ait_seq12_u01_padya_p08_7bd144": "अग्निवातदिनेशानामुत्थानानि पृथक्पृथक्",
 "ait_seq12_u01_padya_p12_caaf64": "अन्नाभिमानिदेवश्च तृचाशीत्याश्च देवताः",
 "ait_seq12_u01_padya_p16_0a5efd": "अरणं गमनं यस्मादर्कः शीघ्रगतित्वतः",
 "ait_seq12_u01_padya_p20_173729": "योऽसौ चितिगतो वीन्द्रः सोऽग्निवातरविष्वपि",
 "ait_seq12_u01_padya_p24_67513a": "व्याप्तत्वाज्जीवदेहेषु मुखे विष्णोर्मुखं स्मृतम्",
 "ait_seq12_u01_padya_p28_20ef18": "चक्षुस्तु कपिलो विष्णुरग्न्यादीनां च कारणम्",
 "ait_seq12_u01_padya_p32_8e2c90": "स एव व्यूह्य चात्मानं पृथग्रूप इव स्थितः",
 "ait_seq12_u01_padya_p36_ae0936": "अन्ने स्थितः स एवेशो ह्यन्नदातृगतिप्रदः",
 "ait_seq12_u01_padya_p40_27a5b9": "निहितश्चैव तल्लोको नासिकायां नतस्थले",
 "ait_seq12_u01_padya_p44_a06be3": "भोग्यत्वादाद्य इत्युक्त एवमाद्यात्तृरूपवान्",
 "ait_seq12_u01_padya_p48_bf3872": "सर्वे लोकास्तथा कर्तुं नैवेष्टे कश्चन क्वचित्",
 "ait_seq16_u01_padya_p04_d55c40": "तस्मात् प्रपदनादेव प्रपदं नाम कीर्तितम्",
 "ait_seq16_u01_padya_p08_8fa4f2": "स्थित ऊरू च तावास्तामूरूर्ध्वगमनाद्धरेः",
 "ait_seq16_u01_padya_p12_7c740f": "तत्स्थानमुदरं नाम पुनराह जनार्दनः",
 "ait_seq16_u01_padya_p16_b0bc5a": "सूक्ष्मदृष्टियुता ये तु मुनयः शार्कराक्ष्यकाः",
 "ait_seq16_u01_padya_p20_a3cb90": "एकमेव यतस्तस्मादुभये ह्यपि तद्विदः",
 "ait_seq16_u01_padya_p24_67c44d": "शेषः सुपर्ण इन्द्रश्च मनांस्येव पृथक्पृथक्",
 "ait_seq16_u01_padya_p28_71c135": "एते देवास्तदन्ये च सर्वप्राणिषु संस्थिताः",
 "ait_seq16_u01_padya_p32_d4597c": "देहादब्जभवस्यास्माद् यस्मिन्नुत्क्रान्त एव हि",
 "ait_seq16_u01_padya_p36_992869": "वायावुत्क्रान्त एवैतच्छरीरमपतत् क्षितौ",
 "ait_seq16_u01_padya_p40_e3aac1": "नोत्थानमभवत् तेषु प्रविष्टेष्वपि सर्वशः",
 "ait_seq16_u01_padya_p44_9d1343": "भृत्या वयं तवैव स्म त्वमस्माकं पतिः सदा",
 "ait_seq18_u01_padya_p01_7a24a5": "तस्माच्छ्रुत्वा परं ब्रह्म देवा नारायणाभिधम्",
 "ait_seq18_u01_padya_p05_c7289d": "तत्रतत्र प्रविष्टत्वात् प्रततोऽसौ बभूव ह",
 "ait_seq18_u01_padya_p09_1d848a": "वायोस्तत् पुनरध्यात्मं प्राणापानाभिधं द्वयम्",
 "ait_seq18_u01_padya_p13_96709c": "श्रोत्राभिमानिनः सर्वे वैदिकश्रवणोचितम्",
 "ait_seq18_u01_padya_p17_9e7cdd": "श्रोत्रं यन्नीतिशास्त्रार्थं कुबेरश्च प्रकीर्तितः",
 "ait_seq18_u01_padya_p21_b13f6d": "शेषशङ्करशक्राश्च चन्द्रसूर्ययमा अपि",
 "ait_seq18_u01_padya_p25_629df2": "पूर्णज्ञानस्वरूपत्वादेतावत् कथितं भवेत्",
 "ait_seq18_u01_padya_p29_2d403e": "विष्णुना प्रहितानां हि देवानामहमुत्तमम्",
 "ait_seq18_u01_padya_p33_92f589": "अधिदैवेन सहिता विष्णुना प्रभविष्णुना",
 "ait_seq18_u01_padya_p37_23aacd": "एतादृशोपासनाया योग्यः सन् सततं सुधीः",
 "ait_seq18_u01_padya_p41_9d4349": "मानुषा ज्ञानमात्रेण स्वावरैः पूज्यतामियुः",
 "ait_seq18_u01_padya_p45_b2f9b0": "देवतात्रयमन्यच्च पृथक् सत्यमितीर्यते",
 "ait_seq18_u01_padya_p49_c72b69": "अन्नं प्रजापतिरिति श्रुतिरन्या ह्यभाषत",
 "ait_seq18_u01_padya_p53_64d36c": "शुक्लकृष्णकनीनासु चक्षुषोऽप्येत आस्थिताः",
 "ait_seq18_u01_padya_p57_a86dad": "मनुष्याणां ज्ञानमात्राद् दोषो नातितरां भवेत्",
 "ait_seq20_u01_padya_p04_3f231f": "दाम तेनैव बध्नाति सकलं जगदच्युतः",
 "ait_seq20_u01_padya_p08_94afbc": "ज्ञात्वा जगदुपास्ते तु योग्यः संस्तदुपासने",
 "ait_seq20_u01_padya_p12_46253b": "भूतयुक्ते रथे तस्मात् स तिष्ठति सुरार्चितः",
 "ait_seq20_u01_padya_p16_1a1e44": "सुपर्णशेषगिरिशशक्रसूर्याद्यमञ्जसा",
 "ait_seq20_u01_padya_p20_ff15f6": "छन्नश्छन्दोभिरेवं स केशवस्तेन चाभिधा",
 "ait_seq20_u01_padya_p24_7fa3aa": "छन्दस्सु संस्थितो विष्णुर्गोपायत्येव तद्विदः",
 "ait_seq20_u01_padya_p28_7d5521": "वायुश्च वायुसंस्थश्च कदाचिन्नैव तिष्ठतः",
 "ait_seq20_u01_padya_p32_f94031": "वायुस्तत्स्थो हरिश्चैव चरत्यमितपौरुषः",
 "ait_seq20_u01_padya_p36_9487f7": "हस्तयोरेतयोरेव नित्याक्षीणं वसु स्थितम्",
 "ait_seq20_u01_padya_p40_db7ba8": "आच्छाद्यन्ते वित्तवद्भिस्ताभ्यामेवं च चेतनाः",
 "ait_seq20_u01_padya_p44_8e2306": "बृहत्त्वात् बृहतीत्येव तयोर्नाम प्रकीर्तितम्",
 "ait_seq24_u01_padya_p01_2a54de": "आप इत्येव देवानां ब्रह्मादीनां कथं भवेत्",
 "ait_seq24_u01_padya_p05_1edbf2": "आ पूर्णत्वाद् गुणैः सर्वैस्तन्मूलमखिलस्य च",
 "ait_seq24_u01_padya_p09_643d76": "तन्नामाप इति ह्येतद् ब्रह्मरुद्रादिनां भवेत्",
 "ait_seq24_u01_padya_p13_1fba88": "तथाऽपि मुख्यया वृत्त्या व्यवहारव्यवस्थितिः",
 "ait_seq24_u01_padya_p17_fc0d18": "एवं स भगवान् विष्णुर्महिदासाभिधः प्रभुः",
 "ait_seq24_u01_padya_p21_416db3": "मयि देवास्तेषु चाहमिति विद्धि वरानने",
 "ait_seq24_u01_padya_p25_5686dd": "सम्भृता मत्त एवैते स एष भगवान् गिरिः",
 "ait_seq24_u01_padya_p29_519fe4": "गिरणाच्चाखिलस्यास्य प्राहुर्ब्रह्मगिरिं प्रभुम्",
 "ait_seq24_u01_padya_p33_3dd3ec": "असनाद् भगवान् सोऽसुः सर्वस्यापि जनार्दनः",
 "ait_seq24_u01_padya_p37_737cdd": "सुखज्ञानादिगुणदं पूर्णं सर्वगुणैः प्रभुम्",
 "ait_seq24_u01_padya_p41_4b2dc6": "स्थित्वा सुप्तेषु विष्णुं तं भूर्भूरित्येव शंसति",
 "ait_seq24_u01_padya_p45_c11c36": "ज्ञानैश्वर्यादिभिर्हीनाः पेतुरन्धे तमस्यथ",
 "ait_seq24_u01_padya_p49_acd14a": "प्रसादात् तस्य पाप्मा च पराभवति सर्वशः",
 "ait_seq24_u01_padya_p53_f4f056": "शरीराद् बहिरेतौ तु यदा निःसारयत्यजः",
 "ait_seq24_u01_padya_p57_656131": "अनेनैव गृहीतो हि प्राणोऽपानेन संयुतः",
 "ait_seq24_u01_padya_p61_81a334": "स्थूलसूक्ष्मविभागेन किमु वायुर्जगत्प्रभुः",
 "ait_seq24_u01_padya_p65_5b7698": "चेतनेशं हरिं याति विरुद्धगमनौ च तौ",
 "ait_seq24_u01_padya_p69_5f529b": "पूर्णानन्देन हरिणा गृहीतं तद्वशं सदा",
 "ait_seq24_u01_padya_p73_cd692f": "क्रमेण चतस्रो मूर्तयः",
 "ait_seq24_u01_padya_p77_465833": "इरामया इति दैर्घ्यमवधारणार्थम्",
 "ait_seq24_u04_padya_p01_835c21": "देशतः कालतोऽर्थाच्च बलतो गुणतस्तथा",
 "ait_seq24_u04_padya_p05_0077d1": "अचिन्त्यात् तु तथैश्वर्यादेकोऽपि बहुरूपवान्",
 "ait_seq24_u05_gadya_p01_c1237c": "इत्यादिशब्दनिर्णयवचनाद् द्विवचनमत्र व्यवहारमात्रमिति ता इत्युक्तम्",
 "ait_seq24_u07_padya_p02_a4cf19": "अद उ एव नारायणाख्यमधिदैवतमन्यानि दैवतमात्राणि",
 "ait_seq24_u09_gadya_p01_0a061f": "इत्यादि",
 "ait_seq24_u13_gadya_p01_2320e5": "इति सूत्रात्",
 "ait_seq24_u17_gadya_p01_65972f": "इत्यादिवच्च",
 "ait_seq24_u19_padya_p02_d87a3e": "अस्मै पुण्याय कर्मण इति",
 "ait_seq24_u19_padya_p06_949307": "अन्येषां जीवानां श्रवणजं भोगं स्वश्रोत्रेण दिग्भिरननुगृहीतेनैव भगवान् भुङ्क्ते",
 "ait_seq24_u21_padya_p02_74c451": "सृष्टिभेदादन्यथावचनम्",
 "ait_seq24_u21_padya_p06_2b9dc4": "पितृत्वं चात्रोक्तम्",
 "ait_seq24_u24_padya_p02_e492ee": "दैवतैरुपकारस्तु क्रियते नरकर्मणाम्",
 "ait_seq24_u26_padya_p01_634fd1": "आह महिदास ऐतरेयः",
 "ait_seq24_u28_padya_p01_bbb12e": "इन्द्रं कुत्सः",
 "ait_seq24_u31_gadya_p01_dcf9fe": "इति",
 "ait_seq71_u01_padya_p03_0eb563": "तस्यात्रैवान्तर्भावात्",
 "ait_seq71_u03_padya_p03_9cb0a4": "तस्या एव बृहतीसम्पादने नव स्रक्तयो भवन्ति",
 "ait_seq71_u03_padya_p07_aa4a5f": "स च वायुर्विष्णोर्मुख्यप्रतिमा",
 "ait_seq71_u03_padya_p11_58d67c": "ततश्चोमाया अपि भगवत्प्रतिमात्वाद् विष्णुप्रतिमास्थापक एव भवत्येतत् सर्वं सम्यग् ध्यायन्",
 "ait_seq71_u03_padya_p15_70df99": "अत एवेन्द्रात् परितन्वं मम इत्युक्तम्",
 "ait_seq71_u09_padya_p01_6697f6": "इत्यादि च",
 "ait_seq71_u11_padya_p03_47d8ec": "अकाराख्यवाग् विकारेषूत्तमो बृहतीसहस्राख्यः",
 "ait_seq71_u15_padya_p02_98ff00": "अकारार्थत्वान्नकारस्य किञ्चिन्मूलमिव",
 "ait_seq71_u15_padya_p06_c06aee": "यद्धि देवतासु करोति तदात्मन्यापतति",
 "ait_seq71_u15_padya_p10_5b7af7": "उकारादिविकारसहितत्वात् पुष्पफलात्मकश्च",
 "ait_seq71_u15_padya_p14_80f2ab": "नकारस्त्वच्छिरस्कत्वान्मूलभूतस्याकारस्यान्ते स्थितिरूपत्वादयथास्थितेरसत्यरूपः",
 "ait_seq73_u03_padya_p01_446ea6": "इति पुनःपुनः परामर्शः",
 "ait_seq73_u03_padya_p05_3fb616": "तस्मात् तमेव वेदा इन्द्रशब्देन वदन्ति मुख्यतः",
 "ait_seq73_u07_padya_p01_dcf9fe": "इति",
 "ait_seq73_u07_padya_p05_ff6844": "नचात्र द्वित्वगमकं चकारादिकं विद्यते",
 "ait_seq73_u09_padya_p03_5ae0fd": "अन्यथैकत्वमेव",
 "ait_seq73_u15_padya_p01_0a9a02": "इति पूर्वोक्त इन्द्रो विष्णुरेवेति सिद्धम्",
 "ait_seq73_u19_padya_p01_7c39e7": "इतीन्द्रस्य परमदैवं जनको यज्ञभागादिप्रदाता विष्णुरेव हि श्रूयते",
 "ait_seq73_u21_padya_p01_35387f": "इति वायुना विवदमान आजौ पराजितो वायुं प्रसादयित्वा चतुर्थे",
 "ait_seq73_u25_padya_p02_c58551": "तस्माद् भगवत एवैतद् यशो बृहदुक्थादिकम्",
 "ait_seq73_u27_padya_p04_6eda5f": "नात्र प्रेत्यशब्दो मरणवाची",
 "ait_seq73_u29_padya_p03_ecc6c0": "नच यशोमात्रराजनेन स्वस्य राजनं भवति",
 "ait_seq73_u33_padya_p03_3f14f1": "अनेन महिदासादिरूपेणामुं लोकं दिविष्ठं स्वरूपम्",
 "ait_seq73_u35_padya_p03_e753f6": "अनेन रूपेण तद्रूपमभिसम्भवति किम्? उभयोरपि परिहारदर्शनादस्यापि प्रश्नत्वमवगम्यते",
 "ait_seq73_u39_padya_p02_fd9ad1": "केन रूपेणेमं लोकमाभवति",
 "ait_seq73_u39_padya_p06_da64e1": "देवी लोहितस्थितमात्मनः स्त्रीरूपं महिदासादिरूपेभ्यो मानुषरेतःस्थितरूपेभ्यश्च दिविष्ठैश्च विष्ण्वादिस्वरूपैः प्रयच्छति च",
 "ait_seq73_u39_padya_p10_4a1bcd": "नह्यग्न्यादिस्वरूपमेव लोहितादि",
 "ait_seq73_u43_padya_p01_2bded9": "इत्यादि च ब्रह्माण्डे",
 "ait_seq75_u01_padya_p02_d2edd8": "स्त्रीपुंरूपेण युजो देवा अश्वरूपेण रथे युक्ताः सन्तो यन्नारायणाख्यं परं ब्रह्माभिसंवहन्ति",
 "ait_seq75_u01_padya_p06_6b34a6": "सन्तो मिलिता भवन्ति",
 "ait_seq75_u04_padya_p02_220325": "नचैकीभावशब्दः स्वरूपैकत्वविषये प्रयुज्यमानः कुत्रचिद् दृष्टः",
 "ait_seq75_u04_padya_p06_15894c": "किन्तु ज्ञात इत्येव प्रयुज्यते",
 "ait_seq75_u04_padya_p10_b5ddca": "तस्मादत्रापि संसर्ग एव विवक्षितः",
 "ait_seq75_u08_padya_p04_e1c0fa": "यस्मादक्षरान्नारायणाख्यात् स स्वयमेव भगवान् प्रादुर्भावरूपी स्त्रीपुंरूपेण युक्त आगच्छति",
 "ait_seq75_u08_padya_p08_aa6a11": "शृते परिपक्वे सति ज्ञाने",
 "ait_seq75_u10_padya_p01_c6e93b": "इति शब्दनिर्णये",
 "ait_seq75_u14_padya_p03_4aafd5": "वदन् वदति वदन्नेव वदति",
 "ait_seq75_u14_padya_p07_5c743a": "अप्रसिद्धत्वान्न वदति च",
 "ait_seq75_u24_padya_p01_1c9d6b": "इति शब्दनिर्णये",
 "ait_seq75_u24_padya_p05_e70e73": "मनसि प्रस्तुतत्वादवचनेऽपि प्रस्तुतमेवेदं सर्वम्",
 "ait_seq75_u24_padya_p09_a6739e": "शून्याङ्गीकारे ह्यकारस्याभावताख्य एक एवार्थ इति सिद्ध्यति",
 "ait_seq75_u24_padya_p13_985b3e": "तस्मादमुख्यार्थत्वादन्ययुक्तेनैवाकारेणाभाव इति तदुच्यते",
 "ait_seq75_u24_padya_p17_2f19cd": "पूर्णं हि ब्रह्मशब्दस्यार्थः",
 "ait_seq75_u24_padya_p21_d4709b": "तदेतदुक्तम्- अः इति ब्रह्मेति",
 "ait_seq75_u26_padya_p03_2e06d6": "तत्रागतमहमिति",
 "ait_seq75_u26_padya_p07_fa63e1": "मुक्तेभ्यः प्रलये लीनेभ्यश्च सर्ववस्तुभ्यः सदा विभिन्न एव भगवानिति",
 "ait_seq75_u28_padya_p02_a199c1": "नच निषेधस्वरूपे विरुद्धता चान्यता चास्तीत्येतावता पूर्णार्थता भवति",
 "ait_seq75_u30_padya_p02_7fac57": "तस्मान्नारायण एवाकारवाच्य इति सिद्धम्",
 "ait_seq75_u36_padya_p01_415352": "इत्यस्य व्याख्यानरूपत्वाच्चैतदवसीयते",
 "ait_seq75_u36_padya_p05_467177": "प्रसिद्धमेव च रूपद्वयम्",
 "ait_seq75_u38_padya_p02_9f3c2a": "नच रक्ष इति नपुंसकशब्दमात्रेण रावणादयो नपुंसका भवन्ति",
 "ait_seq75_u40_padya_p03_997ff5": "ऋभव इत्यत्र देवानां साधारणं नाम",
 "ait_seq75_u44_padya_p04_19dcbe": "अहनी इति द्विवचनेन द्वित्वे सिद्धेऽप्युभे इति वचनमध्यात्माधिदैवतयोरुभयोरपि वचनार्थम्",
 "ait_seq75_u44_padya_p08_981436": "सप्ताश्वत्वाच्च तद्रथस्य",
 "ait_seq75_u46_padya_p03_5412f8": "असुदिनस्यापि तत एव जातत्वाद् व्यर्थविशेषणता च",
 "ait_seq75_u48_padya_p02_5f234c": "नहि मुक्तावधिक्यार्जनमस्ति",
 "ait_seq75_u50_padya_p04_135479": "नचाश्विरथो वर्ण्यते",
 "ait_seq75_u52_padya_p02_e461f3": "नच विवस्वच्छब्दोऽश्विनोर्विद्यते",
 "ait_seq186_u01_padya_p02_5598de": "अनुव्याहारशब्देन भगवदुपासनाविषय एवास्याशक्त्यादिदोषं वदतः प्रत्युक्तिरुच्यते",
 "ait_seq186_u03_padya_p02_2f7658": "स य एनं प्राणं वंशमुपवदेत् प्राणं प्रत्येनमुपासकमुपवदेत्",
 "ait_seq186_u05_padya_p01_7446a9": "इति च भारते",
 "ait_seq12_u01_padya_p01_fee597": "उत्थापनादुक्थनामा स एव पृथिवीस्थितः",
 "ait_seq12_u01_padya_p05_daf299": "पूर्षु स्थितत्वात् स महान् प्रजानां पतिरेव च",
 "ait_seq12_u01_padya_p09_a4d8f2": "वदनं नासिका नेत्रमित्येतानि परात्मनः",
 "ait_seq12_u01_padya_p13_0e04d8": "सोम एव ततश्चान्नमशीतय इतीरितम्",
 "ait_seq12_u01_padya_p17_8081ae": "श्येन एव तदाकारा चितिरर्कपदोदिता",
 "ait_seq12_u01_padya_p21_736a2a": "तथा वाक्प्राणचक्षुष्षु तस्मात् तेऽर्काः प्रकीर्तिताः",
 "ait_seq12_u01_padya_p25_306b1b": "नासयोर्नासिके विष्णोरक्ष्णोरेव तदक्षिणी",
 "ait_seq12_u01_padya_p29_263c0f": "जीववागादिसंस्थं च सुपर्णमधिसंस्थिताः",
 "ait_seq12_u01_padya_p33_3d09d4": "सुपर्णनामा भगवान् सुपर्णे च व्यवस्थितः",
 "ait_seq12_u01_padya_p37_9430f5": "तस्यान्तरिक्षगस्यैव नियमादनुपक्षिणः",
 "ait_seq12_u01_padya_p41_7eab44": "पृथिव्यां संस्थितो विष्णुः स्त्रीरूपेण द्युलोकतः",
 "ait_seq12_u01_padya_p45_5b128b": "एक एव परो विष्णुरत्ताऽन्यैरुपजीव्यतः",
 "ait_seq16_u01_padya_p01_a22e6f": "तमिमं प्रथमज्ञानिपुरुषं चतुराननम्",
 "ait_seq16_u01_padya_p05_f4873a": "चतुर्मुखाकारवतां नृणां पादतलोपरि",
 "ait_seq16_u01_padya_p09_114223": "किञ्चिदूर्ध्वं ततो गत्वा वायुना सह केशवः",
 "ait_seq16_u01_padya_p13_a04c8a": "उरु स्थानं निवासं मे कुरु विस्तारसंयुतम्",
 "ait_seq16_u01_padya_p17_089a82": "उदरे ते परं ब्रह्म वासुदेवमुपासते",
 "ait_seq16_u01_padya_p21_b7bb73": "तत ऊर्ध्वं गतो विष्णुर्वायुना सह दैवतैः",
 "ait_seq16_u01_padya_p25_2f16c0": "अहम्भावमनो रुद्रः शेषोऽसौ पाञ्चरात्रकम्",
 "ait_seq16_u01_padya_p29_51f196": "उपासते महाविष्णुं परमात्मानमच्युतम्",
 "ait_seq16_u01_padya_p33_bce795": "शरीरं पद्यते श्रेयान् स न इत्यवधार्यताम्",
 "ait_seq16_u01_padya_p37_4dfa68": "उदासीनवदास्तां तौ केशवश्चाब्जसम्भवः",
 "ait_seq16_u01_padya_p41_28441e": "वायौ प्रविष्टे तूत्थानं कायस्यासीत् तदैव च",
 "ait_seq16_u01_padya_p45_cdf389": "स्पर्धामहे त्वद्बलेन त्वया नान्येन केनचित्",
 "ait_seq18_u01_padya_p02_fabf9b": "शिष्यप्रशिष्यादिषु च तेऽनयन् वायुनोदितम्",
 "ait_seq18_u01_padya_p06_680ec4": "प्रततत्वात् प्रातरिति तस्य नामाभवद् विभोः",
 "ait_seq18_u01_padya_p10_2bdd27": "अध्यात्ममग्निर्वागाख्यश्चक्षुः सूर्यः प्रकीर्तितः",
 "ait_seq18_u01_padya_p14_3e17f3": "श्रोत्रं चन्द्रस्तथा स्मार्ततान्त्रिकश्रवणोचितम्",
 "ait_seq18_u01_padya_p18_a1d878": "विष्णुना प्रहितानां हि संयोगोऽध्यात्ममेष हि",
 "ait_seq18_u01_padya_p22_2e8168": "अग्निश्च मित्रावरुणौ कुबेराद्याश्च सर्वशः",
 "ait_seq18_u01_padya_p26_44a4b1": "तात्पर्यात् सर्ववेदैश्च तज्जानन्नवदन् मुनिः",
 "ait_seq18_u01_padya_p30_c27cfa": "वेद संयोगमध्यात्मं ततो मुक्तौ यथेष्टभुक्",
 "ait_seq18_u01_padya_p34_4bd7a0": "एतद्धि तेन कथितं मुनिना तत्त्ववेदिना",
 "ait_seq18_u01_padya_p38_f0a512": "स्वस्वाम्यन्यानि भूतानि हरेयुर्बलिमस्य हि",
 "ait_seq18_u01_padya_p42_baa5cc": "मुक्तामुक्तैर्मुक्तियोग्या इति शास्त्रस्य निर्णयः",
 "ait_seq18_u01_padya_p46_5f6e8b": "शेषवीन्द्रशिवादिभ्य उत्तमत्वात् सदैव हि",
 "ait_seq18_u01_padya_p50_94ea8e": "अतिनादात् सदा वेदैरप्यन्नं स चतुर्मुखः",
 "ait_seq18_u01_padya_p54_4df950": "एवं सत्यपदार्थं हि विज्ञायोपास्त आदरात्",
 "ait_seq20_u01_padya_p01_33499a": "तस्य नारायणस्यैव सर्ववेदात्मिका हि वाक्",
 "ait_seq20_u01_padya_p05_370457": "सर्वे हि नामवन्तोऽत्र सर्वे वेदोदिता अपि",
 "ait_seq20_u01_padya_p09_b8b06a": "तं प्रत्येवाखिलान्येव भूतानि सह दैवतैः",
 "ait_seq20_u01_padya_p13_8e9494": "मुक्तः संश्च तदन्येषां ज्ञानमात्राद् विमुक्तिगैः",
 "ait_seq20_u01_padya_p17_b892c4": "विष्णोर्वायोश्च लोमादौ छन्दांस्येवाश्रितानि च",
 "ait_seq20_u01_padya_p21_b3d8ff": "छन्दांसीत्येव तेषां हि य एवंविदुपासकः",
 "ait_seq20_u01_padya_p25_e6e779": "मन्त्रोऽप्यर्थमिमं प्राहापश्यं गोपामिति स्म ह",
 "ait_seq20_u01_padya_p29_97577b": "वायुर्हि नित्यसञ्चारी सदा सर्वप्रवृत्तिमान्",
 "ait_seq20_u01_padya_p33_4b9405": "सध्रीचीनासु पूर्वादिदिक्ष्वेतौ चतसृष्वपि",
 "ait_seq20_u01_padya_p37_e84eb8": "तद्ध्यसह्यं बलं वायोरनन्तं किमु तद्धरेः",
 "ait_seq20_u01_padya_p41_8178d0": "आवृता महदाद्यास्तु देहे तिष्ठन्ति चैतयोः",
 "ait_seq20_u01_padya_p45_0239bd": "वायुकेशवयोः प्राणनाम सर्वप्रणायनात्",
 "ait_seq24_u01_padya_p02_b07bb6": "नामेत्यपृच्छल्लक्ष्मीस्तं महिदासं जनार्दनम्",
 "ait_seq24_u01_padya_p06_9dec92": "तूलभूतं तदन्यत् तु पिता ह्येष जनार्दनः",
 "ait_seq24_u01_padya_p10_14c897": "यथा यदव इत्येव रघवः कुरवस्तथा",
 "ait_seq24_u01_padya_p14_2d0727": "आप इत्येव देवानां सर्वेषां प्रददौ हरिः",
 "ait_seq24_u01_padya_p18_710111": "जानन् नित्योदितज्ञानादाह देवीमिदं वचः",
 "ait_seq24_u01_padya_p22_2429aa": "मयैतानि प्रदत्तानि पदानि ब्रह्मपूर्वकाः",
 "ait_seq24_u01_padya_p26_059cc9": "गिरणात् सर्वभूतानां चक्षुर्नामास्य दर्शनात्",
 "ait_seq24_u01_padya_p30_3905b1": "य एवं वेद तं विष्णुमापरोक्ष्येण शाश्वतम्",
 "ait_seq24_u01_padya_p34_ab8184": "प्रकृष्टानन्दरूपत्वात् प्राण इत्यभिधीयते",
 "ait_seq24_u01_padya_p38_cbdc1d": "उपासते तं वाय्वाद्या देवास्तस्माच्च तेऽखिलाः",
 "ait_seq24_u01_padya_p42_a2b3e8": "भूःशब्दार्थो भूतिरिति वैपरीत्येन चासुराः",
 "ait_seq24_u01_padya_p46_fe6bc0": "य एवं वेद तं विष्णुं भूतिदं भूतिरूपिणम्",
 "ait_seq24_u01_padya_p50_0887a4": "स एष भगवान् विष्णुर्मृत्युदो मोक्षदस्तथा",
 "ait_seq24_u01_padya_p54_2b0ed5": "तदा मृत्युप्रदश्चायं मुक्तानामपि जीवनम्",
 "ait_seq24_u01_padya_p58_9193b3": "अनेन हरिणा यस्मान्नियतो न पराग् भवेत्",
 "ait_seq24_u01_padya_p62_a4f35a": "नानागती तु तावेतौ वायुः प्राप्नोति केशवम्",
 "ait_seq24_u01_padya_p66_0a0e38": "ऊर्ध्वं गच्छति देवः स देहोऽधः पतति क्षितौ",
 "ait_seq24_u01_padya_p70_ddbb80": "स मुक्तो लोकमाप्नोति विष्णोर्मुक्तैश्च दृश्यते",
 "ait_seq24_u01_padya_p74_de7694": "नासिकायां यन्नेत्रयोर्मध्ये",
 "ait_seq24_u02_padya_p01_f55792": "दैर्घ्यं प्लुतं च हिङ्कारो बिन्दुरप्यवधारणे",
 "ait_seq24_u04_padya_p02_2341ed": "स्वरूपतोऽपि नैव स्याद् भेदोऽत्यल्पोऽपि यत्र हि",
 "ait_seq24_u04_padya_p06_86166d": "प्रकाशयेद् यतो विष्णुः सर्वत्राप्यविशेषवान्",
 "ait_seq24_u06_padya_p01_a20f6b": "संहितायां यत्र दैर्घ्यं पदे यत्र न विद्यते",
 "ait_seq24_u07_padya_p03_ae955f": "स्थानान्तरेऽन्येषामप्यधिदैवत्वकथनं कर्मजदेवाद्यपेक्षया",
 "ait_seq24_u10_padya_p01_febf0b": "लोमसूष्णिक्",
 "ait_seq24_u14_padya_p01_7680dd": "स च्छन्दोभिश्छन्नः",
 "ait_seq24_u18_padya_p01_397900": "अङ्गेषु यस्य च्छन्दांसि देवा लोका मखा अपि",
 "ait_seq24_u19_padya_p03_da12fa": "एतमुद्दिश्य जीवानां पुण्यकर्म कर्तुम्",
 "ait_seq24_u19_padya_p07_66a159": "नच जीववागादिना पृथिव्यग्न्यादिकं सृष्टमित्यत्र किञ्चिन्मानमस्ति",
 "ait_seq24_u21_padya_p03_f11341": "नच मुख्यकारणाङ्गीकारेऽविरोध औपचारिकं कारणमङ्गीकर्तुं युक्तम्",
 "ait_seq24_u22_padya_p01_a74784": "वाचं पितरम्",
 "ait_seq24_u24_padya_p03_ab7280": "देवानां कर्मणैवैते जायन्ते सर्वमानुषाः",
 "ait_seq24_u27_padya_p01_97a524": "इति तु सर्वस्य वचनस्य तदीयत्वज्ञापनार्थम्",
 "ait_seq24_u29_padya_p01_9b13e3": "इत्यादि",
 "ait_seq65_u01_gadya_p03_8c2296": "स जीवो यद्यपि भगवत्प्रसादात् सर्वलोकाधिपो भवति",
 "ait_seq71_u01_padya_p04_7d7c6e": "जगत्यादिकं त्वधिकत्वेऽपि बृहतीवन्माहात्म्याभावादेवोपेक्ष्यते",
 "ait_seq71_u03_padya_p04_813621": "ऋचा वाक् ऋग्रूपेण वाग् ऋतं स्पृष्टा सत्यरूपं विष्णुं स्पृष्टा भवति",
 "ait_seq71_u03_padya_p08_dec32a": "तस्माद् विष्णोरेव प्रतिमा बृहतीसहस्रम्",
 "ait_seq71_u03_padya_p12_60834a": "विष्णुरेव बृहत्याः प्राणस्याधिष्ठातृदेवता",
 "ait_seq71_u03_padya_p16_f21fcf": "बृहतीस्थविष्णोर्बलादेव तत् सम्पद्यते",
 "ait_seq71_u09_padya_p02_afbd44": "स्रक्तयो विभागाः",
 "ait_seq71_u13_padya_p01_4d6599": "इत्यादि ब्रह्मसारे",
 "ait_seq71_u15_padya_p03_62cddd": "तस्मान्मूलत्वादकारार्थोऽपि ज्ञेय एव",
 "ait_seq71_u15_padya_p07_6c0642": "तस्माद् द्रव्यदानं ज्ञानदानं वा काले पात्राद्यनुसारेणैव कुर्यात्",
 "ait_seq71_u15_padya_p11_de2222": "अकारस्यार्थरूपः सन्नेव च भगवांस्तमेवोङ्कारो वक्ति",
 "ait_seq71_u15_padya_p15_ad567a": "तथाऽप्यकारस्य नकारस्य चैकार्थत्वान्मूलभूतश्च",
 "ait_seq73_u03_padya_p02_401288": "तदिदं बृहतीसहस्रं तद्यशः तस्य नारायणस्य यशः",
 "ait_seq73_u05_padya_p01_4cd9aa": "इति धातोश्च तस्यैव हि परमैश्वर्यम्",
 "ait_seq73_u07_padya_p02_b6d946": "नचेन्द्रं विष्णुं चेति पृथगन्वयः क्रियते",
 "ait_seq73_u07_padya_p06_1f820c": "तस्मात्",
 "ait_seq73_u11_padya_p01_080568": "इति चोक्तम्",
 "ait_seq73_u15_padya_p02_f53089": "महत्त्वं च तस्यादितिपुत्रत्वेऽग्रजत्वमात्रं नतु सामर्थ्यतः",
 "ait_seq73_u19_padya_p02_5b4471": "इन्द्रश्च यजमानः",
 "ait_seq73_u21_padya_p02_b47225": "वायुना सह ग्रहमाप",
 "ait_seq73_u27_padya_p01_6b6cf5": "इत्यादि च",
 "ait_seq73_u27_padya_p05_e33e75": "किन्तु",
 "ait_seq73_u29_padya_p04_0d12f6": "भिन्नपदार्थत्वात्",
 "ait_seq73_u33_padya_p04_325a02": "लोक्यत इति स्वरूपवाची लोकशब्दः",
 "ait_seq73_u37_padya_p01_476b6a": "इत्यादिवत्",
 "ait_seq73_u39_padya_p03_7f9943": "केन स्वरूपेण भूमिष्ठेनात्मन एव स्त्रीरूपेण विष्णुः सम्बध्यते",
 "ait_seq73_u39_padya_p07_fa150f": "तानि भूमिष्ठत्वेन दिविष्ठत्वेन द्विविधत्वात् तावित्युच्यन्ते",
 "ait_seq73_u39_padya_p11_d28feb": "नच लौकिकस्त्रीपुरुषसम्बन्धमात्रमत्रोच्यते",
 "ait_seq73_u43_padya_p02_68cb8a": "यदक्षरं पञ्चविधं समेति",
 "ait_seq75_u01_padya_p03_59b27d": "तदेतत् सत्यस्य सत्यं नारायणाख्यं ब्रह्म यत्रानुयुज्यते यस्मिन् स्वरूप",
 "ait_seq75_u01_padya_p07_aac0e6": "नायमेकीभावो नाम स्वरूपैक्यम्",
 "ait_seq75_u04_padya_p03_28491f": "एकः पुरुषोऽपि यदा द्विधा भूत्वा एकीभवतीत्युच्यते तदाऽपि स्थानैक्यमेव",
 "ait_seq75_u04_padya_p07_67a86b": "तस्माद् भावसहित एकशब्दो न स्वरूपवाची",
 "ait_seq75_u08_padya_p01_ebbdb1": "इति परामर्शं कृत्वा",
 "ait_seq75_u08_padya_p05_90f38a": "तात्पर्यार्थं तस्यैवार्थस्य पुनरभ्यासः",
 "ait_seq75_u08_padya_p09_51a226": "यस्मिन् विष्णौ नामानि ज्ञात्वा तस्मिन् ज्ञाने परिपक्वे समतृप्यन्",
 "ait_seq75_u10_padya_p02_34fc66": "अस्त्री पुमान् ब्रुवन् अस्त्री पुमांसं ब्रुवन्",
 "ait_seq75_u14_padya_p04_5c3853": "वदन्नेव न वदति",
 "ait_seq75_u22_padya_p01_6087b1": "इत्याद्यर्धनारीनारायणतन्त्रे",
 "ait_seq75_u24_padya_p02_873a0f": "तत्रागतमहमिति",
 "ait_seq75_u24_padya_p06_1090bb": "दृष्टसम्बन्धित्वाददृष्टं सर्वमपि प्रस्तुतं भवति",
 "ait_seq75_u24_padya_p10_3e3f52": "विष्णोरङ्गीकारे त्वभावताऽन्यता विरोधितेति त्रयोऽप्यर्थाः सम्यगेव सिद्ध्यन्ति",
 "ait_seq75_u24_padya_p14_c605ae": "नत्व इत्येव केनचित् क्वचित्",
 "ait_seq75_u24_padya_p18_05ed23": "नच दोषयुक्तस्य पूर्णता",
 "ait_seq75_u24_padya_p22_1dc666": "अः इति पृथक्त्वेन वचनं तत्सममधिकं वा किमपि नास्तीति दर्शयितुम्",
 "ait_seq75_u26_padya_p04_9f74eb": "तत्राकारस्य पूर्णवाचित्वेऽहमेव सोऽकारवाच्य इत्याह महिदासरूपो भगवान् नारायणः",
 "ait_seq75_u26_padya_p08_0c8cda": "दर्शयितुं च अः इति पृथग् वचनम्",
 "ait_seq75_u28_padya_p03_420d42": "तदाऽर्थत्रयकल्पनस्य वैयर्थ्यात्",
 "ait_seq75_u34_padya_p01_9e8495": "इत्यर्धनारीनारायणतन्त्रे",
 "ait_seq75_u36_padya_p02_7510d6": "पुमांसं स्त्रियं च वदन्नेव न वदतीत्युक्तत्वादुभयात्मकं रूपं प्रतीयते",
 "ait_seq75_u36_padya_p06_51638b": "अतो नपुंसके वदन्नपि न वदतीति न तद्वदनुषज्यते",
 "ait_seq75_u38_padya_p03_bc4400": "भवतीतिपदाभावादनकाममार इति भगवन्नामैवेति ज्ञायते",
 "ait_seq75_u44_padya_p01_9c1d36": "इत्याद्यैतरेयसंहितायाम्",
 "ait_seq75_u44_padya_p05_c511f4": "नच सूर्यरथोऽत्र वर्ण्यते",
 "ait_seq75_u44_padya_p09_9eebd7": "चतुरश्वत्वं चात्रोच्यते",
 "ait_seq75_u46_padya_p04_3c674b": "अस्मिन् पक्षे तु लौकिकाहर्व्यावृत्त्यर्थं सुदिने इति युज्यते",
 "ait_seq75_u50_padya_p01_10a562": "इति वचनात्",
 "ait_seq75_u50_padya_p05_6090a8": "नह्यश्विरथयोगादहनी जायेते",
 "ait_seq75_u56_padya_p01_6b5c51": "इत्यादिना तस्यैव प्रस्तावाच्च",
 "ait_seq186_u01_padya_p03_797130": "निर्भुजं वदन्तमित्यादि त्ववस्थामात्रदर्शनम्",
 "ait_seq186_u03_padya_p03_c79750": "प्राणस्य विष्णोः प्रियत्वं तव न प्राप्स्यतीति"
}