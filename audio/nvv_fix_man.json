{
 "nvv_seq465_u01_padya_p01_7ca743": "इत्यनन्तमहान्यायमीमांसापारवारिधेः",
 "nvv_seq465_u01_padya_p02_49b3f6": "उत्तारणात्यशक्त्यैव व्याकुलीकृतचेतसाम्",
 "nvv_seq465_u02_padya_p01_66793d": "मन्दानामुपकाराय महतां चोच्छ्रितात्मनाम्",
 "nvv_seq465_u02_padya_p02_451540": "तद्विशेषपरिज्ञानप्रदीप्तार्काभचेतसाम्",
 "nvv_seq465_u03_padya_p01_252c32": "विशेषगाढे मनसि नितरामुपकारकः",
 "nvv_seq465_u03_padya_p02_11afb0": "न्यायप्लवो मयाऽकारि सङ्क्षेपात् प्रमिताक्षरैः",
 "nvv_seq465_u04_padya_p01_e17d1d": "विस्तरोऽप्ययमेव स्यात् तद्विशेषातिवेदिनाम्",
 "nvv_seq465_u04_padya_p02_0ebe61": "व्याख्यानुव्याख्यायोरेव विस्तारो यदुदीरितः",
 "nvv_seq465_u05_padya_p01_e8dcba": "अनल्पचेतसां पुंसामलं विज्ञानसिद्धये",
 "nvv_seq465_u05_padya_p02_ac8de1": "तन्न्यायोद्धरणेशक्ता अपि ह्येतेन सुस्थिरम्",
 "nvv_seq465_u06_padya_p01_4ad477": "न्यायानुगं मनः कुर्युरितिसङ्ग्रहलालसाः",
 "nvv_seq465_u06_padya_p02_5d3778": "को नामाशेषविद्योरुसागरोन्मथनोद्धृतम्",
 "nvv_seq465_u07_padya_p01_b538c6": "साक्षाद्विद्याधिराजेन न्यायामृतमनुत्तमम्",
 "nvv_seq465_u07_padya_p02_24a855": "अशेषतोऽधिगच्छेत वन्द्यो वृन्दारकोऽपि सन्",
 "nvv_seq465_u08_padya_p01_a21100": "एवं सुदुर्लभेऽप्यद्धा महान्यायपरामृते",
 "nvv_seq465_u08_padya_p02_357227": "केचनाधिक्रियन्तेऽत्र तत्प्रसादानुरञ्जिताः",
 "nvv_seq465_u09_padya_p01_b061e8": "ब्रह्माद्या अमृते यद्वत् सागरोन्मथनोद्धृते",
 "nvv_seq465_u09_padya_p02_ad52c8": "अहं तु तत्प्रसादैकमहास्पदबलोद्धतः",
 "nvv_seq465_u10_padya_p01_5924fc": "न्यायमृतार्णवमिममवगाह्य विभज्य च",
 "nvv_seq465_u10_padya_p02_dbe299": "सङ्क्षेपविस्तराभ्यां च चकार व्याकृतिं कृतिम्",
 "nvv_seq465_u11_padya_p01_0a4201": "तत्प्रसादमृते कस्य शक्तिः संसारसागरे",
 "nvv_seq465_u11_padya_p02_262d41": "मग्नस्य चेतनस्य स्यात् तत्कृतानुकूतौ क्वचित्",
 "nvv_seq465_u12_padya_p01_c7823d": "नित्यानन्दामृतस्यन्दितत्कटाक्षैधितस्य तु",
 "nvv_seq465_u12_padya_p02_3a7399": "का नु शक्तिर्भवेन्नैव ततः को वाऽतिविस्मयः",
 "nvv_seq465_u13_padya_p01_19de68": "विद्याविद्ये सुखं दुःखमशक्तिः शक्तिरेव च",
 "nvv_seq465_u13_padya_p02_1da0a4": "उत्पत्तिस्थितिनाशाश्च विशेषाश्च परेखिलाः",
 "nvv_seq465_u14_padya_p01_4aebe4": "चेतनाचेतनस्यास्य समस्तस्य यदिच्छया",
 "nvv_seq465_u14_padya_p02_0c6b72": "स मम स्वकृतेनैव प्रीयतां पुरुषोत्तमः"
}