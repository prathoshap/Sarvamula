_u01_padya_p11_dfe8ca", "meter": "anuṣṭubh", "padas": ["व्यञ्जकाद् व्यक्तिमभ्येति तस्मात् तज्ज्ञानमुत्तमम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq89_u01_padya_p07_a71fdc", "meter": "anuṣṭubh", "padas": ["स्वाख्याच्छरीराज्जीवात् तु प्रवृहेद् विष्णुमव्ययम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq74_u01_padya_p23_581c84", "meter": "anuṣṭubh", "padas": ["एकः स्वतन्त्रो नान्योऽस्ति सर्वजीवान्तरस्थितः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq5_u01_padya_p06_e5453d", "meter": "anuṣṭubh", "padas": ["पत्न्या सम्पूज्यमानोऽपि जग्राहार्घ्यादिकं नतु"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq13_u09_padya_p01_b65c47", "meter": "śārdūlavikrīḍita", "padas": ["य एषु सुप्तेषु जागर्ति कामङ्कामं पुुरुषो निर्ममाणः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq48_u01_padya_p16_557e6e", "meter": "anuṣṭubh", "padas": ["शिवादीन् ब्रह्मवाय्वोस्तु नियच्छेन्महदात्मनोः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq1_u02_padya_p03_fa3644", "meter": "anuṣṭubh", "padas": ["उष्य मन्वन्तरं कालममृतत्वं भजेत् क्रमात्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq7_u04_padya_p01_5e8d6f", "meter": "anuṣṭubh", "padas": ["इष्टकादेवतां विष्णुं षष्ठ्युत्तरशतत्रिकम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq35_u01_padya_p02_3cbbd4", "meter": "anuṣṭubh", "padas": ["सर्वस्यालम्बनं ज्ञात्वा मुच्यते नात्र संशयः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq48_u01_padya_p13_a5e6ea", "meter": "anuṣṭubh", "padas": ["तस्यास्तु पुरुषो विष्णुः पूर्णत्वान्नैव तत्समः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq74_u01_padya_p16_c317d1", "meter": "anuṣṭubh", "padas": ["अतो मुख्याश्रयो विष्णुश्चेतनानां स्वतन्त्रतः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq79_u02_padya_p05_050590", "meter": "anuṣṭubh", "padas": ["प्रवाहतस्त्वनादिश्च मुख्यतस्त्वमृतो हरिः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq7_u02_padya_p01_95df81", "meter": "anuṣṭubh", "padas": ["अग्र्यत्वादग्निनामाऽसौ नाचिकेताग्निगो हरिः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq13_u05_padya_p04_cce219", "meter": "anuṣṭubh", "padas": ["गुणान् सर्वोत्तमत्वादीनविज्ञाय हरेस्तथा"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq48_u01_padya_p10_1ca6f3", "meter": "anuṣṭubh", "padas": ["मनोभिमानिनो रुद्रवीन्द्रशेषास्त्रयोऽपितु"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq68_u01_padya_p05_d74e09", "meter": "anuṣṭubh", "padas": ["अत्यल्मपि मृत्वा स तमोऽन्धं यात्यसंशयम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq74_u01_padya_p26_af0311", "meter": "anuṣṭubh", "padas": ["अनादिप्रतिबिम्बाश्च बभूवुस्ते ह्यनन्तकाः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq79_u02_padya_p13_e0b4fe", "meter": "anuṣṭubh", "padas": ["स्पष्टं तथा ब्रह्मलोके दृश्यते पुरुषोत्तमः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq5_u01_padya_p04_d038fe", "meter": "anuṣṭubh", "padas": ["उवाच पुत्रस्तं बालस्तं शशाप पिता स्वयम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq13_u03_padya_p02_68d890", "meter": "anuṣṭubh", "padas": ["देहाद् विमुच्यमानस्य किमत्र परिशिष्यते"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq48_u01_padya_p08_c8d9f8", "meter": "anuṣṭubh", "padas": ["यमो दक्षश्चेन्द्रियेशाः सुपर्णी वारुणी तथा"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq68_u01_padya_p01_22c8d3", "meter": "anuṣṭubh", "padas": ["यः प्रादुर्भावगो विष्णुर्देहादिषु च संस्थितः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq74_u01_padya_p11_b7bd01", "meter": "anuṣṭubh", "padas": ["तथैवर्तेषु मुक्तेषु गतास्ते विष्णुमित्यृताः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq74_u07_padya_p01_b74db8", "meter": "anuṣṭubh", "padas": ["ब्रह्मादीनां तु मुक्तानां सुखं विष्णुसुखस्य तु"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq95_u01_padya_p02_7f57f3", "meter": "anuṣṭubh", "padas": ["यस्याहमाप्त आप्तेभ्यो यो म आप्ततमः सदा"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq48_u01_padya_p18_e124ed", "meter": "anuṣṭubh", "padas": ["तद्वशत्वेन तद्ध्यानं नियमो नाम नापरः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq74_u01_padya_p09_9bb771", "meter": "anuṣṭubh", "padas": ["