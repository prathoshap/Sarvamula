", "padas": ["इति काठकोपनिषत् सम्पूर्णा"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq29_u02_gadya_p03_ad46ce", "meter": "anuṣṭubh", "padas": ["स्तोमेभ्योऽपि महान्तम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq62_u04_padya_p01_280f97", "meter": "anuṣṭubh", "padas": ["मुखादिन्द्रश्चाग्निश्च"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq89_u06_gadya_p05_98e8dc", "meter": "anuṣṭubh", "padas": ["न जीवोऽङ्गुष्ठमात्रः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq64_u03_gadya_p05_d3e8aa", "meter": "anuṣṭubh", "padas": ["सह विविधं जनयामास"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq1_u03_gadya_p01_d1fc82", "meter": "anuṣṭubh", "padas": ["इति ब्रह्मसारे"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq11_u05_gadya_p01_d35078", "meter": "anuṣṭubh", "padas": ["इति नामनिरुक्ते"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq62_u06_padya_p01_800df3", "meter": "vasantatilakā", "padas": ["जज्ञे बहुज्ञम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq33_u03_gadya_p01_ea9494", "meter": "anuṣṭubh", "padas": ["इति महावाराहे"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq5_u02_gadya_p01_3c4336", "meter": "anuṣṭubh", "padas": ["इति गतिसारे"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq13_u03_padya_p03_ab8f98", "meter": "anuṣṭubh", "padas": ["एतद् वै तत्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq11_u03_gadya_p01_0a061f", "meter": "anuṣṭubh", "padas": ["इत्यादि"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq62_u03_gadya_p01_abe7e9", "meter": "anuṣṭubh", "padas": ["इति च"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq74_u06_gadya_p01_abe7e9", "meter": "anuṣṭubh", "padas": ["इति च"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq89_u04_gadya_p01_abe7e9", "meter": "anuṣṭubh", "padas": ["इति च"], "seed": 60, "no_sandhi": true}]