[{"id": "kat_seq25_u01_sutra_p01_7562d2", "meter": "anuṣṭubh", "padas": ["दूरमेते विपरीते विषूची अविद्या या च विद्येति ज्ञाता विद्याभीप्सितं नचिकेतसं मन्ये न त्वा कामा बहवो लोलुपन्तः अविद्यायामन्तरे वर्तमानाः स्वयं धीराः पण्डितम्मन्यमानाः दन्द्रम्यमाणाः परियन्ति मूढा अन्धेनैव नीयमाना यथाऽन्धाः न साम्परायः प्रतिभाति बालं प्रमाद्यन्तं वित्तमोहेन मूढम् अयं लोको नास्ति पर इति मानी पुनःपुनर्वशमापद्यते मे श्रवणायापि बहुभिर्यो न लभ्यः शृण्वन्तोऽपि बहवो यं न विद्युः आश्चर्योऽस्य वक्ता कुशलोऽस्य लब्धा आश्चर्यो ज्ञाता कुशलानुशिष्टः न नरेणावरः प्रोक्त एष सुज्ञेयो बहुधा चिन्त्यमानः अनन्यप्रोक्ते गतिरस्य नास्त्यणीयान् ह्यतर्क्यमणुप्रमाणात् नैषा तर्केण मतिरापनेया प्रोक्ताऽन्येनैव सुज्ञानाय प्रेष्ठ यां त्वमापः सत्यधृतिर्बतासि त्वादृङ् नो भूयान्नचिकेतः प्रष्टा"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq76_u01_sutra_p01_e69ec9", "meter": "anuṣṭubh", "padas": ["न यत्र सूर्यो भाति न चन्द्रतारकं नेमा विद्युतो भान्ति कुतोऽयमग्निः तमेव भान्तमनुभाति सर्वं तस्य भासा सर्वमिदं विभाति"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq62_u01_sutra_p01_a40bd2", "meter": "śārdūlavikrīḍita", "padas": ["यः पूर्वं तपसोऽजातमद्भ्यः पूर्वमजायत गुहां प्रविश्य तिष्ठन्तं यो भूतेभिर्व्यपश्यत एतद् वै तत्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq11_u12_padya_p01_448fff", "meter": "sragdharā", "padas": ["तद् वा एतदक्षरं गार्ग्यविदित्वाऽस्मिल्ँलोके जुहोति यजते तपस्तप्यते बहूनि"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq58_u01_gadya_p02_a80aaa", "meter": "anuṣṭubh", "padas": ["यथा मरणं प्राप्य जीवो भवति तच्च प्रवक्ष्यामि जीवेश्वरभेदज्ञापनाय"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq13_u04_gadya_p04_e097aa", "meter": "anuṣṭubh", "padas": ["स्थूलदेहपरित्यागस्तु विस्रंसमानस्य इत्यनेनैवोक्तो भवति"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq68_u04_gadya_p02_258983", "meter": "anuṣṭubh", "padas": ["अतो नानेव इतीवशब्दोऽत्यल्पविषयो भेदाभेदविषयश्च"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq79_u02_padya_p04_9ada48", "meter": "anuṣṭubh", "padas": ["तद्व्याप्तत्वात् तदन्नत्वादश्