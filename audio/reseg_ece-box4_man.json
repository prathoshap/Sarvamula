{
 "bsb_1_1_3_u05_padya_p01_78375e": "इत्यादिश्रुतिभ्यश्च",
 "bsb_1_1_3_u11_padya_p01_55b4d2": "इति मोक्षधर्मवचनान्न नास्तिक्यवादो युज्यते",
 "bsb_1_1_6_u02_padya_p01_ebeeaa": "गौणश्चेन्नात्मशब्दात्",
 "bsb_1_1_6_u08_padya_p01_e420c4": "इति तलवकारब्राह्मणम्",
 "bsb_1_1_26_u06_padya_p03_2e45fc": "चतुर्भागबल इतिवद् भिन्नं च",
 "bsb_1_1_31_u04_padya_p03_bf94f9": "तस्मान्नेति चेत्",
 "bsb_1_1_31_u10_padya_p01_77b375": "इति ब्रह्माण्डे",
 "bsb_1_3_28_u06_padya_p02_b6addd": "तस्मान्नानीदृशं क्वापि विश्वमेतद् भविष्यति",
 "bsb_2_1_14_u04_padya_p01_a12c9f": "इति मुक्तजीवस्य परापत्तिरुच्यते",
 "bsb_2_1_14_u04_padya_p05_adcbbf": "न स्याल्लोकवत्",
 "bsb_2_1_14_u06_padya_p01_aa7892": "इति",
 "bsb_2_1_24_u02_padya_p01_3051c7": "अश्मादिवच्च तदनुपपत्तिः",
 "bsb_2_1_26_u02_padya_p03_8272f1": "देवादिवददृश्यत्वशक्तियोगात्",
 "bsb_2_1_29_u02_padya_p02_475ddf": "परमात्मनो विचित्राश्च शक्तयः सन्ति",
 "bsb_2_2_5_u02_padya_p01_81eb2f": "सेश्वरसाङ्ख्यमतं निराकरोति",
 "bsb_2_2_5_u10_padya_p01_5c7f53": "इत्यादि च",
 "bsb_2_3_24_u02_padya_p03_d0ca1a": "यथा हरिचन्दनविप्लुष एकदेशपतितायाः सर्वशरीरव्याप्तिः",
 "bsb_2_4_1_u08_padya_p03_0d31d7": "यथाऽऽकाशादयः परमात्मन उत्पद्यन्ते तथा प्राणा अपि",
 "bsb_3_1_4_u04_padya_p02_9319c9": "न",
 "bsb_3_1_27_u02_padya_p01_6cc175": "अशुद्धमिति चेन्न शब्दात्",
 "bsb_3_2_13_u02_padya_p01_be4dbd": "अपि चैवमेके",
 "bsb_3_2_13_u04_padya_p02_facf93": "अभेदेऽपि भेदव्यपदेशः स्थानभेदादैश्वर्ययोगाच्च युज्यते",
 "bsb_3_2_22_u02_padya_p03_03d73b": "उक्तं सृष्टिसंहारकर्तृत्वमात्रं प्रतिषिद्ध्य ततोऽधिकं ब्रवीति",
 "bsb_3_3_4_u02_padya_p02_8dd42f": "यथा सर्वं सलिलं समुद्रं गच्छति",
 "bsb_3_3_40_u02_padya_p02_e47c8d": "अत्रोच्यते- कामादितरत्र तत्र चायतनादिभ्यः",
 "bsb_3_3_56_u02_padya_p03_dff6b6": "तदुपासनादिभोगादंशस्य",
 "bsb_3_3_58_u02_padya_p03_9e0de2": "एवमविरोधो वा",
 "bsb_3_4_1_u02_padya_p01_22a9f1": "ज्ञानसामर्थ्यमस्मिन् पाद उच्यते",
 "bsb_3_4_27_u02_padya_p02_315d8c": "यद्यपि ज्ञानेनैव मोक्षो नियतस्तथाऽपि ज्ञानी शमदमाद्युपेतः स्यात्",
 "bsb_3_4_41_u02_padya_p02_9783ea": "नच परमात्मैश्वर्यादिकमाकाङ्क्ष्यम्",
 "bsb_3_4_41_u02_padya_p06_b475f1": "अयोग्यमारोढुं प्रयतन् प्रपतन् हि दृश्यते",
 "bsb_3_4_51_u02_padya_p03_51794b": "तद्भावे जन्मान्तराणीत्यनियमः",
 "bsb_4_1_6_u04_padya_p01_ff69ca": "इत्याद्युपासनं च देवानां कार्यमेव",
 "bsb_4_1_17_u02_padya_p02_fd80b5": "मुक्तावनुभवकारणाद् यदन्यत् पुण्यमपि विनश्यति",
 "bsb_4_4_16_u04_padya_p02_255d24": "यतः स्वाप्ययसम्पत्त्योरन्यतरापेक्षमाविष्कृतं हि",
 "bsb_4_4_16_u08_padya_p04_b07479": "सर्वदोषनिवृत्तास्ते गुणमात्रस्वरूपिणः",
 "nvv_seq137_u02_padya_p03_d5bbae": "अपूर्णोऽयं जीवसङ्घोऽस्वतन्त्रः पूर्णो हरिर्यः स्वतन्त्रः सदैव",
 "nvv_seq143_u02_padya_p02_af85f9": "व्यवस्थायोगात्",
 "nvv_seq143_u02_padya_p06_b29db7": "अभावो हि प्रदेशस्य नह्यत्राभाव इत्यपि",
 "nvv_seq157_u02_padya_p03_698330": "द्विविधः क्रम उद्दिष्टो व्यत्क्रमोऽनुक्रमस्तथा",
 "nvv_seq193_u02_padya_p02_9899ac": "तस्योत्पत्तिर्मृतिश्चैव कथं प्राणस्य युज्यते",
 "nvv_seq193_u02_padya_p06_fe769e": "इति श्रुतेस्ततोऽपि माहात्म्याद् विष्णोः",
 "nvv_seq195_u02_padya_p04_75afd4": "इति श्रुतेर्मुख्यप्राणस्य ततोऽपि व्यक्तसद्गुणत्वात्",
 "nvv_seq203_u02_padya_p04_f8c3a8": "अतो रूपस्य नाम्नश्च व्यवहारस्य चैकराट्",
 "nvv_seq248_u02_padya_p02_0cb5ba": "योनिद्वारेण देहं च प्राप्नोति प्रायशो नरः इति वचनात् सामान्यतो गत्यन्तराभावात्",
 "nvv_seq262_u02_padya_p01_f47005": "नच राजादीनां पृथग्दर्शनादीशान्तरकल्पना",
 "nvv_seq282_u02_padya_p01_847549": "नच ब्रह्मानन्दादीनामन्यथात्वादतच्छब्दत्वं तच्छब्दत्वे लोकोपमत्वं चेति विलोमता",
 "nvv_seq288_u02_padya_p01_e3f0b6": "नच नानावतारकौतुकदर्शनाद् विष्णोः क्वचिद् देशकालान्तरे कौतुकादेव सृष्ट्यादि कुर्वन्नन्यमेव सामस्त्येन नियोजयति",
 "nvv_seq288_u02_padya_p05_5302db": "नियतक्रीडनादेव कर्ता नान्योऽस्ति कस्यचित्",
 "nvv_seq290_u02_padya_p01_522542": "नच कर्मान्वयव्यतिरेकात् फलस्येश्वरः फलदातेति प्रलोभमात्रम्",
 "nvv_seq290_u02_padya_p05_7fdc59": "स्वातन्त्र्यं चेत् कर्मणां सर्वभोगः स्यान्नह्येवं क्वापि तत् केनचित् स्यात्",
 "nvv_seq290_u02_padya_p09_efb6f2": "स्वतन्त्र ईश एवैकस्तद्वशं कर्म सर्वदा",
 "nvv_seq298_u02_padya_p01_2ef658": "केषाञ्चित् सर्वगुणोपसंहारस्य कर्तव्यत्वे सर्वेषामपि तथा स्यात्",
 "nvv_seq298_u02_padya_p05_ff08fd": "युगपद् ब्रह्मणः सर्वे भासन्ते हि गुणा हरेः",
 "nvv_seq304_u02_padya_p02_1473cd": "यथायोग्यान् गुणपूगानुपास्य फलं भवेन्मुक्तिगं नान्यथा स्यात्",
 "nvv_seq316_u02_padya_p02_8de332": "समविषमोपासनायुक्तेरिति न मन्तव्यम्",
 "nvv_seq316_u02_padya_p06_cba3d8": "साम्यं तयोर्यथाविष्णोर्गुणोपासा फलं भवेत्",
 "nvv_seq320_u02_padya_p03_eaaa67": "नान्यत् किञ्चित् समुपासीत धीरः सर्वैर्गुणैर्देवगणा उपासते",
 "nvv_seq320_u02_padya_p07_6c3869": "पर्यायेणैव सत्याः स्युर्नैवान्येषां कथञ्चन",
 "nvv_seq330_u02_padya_p03_83cfe5": "कथञ्चिदधिके यत्ने तत्साधनादिवस्तूनां दूषणप्राप्तेः",
 "nvv_seq336_u02_padya_p01_94a362": "नच सत्यादीनाभेदानुक्तेरन्यत्वम्",
 "nvv_seq336_u02_padya_p05_be92ad": "मध्यतः पूर्णं सर्वतः",
 "nvv_seq336_u02_padya_p09_ca4f8d": "इति श्रुतेः सर्वेषामनूनत्वात्",
 "nvv_seq382_u02_padya_p01_e28301": "नच ज्ञानिनामात्मस्वरूपदार्ढ्यात् सत्प्रवृत्तिविपरीतप्रवृत्योरविशेषः",
 "nvv_seq382_u02_padya_p05_0ab3c2": "इति वचनात् स्थितिविशेषोपपत्तेः",
 "nvv_seq388_u02_padya_p04_55397b": "शतं परानभिपश्यैव देवं ब्रह्माऽचरद् दुश्चरं यत् तपोऽग्र्यम्",
 "nvv_seq388_u02_padya_p08_3f9571": "इति श्रुतेर्गृहिभ्यो यतीनां तेभ्यो देवानामत्वरया सिद्धेः",
 "nvv_seq411_u02_padya_p03_c7623a": "प्रारब्धस्यैव कृतस्य यावद्भोगं संस्थितेः",
 "nvv_seq417_u02_padya_p01_5a3104": "नच मनःपूर्वकत्वनियमादशेषदृष्टादृष्टव्यापाराणां तस्य प्राणादनूनता",
 "nvv_seq417_u02_padya_p05_6649e7": "जीवस्थितेन रूपेण वेदयत्यहमित्यपि",
 "nvv_seq417_u02_padya_p09_1a528b": "तस्येशो भगवान् विष्णुरेवमेष यथाऽन्यगः",
 "nvv_seq431_u02_padya_p03_a8f7ea": "फलं भवेत् सर्वथेत्येव तस्मात् स्मरेत् सदा निश्चितत्वेन विद्वान्",
 "nvv_seq449_u02_padya_p01_540eeb": "नच परमगतित्वादीश्वराभुक्ता अपि भोगा मुक्तौ भवन्ति",
 "nvv_seq449_u02_padya_p05_c7667f": "इत्याश्चर्यतयैव ब्रह्मण उभयोक्तेः",
 "nvv_seq457_u02_padya_p03_400f7e": "देहाभावाच्च भावाच्च निर्भोगित्वं च दुःखिताम्",
 "nvv_seq459_u02_padya_p02_541c08": "व्यापारो जगतो विष्णोर्मुक्तानां तु स्वभोगगः",
 "nvv_seq459_u02_padya_p06_462907": "नच कामस्तथा भूयात् ततः स्यात् सत्यकामिता",
 "nvv_seq459_u02_padya_p10_e7ee2c": "इति च विशेषकॢप्तिः",
 "ait_seq12_u01_padya_p04_3a85ee": "अध्यात्मे च निविष्टोऽसौ पुरुषाख्यो जनार्दनः",
 "ait_seq12_u01_padya_p08_7bd144": "अग्निवातदिनेशानामुत्थानानि पृथक्पृथक्",
 "ait_seq12_u01_padya_p12_caaf64": "अन्नाभिमानिदेवश्च तृचाशीत्याश्च देवताः",
 "ait_seq12_u01_padya_p16_0a5efd": "अरणं गमनं यस्मादर्कः शीघ्रगतित्वतः",
 "ait_seq12_u01_padya_p20_173729": "योऽसौ चितिगतो वीन्द्रः सोऽग्निवातरविष्वपि",
 "ait_seq12_u01_padya_p24_67513a": "व्याप्तत्वाज्जीवदेहेषु मुखे विष्णोर्मुखं स्मृतम्",
 "ait_seq12_u01_padya_p28_20ef18": "चक्षुस्तु कपिलो विष्णुरग्न्यादीनां च कारणम्",
 "ait_seq12_u01_padya_p32_8e2c90": "स एव व्यूह्य चात्मानं पृथग्रूप इव स्थितः",
 "ait_seq12_u01_padya_p36_ae0936": "अन्ने स्थितः स एवेशो ह्यन्नदातृगतिप्रदः",
 "ait_seq12_u01_padya_p40_27a5b9": "निहितश्चैव तल्लोको नासिकायां नतस्थले",
 "ait_seq12_u01_padya_p44_a06be3": "भोग्यत्वादाद्य इत्युक्त एवमाद्यात्तृरूपवान्",
 "ait_seq12_u01_padya_p48_bf3872": "सर्वे लोकास्तथा कर्तुं नैवेष्टे कश्चन क्वचित्",
 "ait_seq16_u01_padya_p04_d55c40": "तस्मात् प्रपदनादेव प्रपदं नाम कीर्तितम्",
 "ait_seq16_u01_padya_p08_8fa4f2": "स्थित ऊरू च तावास्तामूरूर्ध्वगमनाद्धरेः",
 "ait_seq16_u01_padya_p12_7c740f": "तत्स्थानमुदरं नाम पुनराह जनार्दनः",
 "ait_seq16_u01_padya_p16_b0bc5a": "सूक्ष्मदृष्टियुता ये तु मुनयः शार्कराक्ष्यकाः",
 "ait_seq16_u01_padya_p20_a3cb90": "एकमेव यतस्तस्मादुभये ह्यपि तद्विदः",
 "ait_seq16_u01_padya_p24_67c44d": "शेषः सुपर्ण इन्द्रश्च मनांस्येव पृथक्पृथक्",
 "ait_seq16_u01_padya_p28_71c135": "एते देवास्तदन्ये च सर्वप्राणिषु संस्थिताः",
 "ait_seq16_u01_padya_p32_d4597c": "देहादब्जभवस्यास्माद् यस्मिन्नुत्क्रान्त एव हि",
 "ait_seq16_u01_padya_p36_992869": "वायावुत्क्रान्त एवैतच्छरीरमपतत् क्षितौ",
 "ait_seq16_u01_padya_p40_e3aac1": "नोत्थानमभवत् तेषु प्रविष्टेष्वपि सर्वशः",
 "ait_seq16_u01_padya_p44_9d1343": "भृत्या वयं तवैव स्म त्वमस्माकं पतिः सदा",
 "ait_seq18_u01_padya_p01_7a24a5": "तस्माच्छ्रुत्वा परं ब्रह्म देवा नारायणाभिधम्",
 "ait_seq18_u01_padya_p05_c7289d": "तत्रतत्र प्रविष्टत्वात् प्रततोऽसौ बभूव ह",
 "ait_seq18_u01_padya_p09_1d848a": "वायोस्तत् पुनरध्यात्मं प्राणापानाभिधं द्वयम्",
 "ait_seq18_u01_padya_p13_96709c": "श्रोत्राभिमानिनः सर्वे वैदिकश्रवणोचितम्",
 "ait_seq18_u01_padya_p17_9e7cdd": "श्रोत्रं यन्नीतिशास्त्रार्थं कुबेरश्च प्रकीर्तितः",
 "ait_seq18_u01_padya_p21_b13f6d": "शेषशङ्करशक्राश्च चन्द्रसूर्ययमा अपि",
 "ait_seq18_u01_padya_p25_629df2": "पूर्णज्ञानस्वरूपत्वादेतावत् कथितं भवेत्",
 "ait_seq18_u01_padya_p29_2d403e": "विष्णुना प्रहितानां हि देवानामहमुत्तमम्",
 "ait_seq18_u01_padya_p33_92f589": "अधिदैवेन सहिता विष्णुना प्रभविष्णुना",
 "ait_seq18_u01_padya_p37_23aacd": "एतादृशोपासनाया योग्यः सन् सततं सुधीः",
 "ait_seq18_u01_padya_p41_9d4349": "मानुषा ज्ञानमात्रेण स्वावरैः पूज्यतामियुः",
 "ait_seq18_u01_padya_p45_b2f9b0": "देवतात्रयमन्यच्च पृथक् सत्यमितीर्यते",
 "ait_seq18_u01_padya_p49_c72b69": "अन्नं प्रजापतिरिति श्रुतिरन्या ह्यभाषत",
 "ait_seq18_u01_padya_p53_64d36c": "शुक्लकृष्णकनीनासु चक्षुषोऽप्येत आस्थिताः",
 "ait_seq18_u01_padya_p57_a86dad": "मनुष्याणां ज्ञानमात्राद् दोषो नातितरां भवेत्",
 "ait_seq20_u01_padya_p04_3f231f": "दाम तेनैव बध्नाति सकलं जगदच्युतः",
 "ait_seq20_u01_padya_p08_94afbc": "ज्ञात्वा जगदुपास्ते तु योग्यः संस्तदुपासने",
 "ait_seq20_u01_padya_p12_46253b": "भूतयुक्ते रथे तस्मात् स तिष्ठति सुरार्चितः",
 "ait_seq20_u01_padya_p16_1a1e44": "सुपर्णशेषगिरिशशक्रसूर्याद्यमञ्जसा",
 "ait_seq20_u01_padya_p20_ff15f6": "छन्नश्छन्दोभिरेवं स केशवस्तेन चाभिधा",
 "ait_seq20_u01_padya_p24_7fa3aa": "छन्दस्सु संस्थितो विष्णुर्गोपायत्येव तद्विदः",
 "ait_seq20_u01_padya_p28_7d5521": "वायुश्च वायुसंस्थश्च कदाचिन्नैव तिष्ठतः",
 "ait_seq20_u01_padya_p32_f94031": "वायुस्तत्स्थो हरिश्चैव चरत्यमितपौरुषः",
 "ait_seq20_u01_padya_p36_9487f7": "हस्तयोरेतयोरेव नित्याक्षीणं वसु स्थितम्",
 "ait_seq20_u01_padya_p40_db7ba8": "आच्छाद्यन्ते वित्तवद्भिस्ताभ्यामेवं च चेतनाः",
 "ait_seq20_u01_padya_p44_8e2306": "बृहत्त्वात् बृहतीत्येव तयोर्नाम प्रकीर्तितम्",
 "ait_seq24_u01_padya_p01_2a54de": "आप इत्येव देवानां ब्रह्मादीनां कथं भवेत्",
 "ait_seq24_u01_padya_p05_1edbf2": "आ पूर्णत्वाद् गुणैः सर्वैस्तन्मूलमखिलस्य च",
 "ait_seq24_u01_padya_p09_643d76": "तन्नामाप इति ह्येतद् ब्रह्मरुद्रादिनां भवेत्",
 "ait_seq24_u01_padya_p13_1fba88": "तथाऽपि मुख्यया वृत्त्या व्यवहारव्यवस्थितिः",
 "ait_seq24_u01_padya_p17_fc0d18": "एवं स भगवान् विष्णुर्महिदासाभिधः प्रभुः",
 "ait_seq24_u01_padya_p21_416db3": "मयि देवास्तेषु चाहमिति विद्धि वरानने",
 "ait_seq24_u01_padya_p25_5686dd": "सम्भृता मत्त एवैते स एष भगवान् गिरिः",
 "ait_seq24_u01_padya_p29_519fe4": "गिरणाच्चाखिलस्यास्य प्राहुर्ब्रह्मगिरिं प्रभुम्",
 "ait_seq24_u01_padya_p33_3dd3ec": "असनाद् भगवान् सोऽसुः सर्वस्यापि जनार्दनः",
 "ait_seq24_u01_padya_p37_737cdd": "सुखज्ञानादिगुणदं पूर्णं सर्वगुणैः प्रभुम्",
 "ait_seq24_u01_padya_p41_4b2dc6": "स्थित्वा सुप्तेषु विष्णुं तं भूर्भूरित्येव शंसति",
 "ait_seq24_u01_padya_p45_c11c36": "ज्ञानैश्वर्यादिभिर्हीनाः पेतुरन्धे तमस्यथ",
 "ait_seq24_u01_padya_p49_acd14a": "प्रसादात् तस्य पाप्मा च पराभवति सर्वशः",
 "ait_seq24_u01_padya_p53_f4f056": "शरीराद् बहिरेतौ तु यदा निःसारयत्यजः",
 "ait_seq24_u01_padya_p57_656131": "अनेनैव गृहीतो हि प्राणोऽपानेन संयुतः",
 "ait_seq24_u01_padya_p61_81a334": "स्थूलसूक्ष्मविभागेन किमु वायुर्जगत्प्रभुः",
 "ait_seq24_u01_padya_p65_5b7698": "चेतनेशं हरिं याति विरुद्धगमनौ च तौ",
 "ait_seq24_u01_padya_p69_5f529b": "पूर्णानन्देन हरिणा गृहीतं तद्वशं सदा",
 "ait_seq24_u01_padya_p73_cd692f": "क्रमेण चतस्रो मूर्तयः",
 "ait_seq24_u01_padya_p77_465833": "इरामया इति दैर्घ्यमवधारणार्थम्",
 "ait_seq24_u04_padya_p01_835c21": "देशतः कालतोऽर्थाच्च बलतो गुणतस्तथा",
 "ait_seq24_u04_padya_p05_0077d1": "अचिन्त्यात् तु तथैश्वर्यादेकोऽपि बहुरूपवान्",
 "ait_seq24_u05_gadya_p01_c1237c": "इत्यादिशब्दनिर्णयवचनाद् द्विवचनमत्र व्यवहारमात्रमिति ता इत्युक्तम्",
 "ait_seq24_u07_padya_p02_a4cf19": "अद उ एव नारायणाख्यमधिदैवतमन्यानि दैवतमात्राणि",
 "ait_seq24_u09_gadya_p01_0a061f": "इत्यादि",
 "ait_seq24_u13_gadya_p01_2320e5": "इति सूत्रात्",
 "ait_seq24_u17_gadya_p01_65972f": "इत्यादिवच्च",
 "ait_seq24_u19_padya_p02_d87a3e": "अस्मै पुण्याय कर्मण इति",
 "ait_seq24_u19_padya_p06_949307": "अन्येषां जीवानां श्रवणजं भोगं स्वश्रोत्रेण दिग्भिरननुगृहीतेनैव भगवान् भुङ्क्ते",
 "ait_seq24_u21_padya_p02_74c451": "सृष्टिभेदादन्यथावचनम्",
 "ait_seq24_u21_padya_p06_2b9dc4": "पितृत्वं चात्रोक्तम्",
 "ait_seq24_u24_padya_p02_e492ee": "दैवतैरुपकारस्तु क्रियते नरकर्मणाम्",
 "ait_seq24_u26_padya_p01_634fd1": "आह महिदास ऐतरेयः",
 "ait_seq24_u28_padya_p01_bbb12e": "इन्द्रं कुत्सः",
 "ait_seq24_u31_gadya_p01_dcf9fe": "इति",
 "ait_seq71_u01_padya_p03_0eb563": "तस्यात्रैवान्तर्भावात्",
 "ait_seq71_u03_padya_p03_9cb0a4": "तस्या एव बृहतीसम्पादने नव स्रक्तयो भवन्ति",
 "ait_seq71_u03_padya_p07_aa4a5f": "स च वायुर्विष्णोर्मुख्यप्रतिमा",
 "ait_seq71_u03_padya_p11_58d67c": "ततश्चोमाया अपि भगवत्प्रतिमात्वाद् विष्णुप्रतिमास्थापक एव भवत्येतत् सर्वं सम्यग् ध्यायन्",
 "ait_seq71_u03_padya_p15_70df99": "अत एवेन्द्रात् परितन्वं मम इत्युक्तम्",
 "ait_seq71_u09_padya_p01_6697f6": "इत्यादि च",
 "ait_seq71_u11_padya_p03_47d8ec": "अकाराख्यवाग् विकारेषूत्तमो बृहतीसहस्राख्यः",
 "ait_seq71_u15_padya_p02_98ff00": "अकारार्थत्वान्नकारस्य किञ्चिन्मूलमिव",
 "ait_seq71_u15_padya_p06_c06aee": "यद्धि देवतासु करोति तदात्मन्यापतति",
 "ait_seq71_u15_padya_p10_5b7af7": "उकारादिविकारसहितत्वात् पुष्पफलात्मकश्च",
 "ait_seq71_u15_padya_p14_80f2ab": "नकारस्त्वच्छिरस्कत्वान्मूलभूतस्याकारस्यान्ते स्थितिरूपत्वादयथास्थितेरसत्यरूपः",
 "ait_seq73_u03_padya_p01_446ea6": "इति पुनःपुनः परामर्शः",
 "ait_seq73_u03_padya_p05_3fb616": "तस्मात् तमेव वेदा इन्द्रशब्देन वदन्ति मुख्यतः",
 "ait_seq73_u07_padya_p01_dcf9fe": "इति",
 "ait_seq73_u07_padya_p05_ff6844": "नचात्र द्वित्वगमकं चकारादिकं विद्यते",
 "ait_seq73_u09_padya_p03_5ae0fd": "अन्यथैकत्वमेव",
 "ait_seq73_u15_padya_p01_0a9a02": "इति पूर्वोक्त इन्द्रो विष्णुरेवेति सिद्धम्",
 "ait_seq73_u19_padya_p01_7c39e7": "इतीन्द्रस्य परमदैवं जनको यज्ञभागादिप्रदाता विष्णुरेव हि श्रूयते",
 "ait_seq73_u21_padya_p01_35387f": "इति वायुना विवदमान आजौ पराजितो वायुं प्रसादयित्वा चतुर्थे",
 "ait_seq73_u25_padya_p02_c58551": "तस्माद् भगवत एवैतद् यशो बृहदुक्थादिकम्",
 "ait_seq73_u27_padya_p04_6eda5f": "नात्र प्रेत्यशब्दो मरणवाची",
 "ait_seq73_u29_padya_p03_ecc6c0": "नच यशोमात्रराजनेन स्वस्य राजनं भवति",
 "ait_seq73_u33_padya_p03_3f14f1": "अनेन महिदासादिरूपेणामुं लोकं दिविष्ठं स्वरूपम्",
 "ait_seq73_u35_padya_p03_e753f6": "अनेन रूपेण तद्रूपमभिसम्भवति किम्? उभयोरपि परिहारदर्शनादस्यापि प्रश्नत्वमवगम्यते",
 "ait_seq73_u39_padya_p02_fd9ad1": "केन रूपेणेमं लोकमाभवति",
 "ait_seq73_u39_padya_p06_da64e1": "देवी लोहितस्थितमात्मनः स्त्रीरूपं महिदासादिरूपेभ्यो मानुषरेतःस्थितरूपेभ्यश्च दिविष्ठैश्च विष्ण्वादिस्वरूपैः प्रयच्छति च",
 "ait_seq73_u39_padya_p10_4a1bcd": "नह्यग्न्यादिस्वरूपमेव लोहितादि",
 "ait_seq73_u43_padya_p01_2bded9": "इत्यादि च ब्रह्माण्डे",
 "ait_seq75_u01_padya_p02_d2edd8": "स्त्रीपुंरूपेण युजो देवा अश्वरूपेण रथे युक्ताः सन्तो यन्नारायणाख्यं परं ब्रह्माभिसंवहन्ति",
 "ait_seq75_u01_padya_p06_6b34a6": "सन्तो मिलिता भवन्ति",
 "ait_seq75_u04_padya_p02_220325": "नचैकीभावशब्दः स्वरूपैकत्वविषये प्रयुज्यमानः कुत्रचिद् दृष्टः",
 "ait_seq75_u04_padya_p06_15894c": "किन्तु ज्ञात इत्येव प्रयुज्यते",
 "ait_seq75_u04_padya_p10_b5ddca": "तस्मादत्रापि संसर्ग एव विवक्षितः",
 "ait_seq75_u08_padya_p04_e1c0fa": "यस्मादक्षरान्नारायणाख्यात् स स्वयमेव भगवान् प्रादुर्भावरूपी स्त्रीपुंरूपेण युक्त आगच्छति",
 "ait_seq75_u08_padya_p08_aa6a11": "शृते परिपक्वे सति ज्ञाने",
 "ait_seq75_u10_padya_p01_c6e93b": "इति शब्दनिर्णये",
 "ait_seq75_u14_padya_p03_4aafd5": "वदन् वदति वदन्नेव वदति",
 "ait_seq75_u14_padya_p07_5c743a": "अप्रसिद्धत्वान्न वदति च",
 "ait_seq75_u24_padya_p01_1c9d6b": "इति शब्दनिर्णये",
 "ait_seq75_u24_padya_p05_e70e73": "मनसि प्रस्तुतत्वादवचनेऽपि प्रस्तुतमेवेदं सर्वम्",
 "ait_seq75_u24_padya_p09_a6739e": "शून्याङ्गीकारे ह्यकारस्याभावताख्य एक एवार्थ इति सिद्ध्यति",
 "ait_seq75_u24_padya_p13_985b3e": "तस्मादमुख्यार्थत्वादन्ययुक्तेनैवाकारेणाभाव इति तदुच्यते",
 "ait_seq75_u24_padya_p17_2f19cd": "पूर्णं हि ब्रह्मशब्दस्यार्थः",
 "ait_seq75_u24_padya_p21_d4709b": "तदेतदुक्तम्- अः इति ब्रह्मेति",
 "ait_seq75_u26_padya_p03_2e06d6": "तत्रागतमहमिति",
 "ait_seq75_u26_padya_p07_fa63e1": "मुक्तेभ्यः प्रलये लीनेभ्यश्च सर्ववस्तुभ्यः सदा विभिन्न एव भगवानिति",
 "ait_seq75_u28_padya_p02_a199c1": "नच निषेधस्वरूपे विरुद्धता चान्यता चास्तीत्येतावता पूर्णार्थता भवति",
 "ait_seq75_u30_padya_p02_7fac57": "तस्मान्नारायण एवाकारवाच्य इति सिद्धम्",
 "ait_seq75_u36_padya_p01_415352": "इत्यस्य व्याख्यानरूपत्वाच्चैतदवसीयते",
 "ait_seq75_u36_padya_p05_467177": "प्रसिद्धमेव च रूपद्वयम्",
 "ait_seq75_u38_padya_p02_9f3c2a": "नच रक्ष इति नपुंसकशब्दमात्रेण रावणादयो नपुंसका भवन्ति",
 "ait_seq75_u40_padya_p03_997ff5": "ऋभव इत्यत्र देवानां साधारणं नाम",
 "ait_seq75_u44_padya_p04_19dcbe": "अहनी इति द्विवचनेन द्वित्वे सिद्धेऽप्युभे इति वचनमध्यात्माधिदैवतयोरुभयोरपि वचनार्थम्",
 "ait_seq75_u44_padya_p08_981436": "सप्ताश्वत्वाच्च तद्रथस्य",
 "ait_seq75_u46_padya_p03_5412f8": "असुदिनस्यापि तत एव जातत्वाद् व्यर्थविशेषणता च",
 "ait_seq75_u48_padya_p02_5f234c": "नहि मुक्तावधिक्यार्जनमस्ति",
 "ait_seq75_u50_padya_p04_135479": "नचाश्विरथो वर्ण्यते",
 "ait_seq75_u52_padya_p02_e461f3": "नच विवस्वच्छब्दोऽश्विनोर्विद्यते",
 "ait_seq186_u01_padya_p02_5598de": "अनुव्याहारशब्देन भगवदुपासनाविषय एवास्याशक्त्यादिदोषं वदतः प्रत्युक्तिरुच्यते",
 "ait_seq186_u03_padya_p02_2f7658": "स य एनं प्राणं वंशमुपवदेत् प्राणं प्रत्येनमुपासकमुपवदेत्",
 "ait_seq186_u05_padya_p01_7446a9": "इति च भारते",
 "vtn_seq40_u06_padya_p04_f13c46": "सर्वज्ञत्वादीश्वरस्य तद्बुद्धौ सर्वदा प्रतीयमानत्वात्",
 "vtn_seq73_u01_padya_p01_650f6d": "“अदुष्टमिन्द्रियं त्वक्षं तर्कोऽदुष्टस्तथाऽनुमा",
 "vtn_seq73_u01_padya_p05_83f0a9": "तयोः स्वभावो बलवानुपजीव्यादिकश्च सः",
 "vtn_seq73_u01_padya_p09_782abb": "अनुप्रमाणतां याति तथाऽक्षादित्रयं ततः",
 "vtn_seq76_u01_padya_p02_43b42c": "सा व्यर्था नोपपत्त्या हि विना साऽपि प्रमाणताम्",
 "vtn_seq76_u01_padya_p06_fd2012": "पृथक्पृथक्प्रमाणत्वं याति युक्तितयैव तु",
 "vtn_seq76_u01_padya_p10_08dec5": "दृष्टान्तो यात्युपनयो व्याप्तिमाश्रित्य केवलम्",
 "vtn_seq78_u01_padya_p01_d844d0": "विरोधश्च तथाऽधिक्यं न्यूनताऽसङ्गतिस्तथा",
 "vtn_seq78_u01_padya_p05_26d22e": "निग्रहा एत एव स्युः संवादानुक्तिसंयुताः",
 "vtn_seq80_u01_padya_p04_665f46": "अभावस्य परिज्ञानं द्विविधं समुदाहृतम्",
 "vtn_seq80_u01_padya_p08_418935": "क्वचिद् घटाद्यभावोऽपि प्रत्यक्षेणावगम्यते",
 "vtn_seq170_u04_padya_p02_0cb5b0": "समवहारमेकतां गमयन्ति ते यथा तत्र न विवेकं लभन्तेऽमुष्याहं",
 "vtn_seq170_u04_padya_p06_a9cca7": "वराहो वा कीटो वा पतङ्गो वा दंशो वा",
 "vtn_seq170_u05_padya_p05_f50f7e": "त इह व्याघ्रो वा सिंहो वा वृको वा",
 "vtn_seq170_u07_padya_p02_7e28f0": "किमत्र पश्यसीत्यण्व्य इवेमा धाना भगव इत्यासामङ्गैकां भिन्धीति भिन्ना",
 "vtn_seq170_u10_padya_p01_c5c8db": "अथ यदाऽस्य वाङ् मनसि सम्पद्यते मनः प्राणे प्राणस्तेजसि",
 "vtn_seq172_u03_padya_p01_c69bce": "सत आगम्य न विदुः सत आगच्छामह इति त",
 "vtn_seq174_u06_padya_p01_761251": "इति परमोपनिषदि",
 "vtn_seq186_u02_padya_p01_cf1193": "इत्यत्र चान्याभिमतस्यैव वस्तुनोऽपहार्यत्वाद् भेद एवायं दृष्टान्तः",
 "vtn_seq219_u07_padya_p02_7c178d": "केन कं जिघ्रेत् तत् केन कं विजानीयात् येनेदं",
 "vtn_seq250_u02_padya_p01_25a985": "इत्यस्य चायमर्थः",
 "vtn_seq250_u02_padya_p05_98c2ca": "तस्मादनादिरेवायम्",
 "vtn_seq250_u02_padya_p09_01f2c2": "मायेति भगवत्प्रज्ञा",
 "vtn_seq250_u02_padya_p13_b73084": "तर्हि",
 "vtn_seq250_u04_padya_p04_af3188": "अन्यथा",
 "vtn_seq250_u08_padya_p01_c9b77a": "इति वाक्यशेषाच्च न कल्पितत्वमस्येति ज्ञायते",
 "vtn_seq250_u08_padya_p05_5e0c15": "अतः प्रपञ्चस्यानादिसत्यत्वपरमिदं वाक्यम्",
 "vtn_seq252_u05_padya_p01_07485b": "अथ ये चान्ये मिथ्यातर्कैर्दृष्टान्तैः कुहकेन्द्रजालैर्वैदिकेषु परिस्थातुमिच्छन्ति तैः सह",
 "gb_2_14d_u01_padya_p01_7f3ec7": "नचाविद्यामानविद्यमानयोरुत्पत्तिनाशनिषेधकोऽयं श्लोकः",
 "gb_2_14d_u01_padya_p05_90617a": "इदं तु वाक्यमन्यथासिद्धम्",
 "gb_2_17b_u26_padya_p02_e5fba3": "नच",
 "gb_2_17b_u40_padya_p04_95c1e3": "नहि शुक्तिज्ञो रजतज्ञ इति व्यवहारः",
 "gb_2_17b_u42_padya_p02_7ea35e": "तत्स्वामिकम्",
 "gb_2_17b_u44_padya_p03_c067aa": "न स्यात्? अनुवादोऽपि",
 "gb_2_17b_u53_padya_p01_9b13e3": "इत्यादि",
 "gb_2_17b_u53_padya_p05_4f4757": "निर्विशेषत्वोक्तेः",
 "gb_2_17b_u53_padya_p09_3786e5": "उपाधिकृतभेदेऽप्युपाधेर्मिथ्यात्वे त्वप्राप्तमेवोपाधिभेदं प्रापयित्वा पुनर्निषिध्यत इति स एव दोषः",
 "gb_2_39_u02_padya_p01_cce438": "सम्यक् ख्यातिर्ज्ञानं साङ्ख्यम्",
 "gb_2_39_u06_padya_p03_43b25b": "साङ्ख्यैर्योगैश्च विहितहिंसाया अप्यनर्थहेतुत्वाङ्गीकारात्",
 "gb_2_39_u08_padya_p02_cf67f6": "परमसाड्ख्ययोगयोश्चोक्तार्थत्वेनैव न विरोधः",
 "gb_3_17_u10_padya_p04_7a3560": "मुक्तस्यैव कार्यं नास्तीत्येवकारार्थोऽपि यस्त्विति तुशब्देनावगतः",
 "gb_3_17_u13_padya_p02_903123": "पाण्डवानां च मुक्तानामन्तरं किञ्चिदेव हि",
 "gb_3_17_u16_padya_p02_2133c0": "एषां कदाचिद् दुःखाभासस्यापि भावात्",
 "gb_7_7_u26_padya_p01_1effff": "इति भेदेनैवोपक्रमाच्च",
 "gb_7_7_u31_padya_p03_e4aaa4": "ततो मां प्रपद्यते",
 "gb_7_27_u04_padya_p02_7c336d": "जीवेश्वरादिकं द्वन्द्वम्",
 "gb_7_27_u06_padya_p02_67c287": "सर्गे सर्गकाल एव",
 "gb_11_1_u20_padya_p02_56d212": "नित्यत्वम्",
 "gb_11_1_u30_padya_p01_3c989b": "विष्णुं समाश्रितो ब्रह्मा ब्रह्मणोऽङ्कगतो हरः",
 "gb_13_0_u02_padya_p01_2bd347": "श्रीभगवानुवाच- इदं शरीरं कौन्तेय क्षेत्रमित्यभिधीयते",
 "gb_13_13_u10_padya_p02_77eaa8": "कर्तृकर्मविरोधवादिमतं निराकरोत्युत्तरज्ञेयशब्देन",
 "gt_2_55_u04_padya_p02_98ac56": "एवं परमानन्दतृप्तः किमर्थं प्रवृत्तिं करोति? इति प्रश्नाभिप्रायः",
 "gt_2_55_u05_padya_p01_720917": "त्वत्पादभक्तिमिच्छन्ति ज्ञानिनस्तत्त्वदर्शिनः",
 "gt_2_55_u07_padya_p01_699f50": "आधिकारिकपुंसां तु बृहत्कर्मत्वकारणात्",
 "gt_2_55_u08_padya_p03_87d03a": "न ते ज्ञानिन इत्यवगन्तव्यम्",
 "gt_2_55_u10_padya_p02_829602": "नहि समाधिं कुर्वतस्तस्य शुभाशुभप्राप्तिरस्ति",
 "gt_2_55_u11_padya_p01_b513d2": "कामादयो न जायन्ते ह्यपि विक्षिप्तचेतसाम्",
 "gt_2_55_u12_padya_p03_0c6887": "अतस्तत्रैव तद्विरुद्धज्ञानोत्पत्तौ युक्तं हानं तेषामिति दर्शयति- मनोगतानिति",
 "gt_2_55_u14_padya_p02_5b292d": "नचैतददृष्ट्याऽपलपनीयम्",
 "gt_2_55_u14_padya_p06_3bbbc5": "आत्माख्ये तस्मिन् स्थितस्य तत्प्रसादादेव तुष्टिर्भवति",
 "gt_2_55_u16_padya_p02_38b5fa": "अतो नात्मा जीवः",
 "gt_3_34_u03_padya_p01_23d09b": "संस्कारो बलवानेव ब्रह्माद्या अपि तद्वशाः",
 "gt_5_2_u13_padya_p02_a04862": "अतो नात्राश्रमः सन्न्यास उक्तः",
 "gt_16_1_u04_padya_p01_3822ff": "पुमर्थसाधनविरोधीन्यनेनाध्यायेन दर्शयति",
 "gt_16_1_u06_gadya_p02_d95bcb": "कथनम्",
 "gt_16_1_u08_padya_p02_fd7452": "लौल्यं रागः",
 "gt_16_1_u11_padya_p01_8730cf": "चपलश्चञ्चलोऽस्थिरः",
 "gt_16_1_u14_gadya_p01_ef2b82": "इत्यभिधानात्",
 "gt_16_11_u10_padya_p01_414067": "ईश्वरो यदि सर्वस्य कारकः कारयीत माम्",
 "gt_17_27b_u01_padya_p02_9117e0": "तथाचर्ग्वेदखिलेषु",
 "tvk_seq14_u01_padya_p03_238913": "भूतेन्द्रियप्राणगुणसूक्ष्मरूपं च नित्यकम्",
 "tvk_seq18_u01_padya_p03_b9f8e1": "खण्डिते भेद ऐक्यं च यावद्वस्तु न भेदवत्",
 "tvk_seq18_u01_padya_p07_cec4c7": "विशिष्टशुद्धयोश्चैव तथैवांशांशिनोरपि",
 "uk_seq5_u01_padya_p06_f5b65d": "सर्वज्ञतादीशगुणविरुद्धा ह्यनुभूतिगाः",
 "uk_seq5_u03_padya_p02_8626c8": "नच वेदोक्तमिथ्यात्वे मानं तन्मानताऽपि न",
 "uk_seq14_u01_gadya_p03_af5386": "तत्त्वप्रकाशिकापरनामकं सम्पूर्णम्",
 "tdy_seq72_u03_padya_p02_f59b44": "अतोऽनौपाधिकत्वादेव भेदस्य न मुक्तस्येश्वरैक्यम्",
 "tsk_seq12_u01_padya_p06_053329": "एवं विमुक्तियोग्याश्च तमोगाः सृतिसंस्थिताः",
 "man_seq1_u01_padya_p03_e4a5fa": "मण्डूकरूपिणा वरुणेन चतूरूपो नारायणः स्तूयते",
 "kat_seq11_u05_padya_p01_656520": "इति नामनिरुक्ते",
 "kat_seq11_u11_padya_p01_75e56a": "इति परामर्शाच्च",
 "kat_seq11_u13_padya_p01_c4573f": "इत्यादिश्रुतेः",
 "kan_seq288_u06_padya_p01_98e403": "इति",
 "kan_seq288_u06_padya_p05_c93b65": "त्वाष्ट्रं त्वष्टुः पुत्रेण विश्वरूपेणेन्द्रायोक्तम्",
 "kan_seq288_u06_padya_p09_cf79b0": "तस्यां विद्यायां परस्योक्तायां तव शिरश्छेत्स्यामीतीन्द्रेण दधीचं प्रत्युक्ते सोऽश्विभ्यामावां ब्रवीहीत्युक्त इन्द्रेणोक्तमाह",
 "knr_seq35_u02_padya_p01_a41037": "इति धातोः आयो इत्यायतिः",
 "knr_seq35_u04_padya_p03_9d6780": "समीपस्थमपि जानातीत्युपोमन्यः",
 "knr_seq35_u06_padya_p01_516a9f": "इति धातोर्मन्युरिति ज्ञानी",
 "knr_seq35_u06_padya_p05_721c5d": "समीपतो दूरतश्च त्वां मन्यमानाय मह्यं मन्यवे ज्ञानाय माम्",
 "ath_seq14_u07_padya_p01_775b98": "येऽप्यन्यदेवता भक्ताः तेऽपि मामेव कौन्तेय यजन्ति",
 "bt_3_11_12_u04_padya_p10_1f0150": "यो वा ईश ईशानमाविवेश तं वा एनं काल",
 "bt_10_40_15_u04_padya_p01_2e74af": "जय जय हन हन प्रकृतिं द्रावय द्रावय भिन्धि",
 "bt_10_40_15_u04_padya_p05_57f483": "एष ह्यानन्दोऽजरोऽमरोऽधिशक्तिमांस्त्वदाभासस्त्वया तथाऽधिसम्भाव्यो यतः परः परमेश्वरः परज्ञानः परानन्दः",
 "bt_10_40_15_u04_padya_p09_de6097": "कं वा विदधते कं वा निषेधन्ति स्तुतिमात्रा एव",
 "bt_10_40_17_u03_padya_p02_d03bc6": "मुक्ताः किमु ते स्वरूपगाः",
 "bt_10_40_19_u10_padya_p03_92c9b1": "न प्राणादपरः परमनुभुङ्क्ते प्राण एवैनमन्वानन्दी भवति",
 "bt_10_40_19_u13_padya_p03_91e0ca": "शफाः खुरा इत्यन्येषां पशूनाम्",
 "bt_10_40_19_u13_padya_p07_ac7cd5": "श्रिताः चक्षुः श्रोत्रं मनोवाक् प्राणः श्रयन्तेऽस्मिन् श्रियो य",
 "bt_11_17_5_u03_padya_p01_8b5942": "स प्राणमसृजत प्राणाच्छ्रद्धां खं वायुर्ज्योतिरापः पृथिवीन्द्रियं मनोऽन्नमन्नाद्वीर्यं तपो"
}