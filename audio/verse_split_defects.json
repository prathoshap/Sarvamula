  "part": 1,
  "seq": 10,
  "source_line": "शास्त्रं योनिः प्रमाणमस्येति शास्त्रयोनि॥ ३॥",
  "became": [
   "शास्त्रं योनिः ।",
   "प्रमाणमस्येति शास्त्रयोनि ।"
  ]
 },
 {
  "work": "sutra_bhashya",
  "block": "bsb_1_1_6",
  "part": 1,
  "seq": 18,
  "source_line": "नच ‘गौण आत्मा दृश्यो वाच्यश्च, न निर्गुणः’ इति युक्तम्।",
  "became": [
   "नच ।",
   "गौण आत्मा दृश्यो वाच्यश्च ।",
   "न निर्गुणः ॥",
   "इति युक्तम् ।"
  ]
 },
 {
  "work": "sutra_bhashya",
  "block": "bsb_1_1_26",
  "part": 1,
  "seq": 64,
  "source_line": "पाद इत्येकदेशपरिमितम्, चतुर्भागबल इतिवद् भिन्नं च।",
