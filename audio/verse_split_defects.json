  "block": "bsb_1_2_22",
  "part": 1,
  "seq": 127,
  "source_line": "इति स्कान्दे त्र्यक्षराभिधानात् “अक्षरात् परतः परः” इत्यपि विशेषणमेव।",
  "became": [
   "इति स्कान्दे त्र्यक्षराभिधानात् ।",
   "अक्षरात् परतः परः ॥",
   "इत्यपि विशेषणमेव ।"
  ]
 },
 {
