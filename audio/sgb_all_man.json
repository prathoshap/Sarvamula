[
 [
  "sgb_001_u01_padya_p01_e03f5e",
  "नारायणं गुणैः सर्वैरुदीर्णं दोषवर्जितम्"
 ],
 [
  "sgb_001_u01_padya_p02_5bd31f",
  "ज्ञेयं गम्यं गुरूंश्चापि नत्वा सूत्रार्थ उच्यते"
 ],
 [
  "sgb_001_u02_padya_p01_698865",
  "विष्णुरेव विजिज्ञास्यः सर्वकर्ताऽऽगमोदितः"
 ],
 [
  "sgb_001_u02_padya_p02_4a33e5",
  "समन्वयादीक्षतेश्च पूर्णानन्दोऽन्तरः खवत्"
 ],
 [
  "sgb_001_u03_padya_p01_9a7e45",
  "प्रणेता ज्योतिरित्याद्यैः प्रसिद्धैरन्यवस्तुषु"
 ],
 [
  "sgb_001_u03_padya_p02_7bc72a",
  "उच्यते विष्णुरेवैकः सर्वैः सर्वगुणत्वतः"
 ],
 [
  "sgb_001_u04_padya_p01_0a09ba",
  "सर्वगोऽत्ता नियन्ता च दृश्यत्वाद्युज्झितः सदा"
 ],
 [
  "sgb_001_u04_padya_p02_696400",
  "| विश्वजीवान्तरत्वाद्यैर्लिङ्गैः सर्वैर्युतः स हि"
 ],
 [
  "sgb_001_u05_padya_p01_622dc3",
  "सर्वाश्रयः पूर्णगुणः सोऽक्षरः सन् हृदब्जगः"
 ],
 [
  "sgb_001_u05_padya_p02_8942e5",
  "सूर्यादिभासकः प्राणप्रेरको दैवतैरपि"
 ],
 [
  "sgb_001_u06_padya_p01_d49312",
  "ज्ञेयो न वेदैः शूद्राद्यैः कम्पकोऽन्यश्च जीवतः"
 ],
 [
  "sgb_001_u06_padya_p02_7f5037",
  "पतित्वादिगुणैर्युक्तस्तदन्यत्र च वाचकैः"
 ],
 [
  "sgb_001_u07_padya_p01_da479a",
  "मुख्यतः सर्वशब्दैश्च वाच्य एको जनार्दनः"
 ],
 [
  "sgb_001_u07_padya_p02_233433",
  "अव्यक्तः कर्मवाक्यैश्च वाच्य एकोऽमितात्मकः"
 ],
 [
  "sgb_001_u08_padya_p01_10955c",
  "अवान्तरं कारणं च प्रकृतिः शून्यमेव च"
 ],
 [
  "sgb_001_u08_padya_p02_c00a56",
  "इत्याद्यन्यत्र नियतैरपि मुख्यतयोदितः"
 ],
 [
  "sgb_001_u08_padya_p03_7d64de",
  "शब्दैरतोऽनन्तगुणो यच्छब्दा योगवृत्तयः"
 ],
 [
  "sgb_001_u09_padya_p01_3e58b1",
  "इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते"
 ],
 [
  "sgb_001_u09_padya_p02_6a64aa",
  "ब्रह्मसूत्रसङ्ग्रहभाष्ये प्रथमोऽध्यायः"
 ],
 [
  "sgb_001_u09_padya_p03_1a6996",
  "श्रौतस्मृतिविरुद्धत्वात् स्मृतयो न गुणान् हरेः"
 ],
 [
  "sgb_001_u09_padya_p04_c6c455",
  "निषेद्धुं शक्नुयुर्वेदा नित्यत्वान्मानमुत्तमम्"
 ],
 [
  "sgb_002_u01_padya_p01_3d4950",
  "देवतावचनादापो वदन्तीत्यादिकं वचः"
 ],
 [
  "sgb_002_u01_padya_p02_087f3c",
  "नायुक्तवाद्यसन्नैव कारणं दृश्यते क्वचित्"
 ],
 [
  "sgb_002_u02_padya_p01_801d8b",
  "असज्जीवप्रधानादिशब्दा ब्रह्मैव नापरम्"
 ],
 [
  "sgb_002_u02_padya_p02_7a162e",
  "वदन्ति कारणत्वेन क्वापि पूर्णगुणो हरिः"
 ],
 [
  "sgb_002_u03_padya_p01_8f2e49",
  "स्वातन्त्र्यात् सर्वकर्तृत्वान्नायुक्तं तद् वदेच्छ्रुतिः"
 ],
 [
  "sgb_002_u03_padya_p02_ec5280",
  "भ्रान्तिमूलतया सर्वसमयानामयुक्तितः"
 ],
 [
  "sgb_002_u04_padya_p01_69d399",
  "न तद्विरोधाद् वचनं वैदिकं शङ्क्यतां व्रजेत्"
 ],
 [
  "sgb_002_u04_padya_p02_53b822",
  "आकाशदिसमस्तं च तज्जं तेनैव लीयते"
 ],
 [
  "sgb_002_u05_padya_p01_63974e",
  "सोऽनुत्पत्तिलयः कर्ता जीवस्तद्वशगः सदा"
 ],
 [
  "sgb_002_u05_padya_p02_50f40d",
  "तदाभासो हरिः सर्वरूपेष्वपि समः सदा"
 ],
 [
  "sgb_002_u06_padya_p01_c62c9e",
  "मुख्यप्राणश्चेन्द्रियाणि देहश्चैव तदुद्भवः"
 ],
 [
  "sgb_002_u06_padya_p02_8de6cb",
  "मुख्यप्राणवशे सर्वं स विष्णोर्वशगः सदा"
 ],
 [
  "sgb_002_u07_padya_p01_b8f813",
  "सर्वदोषोज्झितस्तस्माद् भगवान् पुरुषोत्तमः"
 ],
 [
  "sgb_002_u07_padya_p02_e39746",
  "उक्ता गुणाश्चाविरुद्धास्तस्य वेदेन सर्वशः"
 ],
 [
  "sgb_002_u08_padya_p01_3e58b1",
  "इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते"
 ],
 [
  "sgb_002_u08_padya_p02_8e38d2",
  "ब्रह्मसूत्रसङ्ग्रहभाष्ये द्वितीयोऽध्यायः"
 ],
 [
  "sgb_002_u08_padya_p03_fcb164",
  "शुभेन कर्मणा स्वर्गं निरयं च विकर्मणा"
 ],
 [
  "sgb_002_u08_padya_p04_d74087",
  "मिथ्याज्ञानेन च तमो ज्ञानेनैव परं पदम्"
 ],
 [
  "sgb_003_u01_padya_p01_710714",
  "याति तस्माद् विरक्तः सन् ज्ञानमेव समाश्रयेत्"
 ],
 [
  "sgb_003_u01_padya_p02_658cf9",
  "सर्वावस्थाप्रेरकश्च सर्वरूपेष्वभेदवान्"
 ],
 [
  "sgb_003_u02_padya_p01_0ce8ee",
  "सर्वदेशेषु कालेषु स एकः परमेश्वरः"
 ],
 [
  "sgb_003_u02_padya_p02_2454c1",
  "तद्भक्तितारतम्येन तारतम्यं विमुक्तिगम्"
 ],
 [
  "sgb_003_u03_padya_p01_aa82ee",
  "सच्चिदानन्द आत्मेति मानुषैस्तु सुरेश्वरैः"
 ],
 [
  "sgb_003_u03_padya_p02_54eea2",
  "यथाक्रमं बहुगुणैर्ब्रह्मणा त्वखिलैर्गुणैः"
 ],
 [
  "sgb_003_u04_padya_p01_20bb56",
  "उपास्यः सर्ववेदैश्च सर्वैरपि यथाबलम्"
 ],
 [
  "sgb_003_u04_padya_p02_a1a7a2",
  "ज्ञेयो विष्णुर्विशेषस्तु ज्ञाने स्यादुत्तरोत्तरम्"
 ],
 [
  "sgb_003_u05_padya_p01_190695",
  "सर्वेऽपि पुरुषार्थाः स्युर्ज्ञानादेव न संशयः"
 ],
 [
  "sgb_003_u05_padya_p02_6cffce",
  "न लिप्यते ज्ञानवांश्च सर्वदोषैरपि क्वचित्"
 ],
 [
  "sgb_003_u06_padya_p01_f42a53",
  "गुणदौषैः सुखस्यापि वृद्धिह्रासौ विमुक्तिगौ"
 ],
 [
  "sgb_003_u06_padya_p02_905aee",
  "नृणां सुराणां मुक्तौ तु सुखं कॢप्तं यथाक्रमम्"
 ],
 [
  "sgb_003_u07_padya_p01_3e58b1",
  "इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते"
 ],
 [
  "sgb_003_u07_padya_p02_84fbb4",
  "ब्रह्मसूत्रसङ्ग्रहभाष्ये तृतीयोऽध्यायः"
 ],
 [
  "sgb_003_u07_padya_p03_db8afb",
  "विष्णुर्ब्रह्म तथाऽऽदातेत्येवं नित्यमुपासनम्"
 ],
 [
  "sgb_003_u07_padya_p04_6451c1",
  "कार्यमापद्यपि ब्रह्म तेन यात्यपरोक्षताम्"
 ],
 [
  "sgb_004_u01_padya_p01_055446",
  "प्रारब्धकर्मणोऽन्यस्य ज्ञानादेव परिक्षयः"
 ],
 [
  "sgb_004_u01_padya_p02_bc8627",
  "अनिष्टस्योभयस्यापि सर्वस्यान्यस्य भोगतः"
 ],
 [
  "sgb_004_u02_padya_p01_69a5b7",
  "उत्तरेषूत्तरेष्वेवं यावद् वायुं विमुक्तिगाः"
 ],
 [
  "sgb_004_u02_padya_p02_cb9266",
  "प्रविश्य भुञ्जते भोगांस्तदन्तर्बहिरेव वा"
 ],
 [
  "sgb_004_u03_padya_p01_23792f",
  "वायुर्विष्णुं प्रविश्यैव भोगश्चैवोत्तरोत्तरम्"
 ],
 [
  "sgb_004_u03_padya_p02_642117",
  "उत्क्रम्य मानुषा मुक्तिं यान्ति देहक्षयात् सुराः"
 ],
 [
  "sgb_004_u04_padya_p01_5080e7",
  "अर्चिरादिपथा वायुं प्राप्य तेन जनार्दनम्"
 ],
 [
  "sgb_004_u04_padya_p02_9d53d9",
  "यान्त्युत्तमा नरोच्चाद्या ब्रह्मलोकात् सहामुना"
 ],
 [
  "sgb_004_u05_padya_p01_7e38dc",
  "यथासङ्कल्पभोगाश्च चिदानन्दशरीरिणः"
 ],
 [
  "sgb_004_u05_padya_p02_013ebe",
  "जगत्सृष्ट्यादिविषये महासामर्थ्यमप्यृते"
 ],
 [
  "sgb_004_u06_padya_p01_eae8c1",
  "यथेष्टशक्तिमन्तश्च विना स्वाभाविकोत्तमान्"
 ],
 [
  "sgb_004_u06_padya_p02_056b2d",
  "अनन्यवशगाश्चैव वृद्धिह्रासविवर्जिताः"
 ],
 [
  "sgb_004_u06_padya_p03_06e962",
  "दुःखादिरहिता नित्यं मोदन्तेऽविरतं सुखम्"
 ],
 [
  "sgb_004_u07_padya_p01_b01363",
  "पूर्णप्रज्ञेन मुनिना सर्वशास्त्रार्थसङ्ग्रहः"
 ],
 [
  "sgb_004_u07_padya_p02_b1fed2",
  "कृतोऽयं प्रीयतां तेन परमात्मा रमापतिः"
 ],
 [
  "sgb_005_u01_padya_p01_575b88",
  "नमोनमोऽशेषदोषदूरपूर्णगुणात्मने"
 ],
 [
  "sgb_005_u01_padya_p02_4aa201",
  "विरिञ्चिशर्वपूर्वेड्य वन्द्याय श्रीवराय ते"
 ],
 [
  "sgb_005_u02_padya_p01_3e58b1",
  "इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते"
 ],
 [
  "sgb_005_u02_padya_p02_44fa76",
  "ब्रह्मसूत्रसङ्ग्रहभाष्ये चतुर्थोऽध्यायः"
 ],
 [
  "sgb_005_u02_padya_p03_23267e",
  "समाप्तश्चायं ग्रन्थः"
 ]
]