{
 "kat_seq11_u09_padya_p01_ef43ea": "इति पाद्मे",
 "kat_seq11_u11_padya_p03_8b57f9": "गुहानिहितत्वं च तस्यैव विशेषतः प्रसिद्धम्",
 "kat_seq11_u09_padya_p02_251990": "लोकादिः प्रतिष्ठा ब्रह्मजज्ञोऽनन्तलोकाप्तिरित्यादिविशेषणैश्च भगवानेव",
 "kat_seq11_u11_padya_p04_471873": "नचाग्निपरिज्ञानमात्रेणानन्तलोकाप्तिर्भगवज्ज्ञानं विना",
 "kat_seq11_u05_padya_p01_656520": "इति नामनिरुक्ते",
 "kat_seq11_u11_padya_p01_75e56a": "इति परामर्शाच्च",
 "kat_seq11_u13_padya_p01_c4573f": "इत्यादिश्रुतेः",
 "kat_seq11_u05_padya_p02_7f8dbc": "अनेकरूपां सुवर्णमयीम्",
 "kat_seq11_u11_padya_p02_ca1817": "भगवतो ह्युरुगायनाम प्रसिद्धम्",
 "kat_seq11_u13_padya_p02_cd6c70": "नच मुख्ये सत्यमुख्यार्थो युज्यते"
}