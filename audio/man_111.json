{
 "bsb_1_1_1_u01_sutra_p01_01d49e": "अथातो ब्रह्मजिज्ञासा",
 "bsb_1_1_1_u02_padya_p01_e03f5e": "नारायणं गुणैः सर्वैरुदीर्णं दोषवर्जितम्",
 "bsb_1_1_1_u02_padya_p02_5bd31f": "ज्ञेयं गम्यं गुरूंश्चापि नत्वा सूत्रार्थ उच्यते",
 "bsb_1_1_1_u03_gadya_p01_781fd3": "द्वापरे सर्वत्र ज्ञान आकुलीभूते तन्निर्णयाय",
 "bsb_1_1_1_u03_gadya_p02_886f6a": "ब्रह्मरुद्रेन्द्रादिभिरर्थितो भगवान् नारायणो व्यासत्वेनावततार",
 "bsb_1_1_1_u03_gadya_p03_6cefd2": "अथेष्टानिष्टप्राप्तिपरिहारेच्छूनां तद्योगमविजानतां",
 "bsb_1_1_1_u03_gadya_p04_4b43d5": "तज्ज्ञापनार्थं वेदमुत्सन्नं व्यञ्जयंश्चतुर्धा व्यभजत्",
 "bsb_1_1_1_u03_gadya_p05_f99a05": "चतुर्विंशतिधैकशतधा सहस्रधा द्वादशधा च",
 "bsb_1_1_1_u03_gadya_p06_28f986": "तदर्थनिर्णयाय ब्रह्मसूत्राणि चकार",
 "bsb_1_1_1_u03_gadya_p07_5a5339": "तच्चोक्तं स्कान्दे",
 "bsb_1_1_1_u04_padya_p01_45f674": "नारायणाद् विनिष्पन्नं ज्ञानं कृतयुगे स्थितम्",
 "bsb_1_1_1_u04_padya_p02_4c489f": "किञ्चित् तदन्यथा जातं त्रेतायां द्वापरेऽखिलम्",
 "bsb_1_1_1_u04_padya_p03_24035b": "गौतमस्य ऋषेः शापाज्ज्ञाने त्वज्ञानतां गते",
 "bsb_1_1_1_u04_padya_p04_37bb34": "सङ्कीर्णबुद्धयो देवा ब्रह्मरुद्रपुरःसराः",
 "bsb_1_1_1_u04_padya_p05_7c5fb5": "शरण्यं शरणं जग्मुर्नारायणमनामयम्",
 "bsb_1_1_1_u04_padya_p06_4f16b2": "तैर्विज्ञापितकार्यस्तु भगवान् पुरुषोत्तमः",
 "bsb_1_1_1_u04_padya_p07_e73544": "अवतीर्णो महायोगी सत्यवत्यां पराशरात्",
 "bsb_1_1_1_u04_padya_p08_cfd296": "उत्सन्नान् भगवान् वेदानुज्जहार हरिः स्वयम्",
 "bsb_1_1_1_u04_padya_p09_d0ad51": "चतुर्धा व्यभजत् तांश्च चतुर्विंशतिधा पुनः",
 "bsb_1_1_1_u04_padya_p10_4d4eb8": "शतधा चैकधा चैव तथैव च सहस्रधा",
 "bsb_1_1_1_u04_padya_p11_383124": "कृष्णो द्वादशधा चैव पुनस्तस्यार्थवित्तये",
 "bsb_1_1_1_u04_padya_p12_f026d2": "चकार ब्रह्मसूत्राणि येषां सूत्रत्वमञ्जसा",
 "bsb_1_1_1_u04_padya_p13_c33ef2": "अल्पाक्षरमसन्दिग्धं सारवद् विश्वतोमुखम्",
 "bsb_1_1_1_u04_padya_p14_f09c11": "अस्तोभमनवद्यं च सूत्रं सूत्रविदो विदुः",
 "bsb_1_1_1_u04_padya_p15_996071": "निर्विशेषितसूत्रत्वं ब्रह्मसूत्रस्य चाप्यतः",
 "bsb_1_1_1_u04_padya_p16_37a0ec": "यथा व्यासत्वमेकस्य कृष्णस्यान्ये विशेषणात्",
 "bsb_1_1_1_u04_padya_p17_2f2ad6": "सविशेषणसूत्राणि ह्यपराणि विदो विदुः",
 "bsb_1_1_1_u04_padya_p18_7f4cd6": "मुख्यस्य निर्विशेषेण शब्दोऽन्येषां विशेषतः",
 "bsb_1_1_1_u04_padya_p19_f96828": "इति वेदविदः प्राहुः शब्दतत्त्वार्थवेदिनः",
 "bsb_1_1_1_u04_padya_p20_ade2ee": "सूत्रेषु येषु सर्वेऽपि निर्णयाः समुदीरिताः",
 "bsb_1_1_1_u04_padya_p21_ceeda7": "शब्दजातस्य सर्वस्य यत्प्रमाणश्च निर्णयः",
 "bsb_1_1_1_u04_padya_p22_163da6": "एवंविधानि सूत्राणि कृत्वा व्यासो महायशाः",
 "bsb_1_1_1_u04_padya_p23_ccff33": "ब्रह्मरुद्रादिदेवेषु मनुष्यपितृपक्षिषु",
 "bsb_1_1_1_u04_padya_p24_2d2ee9": "ज्ञानं संस्थाप्य भगवान् क्रीडते पुरुषोत्तमः",
 "bsb_1_1_1_u05_gadya_p01_0a061f": "इत्यादि",
 "bsb_1_1_1_u05_gadya_p02_01d49e": "अथातो ब्रह्मजिज्ञासा",
 "bsb_1_1_1_u05_gadya_p03_bc7a69": "अथशब्दो मङ्गलार्थोऽधिकारानन्तर्यार्थश्च",
 "bsb_1_1_1_u05_gadya_p04_0502e2": "अतः शब्दो हेत्वर्थः",
 "bsb_1_1_1_u05_gadya_p05_2bf9c5": "उक्तं च गारुडे",
 "bsb_1_1_1_u06_padya_p01_0df1cc": "अथातःशब्दपूर्वाणि सूत्राणि निखिलान्यपि",
 "bsb_1_1_1_u06_padya_p02_fc54c9": "प्रारभन्ते नियत्यैव तत् किमत्र नियामकम्",
 "bsb_1_1_1_u06_padya_p03_a76217": "कश्चार्थश्च तयोर्विद्वन् कथमुत्तमता तयोः",
 "bsb_1_1_1_u06_padya_p04_0e50dd": "एतदाख्याहि मे ब्रह्मन् यथा ज्ञास्यामि तत्त्वतः",
 "bsb_1_1_1_u06_padya_p05_ac7fa7": "एवमुक्तो नारदेन ब्रह्मा प्रोवाच सत्तमः",
 "bsb_1_1_1_u06_padya_p06_55eab4": "आनन्तर्येऽधिकारस्य मङ्गलार्थे तथैव च",
 "bsb_1_1_1_u06_padya_p07_c4f3f3": "अथशब्दस्त्वतःशब्दो हेत्वर्थे समुदीरितः",
 "bsb_1_1_1_u06_padya_p08_9bf9bd": "परस्य ब्रह्मणो विष्णोः प्रसादादिति वा भवेत्",
 "bsb_1_1_1_u06_padya_p09_8d64ed": "स हि सर्वमनोवृत्तिप्रेरकः समुदाहृतः",
 "bsb_1_1_1_u06_padya_p10_c1fc26": "सिसृक्षोः परमाद् विष्णोः प्रथमं द्वौ विनिःसृतौ",
 "bsb_1_1_1_u06_padya_p11_ced5f1": "ओङ्कारश्चाथशब्दश्च तस्मात् प्राथमिकौ क्रमात्",
 "bsb_1_1_1_u06_padya_p12_8c766d": "तद्धेतुत्वं वदंश्चापि तृतीयोऽत उदाहृतः",
 "bsb_1_1_1_u06_padya_p13_bacc48": "अकारः सर्ववागात्मा परब्रह्माभिधायकः",
 "bsb_1_1_1_u06_padya_p14_dd1ab3": "तथौ प्राणात्मकौ प्रोक्तौ व्याप्तिस्थितिविधायकौ",
 "bsb_1_1_1_u06_padya_p15_5bb2f2": "अतश्च पूर्वमुच्चार्याः सर्व एते सतां मताः",
 "bsb_1_1_1_u06_padya_p16_ede590": "अथातःशब्दयोरेवं वीर्यमाज्ञाय तत्त्वतः",
 "bsb_1_1_1_u06_padya_p17_f90b19": "सूत्रेषु तु महाप्राज्ञास्तावेवादौ प्रयुञ्जते",
 "bsb_1_1_1_u07_gadya_p01_dcf9fe": "इति",
 "bsb_1_1_1_u08_gadya_p01_8d3daa": "अधिकारश्चोक्तो भागवततन्त्रे",
 "bsb_1_1_1_u09_padya_p01_0ec1af": "मन्दमध्योत्तमत्वेन त्रिविधा ह्यधिकारिणः",
 "bsb_1_1_1_u09_padya_p02_dcbf9d": "तत्र मन्दा मनुष्येषु य उत्तमगणा मताः",
 "bsb_1_1_1_u09_padya_p03_56d135": "मध्यमा ऋषिगन्धर्वा देवास्तत्रोत्तमा मताः",
 "bsb_1_1_1_u09_padya_p04_f04cac": "इति जातिकृतो भेदस्तथाऽन्यो गुणपूर्वकः",
 "bsb_1_1_1_u09_padya_p05_1efed9": "भक्तिमान् परमे विष्णौ यस्त्वध्ययनवान् नरः",
 "bsb_1_1_1_u09_padya_p06_971e2a": "अधमः शमादिसंयुक्तो मध्यमः समुदाहृतः",
 "bsb_1_1_1_u09_padya_p07_37e78d": "आब्रह्मस्तम्बपर्यन्तमसारं चाप्यनित्यकम्",
 "bsb_1_1_1_u09_padya_p08_a437cb": "विज्ञाय जातवैराग्यो विष्णुपादैकसंश्रयः",
 "bsb_1_1_1_u09_padya_p09_0a1e99": "स उत्तमोऽधिकारी स्यात् सन्न्यस्ताखिलकर्मवान्",
 "bsb_1_1_1_u10_gadya_p01_dcf9fe": "इति",
 "bsb_1_1_1_u11_padya_p01_84aeb5": "अध्ययनमात्रवतः",
 "bsb_1_1_1_u12_padya_p01_283e88": "नाविशेषात्",
 "bsb_1_1_1_u13_gadya_p01_37cc92": "इति चोपरि",
 "bsb_1_1_1_u14_padya_p01_c9fb82": "शान्तो दान्त उपरतस्तितिक्षुः समाहितो भूत्वाऽऽत्मन्येवात्मानं पश्येत्",
 "bsb_1_1_1_u15_padya_p01_32f07b": "परीक्ष्य लोकान् कर्मचितान् ब्राह्मणो निर्वेदमायान्नास्त्यकृतः कृतेन",
 "bsb_1_1_1_u15_padya_p02_85524c": "तद्विज्ञानार्थं स गुरुमेवाभिगच्छेत् समित्पाणिः श्रोत्रियं ब्रह्मनिष्ठम्",
 "bsb_1_1_1_u16_padya_p01_efef5a": "यमेवैष वृणुते तेन लभ्यस्तस्यैष आत्मा विवृणुते तनूं स्वाम्",
 "bsb_1_1_1_u17_padya_p01_414c42": "यस्य देवे परा भक्तिर्यथा देवे तथा गुरौ",
 "bsb_1_1_1_u17_padya_p02_aad37b": "तस्यैते कथिता ह्यर्थाः प्रकाशन्ते महात्मनः",
 "bsb_1_1_1_u18_gadya_p01_2f35a4": "इत्यादिश्रुतिभ्यश्च",
 "bsb_1_1_1_u18_gadya_p02_bcb556": "व्योमसंहितायां च",
 "bsb_1_1_1_u19_padya_p01_a4b042": "अन्त्यजा अपि ये भक्ता नामज्ञानाधिकारिणः",
 "bsb_1_1_1_u19_padya_p02_70e3a7": "स्त्रीशूद्रब्रह्मबन्धूनां तन्त्रज्ञानेऽधिकारिता",
 "bsb_1_1_1_u19_padya_p03_46b11b": "एकदेशे परोक्ते तु नतु ग्रन्थपुरःसरे",
 "bsb_1_1_1_u19_padya_p04_a6345f": "त्रैवर्णिकानां वेदोक्ते सम्यग्भक्तिमतां हरौ",
 "bsb_1_1_1_u19_padya_p05_5aecfd": "आहुरप्युत्तमस्त्रीणामधिकारं तु वैदिके",
 "bsb_1_1_1_u19_padya_p06_7d211f": "यथोर्वशी यमी चैव शच्याद्याश्च तथा पराः",
 "bsb_1_1_1_u20_gadya_p01_dcf9fe": "इति",
 "bsb_1_1_1_u20_gadya_p02_5dd8ec": "यतो नारायणप्रसादमृते न मोक्षः",
 "bsb_1_1_1_u20_gadya_p03_fa5dac": "नच ज्ञानं विनाऽत्यर्थप्रसादः",
 "bsb_1_1_1_u20_gadya_p04_6f86dd": "अतो ब्रह्मजिज्ञासा कर्तव्या",
 "bsb_1_1_1_u21_padya_p01_225227": "यत्रानवसरोऽन्यत्र पदं तत्र प्रतिष्ठितम्",
 "bsb_1_1_1_u21_padya_p02_cf3beb": "वाक्यं वेति सतां नीतिः सावकाशे न तद् भवेत्",
 "bsb_1_1_1_u22_gadya_p01_649811": "इति बृहत्संहितायाम्",
 "bsb_1_1_1_u23_padya_p01_998919": "तमेवं विद्वानमृत इह भवति",
 "bsb_1_1_1_u23_padya_p02_b8d3cd": "नान्यः पन्था अयनाय विद्यते",
 "bsb_1_1_1_u24_padya_p01_5a0d2b": "प्रियो हि ज्ञानिनोऽत्यर्थमहं स च मम प्रियः",
 "bsb_1_1_1_u25_padya_p01_c6752e": "यमेवैष वृणुते तेन लभ्यः",
 "bsb_1_1_1_u26_padya_p01_f98ba9": "आत्मा वा अरे द्रष्टव्यः श्रोतव्यो मन्तव्यो निदिध्यासितव्यः",
 "bsb_1_1_1_u27_gadya_p01_b44518": "इत्यादिश्रुतिस्मृतिभ्यः",
 "bsb_1_1_1_u28_padya_p01_0c4813": "कर्मणा त्वधमः प्रोक्तः प्रसादः श्रवणादिभिः",
 "bsb_1_1_1_u28_padya_p02_277dcb": "मध्यमो ज्ञानसम्पत्त्या प्रसादस्तूत्तमो मतः",
 "bsb_1_1_1_u28_padya_p03_59a5ab": "प्रसादात् त्वधमाद् विष्णोः स्वर्गलोकः प्रकीर्तितः",
 "bsb_1_1_1_u28_padya_p04_ff94f2": "मध्यमाज्जनलोकादिरुत्तमस्त्वेव मुक्तिदः",
 "bsb_1_1_1_u28_padya_p05_fa035c": "श्रवणं मननं चैव ध्यानं भक्तिस्तथैव च",
 "bsb_1_1_1_u28_padya_p06_6d7909": "साधनं ज्ञानसम्पत्तौ प्रधानं नान्यदिष्यते",
 "bsb_1_1_1_u28_padya_p07_5f5cad": "नचैतानि विना कश्चिज्ज्ञानमाप कुतश्चन",
 "bsb_1_1_1_u29_gadya_p01_44abf7": "इति नारदीये",
 "bsb_1_1_1_u29_gadya_p02_10c070": "ब्रह्मशब्दश्च विष्णावेव",
 "bsb_1_1_1_u30_padya_p01_39508c": "यमन्तः समुद्रे कवयोऽवयन्ति",
 "bsb_1_1_1_u31_gadya_p01_be87c8": "इत्याद्युक्त्वा",
 "bsb_1_1_1_u32_padya_p01_5a857f": "तदेव ब्रह्म परमं कवीनाम्",
 "bsb_1_1_1_u33_gadya_p01_b5cb78": "इति हि श्रुतिः",
 "bsb_1_1_1_u34_padya_p01_8dcdec": "तन्नो विष्णुः",
 "bsb_1_1_1_u35_gadya_p01_6e2da6": "इति वचनाद् विष्णुरेव हि तत्रोच्यते",
 "bsb_1_1_1_u35_gadya_p02_6ea861": "नचेतरशब्दात् तत्प्राप्तिः",
 "bsb_1_1_1_u36_padya_p01_ae6017": "नामानि विश्वाऽभि न सन्ति लोके यदाविरासीदनृतस्य सर्वम्",
 "bsb_1_1_1_u36_padya_p02_3108d7": "नामानि सर्वाणि यमाविशन्ति तं वै विष्णुं परममुदाहरन्ति",
 "bsb_1_1_1_u37_gadya_p01_f38b76": "इति भाल्लवेयश्रुतिः",
 "bsb_1_1_1_u38_padya_p01_6df92d": "यो देवानां नामधा एक एव",
 "bsb_1_1_1_u39_gadya_p01_d8c880": "इत्येवशब्दान्नान्येषां सर्वनामता",
 "bsb_1_1_1_u40_padya_p01_8fc1be": "अजस्य नाभावध्येकमर्पितं यस्मिन् विश्वानि भुवनानि तस्थुः",
 "bsb_1_1_1_u41_gadya_p01_6ded9d": "इति हि विष्णोर्लिङ्गम्",
 "bsb_1_1_1_u41_gadya_p02_bfb803": "नच प्रसिद्धार्थं विनाऽन्योऽर्थो युज्यते",
 "bsb_1_1_1_u42_padya_p01_f484e8": "अजस्य नाभाविति यस्य नाभेरभूच्छ्रुतेः पुष्करं लोकसारम्",
 "bsb_1_1_1_u42_padya_p02_bd1f99": "तस्मै नमो व्यस्तसमस्तविश्वविभूतये विष्णवे लोककर्त्रे",
 "bsb_1_1_1_u43_gadya_p01_a9f3ed": "इति स्कान्दे",
 "bsb_1_1_1_u44_padya_p01_3b44a9": "परो दिवा पर एना पृथिव्या",
 "bsb_1_1_1_u45_gadya_p01_9e8eab": "इति समाख्याश्रुतौ",
 "bsb_1_1_1_u46_padya_p01_173133": "यं कामये तन्तमुग्रं कृणोमि तं ब्रह्माणं तमृषिं तं सुमेधाम्",
 "bsb_1_1_1_u47_gadya_p01_f40ddb": "इत्युक्त्वा",
 "bsb_1_1_1_u48_padya_p01_1364aa": "मम योनिरप्स्वन्तःसमुद्रे",
 "bsb_1_1_1_u49_gadya_p01_af036f": "इत्याह",
 "bsb_1_1_1_u49_gadya_p02_7c7990": "उग्रो रुद्रः",
 "bsb_1_1_1_u49_gadya_p03_b07a29": "समुद्रेऽन्तर्नारायणः",
 "bsb_1_1_1_u49_gadya_p04_74db61": "प्रसिद्धत्वात् सूचितत्वाच्चास्यार्थस्य",
 "bsb_1_1_1_u49_gadya_p05_5bc7ec": "नचाविरोधे प्रसिद्धः परित्यज्यते",
 "bsb_1_1_1_u49_gadya_p06_bd41cf": "उक्तन्यायेन च श्रुतय एतमेव वदन्ति",
 "bsb_1_1_1_u50_padya_p01_9f4e9b": "वेदे रामायणे चैव पुराणे भारते तथा",
 "bsb_1_1_1_u50_padya_p02_e85851": "आदावन्ते च मध्ये च विष्णुः सर्वत्र गीयते",
 "bsb_1_1_1_u51_gadya_p01_a3a61a": "इति हरिवंशेषु",
 "bsb_1_1_1_u51_gadya_p02_b1ff65": "नचेतरग्रन्थविरोधः",
 "bsb_1_1_1_u52_padya_p01_e64ab6": "एष मोहं सृजाम्याशु यो जनान् मोहयिष्यति",
 "bsb_1_1_1_u52_padya_p02_0ced87": "त्वं च रुद्र महाबाहो मोहशास्त्राणि कारय",
 "bsb_1_1_1_u52_padya_p03_a1a63a": "अतथ्यानि वितथ्यानि दर्शयस्व महाभुज",
 "bsb_1_1_1_u52_padya_p04_e9be43": "प्रकाशं कुरु चात्मानमप्रकाशं च मां कुरु",
 "bsb_1_1_1_u53_gadya_p01_bc8095": "इति वाराहवचनात्",
 "bsb_1_1_1_u53_gadya_p02_beac22": "शैवे च स्कान्दे",
 "bsb_1_1_1_u54_padya_p01_dc049d": "श्वपचादपि कष्टत्वं ब्रह्मेशानादयः सुराः",
 "bsb_1_1_1_u54_padya_p02_a5ab7e": "तदैवाच्युत यान्त्येव यदैव त्वं पराङ्मुखः",
 "bsb_1_1_1_u55_gadya_p01_dcf9fe": "इति",
 "bsb_1_1_1_u55_gadya_p02_999089": "ब्राह्मे च ब्रह्मवैवर्ते",
 "bsb_1_1_1_u56_padya_p01_164705": "नाहं नच शिवोऽन्ये च तच्छक्त्येकांशभागिनः",
 "bsb_1_1_1_u56_padya_p02_2233c9": "बालः क्रीडनकैर्यद्वत् क्रीडतेऽस्माभिरच्युतः",
 "bsb_1_1_1_u57_gadya_p01_dcf9fe": "इति",
 "bsb_1_1_1_u57_gadya_p02_b1e348": "नच वैष्णवेषु तथा",
 "bsb_1_1_1_u57_gadya_p03_7bc379": "तच्च",
 "bsb_1_1_1_u58_padya_p01_a4273f": "एष मोहम्",
 "bsb_1_1_1_u59_gadya_p01_2bc73f": "इत्युक्तम्"
}