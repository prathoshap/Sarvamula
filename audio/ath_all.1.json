[{"id": "ath_seq64_u01_sutra_p01_bfc83b", "meter": "anuṣṭubh", "padas": ["कामान् यः कामयते मन्यमानः स कामभिर्जायते तत्रतत्र पर्याप्तकामस्य कृतात्मनश्च इहैव सर्वे प्रविलीयन्ति कामाः नायमात्मा प्रवचनेन लभ्यो न मेधया न बहुना श्रुतेन यमेवैष वृणुते तेन लभ्यस्तस्यैष आत्मा विवृणुते तनूं स्वाम् नायमात्मा बलहीनेन लभ्यो नच प्रमादात् तपसो वाऽप्यलिङ्गात् एतैरुपायैर्यतते यस्तु विद्वांस्तस्यैष आत्मा विशते ब्रह्मधाम सम्प्राप्यैनमृषयो ज्ञानतृप्ताः कृतात्मानो वीतरागाः प्रशान्ताः ते सर्वगं सर्वतः प्राप्य धीरा मुक्तात्मानः सर्वमेवापियन्ति"], "seed": 60, "no_sandhi": true}, {"id": "ath_seq74_u01_sutra_p01_0e77fa", "meter": "anuṣṭubh", "padas": ["तदेष श्लोकः क्रियावन्तः श्रोत्रिया ब्रह्मनिष्ठाः स्वयं जुह्वत एकर्षीन् श्रद्धयन्तः तेषामेवैतां ब्रह्मविद्यां वदेत शिरोव्रतं विधिवद् यैस्तु चीर्णम् तदेतत् सत्यमृषिरङ्गिराः पुरोवाच नैतदचीर्णव्रतोऽधीते नमः परमऋषिभ्यो नमः परमऋषिभ्यः"], "seed": 60, "no_sandhi": true}, {"id": "ath_seq19_u01_sutra_p01_0946e3", "meter": "anuṣṭubh", "padas": ["तदेतत् सत्यम् यथा सुदीप्तात् पावकात् विष्फुलिङ्गाः सहस्रशः प्रभवन्ते सरूपाः तथाऽक्षरात् विविधाः सोम्य भावाः प्रजायन्ते तत्र चैवापियन्ति दिव्यो ह्यमूर्तः पुरुषः स बाह्याभ्यन्तरो ह्यजः अप्राणो ह्यमनाः शुभ्रो ह्यक्षरात् परतः परः"], "seed": 60, "no_sandhi": true}, {"id": "ath_seq72_u01_sutra_p01_3badb7", "meter": "anuṣṭubh", "padas": ["स यो ह वै तत् परमं ब्रह्म वेद ब्रह्मैव भवति नास्याब्रह्मवित् कुले भवति तरति शोकं तरति पाप्मानं गुहाग्रन्थिभ्यो विमुक्तोऽमृतो भवति"], "seed": 60, "no_sandhi": true}, {"id": "ath_seq66_u01_sutra_p01_d2651b", "meter": "anuṣṭubh", "padas": ["वेदान्तविज्ञानसुनिश्चितार्थाः सन्यासयोगाद् यतयः शुद्धसत्त्वाः ते ब्रह्मलोकेषु परान्तकाले परामृतात् परिमुच्यन्ति सर्वे"], "seed": 60, "no_sandhi": true}, {"id": "ath_seq49_u01_sutra_p01_a5489a", "meter": "sragdharā", "padas": ["समाने वृक्षे पुरुषो निमग्नोऽनीशया शोचति मुह्यमानः जुष्टं यदा पश्यत्यन्यमीशमस्य महिमानमिति वीतशोकः"], "seed": 60, "no_sandhi": true}, {"id": "ath_seq68_u08_padya_p01_f67e4f", "meter": "indravajrā", "padas": ["विज्ञानात्मा सह देवैश्