{
 "bsb_1_1_3_u02_padya_p02_eb153c": "शास्त्रयोनित्वात्",
 "bsb_1_1_6_u04_padya_p02_6d31f7": "आत्मशब्दात्",
 "bsb_1_1_31_u04_padya_p06_940277": "इहाश्रितत्वाच्च",
 "bsb_2_1_14_u04_padya_p04_ddd345": "नह्यन्यस्यान्यत्वं युज्यत इति चेत्",
 "bsb_2_1_26_u02_padya_p02_055864": "नच कर्तुरीश्वरस्यादृष्टिविरोधः",
 "bsb_2_2_5_u02_padya_p04_4c98a2": "अतो ब्रवीति- अन्यत्राभावाच्च न तृणादिवत्",
 "bsb_3_1_4_u04_padya_p01_21f586": "इत्यादिश्रुतेर्न प्राणानां जीवेन सह गतिरिति चेत्",
 "bsb_3_2_13_u04_padya_p01_aa7892": "इति",
 "bsb_3_3_40_u02_padya_p01_b8afc9": "प्रकृतेरपि जन्मादेः संसारप्राप्तेः किमिति नामादिष्वपाठ इति",
 "bsb_3_3_59_u02_padya_p03_f6e23a": "दीक्षाप्रायणीयोदयनीयसवनत्रयावभृथात्मकः क्रतुः",
 "bsb_3_4_41_u02_padya_p05_847c63": "चशब्दस्तु ज्ञानार्थिनां पूर्वोक्तादित्थम्भावान्तरसूचकः",
 "bsb_4_1_17_u02_padya_p01_286c87": "अतोऽन्यदपीत्येकेषामुभयोः",
 "nvv_seq137_u02_padya_p02_a3b1d7": "स्वतन्त्रस्य च पूर्णगुणत्वनियमात्",
 "nvv_seq157_u02_padya_p02_d878fe": "क्रमादुत्पद्यते क्रमाद् विलीयते क्रमेणैवोत्पत्तिर्विलयश्च क्रमेणैव ह्यस्योत्पत्तिविलयौ इत्यादिलोकानुसारिबहुवाक्यानुरोधश्च यथोत्पत्तिविलये",
 "nvv_seq195_u02_padya_p03_24e6a0": "तद्दासाः पञ्च चान्येऽपि प्राणाद्याः सद्गुणैर्युताः",
 "nvv_seq248_u02_padya_p05_4e4919": "इति वचनाच्च",
 "nvv_seq288_u02_padya_p04_e1ce6a": "करोति क्वापि नियता क्रीडा सृष्ट्यादिकाऽस्य च",
 "nvv_seq290_u02_padya_p08_fcf624": "इति ब्रह्माण्डे",
 "nvv_seq304_u02_padya_p01_5be4ef": "प्रियशिरस्त्वादीनामानन्दादिविशेषत्वेनैव दर्शनात् तेषामपि सर्वोपसंहार्यत्वमिति न मन्तव्यम्",
 "nvv_seq320_u02_padya_p02_32bf65": "सत्यो ज्ञानं परमानन्दरूप आत्मेत्येवं नित्यदोपासनं स्यात्",
 "nvv_seq330_u02_padya_p06_4e4919": "इति वचनाच्च",
 "nvv_seq336_u02_padya_p12_4e4919": "इति वचनाच्च",
 "nvv_seq388_u02_padya_p07_7e729a": "यो ह्यत्वरया स महत्",
 "nvv_seq417_u02_padya_p04_aeb701": "पृथक्स्थितेन रूपेण जीवं धारयति प्रभुः",
 "nvv_seq431_u02_padya_p06_aae660": "वचनप्रामाण्यात्",
 "nvv_seq459_u02_padya_p01_14a60e": "नच सङ्कल्पादेव समस्तसम्भवात् सृष्ट्यादिसमस्तकार्यसम्भवः",
 "ait_seq12_u01_padya_p03_d4045a": "अन्तरीक्ष्यो यतो द्युस्थो द्युनामाऽतिप्रकाशनात्",
 "ait_seq12_u01_padya_p15_e70623": "मुखनासाचक्षुषां तद्भोग्यमन्नं हरेः श्रुतम्",
 "ait_seq12_u01_padya_p27_473032": "विष्णोर्वाग् भार्गवो रामः प्राणोऽस्य नरकेसरी",
 "ait_seq12_u01_padya_p39_9ee2cb": "परस्य विष्णोर्धामत्वात् सूर्यो ब्रध्न इतीरितः",
 "ait_seq16_u01_padya_p03_b3d46f": "यस्मात् प्रपेदे भगवान् प्रपदाच्चतुराननम्",
 "ait_seq16_u01_padya_p15_15cddf": "उरोमध्ये च हृदयं तत्रावासो हरेः सदा",
 "ait_seq16_u01_padya_p27_b916d3": "श्रोत्रं चन्द्रो रविश्चक्षुर्वागग्निः परिकीर्तितः",
 "ait_seq16_u01_padya_p39_9eca65": "पुनस्ते प्राविशन् सर्वे वह्निसूर्यो शशी शिवः",
 "ait_seq18_u01_padya_p04_f51250": "येये गुणान् विजानन्ति वायोस्तानाविशन्मरुत्",
 "ait_seq18_u01_padya_p16_303226": "श्रोत्रं तु वरुणः काम्यशास्त्रार्थं मित्र एव च",
 "ait_seq18_u01_padya_p28_3b0028": "मदभीष्टं ममादातुं नैवेष्टे कश्चनाञ्जसा",
 "ait_seq18_u01_padya_p40_3e212e": "इत्येतद्ध्यानयोग्याश्च मुनयो देवतास्तथा",
 "ait_seq18_u01_padya_p52_121b82": "देवतात्रयमेतत् तु सहितं सत्यमुच्यते",
 "ait_seq20_u01_padya_p07_b4da4b": "य एतद् विष्णुवाचैव बद्धं नामाख्यदामभिः",
 "ait_seq20_u01_padya_p19_64dbf9": "लोमप्राणादिभेदश्च नैव कश्चिच्चिदात्मनि",
 "ait_seq20_u01_padya_p31_95e927": "आ समन्तात् पराक् चापि पञ्चभूतेभ्य ईश्वरः",
 "ait_seq20_u01_padya_p43_05250f": "स वायुः प्रकृतिश्चैव विष्टब्धौ केशवेन हि",
 "ait_seq24_u01_padya_p08_3b25f1": "स्वतन्त्रत्वाज्जगन्नाथः पितृत्वात् परमेशितुः",
 "ait_seq24_u01_padya_p20_50d0c7": "मत्पर्यन्तं तथा व्याप्तिं देवानामपि सर्वशः",
 "ait_seq24_u01_padya_p32_54e7af": "पराभवति पाप्माऽस्य द्वेष्टा निरयगः सदा",
 "ait_seq24_u01_padya_p44_579055": "इत्येवोपासते तस्मात् पराभूताश्च सर्वशः",
 "ait_seq24_u01_padya_p56_4e41e6": "अवाक् प्राक् च सदा गच्छेद् वायुरानन्दरूपिणा",
 "ait_seq24_u01_padya_p68_cca215": "य एवं वेद तं वायुममृतं सर्वनायकम्",
 "ait_seq24_u03_padya_p02_c0d23d": "ब्रह्मा हैव ताइ ते",
 "ait_seq24_u07_padya_p01_a71816": "इत्यतो ब्रह्मा ह इति दैर्घ्यमपि परब्रह्मत्वविवक्षया",
 "ait_seq24_u16_padya_p01_efd91e": "ब्राह्मणोऽस्य मुखमासीत्",
 "ait_seq24_u21_padya_p01_ded6e4": "इत्यादिना भगवतः सकाशाद्धि सर्वेषां सृष्टिः प्रसिद्धा",
 "ait_seq24_u25_gadya_p01_7e4c84": "इति च ब्रह्माण्डे",
 "ait_seq71_u01_padya_p02_67f74c": "अत आधिक्यात् बृहतीसम्पादनमेव वरम्",
 "ait_seq71_u03_padya_p10_5da9dc": "वाग्रूपाया उमाया उत्पत्तिः संस्मृता भवत्येवं जानतः",
 "ait_seq71_u11_padya_p02_0f27b0": "स वा एष वाचः परमो विकारः",
 "ait_seq71_u15_padya_p09_9c7d3b": "अकारस्यादौ स्थितत्वेन च यथार्थरूपत्वात्",
 "ait_seq73_u03_padya_p04_c928c2": "स हि यत् प्रथमत इन्द्रो बभूव स्वेच्छया यज्ञनामा",
 "ait_seq73_u09_padya_p02_942f8f": "यत्र चैवं भूतेष्वेकत्वे विरोधो दृश्यते तत्र तेनैव विरोधेन द्वित्वं भवति",
 "ait_seq73_u19_padya_p04_b0dd5d": "अन्येन्द्रो हि",
 "ait_seq73_u29_padya_p02_f9bf1a": "नहि मृतः पुनरेषु लोकेष्वेव राजति",
 "ait_seq73_u39_padya_p01_8db353": "इति शब्दनिर्णये",
 "ait_seq73_u39_padya_p13_d2100f": "भगवानेव ह्यत्र प्रस्तुतः",
 "ait_seq75_u04_padya_p01_13a707": "इत्यादिवत्",
 "ait_seq75_u08_padya_p03_b97e16": "तस्मान्न पुनरुक्तिः",
 "ait_seq75_u14_padya_p02_3d41e1": "स्वतन्त्रो हि भगवान् तत्प्रेरित एव तं वदतीत्यभिप्रायः",
 "ait_seq75_u24_padya_p04_3361f3": "प्रत्यक्षत्वाज्जीवजडात्मकस्य जगत एवानुक्तावपि प्रस्तुतरूपत्वात् तदन्यस्तद्विरोधी तत्र दृश्यमानदोषवर्जितश्चाकारशब्दार्थ इति सिद्ध्यति",
 "ait_seq75_u24_padya_p16_bb6277": "तस्मात् पारतन्त्र्याल्पगुणत्वादिसर्ववस्तुस्वभावविरुद्धस्वभावं स्वतन्त्रं पूर्णगुणं सर्वजीवजडेभ्योऽन्यद् अज्ञानदुःखाल्पत्वपारतन्त्र्योत्पत्तिनाशादिसर्वदोषविवर्जितं ब्रह्मैवाशब्दार्थः",
 "ait_seq75_u26_padya_p06_9c30cc": "अन्येषां सर्वेषां मदधीनत्वादल्पत्वादिति",
 "ait_seq75_u34_padya_p03_98e323": "जीवस्थितेनाक्षरगेनाक्षरनाम्ना स्वरूपेण जीवाख्यसूर्यस्थितमहराख्यं स्वरूपमाप्नोति तेन चाक्षराख्यं स्वरूपमाप्नोति",
 "ait_seq75_u40_padya_p02_36ef93": "तेन रथेनाध्यात्मं शरीराख्येनाधिदैवं रथरूपेण",
 "ait_seq75_u46_padya_p02_ac44c8": "नच रात्रौ सुदिनमिति प्रयोगो दृष्टः",
 "ait_seq75_u52_padya_p01_10a562": "इति वचनात्",
 "ait_seq186_u03_padya_p05_b6eb15": "मम प्रीतिं कर्तुं नाशकः",
 "vtn_seq73_u01_padya_p04_a3c8b0": "द्विविधं बलवत्त्वं च बहुत्वाच्च स्वभावतः",
 "vtn_seq76_u01_padya_p05_40378b": "तथोपनयरूपा च परा निगमनात्मिका",
 "vtn_seq78_u01_padya_p04_d8ea47": "जनकं प्रमाणमुद्दिष्टं स्वस्यार्थस्य प्रकाशनात्",
 "vtn_seq170_u04_padya_p01_ae01e4": "यथा सोम्य मधु मधुकृतो निस्तिष्ठन्ति नानात्ययानां वृक्षाणां रसानां",
 "vtn_seq170_u07_padya_p01_df9854": "न्यग्रोधफलमत आहरेतीदं भगव इति भिन्धीति भिन्नं भगव इति",
 "vtn_seq174_u02_padya_p02_7be39c": "स्व इति परमात्मनोऽभिधानम्",
 "vtn_seq222_u06_padya_p02_19dddb": "नहि भोगाभावो",
 "vtn_seq250_u02_padya_p12_bd9d70": "नहीश्वरस्य भ्रान्तिः",
 "vtn_seq250_u08_padya_p04_5667c5": "विद्येतेत्यस्य चोत्पत्त्यर्थानङ्गीकारे यद्यदस्ति तत्तन्निवर्तत इति व्याप्त्यभावान्निवर्तेतेति न युज्यते",
 "gb_2_14d_u01_padya_p04_b05595": "नच विपर्यये किञ्चिन्मानम्",
 "gb_2_17b_u42_padya_p01_07ddc8": "इत्येतदात्मसम्बन्धि",
 "gb_2_17b_u53_padya_p04_0ef4e8": "लक्षितस्वरूपस्यापि न स्वरूपाद् विशेषः",
 "gb_2_39_u06_padya_p02_6843a8": "साङ्ख्यस्य निरीश्वरत्वादुक्तत्वाच्चेश्वरस्य",
 "gb_3_17_u13_padya_p01_ca0a7a": "ब्रह्मनिष्ठा ब्रह्मरता ब्रह्मज्ञानसुतर्पिताः",
 "gb_7_7_u31_padya_p02_51f1ed": "बहूनां जन्मनामन्ते ज्ञानवान् भवति",
 "gb_11_1_u20_padya_p01_1c1f2b": "इत्यादिरूपविशेषणाच्च रूपस्येश्वरसाक्षात्स्वरूपत्वम्",
 "gb_13_13_u10_padya_p01_93b096": "इति पूर्वमेव सिद्धत्वात्",
 "gt_2_55_u06_padya_p03_1e044a": "तच्चोक्तम्",
 "gt_2_55_u10_padya_p05_8a444b": "तथाऽपि न तत्रैवेति नियमः",
 "gt_2_55_u14_padya_p05_90a0db": "परमात्मन्येव स्थितः सन्",
 "gt_5_2_u13_padya_p01_bafb3c": "इत्यादेश्च ब्राह्मे",
 "gt_16_1_u08_padya_p01_d26b1e": "इत्यभिधानम्",
 "gt_16_11_u09_padya_p03_80a354": "यदि स्यान्मामपीदानीं कारयतु - इत्यादि",
 "tvk_seq18_u01_padya_p02_9ef4f0": "रूपमेव द्विधं तच्च यावद्वस्तु च खण्डितम्",
 "uk_seq5_u03_padya_p01_96a029": "इत्यादिवाक्यान्मृषा नच",
 "tsk_seq12_u01_padya_p05_cf2549": "देवर्षिपितृपनरा इति मुक्तास्तु पञ्चधा",
 "kat_seq11_u09_padya_p02_251990": "लोकादिः प्रतिष्ठा ब्रह्मजज्ञोऽनन्तलोकाप्तिरित्यादिविशेषणैश्च भगवानेव",
 "kan_seq288_u06_padya_p04_7fa0e1": "कक्ष्यं नारायणकवचम्",
 "knr_seq35_u04_padya_p02_4ab1c6": "आयो जानातीत्यायोमन्यः",
 "cha_seq200_u50_padya_p01_3ff34a": "असत्यमप्रतिष्ठं ते जगदाहुरनीश्वरम् एतां दृष्टिमवष्टभ्य नष्टात्मानोऽल्पबुद्धयः",
 "bt_10_40_15_u04_padya_p04_3938bc": "जीवगुणा विसंवृताः अधिसंवृताः",
 "bt_10_40_19_u10_padya_p02_db41e9": "प्राण एवैनमनुभुङ्क्ते प्राणमितरा देवताः",
 "bt_11_9_25_u04_padya_p02_7e11c9": "प्रश्वसित्यभूतिरित्यसुरास्ते ह पराबभूवुः"
}