{
 "kam_002_u09_padya_p01_9cce46": "शङ्करः सकृदभ्यर्चितो येन देवदेवो जनार्दनः",
 "kam_002_u10_padya_p01_b9fc75": "सकृदभ्यर्चितो येन हेलयाऽपि नमस्कृतः",
 "kam_002_u15_padya_p01_2f255f": "- द्रव्याणामप्यभावे तु सलिलेनापि पूजितः",
 "kam_003_u01_padya_p01_4fe13f": "नाम्नोऽस्ति यावती शक्तिः पापनिर्हरणे हरेः",
 "kam_003_u02_padya_p01_314d4c": "ब्रह्मा नह्यपुण्यवतां लोके मूढानां कुटिलात्मनाम्",
 "kam_004_u06_padya_p01_e36ecb": "- आराध्यैव नरो विष्णुं मनसा यद्यदिच्छति",
 "kam_007_u02_padya_p01_ef0df7": "विष्णोर्नैवेद्यशेषेण यो भुनक्ति दिनेदिने",
 "kam_007_u04_padya_p01_6c013d": "त्वयोपभुक्तस्रग्गन्धवासोलङ्कारचर्चिताः",
 "kam_007_u07_padya_p01_a0e519": "त्रिरात्रफलदा नद्यो याः काश्चिदसमुद्रगाः",
 "kam_008_u05_padya_p01_7f18a3": "द्वादशाक्षरमन्त्रेण ह्यभिषिच्य विधानतः",
 "kam_008_u25_padya_p01_0133f7": "यथा पादोदकं पुण्यं निर्माल्यं चानुलेपनम्",
 "kam_009_u01_padya_p01_5bc5e3": "क्लिन्नं पादोदकेनैव यस्य नित्यं कलेवरम्",
 "kam_009_u02_padya_p01_37b0d6": "सालग्रामोद्भवो देवो देवो द्वारवतीभवः",
 "kam_009_u03_padya_p01_3d2e17": "शालग्रामशिला यत्र तत्र सन्निहितो हरिः",
 "kam_009_u04_padya_p01_18fd55": "म्लेच्छदेशेऽशुचौ वापि चक्राङ्को यत्र तिष्ठति",
 "kam_009_u07_padya_p01_138383": "रुद्रः शङ्खोदकं च नैवेद्यं निर्माल्यं पादयोर्जलम्",
 "kam_009_u15_padya_p01_843f51": "हरिणा मुक्तिदानीह मुक्तिस्थानानि सर्वशः",
 "kam_011_u46_padya_p01_9e3da7": "यदल्पा द्वादशी दृष्टा निशीथादूर्ध्वमेव तु",
 "kam_011_u49_padya_p01_1fba54": "अशितानशिता यस्मादापो विद्वद्भिरीरिताः",
 "kam_011_u58_padya_p01_ca2df7": "श्रीव्यासः अन्नं निवेदयेन्मह्यं प्राप्ते मद्वासरे शुभे",
 "kam_011_u59_padya_p01_77bf4b": "स ब्रह्महा स गोघ्नश्च स स्तेनो गुरुतल्पगः",
 "kam_011_u65_padya_p01_8b72e1": "धर्मविभूषणः",
 "kam_011_u68_padya_p01_2fb8ea": "ब्रह्मा उपोष्य द्वादशीं पुण्यां सर्वपापक्षयप्रदाम्",
 "kam_013_u03_padya_p01_c2a2e6": "एकादश्यां न भुञ्जीत न सुरां वा पिबेत् क्वचित्",
 "kam_013_u04_padya_p01_76686b": "त्राहित्राहि जगन्नाथ वासुदेवाच्युताव्यय",
 "kam_017_u03_padya_p01_0fbd3c": "सत्यंसत्यं पुनः सत्यमुद्धृत्य भुजमुच्यते",
 "kam_017_u04_padya_p01_ff149e": "“सकृदुच्चारितं येन हरिरित्यक्षरद्वयम्",
 "kam_017_u08_padya_p02_519dfa": "- स्त्री वाऽप्यनूनदशकं देहं मानुषमार्जयेत्",
 "kam_020_u03_padya_p01_658968": "ऊर्ध्वपुण्ड्रं ललाटे तु दण्डाकारं सुशोभनम्",
 "kam_020_u04_padya_p01_3e5223": "अशुचिर्वाऽप्यनाचारो मनसा पापमाचरन्",
 "kam_020_u11_padya_p01_bad5de": "श्वपाकमिव नेक्षेत लोके विप्रमवैष्णवम्",
 "kam_020_u25_padya_p01_35c132": "यो ददाति द्विजातिभ्यश्चन्दनं गोपिमर्दितम्"
}