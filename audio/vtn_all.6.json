adya_p01_f56121", "meter": "indravajrā", "padas": ["सर्वान् वेदानधीत्य महामना अनूचानमानी स्तब्ध एयाय"], "seed": 60, "no_sandhi": true}, {"id": "vtn_seq257_u01_gadya_p01_a9168b", "meter": "anuṣṭubh", "padas": ["स्वप्नेऽपि वासनारूपं सत्यमेव जगन्मनसि स्थितं बहिः"], "seed": 60, "no_sandhi": true}, {"id": "vtn_seq367_u02_padya_p06_45ff80", "meter": "indravajrā", "padas": ["तदेवर्तं तदु सत्यमाहुस्तदेव ब्रह्म परमं कवीनाम्"], "seed": 60, "no_sandhi": true}, {"id": "vtn_seq38_u08_padya_p12_f01e0c", "meter": "anuṣṭubh", "padas": ["क्रियन्तेऽतस्त्वनित्यानि तदर्थाः पूर्वसर्गवत्"], "seed": 60, "no_sandhi": true}, {"id": "vtn_seq172_u05_padya_p01_dca742", "meter": "sragdharā", "padas": ["ताः समुद्रात् समुद्रमेवापियन्ति स समुद्र एव भवति"], "seed": 60, "no_sandhi": true}, {"id": "vtn_seq212_u01_padya_p04_2a3fdb", "meter": "anuṣṭubh", "padas": ["सर्वव्यावृत्तये यस्मात् स्वशब्दोऽयं प्रयुज्यते"], "seed": 60, "no_sandhi": true}, {"id": "vtn_seq306_u01_gadya_p04_407fdf", "meter": "anuṣṭubh", "padas": ["किन्तु? नेदमन्नमिति केनचिदुक्ते कथमिदमन्नत्वेन"], "seed": 60, "no_sandhi": true}, {"id": "vtn_seq26_u01_gadya_p01_db0903", "meter": "anuṣṭubh", "padas": ["नचोच्चारणकाल एव वर्णानामुत्पत्तिरिति वाच्यम्"], "seed": 60, "no_sandhi": true}, {"id": "vtn_seq93_u01_gadya_p03_56449b", "meter": "anuṣṭubh", "padas": ["नचाप्रमाणसिद्धेनानुवादकत्वं प्रमाणस्य भवति"], "seed": 60, "no_sandhi": true}, {"id": "vtn_seq174_u21_padya_p02_715c3d", "meter": "anuṣṭubh", "padas": ["“स्रष्टृत्वादाश्रयत्वाच्च मुक्तानां च प्रतिप्रति"], "seed": 60, "no_sandhi": true}, {"id": "vtn_seq226_u09_gadya_p03_ac3afa", "meter": "anuṣṭubh", "padas": ["निवृत्त्यभिप्राये च पञ्चदशकलानामपि समत्वात्"], "seed": 60, "no_sandhi": true}, {"id": "vtn_seq335_u01_gadya_p13_1593ae", "meter": "anuṣṭubh", "padas": ["स्वरूपमेवोपाधिसम्बद्धमिति न तस्य शुद्धत्वम्"], "seed": 60, "no_sandhi": true}, {"id": "vtn_seq66_u01_gadya_p02_f949b9", "meter": "anuṣṭubh", "padas": ["आगमप्रामाण्यानुभवस्याप्यप्रामाण्यप्राप्तेः"], "seed": 60, "no_sandhi": true}, {"