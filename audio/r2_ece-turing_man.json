{
 "gt_12_13_u10_padya_p01_6cf02c": "इत्यादि",
 "gt_12_13_u12_gadya_p01_7f42ae": "इत्यादेः प्रपञ्च एषः",
 "gt_14_9_u09_padya_p03_24a8db": "तथाहि शार्कराक्ष्यशाखायाम्",
 "gt_14_9_u11_padya_p01_b715db": "इति",
 "nvv_seq342_u02_padya_p02_49d872": "ज्ञानिनो गुरुशापेऽपि नामुक्तिः संसृतेः क्वचित्",
 "nvv_seq342_u02_padya_p05_8d3d87": "ज्ञानिनो ब्रह्मवस्तुवैभवेन मुक्तिः स्यादिति गुरोर्वरेण वा मुक्त्युपपत्तेः",
 "nvv_seq358_u02_padya_p03_1ad184": "जीवं तद्गुणसुव्यक्तिं कृत्वैनं मोचयेद्धरिः",
 "nvv_seq358_u02_padya_p06_180217": "भक्त्यैनं मोचयेद् विष्णुरिति मानत्वमेष्यति",
 "nvv_seq427_u02_padya_p02_ae1d7e": "कृतार्थत्वेनैव विशेषोपपत्तेः",
 "nvv_seq427_u02_padya_p05_1c3dca": "इति च श्रुतिः",
 "nvv_seq439_u02_padya_p03_2b6a3c": "योग्यतातारतम्येन विशेषोऽयमपीष्यते",
 "nvv_seq439_u02_padya_p06_8fcac4": "यान्ति देवं परं केचित् इति प्रमाणप्राप्तत्वादेव",
 "nvv_seq439_u02_padya_p09_015b13": "अतः क्रमात् समृद्धे तु ज्ञाने ब्रह्मलये नरैः",
 "nvv_seq439_u02_padya_p12_f905dc": "नच बहुधा श्रुतेर्यथासौकर्यं चतुर्मुखस्य परस्य वा प्राप्तिरिति वाच्यम्",
 "nvv_seq439_u02_padya_p15_667d32": "यावद् विलयमथ सह चतुर्मुखेन विमुच्यन्त आनन्दिनो भवन्ति इति हि श्रुतिः",
 "spr_seq8_u02_padya_p02_2acd50": "आकाशो ह वा एष देवो वायुरग्निरापः पृथिवी वाङ्मनश्चक्षुः श्रोत्रं च",
 "spr_seq8_u04_padya_p01_c4b3e4": "इत्यत्र भूतवायुरुच्यते",
 "bsb_2_1_27_u02_padya_p02_2b6d9e": "अयं च दोषो जीवकर्तृत्वपक्षे",
 "bsb_2_1_27_u02_padya_p05_7ffd83": "सामर्थ्यैकदेशदर्शनात्",
 "bsb_2_1_27_u04_padya_p01_1a2cc6": "इति भाल्लवेयश्रुतिः",
 "bsb_2_1_27_u04_padya_p04_3e5cd9": "नचान्यत् कल्प्यम्",
 "vtn_seq127_u01_padya_p03_4bcec0": "अज्ञाते च वैलक्षण्ये आत्मनि घट इत्यपि संशयः स्यात्",
 "mbtn_gap0152_h0": "उभौ च तौ तेन विचूर्णितौ रणे रवेः सुतस्योरुबलेरितेन",
 "mbtn_gap0402_h0": "तस्यां सुहोत्रो नामतः पुत्र आसीद् यश्‍चित्रगुप्तो नाम पूर्वं सुलेखः",
 "mbtn_gap0541_h0": "स विद्यया साम्बमुदूह्य रत्या प्रदत्तया रुक्मिणिनन्दनः पुरीम्",
 "mbtn_gap0651_h0": "सस्नाववभृथं कृष्णः सदारः ससुहृज्जनः",
 "mbtn_gap0792_h0": "भग्नास्तानथ गाङ्गेयो दिव्यास्त्रविदधारयत्",
 "mbtn_gap0887_h0": "भीमस्य नानदत एव महास्वनेन विण्मूत्रशोणितमथो मृतिमापुरेके",
 "mbtn_gap1097_h0": "नचापराधो भीमस्य ब्रुवतस्त्वामिदं वचः",
 "bsb_seq76_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_seq149_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_seq251_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_seq318_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_seq408_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_seq512_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_seq639_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_seq780_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_seq886_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_seq1066_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_seq1114_u01_padya_p01_8498c1": "विधीनां विषयास्त्वन्ये ब्रह्मणः स्वेच्छया कृतौ",
 "bsb_seq1117_u01_padya_p01_68684e": "यथाविधानमपरे विधिर्भावे प्रजापतेः",
 "bsb_seq1183_u01_gadya_p01_c14096": "इति श्रीमत्कृष्णद्वैपायनकृतब्रह्मसूत्रभाष्ये",
 "bsb_seq1194_u01_padya_p01_e493d9": "आत्मेत्युपासनं कार्यं सर्वथैव मुमुक्षुभिः",
 "bsb_seq1194_u03_padya_p01_68cc9b": "आत्मा विष्णुरिति ध्यानं विशेषणविशेष्यतः",
 "bsb_seq1194_u04_gadya_p01_38f68b": "इति ब्राह्मे",
 "bsb_seq1233_u01_gadya_p03_e50581": "पादः",
 "bsb_seq1289_u02_padya_p01_f8e78f": "अग्निर्ज्योतिरहः शुक्लः षण्मासा उत्तरायणम्",
 "bsb_seq1289_u02_padya_p04_562c3d": "तत्र चान्द्रमसं ज्योतिर्योगी प्राप्य निवर्तते",
 "bsb_seq1289_u04_padya_p02_2d0595": "अननुस्मरतः काले स्मरणं प्राप्य वै गतिः",
 "bsb_seq1290_u01_gadya_p02_1bdf34": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते चतुर्थाध्यायस्य द्वितीयः",
 "bsb_seq1330_u01_gadya_p02_adfd71": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते चतुर्थाध्यायस्य तृतीयः",
 "bsb_seq1389_u01_gadya_p02_bef192": "श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचिते चतुर्थाध्यायस्य चतुर्थः",
 "bsb_1_1_6_u04_padya_p02_6d31f7": "आत्मशब्दात्",
 "bsb_2_1_26_u02_padya_p02_055864": "नच कर्तुरीश्वरस्यादृष्टिविरोधः",
 "bsb_3_2_13_u04_padya_p01_aa7892": "इति",
 "bsb_3_4_41_u02_padya_p05_847c63": "चशब्दस्तु ज्ञानार्थिनां पूर्वोक्तादित्थम्भावान्तरसूचकः",
 "nvv_seq157_u02_padya_p02_d878fe": "क्रमादुत्पद्यते क्रमाद् विलीयते क्रमेणैवोत्पत्तिर्विलयश्च क्रमेणैव ह्यस्योत्पत्तिविलयौ इत्यादिलोकानुसारिबहुवाक्यानुरोधश्च यथोत्पत्तिविलये",
 "nvv_seq288_u02_padya_p04_e1ce6a": "करोति क्वापि नियता क्रीडा सृष्ट्यादिकाऽस्य च",
 "nvv_seq320_u02_padya_p02_32bf65": "सत्यो ज्ञानं परमानन्दरूप आत्मेत्येवं नित्यदोपासनं स्यात्",
 "nvv_seq388_u02_padya_p07_7e729a": "यो ह्यत्वरया स महत्",
 "nvv_seq459_u02_padya_p01_14a60e": "नच सङ्कल्पादेव समस्तसम्भवात् सृष्ट्यादिसमस्तकार्यसम्भवः",
 "ait_seq12_u01_padya_p27_473032": "विष्णोर्वाग् भार्गवो रामः प्राणोऽस्य नरकेसरी",
 "ait_seq16_u01_padya_p15_15cddf": "उरोमध्ये च हृदयं तत्रावासो हरेः सदा",
 "ait_seq18_u01_padya_p04_f51250": "येये गुणान् विजानन्ति वायोस्तानाविशन्मरुत्",
 "ait_seq18_u01_padya_p40_3e212e": "इत्येतद्ध्यानयोग्याश्च मुनयो देवतास्तथा",
 "ait_seq20_u01_padya_p19_64dbf9": "लोमप्राणादिभेदश्च नैव कश्चिच्चिदात्मनि",
 "ait_seq24_u01_padya_p08_3b25f1": "स्वतन्त्रत्वाज्जगन्नाथः पितृत्वात् परमेशितुः",
 "ait_seq24_u01_padya_p44_579055": "इत्येवोपासते तस्मात् पराभूताश्च सर्वशः",
 "ait_seq24_u03_padya_p02_c0d23d": "ब्रह्मा हैव ताइ ते",
 "ait_seq24_u21_padya_p01_ded6e4": "इत्यादिना भगवतः सकाशाद्धि सर्वेषां सृष्टिः प्रसिद्धा",
 "ait_seq71_u03_padya_p10_5da9dc": "वाग्रूपाया उमाया उत्पत्तिः संस्मृता भवत्येवं जानतः",
 "ait_seq73_u03_padya_p04_c928c2": "स हि यत् प्रथमत इन्द्रो बभूव स्वेच्छया यज्ञनामा",
 "ait_seq73_u29_padya_p02_f9bf1a": "नहि मृतः पुनरेषु लोकेष्वेव राजति",
 "ait_seq75_u04_padya_p01_13a707": "इत्यादिवत्",
 "ait_seq75_u24_padya_p04_3361f3": "प्रत्यक्षत्वाज्जीवजडात्मकस्य जगत एवानुक्तावपि प्रस्तुतरूपत्वात् तदन्यस्तद्विरोधी तत्र दृश्यमानदोषवर्जितश्चाकारशब्दार्थ इति सिद्ध्यति",
 "ait_seq75_u34_padya_p03_98e323": "जीवस्थितेनाक्षरगेनाक्षरनाम्ना स्वरूपेण जीवाख्यसूर्यस्थितमहराख्यं स्वरूपमाप्नोति तेन चाक्षराख्यं स्वरूपमाप्नोति",
 "ait_seq75_u52_padya_p01_10a562": "इति वचनात्",
 "vtn_seq76_u01_padya_p05_40378b": "तथोपनयरूपा च परा निगमनात्मिका",
 "vtn_seq170_u07_padya_p01_df9854": "न्यग्रोधफलमत आहरेतीदं भगव इति भिन्धीति भिन्नं भगव इति",
 "vtn_seq250_u02_padya_p12_bd9d70": "नहीश्वरस्य भ्रान्तिः",
 "gb_2_17b_u42_padya_p01_07ddc8": "इत्येतदात्मसम्बन्धि",
 "gb_3_17_u13_padya_p01_ca0a7a": "ब्रह्मनिष्ठा ब्रह्मरता ब्रह्मज्ञानसुतर्पिताः",
 "gb_13_13_u10_padya_p01_93b096": "इति पूर्वमेव सिद्धत्वात्",
 "gt_2_55_u14_padya_p05_90a0db": "परमात्मन्येव स्थितः सन्",
 "gt_16_11_u09_padya_p03_80a354": "यदि स्यान्मामपीदानीं कारयतु - इत्यादि",
 "tsk_seq12_u01_padya_p05_cf2549": "देवर्षिपितृपनरा इति मुक्तास्तु पञ्चधा",
 "knr_seq35_u04_padya_p02_4ab1c6": "आयो जानातीत्यायोमन्यः",
 "bt_10_40_19_u10_padya_p02_db41e9": "प्राण एवैनमनुभुङ्क्ते प्राणमितरा देवताः",
 "bsb_1_1_26_u06_padya_p02_f74d54": "पाद इत्येकदेशपरिमितम्",
 "bsb_2_1_29_u02_padya_p01_d02005": "आत्मनि चैवं विचित्राश्च हि",
 "bsb_3_2_22_u02_padya_p02_1f6d01": "अत आह- प्रकृतैतावत्त्वं हि प्रतिषेधति ततो ब्रवीति च भूयः",
 "bsb_3_4_51_u02_padya_p02_67999b": "एवमेव प्रारब्धकर्माभावे शरीरपातानन्तरमेव मोक्षः",
 "nvv_seq193_u02_padya_p01_949552": "नच यत्प्राप्तिर्यत्परित्याग उत्पत्तिर्मरणं तथा",
 "nvv_seq288_u02_padya_p08_466dd0": "इति श्रुतेश्च",
 "nvv_seq320_u02_padya_p06_52270f": "देवानां युगपज्ज्ञानं मनुष्याणां तथा नतु",
 "nvv_seq411_u02_padya_p02_d4eacf": "न चेत् कर्माक्षय इति वाच्यम्",
 "nvv_seq459_u02_padya_p05_1a5c6d": "नहि कश्चित् सुशक्तोऽपि चकाराचेतनं चितम्",
 "ait_seq12_u01_padya_p31_2c2709": "अङ्गाङ्गित्वेनैक एव स्वानन्दानुभवे स्थितः",
 "ait_seq16_u01_padya_p19_f40f3a": "उदरस्थं च हृद्गं च ते उभे ब्रह्म तत् परम्",
 "ait_seq18_u01_padya_p08_7c3a1a": "सङ्गतत्वात् सायमिति तद् रूपं नामतोऽभवत्",
 "ait_seq18_u01_padya_p44_3c22e3": "सर्वोत्तमत्वात् पूर्णत्वात् सर्वज्ञत्वात् तथैव च",
 "ait_seq20_u01_padya_p23_158788": "योग्या अस्याश्च विद्याया भृग्वाद्या देवतास्तथा",
 "ait_seq24_u01_padya_p12_18c193": "यथा पितामहाद्याश्च पितरो नाम कीर्तिताः",
 "ait_seq24_u01_padya_p48_3c3009": "ज्ञानैश्वर्यादिभिः सोऽपि भवेत् तस्य परात्मनः",
 "ait_seq24_u04_padya_p04_4a5532": "स्वरस्पर्शविभागेन तत्रोक्तिः स्याद् विभक्तिषु",
 "ait_seq24_u21_padya_p05_ab4664": "नहि यत्किञ्चित् कारणत्वमस्तीत्येतावता ब्राह्मणस्य चण्डालः पितेत्युच्यते",
 "ait_seq71_u03_padya_p14_2e4b30": "तस्माद् बृहत्याः सकाशादनुष्टुप्सम्पादने तस्यैव विष्णोः प्रतिमान्तरं तस्मादेव निर्मितं भवति",
 "ait_seq73_u05_padya_p03_80d981": "अतो विष्णावेवेन्द्रशब्दं प्रयुङ्क्ते श्रुतिः",
 "ait_seq73_u33_padya_p02_f66615": "यदनेन रूपेणामुं लोकमभिसम्भवति",
 "ait_seq75_u04_padya_p05_226a04": "नचाज्ञात एकत्वे पुनर्ज्ञाते ऐक्यं प्राप्त इति प्रयोगो दृश्यते",
 "ait_seq75_u24_padya_p08_a02d5b": "नच शून्यस्याशब्दार्थता",
 "ait_seq75_u36_padya_p04_b2a0bb": "नच नपुंसकरूपं भगवतः कुत्रचिदुक्तम्",
 "ait_seq186_u01_padya_p01_737262": "भगवदुपासकस्य यस्मिन् कस्मिंश्चिद् दोष उक्ते तं प्रत्युक्तिप्रकारः पूर्वं दर्शितः",
 "vtn_seq76_u01_padya_p09_337a83": "प्रतिज्ञावयवत्वात्तु स्वातन्त्र्येणैव मानताम्",
 "vtn_seq170_u07_padya_p05_5589dd": "सोम्यैषोऽणिम्न एवं महान् न्यग्रोधस्तिष्ठति",
 "vtn_seq250_u04_padya_p03_940060": "सर्वस्मादुत्तमोऽर्थः स एक एवेत्यर्थः",
 "gb_2_17b_u44_padya_p02_bf4541": "अविद्यमानमेवेश्वरं सृष्ट्यादिकं चाप्राप्तमेवात्मनो भिन्नत्वेन प्रापयित्वा तन्निषेधे कथं श्रुतेरुन्मत्तवाक्यत्वं",
 "gb_3_17_u16_padya_p01_eb7e37": "इत्येवशब्देन मुक्तानामेभ्यो विशेषो दर्शितः",
 "gt_2_55_u04_padya_p01_60c27a": "इत्यादिना दर्शयिष्यन् लक्षणं प्रथमत आह- प्रजहातीति",
 "gt_2_55_u16_padya_p01_10f955": "इत्युक्तं हि नारायणरामकल्पे",
 "gt_17_27b_u01_padya_p01_b2d89c": "ओमित्युक्त्वाऽनभिसन्धाय फलं यज्ञदानतपआदिकृतामतिप्रीतेर्नामसाम्याद् ब्रह्मैव निष्पादितं भवतीत्याशयः",
 "tsk_seq12_u01_padya_p09_9cdc95": "ते च प्राप्तान्धतमसः सृतिसंस्था इति द्विधा",
 "knr_seq35_u04_padya_p06_32fe2b": "अयनेन प्राप्यं दूरस्थम् आयो इति वा",
 "bt_10_40_19_u13_padya_p02_698a82": "पुरुषं तस्मात्प्रपदे तस्मात्प्रपदे इत्याचक्षते",
 "bsb_1_3_28_u07_gadya_p03_7ff104": "यथेदानीं तथोपर्यपि देवा भविष्यन्तीतीतरेषामनुमानाच्च",
 "bsb_2_4_1_u08_padya_p02_619e72": "अत उच्यते- तथा प्राणाः",
 "bsb_3_3_58_u02_padya_p02_7ae9ca": "सर्वदेवतामन्त्रा यथाऽधीयन्ते",
 "bsb_4_4_16_u07_padya_p02_83543a": "ब्रह्मवैवर्ते च–",
 "nvv_seq248_u02_padya_p01_c5d472": "नच पितुः सकाशादन्यतो वौदर्यगर्भस्थशरीरमेव प्रवेष्टुमुपपत्तेर्योनिप्रवेशाभाव इति वाच्यम्",
 "nvv_seq298_u02_padya_p04_eecfe9": "युगपत् स्वभुजौ यद्वद् ध्यायेत् तावत एव सः",
 "nvv_seq336_u02_padya_p08_91a9ba": "पूर्णस्य पूर्णमादाय पूर्णमेवावशिष्यते",
 "nvv_seq431_u02_padya_p02_7d323a": "क्रियानुवृत्तिर्लौकिके साधने तु मनोनुवृत्तिर्वैदिके साधने स्यात्",
 "ait_seq12_u01_padya_p11_b29f0d": "विष्णोस्तृचाशीतिवत् स्यात् प्रसिद्धान्नमिति स्फुटम्",
 "ait_seq12_u01_padya_p47_08dfee": "हरिः स सर्वजीवानां न भुज्यन्ते यथाऽमुना",
 "ait_seq16_u01_padya_p35_c7d15b": "निष्क्रान्तेषु न वै पातः शरीरस्याभवत् क्वचित्",
 "ait_seq18_u01_padya_p24_ad2c8b": "देवमात्रास्तदन्ये तु स आविः पुरुषोत्तमः",
 "ait_seq20_u01_padya_p03_74a778": "विप्रक्षत्रियवैश्यादिरूपं चाखिलमेव तु",
 "ait_seq20_u01_padya_p39_6c1646": "आवृताः सर्वजीवा हि यथैव कनकावटाः",
 "ait_seq24_u01_padya_p28_2cb4c0": "प्राणनामा प्रणेतृत्वात् तमेनं गुणपूर्तितः",
 "ait_seq24_u01_padya_p64_05624b": "जडं तज्जडतामेति चेतना वायुदेवता",
 "ait_seq24_u12_padya_p01_ff0d5d": "सप्तसु प्रथमा",
 "ait_seq24_u30_padya_p01_27c148": "पूर्वं तु बादरायणो हेतुव्यपदेशात्",
 "ait_seq71_u15_padya_p05_e1fb50": "वाच उद्वर्तनाशक्तेः स्वयमेवोद्वर्तते",
 "ait_seq73_u17_padya_p02_cb4ce1": "पूज्यो ह्यग्रजो भवति",
 "ait_seq73_u39_padya_p09_41c90d": "एवमादित्यनाम्नो विष्णोः",
 "ait_seq75_u08_padya_p11_b86af4": "सर्वयुजो भवन्ति मनोवाक्कर्मभिस्तत्रैव युक्ता भवन्ति",
 "ait_seq75_u26_padya_p02_b40964": "अः इति ब्रह्म पूर्णं वस्तूच्यते",
 "ait_seq75_u44_padya_p07_376c39": "सूर्यस्याश्विनामाभावात्",
 "vtn_seq40_u06_padya_p07_2cda84": "पुराणानामप्यन्यथाशब्दरचनमेवानित्यत्वम्",
 "vtn_seq80_u01_padya_p07_d7f6b5": "एकं प्रत्यक्षरूपं स्याद् द्वितीयमनुमात्मकम्",
 "vtn_seq219_u07_padya_p01_2b8024": "यत्र त्वस्य सर्वमात्मैवाभूत् तत् केन कं पश्येत् तत्",
 "vtn_seq252_u05_padya_p04_a426e0": "’ इति",
 "gb_2_17b_u53_padya_p12_22dccb": "अतो जीवेश्वरयोर्भेद एवेति सिद्धम्",
 "gb_7_27_u06_padya_p01_db7233": "इत्युक्तत्वात्",
 "gt_2_55_u10_padya_p01_381998": "इति स्नेहनिषेधात्",
 "gt_16_1_u06_gadya_p01_57c625": "इत्यभिधानम् पैशुनं परोपद्रवनिमित्तदोषाणां राजादेः",
 "uk_seq5_u01_padya_p05_250fd5": "अज्ञता चाल्पशक्तित्वं दुःखित्वं स्वल्पकर्तृता",
 "kan_seq288_u02_padya_p02_5e4ded": "बभूवेति",
 "bt_10_21_50_u02_padya_p34_8c67b9": "अन्यानि भूतानि मात्रामुपजीवन्ति"
}