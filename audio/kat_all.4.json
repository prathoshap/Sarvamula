[{"id": "kat_seq19_u01_sutra_p01_9abd49", "meter": "anuṣṭubh", "padas": ["श्वोभावा मर्त्यस्य यदन्तकैतत् सर्वेन्द्रियाणां जरयन्ति तेजः अपि सर्वं जीवितमल्पमेव तवैव वाहास्तव नृत्तगीतम् न वित्तेन तर्पणीयो मनुष्यो लप्स्यामहे वित्तमद्राक्ष्म चेत् त्वाम् जीविष्यामो यावदीशिष्यसि त्वं वरस्तु मे वरणीयः स एव अजीर्यताममृतानामुपेत्य जीर्यन् मर्त्यः क्वाधस्थः प्रजानन् अभिध्यायन् वर्णरतिप्रमोदानतिदीर्घे जीविते को रमेत यस्मिन्निदं विचिकित्सन्ति मृत्यो साम्पराये महति ब्रूहि नस्तत् योऽयं वरो गूढमनुप्रविष्टो नान्यं तस्मान्नचिकेता वृणीते"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq50_u01_sutra_p01_3005d8", "meter": "anuṣṭubh", "padas": ["उत्तिष्ठत जाग्रत प्राप्य वरान् निबोधत क्षुरस्य धारा निशिता दुरत्यया दुर्गं पथस्तत् कवयो वदन्ति अशब्दमस्पर्शमरूपमव्ययं तथाऽरसं नित्यमगन्धवच्च यत् अनाद्यनन्तं महतः परं ध्रुवं निचाय्य तं मृत्युमुखात् प्रमुच्यते"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq37_u01_sutra_p01_4eb7f8", "meter": "sragdharā", "padas": ["न जायते म्रियते वा विपश्चिन्नायं कुतश्चिन्न बभूव कश्चित् अजो नित्यः शाश्वतोऽयं पुराणो न हन्यते हन्यमानेऽपि देहे"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq64_u01_sutra_p01_7fc07e", "meter": "anuṣṭubh", "padas": ["या प्राणेन सम्भवत्यदितिर्देवतामयी गुहां प्रविश्य तिष्ठन्तीं या भूतेभिर्व्यजायत एतद् वै तत्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq96_u01_gadya_p01_1c1e47", "meter": "anuṣṭubh", "padas": ["इति श्रीमदानन्दतीर्थभगवत्पादाचार्यविरचितं काठकोपनिषद्भाष्यं सम्पूर्णम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq81_u02_gadya_p02_9f48e0", "meter": "anuṣṭubh", "padas": ["सर्वोत्तमत्वज्ञान एव सर्ववाक्यानां महातात्पर्यमिति ज्ञापयितुम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq11_u11_gadya_p05_471873", "meter": "anuṣṭubh", "padas": ["नचाग्निपरिज्ञानमात्रेणानन्तलोकाप्तिर्भगवज्ज्ञानं विना"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq13_u10_gadya_p01_2a7f29", "meter": "anuṣṭubh", "padas": ["इति वचनाच्च जीवेषु स्थितो भगवान् पृच्छ्यत इति सिद्धम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq68_u04_gadya_p10_074702", "meter": "anuṣṭubh", "padas": ["एवं विष्णोश्च धर्मान् पृथक् पश्यन् अन्धन्तमो विधावति"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq9_u01_gadya_p02_6c1eb3", "meter": "anuṣṭubh", "padas": ["वेदोक्तप्रकारेण भगवत्तत्वादिकं जानन्नित्यर्थः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq13_u05_padya_p05_fad367", "meter": "anuṣṭubh", "padas": ["नैव मुक्तिर्भवेत् तस्मात् कृच्छ्रात् तदवदद् यमः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq74_u01_padya_p33_c3dc96", "meter": "anuṣṭubh", "padas": ["स्वतन्त्रत्वात् स्वतन्त्रो हि नैव दोषेण लिप्यते"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq43_u03_padya_p02_4f9d5f", "meter": "anuṣṭubh", "padas": ["ऐश्वर्याद् भगवान् विष्णुर्विरुद्धं घटयत्यसौ"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq74_u01_padya_p04_29383b", "meter": "anuṣṭubh", "padas": ["होता सर्वेन्द्रियादिस्थो वेद्यां पूज्यश्च वेदिषत्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq7_u02_padya_p03_42149f", "meter": "anuṣṭubh", "padas": ["प्रतिष्ठा सर्वलोकस्य स विष्णुः सर्वहृद्गतः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq13_u05_padya_p07_312b21", "meter": "anuṣṭubh", "padas": ["सुखाधिक्यं भवेन्मुक्तौ तस्मात् तत् पृथगीरितम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq41_u03_padya_p01_89229d", "meter": "anuṣṭubh", "padas": ["जीवाद् गुणपरिमाणं यस्माद् विष्णोर्महत्तरम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq68_u01_padya_p09_b2d1b4", "meter": "anuṣṭubh", "padas": ["यान्त्येवान्धन्तमो नात्र कार्या काचिद् विचारणा"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq74_u01_padya_p21_325b44", "meter": "anuṣṭubh", "padas": ["रूपंरूपं तथाऽप्यस्य प्रत्यभूत् प्रतिरूपकः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq79_u02_padya_p11_dcfa40", "meter": "anuṣṭubh", "padas": ["ततः किञ्चित् स्पष्टतया गान्धर्वे दृश्यते हरिः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq11_u04_padya_p02_e2fca2", "meter": "anuṣṭubh", "padas": ["ब्रह्मजस्तेन कथितः स एव ज्ञोऽखिलज्ञतः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq13_u11_padya_p02_f6cb70", "meter": "anuṣṭubh", "padas": ["सम्प्राप्तमपि जीवेषु जागर्ति स्वपितेष्वपि"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq62_u02_padya_p01_a50747", "meter": "anuṣṭubh", "padas": ["अम्नामभ्यश्च भूतेभ्यस्तपोनाम्नः शिवादपि"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq74_u01_padya_p03_c66b26", "meter": "anuṣṭubh", "padas": ["वरसुर्वसुरित्युक्तः स एवाप्यन्तरिक्षगः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq79_u02_padya_p01_605ab5", "meter": "anuṣṭubh", "padas": ["सर्वोच्चो भगवान् विष्णुर्मूलं भूमिवदस्य तु"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq83_u02_padya_p02_a79738", "meter": "anuṣṭubh", "padas": ["प्रादुर्भावानपि यदा ज्ञानदृष्ट्यैव पश्यति"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq11_u08_padya_p02_ba8bb5", "meter": "anuṣṭubh", "padas": ["शृङ्कां स्वर्णमयीं चैव कण्ठमालामदाद् विभुः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq25_u05_padya_p02_7c2ebd", "meter": "anuṣṭubh", "padas": ["तदनुव्रताश्च ये केचित् तेषां ज्ञानं न जायते"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq48_u01_padya_p19_6bcec8", "meter": "anuṣṭubh", "padas": ["कुतस्तु मानुषो देवान् नियच्छेद् विनियामकान्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq68_u03_padya_p02_82f41c", "meter": "anuṣṭubh", "padas": ["धर्मयोरुपमायां वा स्वल्पत्वे वा विवक्षिते"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq74_u01_padya_p19_d5cfbd", "meter": "anuṣṭubh", "padas": ["रूपंरूपं प्रति ह्येते सन्त्यचेतनवह्नयः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq87_u01_padya_p01_a85a1a", "meter": "anuṣṭubh", "padas": ["अधिकः सतोऽयं भगवान् सर्वस्मादपि केशवः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq25_u05_padya_p01_5fbf36", "meter": "anuṣṭubh", "padas": ["जीवानां चैव विष्णोश्च यो न वेत्ति भिदां पुमान्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq37_u02_padya_p05_3b6599", "meter": "anuṣṭubh", "padas": ["अजो नित्योऽविकारश्च जीव पुरमणन्नपि"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq62_u02_padya_p03_71cf69", "meter": "anuṣṭubh", "padas": ["स्वात्मानं च गुहासंस