[{"id": "kat_seq81_u01_sutra_p01_88761d", "meter": "anuṣṭubh", "padas": ["इन्द्रियाणां पृथग्भावमुदयास्तमयौ च यत् पृथगुत्पद्यमानानां मत्वा धीरो न शोचति इन्द्रियेभ्यः परं मनो मनसः सत्त्वमुत्तमम् सत्त्वादधि महानात्मा महतोऽव्यक्तमुत्तमम् अव्यक्तात् तु परः पुरुषो व्यापकोऽलिङ्ग एव च तं ज्ञात्वा मुच्यते जन्तुरमृतत्वं च गच्छति"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq13_u01_sutra_p01_5aa1a0", "meter": "anuṣṭubh", "padas": ["एष तेऽग्निर्नाचिकेतः स्वर्ग्यो यमवृणीथा द्वितीयेन वरेण एतमग्निं तवैव प्रवक्ष्यन्ति जनासस्तृतीयं वरं नचिकेतो वृणीष्व येयं प्रेते विचिकित्सा मनुष्ये अस्तीत्येके नायमस्तीति चैके एतद् विद्यामनुशिष्टस्त्वयाऽहं वराणामेष वरस्तृतीयः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq60_u01_sutra_p01_d864c7", "meter": "anuṣṭubh", "padas": ["स्वप्नान्तं जागरितान्तं चोभौ येनानुपश्यति महान्तं विभुमात्मानं मत्वा धीरो न शोचति य इदं मध्वदं वेदात्मानं जीवमन्तिकात् ईशानं भूतभव्यस्य न ततो विजुगुप्सते एतद् वै तत्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq29_u01_sutra_p01_f2bb50", "meter": "anuṣṭubh", "padas": ["कामस्याप्तिं जगतः प्रतिष्ठां क्रतोरानन्त्यमभयस्य पारम् स्तोममहदुरुगायं प्रतिष्ठां दृष्ट्वा धृत्या धीरो नचिकेतोऽत्यस्राक्षीः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq83_u01_sutra_p01_1f68c0", "meter": "anuṣṭubh", "padas": ["न सन्दृशे तिष्ठति रूपमस्य न चक्षुषा पश्यति कश्चिदेनम् हृदा मनीषा मनसाभिकॢप्तो य एनं विदुरमृतास्ते भवन्ति"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq13_u10_gadya_p02_c725d4", "meter": "anuṣṭubh", "padas": ["मृतजीवे स्थितो मुक्तजीवे स्थितश्चोभयात्मको भगवान् विवक्षित इत्येतस्माच्चाविरोधः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq62_u05_gadya_p01_c69b54", "meter": "anuṣṭubh", "padas": ["इत्यादिना जाता एवेन्द्रादयः कश्यपात् पुनर्जायन्ते न तथा भगवतो ब्रह्मा"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq13_u04_gadya_p01_529f11", "meter": "anuṣṭubh", "padas": ["इति परिहाराच्च मुक्ते स्थितो भगवान् पृच्छ्यते इति सिद्धम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq89_u04_gadya_p02_f33ea4", "meter": "anuṣṭubh"