: "anuṣṭubh", "padas": ["यमोऽनुवादसन्तुष्टो वह्नेस्तन्नामतामपि"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq39_u01_gadya_p01_22bcf5", "meter": "anuṣṭubh", "padas": ["जीवस्यापि स्वतो मरणाभावात् उभौ तौ न विजानीतः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq62_u05_gadya_p03_dd2fc2", "meter": "anuṣṭubh", "padas": ["अजातम् एव अद्भ्यः पूर्वमजायत जनयामास"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq74_u01_padya_p12_8ac0c7", "meter": "anuṣṭubh", "padas": ["वेदैर्मुख्यतया प्रोक्त ऋतमित्येव चोच्यते"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq79_u02_padya_p02_d3162b", "meter": "anuṣṭubh", "padas": ["जगदाख्यस्य वृक्षस्य शाखा देवास्ततोऽवमाः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq83_u02_padya_p03_dc52bb", "meter": "anuṣṭubh", "padas": ["तदैव मुच्यते योगी न दुष्टैरिन्द्रियैः क्वचित्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq11_u12_padya_p02_549fed", "meter": "sragdharā", "padas": ["वर्षसहस्राण्यन्तवदेवास्य तद् भवति"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq29_u09_gadya_p02_f6524a", "meter": "anuṣṭubh", "padas": ["उरुगायं दृष्ट्वा कामस्याप्तिमत्यस्राक्षीः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq60_u02_gadya_p03_380480", "meter": "anuṣṭubh", "padas": ["वस्त्वन्तरस्य हि दूरत्वमन्तिकत्वं वा"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq68_u04_gadya_p09_a47e69", "meter": "anuṣṭubh", "padas": ["पर्वतेषु दुर्गे शिखरे वृष्टम् अधो विधावति"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq74_u01_padya_p22_ebaaa7", "meter": "anuṣṭubh", "padas": ["अचेतनः स्पर्शगम्यो योऽयमेवं जनार्दनः"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq87_u01_padya_p04_d7d18e", "meter": "anuṣṭubh", "padas": ["प्रकृतेः पुरुषाणां च तत्त्वं भावयति स्फुटम्"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq27_u01_gadya_p01_f627b4", "meter": "anuṣṭubh", "padas": ["आख्यं विष्ण्वाख्यं नित्यं शेवधिरिति जानामि"], "seed": 60, "no_sandhi": true}, {"id": "kat_seq43_u02_gadya_p01_c23544", "meter": "anuṣṭubh", "padas": ["ऐश्वर्यादेव आसीनो दूरं व्रजति इत्यादि"], "se