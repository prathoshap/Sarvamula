{
 "bsb_1_1_1_u01_sutra_p01_050706": "अथातो ब्रह्मजिज्ञासा",
 "bsb_1_1_1_u02_padya_p01_e03f5e": "नारायणं गुणैः सर्वैरुदीर्णं दोषवर्जितम्",
 "bsb_1_1_1_u02_padya_p02_5bd31f": "ज्ञेयं गम्यं गुरूंश्चापि नत्वा सूत्रार्थ उच्यते",
 "bsb_1_1_1_u03_gadya_p01_7f43f0": "द्वापरे सर्वत्र ज्ञान आकुलीभूते तन्निर्णयाय",
 "bsb_1_1_1_u03_gadya_p02_ae5c61": "ब्रह्मरुद्रेन्द्रादिभिरर्थितो भगवान् नारायणो व्यासत्वेनावततार",
 "bsb_1_1_1_u03_gadya_p03_b208f6": "अथेष्टानिष्टप्राप्तिपरिहारेच्छूनां तद्योगमविजानतां",
 "bsb_1_1_1_u03_gadya_p04_734840": "तज्ज्ञापनार्थं वेदमुत्सन्नं व्यञ्जयंश्चतुर्धा व्यभजत्",
 "bsb_1_1_1_u03_gadya_p05_c1a397": "चतुर्विंशतिधैकशतधा सहस्रधा द्वादशधा च",
 "bsb_1_1_1_u03_gadya_p06_03ae2e": "तदर्थनिर्णयाय ब्रह्मसूत्राणि चकार",
 "bsb_1_1_1_u03_gadya_p07_a919b8": "तच्चोक्तं स्कान्दे",
 "bsb_1_1_1_u04_padya_p01_42dd71": "नारायणाद् विनिष्पन्नं ज्ञानं कृतयुगे स्थितम्",
 "bsb_1_1_1_u04_padya_p02_fcdb6e": "किञ्चित् तदन्यथा जातं त्रेतायां द्वापरेऽखिलम्",
 "bsb_1_1_1_u04_padya_p03_8c4a14": "गौतमस्य ऋषेः शापाज्ज्ञाने त्वज्ञानतां गते",
 "bsb_1_1_1_u04_padya_p04_a4ddf7": "सङ्कीर्णबुद्धयो देवा ब्रह्मरुद्रपुरःसराः",
 "bsb_1_1_1_u04_padya_p05_9f7914": "शरण्यं शरणं जग्मुर्नारायणमनामयम्",
 "bsb_1_1_1_u04_padya_p06_8fdbea": "तैर्विज्ञापितकार्यस्तु भगवान् पुरुषोत्तमः",
 "bsb_1_1_1_u04_padya_p07_deb2ac": "अवतीर्णो महायोगी सत्यवत्यां पराशरात्",
 "bsb_1_1_1_u04_padya_p08_c51b80": "उत्सन्नान् भगवान् वेदानुज्जहार हरिः स्वयम्",
 "bsb_1_1_1_u04_padya_p09_c52958": "चतुर्धा व्यभजत् तांश्च चतुर्विंशतिधा पुनः",
 "bsb_1_1_1_u04_padya_p10_44c38a": "शतधा चैकधा चैव तथैव च सहस्रधा",
 "bsb_1_1_1_u04_padya_p11_688a11": "कृष्णो द्वादशधा चैव पुनस्तस्यार्थवित्तये",
 "bsb_1_1_1_u04_padya_p12_e1d525": "चकार ब्रह्मसूत्राणि येषां सूत्रत्वमञ्जसा",
 "bsb_1_1_1_u04_padya_p13_dba447": "अल्पाक्षरमसन्दिग्धं सारवद् विश्वतोमुखम्",
 "bsb_1_1_1_u04_padya_p14_bbeb9d": "अस्तोभमनवद्यं च सूत्रं सूत्रविदो विदुः",
 "bsb_1_1_1_u04_padya_p15_a462fe": "निर्विशेषितसूत्रत्वं ब्रह्मसूत्रस्य चाप्यतः",
 "bsb_1_1_1_u04_padya_p16_f8e3fc": "यथा व्यासत्वमेकस्य कृष्णस्यान्ये विशेषणात्",
 "bsb_1_1_1_u04_padya_p17_c3dd93": "सविशेषणसूत्राणि ह्यपराणि विदो विदुः",
 "bsb_1_1_1_u04_padya_p18_1c04f4": "मुख्यस्य निर्विशेषेण शब्दोऽन्येषां विशेषतः",
 "bsb_1_1_1_u04_padya_p19_762e30": "इति वेदविदः प्राहुः शब्दतत्त्वार्थवेदिनः",
 "bsb_1_1_1_u04_padya_p20_564808": "सूत्रेषु येषु सर्वेऽपि निर्णयाः समुदीरिताः",
 "bsb_1_1_1_u04_padya_p21_5bd52a": "शब्दजातस्य सर्वस्य यत्प्रमाणश्च निर्णयः",
 "bsb_1_1_1_u04_padya_p22_f3bbeb": "एवंविधानि सूत्राणि कृत्वा व्यासो महायशाः",
 "bsb_1_1_1_u04_padya_p23_4e2c4c": "ब्रह्मरुद्रादिदेवेषु मनुष्यपितृपक्षिषु",
 "bsb_1_1_1_u04_padya_p24_72eeef": "ज्ञानं संस्थाप्य भगवान् क्रीडते पुरुषोत्तमः",
 "bsb_1_1_1_u05_gadya_p01_216cb1": "इत्यादि",
 "bsb_1_1_1_u05_gadya_p02_050706": "अथातो ब्रह्मजिज्ञासा",
 "bsb_1_1_1_u05_gadya_p03_303faa": "अथशब्दो मङ्गलार्थोऽधिकारानन्तर्यार्थश्च",
 "bsb_1_1_1_u05_gadya_p04_ff18f7": "अतः शब्दो हेत्वर्थः",
 "bsb_1_1_1_u05_gadya_p05_6d5afb": "उक्तं च गारुडे",
 "bsb_1_1_1_u06_padya_p01_eed863": "अथातःशब्दपूर्वाणि सूत्राणि निखिलान्यपि",
 "bsb_1_1_1_u06_padya_p02_99c9bf": "प्रारभन्ते नियत्यैव तत् किमत्र नियामकम्",
 "bsb_1_1_1_u06_padya_p03_e28230": "कश्चार्थश्च तयोर्विद्वन् कथमुत्तमता तयोः",
 "bsb_1_1_1_u06_padya_p04_2773e6": "एतदाख्याहि मे ब्रह्मन् यथा ज्ञास्यामि तत्त्वतः",
 "bsb_1_1_1_u06_padya_p05_22071e": "एवमुक्तो नारदेन ब्रह्मा प्रोवाच सत्तमः",
 "bsb_1_1_1_u06_padya_p06_beda19": "आनन्तर्येऽधिकारस्य मङ्गलार्थे तथैव च",
 "bsb_1_1_1_u06_padya_p07_ad183c": "अथशब्दस्त्वतःशब्दो हेत्वर्थे समुदीरितः",
 "bsb_1_1_1_u06_padya_p08_7f2644": "परस्य ब्रह्मणो विष्णोः प्रसादादिति वा भवेत्",
 "bsb_1_1_1_u06_padya_p09_6bb016": "स हि सर्वमनोवृत्तिप्रेरकः समुदाहृतः",
 "bsb_1_1_1_u06_padya_p10_5c3283": "सिसृक्षोः परमाद् विष्णोः प्रथमं द्वौ विनिःसृतौ",
 "bsb_1_1_1_u06_padya_p11_ea676c": "ओङ्कारश्चाथशब्दश्च तस्मात् प्राथमिकौ क्रमात्",
 "bsb_1_1_1_u06_padya_p12_94f791": "तद्धेतुत्वं वदंश्चापि तृतीयोऽत उदाहृतः",
 "bsb_1_1_1_u06_padya_p13_4e8a99": "अकारः सर्ववागात्मा परब्रह्माभिधायकः",
 "bsb_1_1_1_u06_padya_p14_2516e7": "तथौ प्राणात्मकौ प्रोक्तौ व्याप्तिस्थितिविधायकौ",
 "bsb_1_1_1_u06_padya_p15_11b7f8": "अतश्च पूर्वमुच्चार्याः सर्व एते सतां मताः",
 "bsb_1_1_1_u06_padya_p16_679b91": "अथातःशब्दयोरेवं वीर्यमाज्ञाय तत्त्वतः",
 "bsb_1_1_1_u06_padya_p17_553376": "सूत्रेषु तु महाप्राज्ञास्तावेवादौ प्रयुञ्जते",
 "bsb_1_1_1_u07_gadya_p01_e083b5": "इति",
 "bsb_1_1_1_u08_gadya_p01_c6fec4": "अधिकारश्चोक्तो भागवततन्त्रे",
 "bsb_1_1_1_u09_padya_p01_970e67": "मन्दमध्योत्तमत्वेन त्रिविधा ह्यधिकारिणः",
 "bsb_1_1_1_u09_padya_p02_d324ed": "तत्र मन्दा मनुष्येषु य उत्तमगणा मताः",
 "bsb_1_1_1_u09_padya_p03_e58455": "मध्यमा ऋषिगन्धर्वा देवास्तत्रोत्तमा मताः",
 "bsb_1_1_1_u09_padya_p04_d991d7": "इति जातिकृतो भेदस्तथाऽन्यो गुणपूर्वकः",
 "bsb_1_1_1_u09_padya_p05_b662e6": "भक्तिमान् परमे विष्णौ यस्त्वध्ययनवान् नरः",
 "bsb_1_1_1_u09_padya_p06_553b6d": "अधमः शमादिसंयुक्तो मध्यमः समुदाहृतः",
 "bsb_1_1_1_u09_padya_p07_75e884": "आब्रह्मस्तम्बपर्यन्तमसारं चाप्यनित्यकम्",
 "bsb_1_1_1_u09_padya_p08_8f16bf": "विज्ञाय जातवैराग्यो विष्णुपादैकसंश्रयः",
 "bsb_1_1_1_u09_padya_p09_32a13b": "स उत्तमोऽधिकारी स्यात् सन्न्यस्ताखिलकर्मवान्",
 "bsb_1_1_1_u10_gadya_p01_e083b5": "इति",
 "bsb_1_1_1_u11_padya_p01_f52c82": "अध्ययनमात्रवतः",
 "bsb_1_1_1_u12_padya_p01_d35127": "नाविशेषात्",
 "bsb_1_1_1_u13_gadya_p01_66520d": "इति चोपरि",
 "bsb_1_1_1_u14_padya_p01_c83a62": "शान्तो दान्त उपरतस्तितिक्षुः समाहितो भूत्वाऽऽत्मन्येवात्मानं पश्येत्",
 "bsb_1_1_1_u15_padya_p01_7f71d5": "परीक्ष्य लोकान् कर्मचितान् ब्राह्मणो निर्वेदमायान्नास्त्यकृतः कृतेन",
 "bsb_1_1_1_u15_padya_p02_ff9bab": "तद्विज्ञानार्थं स गुरुमेवाभिगच्छेत् समित्पाणिः श्रोत्रियं ब्रह्मनिष्ठम्",
 "bsb_1_1_1_u16_padya_p01_33276b": "यमेवैष वृणुते तेन लभ्यस्तस्यैष आत्मा विवृणुते तनूं स्वाम्",
 "bsb_1_1_1_u17_padya_p01_414c42": "यस्य देवे परा भक्तिर्यथा देवे तथा गुरौ",
 "bsb_1_1_1_u17_padya_p02_aad37b": "तस्यैते कथिता ह्यर्थाः प्रकाशन्ते महात्मनः",
 "bsb_1_1_1_u18_gadya_p01_b0b992": "इत्यादिश्रुतिभ्यश्च",
 "bsb_1_1_1_u18_gadya_p02_da9924": "व्योमसंहितायां च",
 "bsb_1_1_1_u19_padya_p01_f8fc54": "अन्त्यजा अपि ये भक्ता नामज्ञानाधिकारिणः",
 "bsb_1_1_1_u19_padya_p02_338eab": "स्त्रीशूद्रब्रह्मबन्धूनां तन्त्रज्ञानेऽधिकारिता",
 "bsb_1_1_1_u19_padya_p03_066ad2": "एकदेशे परोक्ते तु नतु ग्रन्थपुरःसरे",
 "bsb_1_1_1_u19_padya_p04_94b85a": "त्रैवर्णिकानां वेदोक्ते सम्यग्भक्तिमतां हरौ",
 "bsb_1_1_1_u19_padya_p05_0cc2b5": "आहुरप्युत्तमस्त्रीणामधिकारं तु वैदिके",
 "bsb_1_1_1_u19_padya_p06_d3473d": "यथोर्वशी यमी चैव शच्याद्याश्च तथा पराः",
 "bsb_1_1_1_u20_gadya_p01_e083b5": "इति",
 "bsb_1_1_1_u20_gadya_p02_de032a": "यतो नारायणप्रसादमृते न मोक्षः",
 "bsb_1_1_1_u20_gadya_p03_60a3e9": "नच ज्ञानं विनाऽत्यर्थप्रसादः",
 "bsb_1_1_1_u20_gadya_p04_cb4c64": "अतो ब्रह्मजिज्ञासा कर्तव्या",
 "bsb_1_1_1_u21_padya_p01_225227": "यत्रानवसरोऽन्यत्र पदं तत्र प्रतिष्ठितम्",
 "bsb_1_1_1_u21_padya_p02_cf3beb": "वाक्यं वेति सतां नीतिः सावकाशे न तद् भवेत्",
 "bsb_1_1_1_u22_gadya_p01_00b2e5": "इति बृहत्संहितायाम्",
 "bsb_1_1_1_u23_padya_p01_33e689": "तमेवं विद्वानमृत इह भवति",
 "bsb_1_1_1_u23_padya_p02_885dc9": "नान्यः पन्था अयनाय विद्यते",
 "bsb_1_1_1_u24_padya_p01_5a0d2b": "प्रियो हि ज्ञानिनोऽत्यर्थमहं स च मम प्रियः",
 "bsb_1_1_1_u25_padya_p01_201c57": "यमेवैष वृणुते तेन लभ्यः",
 "bsb_1_1_1_u26_padya_p01_61ac67": "आत्मा वा अरे द्रष्टव्यः श्रोतव्यो मन्तव्यो निदिध्यासितव्यः",
 "bsb_1_1_1_u27_gadya_p01_0263bb": "इत्यादिश्रुतिस्मृतिभ्यः",
 "bsb_1_1_1_u28_padya_p01_a2eb7f": "कर्मणा त्वधमः प्रोक्तः प्रसादः श्रवणादिभिः",
 "bsb_1_1_1_u28_padya_p02_362301": "मध्यमो ज्ञानसम्पत्त्या प्रसादस्तूत्तमो मतः",
 "bsb_1_1_1_u28_padya_p03_2690a6": "प्रसादात् त्वधमाद् विष्णोः स्वर्गलोकः प्रकीर्तितः",
 "bsb_1_1_1_u28_padya_p04_8427bc": "मध्यमाज्जनलोकादिरुत्तमस्त्वेव मुक्तिदः",
 "bsb_1_1_1_u28_padya_p05_16aed6": "श्रवणं मननं चैव ध्यानं भक्तिस्तथैव च",
 "bsb_1_1_1_u28_padya_p06_ef82ea": "साधनं ज्ञानसम्पत्तौ प्रधानं नान्यदिष्यते",
 "bsb_1_1_1_u28_padya_p07_84746b": "नचैतानि विना कश्चिज्ज्ञानमाप कुतश्चन",
 "bsb_1_1_1_u29_gadya_p01_be229e": "इति नारदीये",
 "bsb_1_1_1_u29_gadya_p02_621cba": "ब्रह्मशब्दश्च विष्णावेव",
 "bsb_1_1_1_u30_padya_p01_6dc408": "यमन्तः समुद्रे कवयोऽवयन्ति",
 "bsb_1_1_1_u31_gadya_p01_43f738": "इत्याद्युक्त्वा",
 "bsb_1_1_1_u32_padya_p01_637ff4": "तदेव ब्रह्म परमं कवीनाम्",
 "bsb_1_1_1_u33_gadya_p01_35b771": "इति हि श्रुतिः",
 "bsb_1_1_1_u34_padya_p01_fbfb5f": "तन्नो विष्णुः",
 "bsb_1_1_1_u35_gadya_p01_c27532": "इति वचनाद् विष्णुरेव हि तत्रोच्यते",
 "bsb_1_1_1_u35_gadya_p02_a0a134": "नचेतरशब्दात् तत्प्राप्तिः",
 "bsb_1_1_1_u36_padya_p01_32c0fc": "नामानि विश्वाऽभि न सन्ति लोके यदाविरासीदनृतस्य सर्वम्",
 "bsb_1_1_1_u36_padya_p02_3eb028": "नामानि सर्वाणि यमाविशन्ति तं वै विष्णुं परममुदाहरन्ति",
 "bsb_1_1_1_u37_gadya_p01_b352a8": "इति भाल्लवेयश्रुतिः",
 "bsb_1_1_1_u38_padya_p01_f6d05a": "यो देवानां नामधा एक एव",
 "bsb_1_1_1_u39_gadya_p01_d04122": "इत्येवशब्दान्नान्येषां सर्वनामता",
 "bsb_1_1_1_u40_padya_p01_045f72": "अजस्य नाभावध्येकमर्पितं यस्मिन् विश्वानि भुवनानि तस्थुः",
 "bsb_1_1_1_u41_gadya_p01_e9e62d": "इति हि विष्णोर्लिङ्गम्",
 "bsb_1_1_1_u41_gadya_p02_88a763": "नच प्रसिद्धार्थं विनाऽन्योऽर्थो युज्यते",
 "bsb_1_1_1_u42_padya_p01_6a07e3": "अजस्य नाभाविति यस्य नाभेरभूच्छ्रुतेः पुष्करं लोकसारम्",
 "bsb_1_1_1_u42_padya_p02_f49611": "तस्मै नमो व्यस्तसमस्तविश्वविभूतये विष्णवे लोककर्त्रे",
 "bsb_1_1_1_u43_gadya_p01_2ae75f": "इति स्कान्दे",
 "bsb_1_1_1_u44_padya_p01_86e38d": "परो दिवा पर एना पृथिव्या",
 "bsb_1_1_1_u45_gadya_p01_b2ce73": "इति समाख्याश्रुतौ",
 "bsb_1_1_1_u46_padya_p01_9caa36": "यं कामये तन्तमुग्रं कृणोमि तं ब्रह्माणं तमृषिं तं सुमेधाम्",
 "bsb_1_1_1_u47_gadya_p01_97ecfc": "इत्युक्त्वा",
 "bsb_1_1_1_u48_padya_p01_317ee6": "मम योनिरप्स्वन्तःसमुद्रे",
 "bsb_1_1_1_u49_gadya_p01_d60ea3": "इत्याह",
 "bsb_1_1_1_u49_gadya_p02_dea984": "उग्रो रुद्रः",
 "bsb_1_1_1_u49_gadya_p03_f6fc59": "समुद्रेऽन्तर्नारायणः",
 "bsb_1_1_1_u49_gadya_p04_435ceb": "प्रसिद्धत्वात् सूचितत्वाच्चास्यार्थस्य",
 "bsb_1_1_1_u49_gadya_p05_557a3a": "नचाविरोधे प्रसिद्धः परित्यज्यते",
 "bsb_1_1_1_u49_gadya_p06_14709c": "उक्तन्यायेन च श्रुतय एतमेव वदन्ति",
 "bsb_1_1_1_u50_padya_p01_9f4e9b": "वेदे रामायणे चैव पुराणे भारते तथा",
 "bsb_1_1_1_u50_padya_p02_e85851": "आदावन्ते च मध्ये च विष्णुः सर्वत्र गीयते",
 "bsb_1_1_1_u51_gadya_p01_5c10e2": "इति हरिवंशेषु",
 "bsb_1_1_1_u51_gadya_p02_783e70": "नचेतरग्रन्थविरोधः",
 "bsb_1_1_1_u52_padya_p01_09f70d": "एष मोहं सृजाम्याशु यो जनान् मोहयिष्यति",
 "bsb_1_1_1_u52_padya_p02_d32995": "त्वं च रुद्र महाबाहो मोहशास्त्राणि कारय",
 "bsb_1_1_1_u52_padya_p03_8ca2d6": "अतथ्यानि वितथ्यानि दर्शयस्व महाभुज",
 "bsb_1_1_1_u52_padya_p04_3369f2": "प्रकाशं कुरु चात्मानमप्रकाशं च मां कुरु",
 "bsb_1_1_1_u53_gadya_p01_5d6dc8": "इति वाराहवचनात्",
 "bsb_1_1_1_u53_gadya_p02_d5ef75": "शैवे च स्कान्दे",
 "bsb_1_1_1_u54_padya_p01_dc049d": "श्वपचादपि कष्टत्वं ब्रह्मेशानादयः सुराः",
 "bsb_1_1_1_u54_padya_p02_a5ab7e": "तदैवाच्युत यान्त्येव यदैव त्वं पराङ्मुखः",
 "bsb_1_1_1_u55_gadya_p01_e083b5": "इति",
 "bsb_1_1_1_u55_gadya_p02_5417e5": "ब्राह्मे च ब्रह्मवैवर्ते",
 "bsb_1_1_1_u56_padya_p01_164705": "नाहं नच शिवोऽन्ये च तच्छक्त्येकांशभागिनः",
 "bsb_1_1_1_u56_padya_p02_2233c9": "बालः क्रीडनकैर्यद्वत् क्रीडतेऽस्माभिरच्युतः",
 "bsb_1_1_1_u57_gadya_p01_e083b5": "इति",
 "bsb_1_1_1_u57_gadya_p02_432a04": "नच वैष्णवेषु तथा",
 "bsb_1_1_1_u57_gadya_p03_f74a96": "तच्च",
 "bsb_1_1_1_u58_padya_p01_dc4dae": "एष मोहम्",
 "bsb_1_1_1_u59_gadya_p01_a4ac45": "इत्युक्तम्",
 "bsb_1_1_2_u01_sutra_p01_5dfbc6": "जन्माद्यस्य यतः",
 "bsb_1_1_2_u02_gadya_p01_89172c": "ब्रह्मणो लक्षणमाह- जन्माद्यस्य यतः",
 "bsb_1_1_2_u02_gadya_p02_454572": "सृष्टिस्थितिसंहारनियमनज्ञानाज्ञानबन्धमोक्षा यतः",
 "bsb_1_1_2_u03_padya_p01_4378f9": "उत्पत्तिस्थितिसंहारा नियतिर्ज्ञानमावृतिः",
 "bsb_1_1_2_u03_padya_p02_40ce3f": "बन्धमोक्षौ च पुरुषाद् यस्मात् स हरिरेकराट्",
 "bsb_1_1_2_u04_gadya_p01_2ae75f": "इति स्कान्दे",
 "bsb_1_1_2_u05_padya_p01_eee66f": "यतो वा इमानि भूतानि जायन्ते",
 "bsb_1_1_2_u05_padya_p02_98def0": "येन जातानि जीवन्ति",
 "bsb_1_1_2_u05_padya_p03_091bf2": "यत् प्रयन्त्यभि संविशन्ति तद् विजिज्ञासस्व तद् ब्रह्मेति",
 "bsb_1_1_2_u06_padya_p01_061cef": "य उ त्रिधातु पृथिवीमुत द्यामेको दाधार भुवनानि विश्वा",
 "bsb_1_1_2_u07_padya_p01_39a855": "चतुर्भिः साकं नवतिं च नामभिश्चक्रं न वृत्तं व्यतीँरवीविपत्",
 "bsb_1_1_2_u08_padya_p01_f24d28": "परो मात्रया तन्वा वृधान न ते महित्वमन्वश्नुवन्ति",
 "bsb_1_1_2_u08_padya_p02_bf93d1": "न ते विष्णो जायमानो न जातो देव महिम्नः परमन्तमाप",
 "bsb_1_1_2_u09_padya_p01_e4f8e0": "यो नः पिता जनिता यो विधाता धामानि वेद भुवनानि विश्वा",
 "bsb_1_1_2_u10_gadya_p01_a409df": "इत्यादि च"
}