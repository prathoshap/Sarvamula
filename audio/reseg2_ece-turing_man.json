{
 "bsb_1_1_3_u15_padya_p02_151706": "शास्त्रं योनिः प्रमाणमस्येति शास्त्रयोनि",
 "bsb_1_1_31_u04_padya_p02_791a2b": "प्राणसंवादादि मुख्यप्राणलिङ्गम्",
 "bsb_1_3_28_u07_gadya_p03_7ff104": "यथेदानीं तथोपर्यपि देवा भविष्यन्तीतीतरेषामनुमानाच्च",
 "bsb_2_1_14_u13_padya_p02_75f553": "फलत्वेऽपि युक्तिविरोधेऽन्तर्भावादत्रोक्तम्",
 "bsb_2_1_32_u02_padya_p02_c815fc": "नच करणाभावादनुपपत्तिरिति युक्तम्",
 "bsb_2_4_1_u08_padya_p02_619e72": "अत उच्यते- तथा प्राणाः",
 "bsb_3_1_27_u02_padya_p04_7cb421": "शब्दविहितत्वात्",
 "bsb_3_3_4_u02_padya_p01_e172fe": "सलिलवच्च तन्नियमः",
 "bsb_3_3_58_u02_padya_p02_7ae9ca": "सर्वदेवतामन्त्रा यथाऽधीयन्ते",
 "bsb_3_4_41_u02_padya_p01_c606bc": "नचाधिकारिकमपि पतनानुमानात् तदयोगात्",
 "bsb_4_1_4_u04_padya_p03_63283b": "ब्रह्मतर्के च",
 "bsb_4_4_16_u07_padya_p02_83543a": "ब्रह्मवैवर्ते च–",
 "nvv_seq143_u02_padya_p05_284830": "आकाशो नीलिमोदेति न प्रदेशः कथञ्चन",
 "nvv_seq193_u02_padya_p05_1321c9": "किं नाम न सृजेदेष येन शक्त्येदमावृतम्",
 "nvv_seq248_u02_padya_p01_c5d472": "नच पितुः सकाशादन्यतो वौदर्यगर्भस्थशरीरमेव प्रवेष्टुमुपपत्तेर्योनिप्रवेशाभाव इति वाच्यम्",
 "nvv_seq282_u02_padya_p04_54253a": "इत्यादिश्रुतिभ्योऽलौकिकत्वावगमात्",
 "nvv_seq290_u02_padya_p04_5c1e32": "क्वचिद् ददाति क्वच नो ददाति नह्यानन्त्यात् कर्मणां भोगनाशः",
 "nvv_seq298_u02_padya_p04_eecfe9": "युगपत् स्वभुजौ यद्वद् ध्यायेत् तावत एव सः",
 "nvv_seq316_u02_padya_p05_0adea5": "कदाचिल्लोपयेद् देवी स्थानैक्यं न गुणैस्ततः",
 "nvv_seq330_u02_padya_p02_2f7f73": "अधिकारानुसारित्वात् प्रयत्नस्य",
 "nvv_seq336_u02_padya_p08_91a9ba": "पूर्णस्य पूर्णमादाय पूर्णमेवावशिष्यते",
 "nvv_seq388_u02_padya_p03_6ae15b": "तदेष श्लोकः",
 "nvv_seq411_u02_padya_p06_4e4919": "इति वचनाच्च",
 "nvv_seq431_u02_padya_p02_7d323a": "क्रियानुवृत्तिर्लौकिके साधने तु मनोनुवृत्तिर्वैदिके साधने स्यात्",
 "nvv_seq457_u02_padya_p02_90413c": "तदभावे भोगासम्भव इति दोषः",
 "nvv_seq459_u02_padya_p09_d6812d": "मुक्तानां तु नियन्तारस्तेषां ब्रह्माऽस्य वै हरिः",
 "ait_seq12_u01_padya_p11_b29f0d": "विष्णोस्तृचाशीतिवत् स्यात् प्रसिद्धान्नमिति स्फुटम्",
 "ait_seq12_u01_padya_p23_90d76b": "स्थितो विष्णुस्तदर्कास्ते तस्मादेव प्रकीर्तिताः",
 "ait_seq12_u01_padya_p35_672dbe": "अन्ननामा स एवान्ने चेष्टयन् सर्वमास्थितः",
 "ait_seq12_u01_padya_p47_08dfee": "हरिः स सर्वजीवानां न भुज्यन्ते यथाऽमुना",
 "ait_seq16_u01_padya_p11_453235": "उर्वेव गरणं चक्रे वायुर्यत्र स्थितः सदा",
 "ait_seq16_u01_padya_p23_f8a7d5": "तत्र प्राणात्मना वायुर्मनोरूपेण शङ्करः",
 "ait_seq16_u01_padya_p35_c7d15b": "निष्क्रान्तेषु न वै पातः शरीरस्याभवत् क्वचित्",
 "ait_seq16_u01_padya_p47_193bb7": "वायुः स संस्तुतस्तैश्च प्रसन्नोऽभूद् दिवौकसाम्",
 "ait_seq18_u01_padya_p12_ed341e": "मित्रो यमश्च वरुणः कुबेरश्च दिगीश्वराः",
 "ait_seq18_u01_padya_p24_ad2c8b": "देवमात्रास्तदन्ये तु स आविः पुरुषोत्तमः",
 "ait_seq18_u01_padya_p36_fea68c": "वेद तं च नियोक्तारमुपास्ते विष्णुमव्ययम्",
 "ait_seq18_u01_padya_p48_ff235d": "तीति ब्रह्मा समुद्धिष्टः स एवान्नाभिमानवान्",
 "ait_seq20_u01_padya_p03_74a778": "विप्रक्षत्रियवैश्यादिरूपं चाखिलमेव तु",
 "ait_seq20_u01_padya_p15_8bad52": "तथैव वायुना बद्धं जगदेतत् ततोऽवरम्",
 "ait_seq20_u01_padya_p27_d934a1": "छन्दस्सु संस्थितो वायुर्वायौ च स जनार्दनः",
 "ait_seq20_u01_padya_p39_6c1646": "आवृताः सर्वजीवा हि यथैव कनकावटाः",
 "ait_seq24_u01_padya_p04_f6d595": "इदं मदाख्यं यद् ब्रह्म ह्याप इत्यभिधीयते",
 "ait_seq24_u01_padya_p16_d28e05": "नारायणादिनामानि ददौ नान्यस्य केशवः",
 "ait_seq24_u01_padya_p28_2cb4c0": "प्राणनामा प्रणेतृत्वात् तमेनं गुणपूर्तितः",
 "ait_seq24_u01_padya_p40_64c211": "देवानामपि सर्वेषां प्रधानोऽद्यापि मारुतः",
 "ait_seq24_u01_padya_p52_6a12a8": "प्राणं नियमयत्यस्मिन् शरीरे पुरुषोत्तमः",
 "ait_seq24_u01_padya_p64_05624b": "जडं तज्जडतामेति चेतना वायुदेवता",
 "ait_seq24_u01_padya_p76_9aff9c": "तथा इति निर्णयः",
 "ait_seq24_u04_padya_p08_a24fd4": "नैश्वर्ये न बले चैव नानन्दादिगुणेष्वपि",
 "ait_seq24_u12_padya_p01_ff0d5d": "सप्तसु प्रथमा",
 "ait_seq24_u19_padya_p05_c8d8eb": "दिग्भ्योऽप्यन्य एव विशृणोति जीवः",
 "ait_seq24_u24_padya_p01_6ff10c": "मनुष्याणां तु यत् कर्म न देवोत्पत्तिकारणम्",
 "ait_seq24_u30_padya_p01_27c148": "पूर्वं तु बादरायणो हेतुव्यपदेशात्",
 "ait_seq71_u03_padya_p06_febf10": "वायुस्तस्य प्रतिमारूपमिदं बृहतीसहस्रम्",
 "ait_seq71_u03_padya_p18_2d3f79": "वायुरेव यद् भगवन्नियतो नियामयति तस्मात्",
 "ait_seq71_u15_padya_p05_e1fb50": "वाच उद्वर्तनाशक्तेः स्वयमेवोद्वर्तते",
 "ait_seq71_u15_padya_p17_605b25": "तस्माद् विजानतः सर्वमपि भगवन्नामैव",
 "ait_seq73_u07_padya_p04_3ca048": "नहि सर्वेषां पृथङ् मत्सिशब्ददर्शन एकस्यैवान्यथात्वं युज्यते",
 "ait_seq73_u17_padya_p02_cb4ce1": "पूज्यो ह्यग्रजो भवति",
 "ait_seq73_u27_padya_p03_7f421a": "मनुष्यदृष्टिगोचरतां प्राप्यैषु लोकेषु राजति",
 "ait_seq73_u35_padya_p02_e1200f": "यच्छब्दः किंशब्दार्थे",
 "ait_seq73_u39_padya_p09_41c90d": "एवमादित्यनाम्नो विष्णोः",
 "ait_seq75_u01_padya_p05_5b4ee1": "तत्र तस्मिन्नेव परे ब्रह्मणि नारायणाख्ये सर्वदेवा एकीभवन्ति मुक्ताः",
 "ait_seq75_u04_padya_p09_f45189": "किन्तु संसर्ग एव भवति",
 "ait_seq75_u08_padya_p11_b86af4": "सर्वयुजो भवन्ति मनोवाक्कर्मभिस्तत्रैव युक्ता भवन्ति",
 "ait_seq75_u22_padya_p03_20ce0f": "अकारो विशेषतो नारायणवाचक इत्याह- अः इति ब्रह्मेति",
 "ait_seq75_u24_padya_p12_afa51a": "एकदेशार्थत्वात्",
 "ait_seq75_u26_padya_p02_b40964": "अः इति ब्रह्म पूर्णं वस्तूच्यते",
 "ait_seq75_u30_padya_p01_dcf9fe": "इति",
 "ait_seq75_u38_padya_p01_6bc841": "इति ब्रह्माण्डे",
 "ait_seq75_u44_padya_p07_376c39": "सूर्यस्याश्विनामाभावात्",
 "ait_seq75_u50_padya_p03_771c13": "ज्ञानात् पूर्वं तु पतनसंशयादेव न सुदिनम्",
 "ait_seq186_u03_padya_p01_1fe17e": "इति च",
 "vtn_seq40_u06_padya_p07_2cda84": "पुराणानामप्यन्यथाशब्दरचनमेवानित्यत्वम्",
 "vtn_seq76_u01_padya_p01_ccbc56": "यामाहुरनुमां केचित् त्रियाद्यवयवात्मिकाम्",
 "vtn_seq76_u01_padya_p13_6a3b9e": "प्रामाण्यं यात्यनुभवो ज्ञापयत्युपपत्तिताम्",
 "vtn_seq80_u01_padya_p07_d7f6b5": "एकं प्रत्यक्षरूपं स्याद् द्वितीयमनुमात्मकम्",
 "vtn_seq170_u05_padya_p04_4fd517": "प्रजाः सत आगम्य न विदुः सत आगच्छामह इति",
 "vtn_seq172_u01_padya_p02_d850e0": "इह व्याघ्रो वा सिंहो वा",
 "vtn_seq219_u07_padya_p01_2b8024": "यत्र त्वस्य सर्वमात्मैवाभूत् तत् केन कं पश्येत् तत्",
 "vtn_seq250_u02_padya_p08_ab840e": "मायामात्रत्वात्",
 "vtn_seq250_u06_padya_p03_a57784": "अन्येषां समाधिकभावः",
 "vtn_seq252_u05_padya_p04_a426e0": "’ इति",
 "gb_2_17b_u40_padya_p03_8cb2f8": "नचैकविज्ञानेन सर्वविज्ञानं तत्पक्षे",
 "gb_2_17b_u46_padya_p03_157679": "अभेदानुवादेन भेदोपदेशः किमिति न स्यात्? सर्वशाखान्ते भेदोक्तेश्चैतदेव युक्तम्",
 "gb_2_17b_u53_padya_p12_22dccb": "अतो जीवेश्वरयोर्भेद एवेति सिद्धम्",
 "gb_3_17_u10_padya_p03_1d1a0a": "असक्त आचरन्नेव यस्मात् परमाप्नोति",
 "gb_7_7_u18_padya_p03_4bf2a2": "अन्यथा",
 "gb_7_27_u06_padya_p01_db7233": "इत्युक्तत्वात्",
 "gb_13_0_u01_padya_p01_8141c2": "अर्जुन उवाच",
 "gt_2_55_u04_padya_p05_9ced3d": "शुकादीनामपीषद्दर्शनात्",
 "gt_2_55_u10_padya_p01_381998": "इति स्नेहनिषेधात्",
 "gt_2_55_u14_padya_p01_dcf9fe": "इति",
 "gt_3_34_u02_padya_p03_1f4bb5": "तथाह्युक्तम्",
 "gt_16_1_u06_gadya_p01_57c625": "इत्यभिधानम् पैशुनं परोपद्रवनिमित्तदोषाणां राजादेः",
 "gt_16_1_u13_padya_p01_28db7d": "अक्रोधदोषकृच्छत्रोः क्षमावान् स निगद्यते",
 "tvk_seq14_u01_padya_p02_8cc65f": "नित्यानित्यत्वभेदेन देशः कालः श्रुतिस्तथा",
 "uk_seq5_u01_padya_p05_250fd5": "अज्ञता चाल्पशक्तित्वं दुःखित्वं स्वल्पकर्तृता",
 "tdy_seq72_u03_padya_p01_cd73f5": "इति भारतवचनान्न विश्लेषाद् विशेषः",
 "man_seq1_u03_gadya_p01_ef43ea": "इति पाद्मे",
 "kan_seq288_u02_padya_p02_5e4ded": "बभूवेति",
 "kan_seq288_u06_padya_p12_6355be": "पूर्वं जानन्नपीन्द्रः पश्चाद् विश्वरूपाच्छुश्रावेति पुनर्नवत्वायेति न विश्वरूपस्त्वाष्ट्रोऽश्विभ्यामित्यनेन विरोधः",
 "knr_seq35_u06_padya_p04_64f69e": "विश्वध विश्वधारक",
 "bt_10_21_50_u02_padya_p34_8c67b9": "अन्यानि भूतानि मात्रामुपजीवन्ति",
 "bt_10_40_17_u03_padya_p01_1c36cf": "त्यजन्ति तापं य उ ते भवत्कथा इति स्म",
 "bt_10_40_19_u13_padya_p06_855743": "ऊर्ध्वं त्वेवोदसर्प-त्तच्छिरोऽश्रयत यच्छिरोऽश्रयत तच्छिरोऽभवत्तच्छिरसः शिरस्त्वं ता एता शिर्षञ्च्छ्रियः"
}