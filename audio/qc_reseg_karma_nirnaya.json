{
 "knr_seq35_u04_padya_p01_567763": "इति च सूत्रम्",
 "knr_seq35_u04_padya_p05_8f6bb1": "अयं त्वान्तरमप्यापरोक्ष्येण पश्यति",
 "knr_seq35_u06_padya_p03_207019": "एवंविधं मद्गतं त्वामुद्दिश्यैव उपेहि",
 "knr_seq81_u01_gadya_p03_03d7fb": "खण्डार्थनिर्णयापरनामा सम्पूर्णः",
 "knr_seq35_u04_padya_p02_4ab1c6": "आयो जानातीत्यायोमन्यः",
 "knr_seq35_u04_padya_p06_32fe2b": "अयनेन प्राप्यं दूरस्थम् आयो इति वा",
 "knr_seq35_u06_padya_p04_64f69e": "विश्वध विश्वधारक",
 "knr_seq35_u02_padya_p01_a41037": "इति धातोः आयो इत्यायतिः",
 "knr_seq35_u04_padya_p03_9d6780": "समीपस्थमपि जानातीत्युपोमन्यः",
 "knr_seq35_u06_padya_p01_516a9f": "इति धातोर्मन्युरिति ज्ञानी",
 "knr_seq35_u06_padya_p05_721c5d": "समीपतो दूरतश्च त्वां मन्यमानाय मह्यं मन्यवे ज्ञानाय माम्",
 "knr_seq35_u02_padya_p02_24aaac": "उपो इतिवदतिशयार्थ ओकारः",
 "knr_seq35_u04_padya_p04_c9530b": "अन्येषामिन्द्रियाणां पराङ्मुखत्वान्नह्यान्तरं जानन्ति",
 "knr_seq35_u06_padya_p02_cce7c4": "बाह्यज्ञाय ज्ञानिने आन्तरज्ञाय ज्ञानिने इत्यभ्यासो हि तात्पर्यार्थः",
 "knr_seq35_u06_padya_p06_5e6f08": "उपेहि इति वा"
}