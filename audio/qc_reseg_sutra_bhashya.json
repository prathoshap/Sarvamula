{
 "bsb_1_1_3_u02_padya_p01_13e469": "अनुमानतोऽन्ये न कल्पनीयाः",
 "bsb_1_1_3_u07_padya_p01_9e77cf": "इत्यादि महाकौर्मे",
 "bsb_1_1_3_u15_padya_p01_219c0c": "इत्यारभ्य वेदपञ्चरात्रयोरैक्याभिप्रायेण पञ्चरात्रस्यैव प्रामाण्यमुक्तमितरेषां भिन्नमतत्वं प्रदर्श्य मोक्षधर्मेष्वपि",
 "bsb_1_1_6_u04_padya_p01_4f4e4f": "इति युक्तम्",
 "bsb_1_1_26_u06_padya_p01_b02d3a": "इति श्रुतेः",
 "bsb_1_1_31_u04_padya_p01_367494": "इति जीवलिङ्गम्",
 "bsb_1_1_31_u04_padya_p05_af1ec7": "अन्तर्बहिः सर्वगतत्वेनेत्युपासात्रैविध्यात्",
 "bsb_1_3_7_u04_gadya_p01_f0eb48": "इतीशजीवयोः स्थित्यदनोक्तेः",
 "bsb_1_3_28_u07_gadya_p02_8ef0f4": "महतां प्रत्यक्षात्",
 "bsb_2_1_14_u04_padya_p03_efed1b": "अतः पूर्वमपि स एव",
 "bsb_2_1_14_u04_padya_p07_9de8d7": "एवं स्यादत्रापि",
 "bsb_2_1_14_u13_padya_p01_5c7f53": "इत्यादि च",
 "bsb_2_1_26_u02_padya_p01_7dd5cb": "देवादिवदपि लोके",
 "bsb_2_1_26_u02_padya_p05_88bd06": "किम्वीश्वरस्य",
 "bsb_2_1_32_u02_padya_p01_898f18": "विकरणत्वान्नेति चेत् तदुक्तम्",
 "bsb_2_2_5_u02_padya_p03_f98886": "एवं प्रधानादीश्वरानुगृहीतं जगदिति",
 "bsb_2_3_24_u02_padya_p01_eaf8c9": "अविरोधश्चन्दनवत्",
 "bsb_2_4_1_u08_padya_p01_43a14f": "इति च",
 "bsb_2_4_4_u03_padya_p02_a6f3a2": "अत आह- तत्प्राक्छ्रुतेश्च",
 "bsb_3_1_4_u06_padya_p01_8f16d3": "इति ब्राह्मे",
 "bsb_3_1_27_u02_padya_p03_9319c9": "न",
 "bsb_3_2_13_u02_padya_p03_cc84db": "चशब्दादनन्तरूपत्वं चैके शाखिनः पठन्ति",
 "bsb_3_2_22_u02_padya_p01_0d5c66": "सृष्टिसंहारकर्तृत्वमेवास्य न पालकत्वं स्वतः सिद्धेरिति",
 "bsb_3_2_22_u04_padya_p02_eca379": "चशब्दात् स्मृतिश्च",
 "bsb_3_3_4_u02_padya_p04_0a3226": "आग्नेये च–",
 "bsb_3_3_56_u02_padya_p01_52bc8f": "व्यतिरेकस्तद्भावभावित्वान्न तूपलब्धिवत्",
 "bsb_3_3_58_u02_padya_p01_44a70f": "मन्त्रादिवद् वाऽविरोधः",
 "bsb_3_3_59_u02_padya_p02_bd7a80": "सर्वगुणेषु भूमगुणस्य ज्यायस्त्वं क्रतुवत् सर्वत्र सहभावात्",
 "bsb_3_4_1_u02_padya_p03_6423cb": "यद्दर्शनार्थमुपासनोक्ता तस्माद् दर्शनात् सर्वपुरुषार्थप्राप्तिरिति बादरायणो मन्यते",
 "bsb_3_4_27_u08_padya_p02_82b72e": "तुशब्दः पूर्णफलार्थत्वं सूचयति",
 "bsb_3_4_41_u02_padya_p04_0a43be": "किमु परस्येति सूचयितुमपिशब्दः",
 "bsb_3_4_51_u02_padya_p01_c97283": "एवं मुक्तिफलानियमस्तदवस्थावधृतेस्तदवस्थावधृतेः",
 "bsb_4_1_4_u04_padya_p02_73afee": "किन्तु तत्स्थत्वेनैवोपासनं कार्यम्",
 "bsb_4_1_6_u04_padya_p03_e28bac": "नारायणतन्त्रे",
 "bsb_4_1_17_u02_padya_p04_5c6d29": "तथा ह्येकेषां पाठ उभयोस्त्यागेन",
 "bsb_4_4_16_u07_padya_p01_182015": "इत्याद्याविष्कृतत्वात्",
 "bsb_1_1_3_u02_padya_p02_eb153c": "शास्त्रयोनित्वात्",
 "bsb_1_1_3_u07_padya_p02_86e29c": "शक्यत्वाच्चानुमानां सर्वत्र",
 "bsb_1_1_3_u15_padya_p02_151706": "शास्त्रं योनिः प्रमाणमस्येति शास्त्रयोनि",
 "bsb_1_1_6_u04_padya_p02_6d31f7": "आत्मशब्दात्",
 "bsb_1_1_26_u06_padya_p02_f74d54": "पाद इत्येकदेशपरिमितम्",
 "bsb_1_1_31_u04_padya_p02_791a2b": "प्राणसंवादादि मुख्यप्राणलिङ्गम्",
 "bsb_1_1_31_u04_padya_p06_940277": "इहाश्रितत्वाच्च",
 "bsb_1_3_28_u06_padya_p01_650610": "यथैव कालनियमः सुरादिनियमस्तथा",
 "bsb_1_3_28_u07_gadya_p03_7ff104": "यथेदानीं तथोपर्यपि देवा भविष्यन्तीतीतरेषामनुमानाच्च",
 "bsb_2_1_14_u04_padya_p04_ddd345": "नह्यन्यस्यान्यत्वं युज्यत इति चेत्",
 "bsb_2_1_14_u04_padya_p08_802161": "तथाच श्रुतिः",
 "bsb_2_1_14_u13_padya_p02_75f553": "फलत्वेऽपि युक्तिविरोधेऽन्तर्भावादत्रोक्तम्",
 "bsb_2_1_26_u02_padya_p02_055864": "नच कर्तुरीश्वरस्यादृष्टिविरोधः",
 "bsb_2_1_29_u02_padya_p01_d02005": "आत्मनि चैवं विचित्राश्च हि",
 "bsb_2_1_32_u02_padya_p02_c815fc": "नच करणाभावादनुपपत्तिरिति युक्तम्",
 "bsb_2_2_5_u02_padya_p04_4c98a2": "अतो ब्रवीति- अन्यत्राभावाच्च न तृणादिवत्",
 "bsb_2_3_24_u02_padya_p02_0fc536": "अणोरपि जीवस्य सर्वशरीरव्याप्तिर्युज्यते",
 "bsb_2_4_1_u08_padya_p02_619e72": "अत उच्यते- तथा प्राणाः",
 "bsb_3_1_4_u04_padya_p01_21f586": "इत्यादिश्रुतेर्न प्राणानां जीवेन सह गतिरिति चेत्",
 "bsb_3_1_4_u06_padya_p02_daefdb": "ब्रह्माण्डे च",
 "bsb_3_1_27_u02_padya_p04_7cb421": "शब्दविहितत्वात्",
 "bsb_3_2_13_u04_padya_p01_aa7892": "इति",
 "bsb_3_2_22_u02_padya_p02_1f6d01": "अत आह- प्रकृतैतावत्त्वं हि प्रतिषेधति ततो ब्रवीति च भूयः",
 "bsb_3_3_4_u02_padya_p01_e172fe": "सलिलवच्च तन्नियमः",
 "bsb_3_3_40_u02_padya_p01_b8afc9": "प्रकृतेरपि जन्मादेः संसारप्राप्तेः किमिति नामादिष्वपाठ इति",
 "bsb_3_3_56_u02_padya_p02_bd2bc6": "ज्ञानादिभेदे विद्यमानेऽपि नांशांशिनोः पृथग्भाव एव",
 "bsb_3_3_58_u02_padya_p02_7ae9ca": "सर्वदेवतामन्त्रा यथाऽधीयन्ते",
 "bsb_3_3_59_u02_padya_p03_f6e23a": "दीक्षाप्रायणीयोदयनीयसवनत्रयावभृथात्मकः क्रतुः",
 "bsb_3_4_27_u02_padya_p01_ee3945": "शमदमाद्युपेतः स्यात् तथाऽपि तु तद्विधेस्तदङ्गतया तेषामवश्यानुष्ठेयत्वात्",
 "bsb_3_4_41_u02_padya_p01_c606bc": "नचाधिकारिकमपि पतनानुमानात् तदयोगात्",
 "bsb_3_4_41_u02_padya_p05_847c63": "चशब्दस्तु ज्ञानार्थिनां पूर्वोक्तादित्थम्भावान्तरसूचकः",
 "bsb_3_4_51_u02_padya_p02_67999b": "एवमेव प्रारब्धकर्माभावे शरीरपातानन्तरमेव मोक्षः",
 "bsb_4_1_4_u04_padya_p03_63283b": "ब्रह्मतर्के च",
 "bsb_4_1_17_u02_padya_p01_286c87": "अतोऽन्यदपीत्येकेषामुभयोः",
 "bsb_4_4_16_u04_padya_p01_5edefc": "इत्यादिना स्वर्गादिस्थस्यैतदिति वाच्यम्",
 "bsb_4_4_16_u07_padya_p02_83543a": "ब्रह्मवैवर्ते च–",
 "bsb_1_1_3_u05_padya_p01_78375e": "इत्यादिश्रुतिभ्यश्च",
 "bsb_1_1_3_u11_padya_p01_55b4d2": "इति मोक्षधर्मवचनान्न नास्तिक्यवादो युज्यते",
 "bsb_1_1_6_u02_padya_p01_ebeeaa": "गौणश्चेन्नात्मशब्दात्",
 "bsb_1_1_6_u08_padya_p01_e420c4": "इति तलवकारब्राह्मणम्",
 "bsb_1_1_26_u06_padya_p03_2e45fc": "चतुर्भागबल इतिवद् भिन्नं च",
 "bsb_1_1_31_u04_padya_p03_bf94f9": "तस्मान्नेति चेत्",
 "bsb_1_1_31_u10_padya_p01_77b375": "इति ब्रह्माण्डे",
 "bsb_1_3_28_u06_padya_p02_b6addd": "तस्मान्नानीदृशं क्वापि विश्वमेतद् भविष्यति",
 "bsb_2_1_14_u04_padya_p01_a12c9f": "इति मुक्तजीवस्य परापत्तिरुच्यते",
 "bsb_2_1_14_u04_padya_p05_adcbbf": "न स्याल्लोकवत्",
 "bsb_2_1_14_u06_padya_p01_aa7892": "इति",
 "bsb_2_1_24_u02_padya_p01_3051c7": "अश्मादिवच्च तदनुपपत्तिः",
 "bsb_2_1_26_u02_padya_p03_8272f1": "देवादिवददृश्यत्वशक्तियोगात्",
 "bsb_2_1_29_u02_padya_p02_475ddf": "परमात्मनो विचित्राश्च शक्तयः सन्ति",
 "bsb_2_2_5_u02_padya_p01_81eb2f": "सेश्वरसाङ्ख्यमतं निराकरोति",
 "bsb_2_2_5_u10_padya_p01_5c7f53": "इत्यादि च",
 "bsb_2_3_24_u02_padya_p03_d0ca1a": "यथा हरिचन्दनविप्लुष एकदेशपतितायाः सर्वशरीरव्याप्तिः",
 "bsb_2_4_1_u08_padya_p03_0d31d7": "यथाऽऽकाशादयः परमात्मन उत्पद्यन्ते तथा प्राणा अपि",
 "bsb_3_1_4_u04_padya_p02_9319c9": "न",
 "bsb_3_1_27_u02_padya_p01_6cc175": "अशुद्धमिति चेन्न शब्दात्",
 "bsb_3_2_13_u02_padya_p01_be4dbd": "अपि चैवमेके",
 "bsb_3_2_13_u04_padya_p02_facf93": "अभेदेऽपि भेदव्यपदेशः स्थानभेदादैश्वर्ययोगाच्च युज्यते",
 "bsb_3_2_22_u02_padya_p03_03d73b": "उक्तं सृष्टिसंहारकर्तृत्वमात्रं प्रतिषिद्ध्य ततोऽधिकं ब्रवीति",
 "bsb_3_3_4_u02_padya_p02_8dd42f": "यथा सर्वं सलिलं समुद्रं गच्छति",
 "bsb_3_3_40_u02_padya_p02_e47c8d": "अत्रोच्यते- कामादितरत्र तत्र चायतनादिभ्यः",
 "bsb_3_3_56_u02_padya_p03_dff6b6": "तदुपासनादिभोगादंशस्य",
 "bsb_3_3_58_u02_padya_p03_9e0de2": "एवमविरोधो वा",
 "bsb_3_4_1_u02_padya_p01_22a9f1": "ज्ञानसामर्थ्यमस्मिन् पाद उच्यते",
 "bsb_3_4_27_u02_padya_p02_315d8c": "यद्यपि ज्ञानेनैव मोक्षो नियतस्तथाऽपि ज्ञानी शमदमाद्युपेतः स्यात्",
 "bsb_3_4_41_u02_padya_p02_9783ea": "नच परमात्मैश्वर्यादिकमाकाङ्क्ष्यम्",
 "bsb_3_4_41_u02_padya_p06_b475f1": "अयोग्यमारोढुं प्रयतन् प्रपतन् हि दृश्यते",
 "bsb_3_4_51_u02_padya_p03_51794b": "तद्भावे जन्मान्तराणीत्यनियमः",
 "bsb_4_1_6_u04_padya_p01_ff69ca": "इत्याद्युपासनं च देवानां कार्यमेव",
 "bsb_4_1_17_u02_padya_p02_fd80b5": "मुक्तावनुभवकारणाद् यदन्यत् पुण्यमपि विनश्यति",
 "bsb_4_4_16_u04_padya_p02_255d24": "यतः स्वाप्ययसम्पत्त्योरन्यतरापेक्षमाविष्कृतं हि",
 "bsb_4_4_16_u08_padya_p04_b07479": "सर्वदोषनिवृत्तास्ते गुणमात्रस्वरूपिणः",
 "bsb_1_1_3_u05_padya_p02_be13f2": "नचानुमानस्य नियतप्रामाण्यम्",
 "bsb_1_1_3_u11_padya_p02_8f76e4": "दर्शनाच्च तपआदिफलस्य",
 "bsb_1_1_6_u02_padya_p02_92d7df": "नच",
 "bsb_1_1_6_u08_padya_p02_a69d7a": "नच मुख्ये सत्यमुख्यं युज्यते",
 "bsb_1_1_26_u06_padya_p04_1c3924": "स हि पुरुषसूक्ताभिधेयः",
 "bsb_1_1_31_u04_padya_p04_9319c9": "न",
 "bsb_1_1_31_u10_padya_p02_782241": "तत्तदुपासनायोग्यतया च पुरुषाणाम्",
 "bsb_1_3_28_u07_gadya_p01_8be476": "इत्यादेरत एव शब्दात् तेषां प्रभवनियमात्",
 "bsb_2_1_14_u04_padya_p02_d97133": "अतस्तयोरविभागः",
 "bsb_2_1_14_u04_padya_p06_b11bf7": "यथा लोके उदके उदकान्तरस्यैकीभावव्यवहारेऽप्यन्तर्भेदोऽस्त्येव",
 "bsb_2_1_14_u06_padya_p02_d0ddf0": "स्कान्दे च–",
 "bsb_2_1_24_u02_padya_p02_d0875d": "चेतनत्वेऽप्यश्मादिवदस्वतन्त्रत्वात् स्वतः कर्तृत्वानुपपत्तिर्जीवस्य",
 "bsb_2_1_26_u02_padya_p04_e3b79c": "लोकेऽपि पिशाचादीनां तादृशी शक्तिर्दृष्टा",
 "bsb_2_1_29_u02_padya_p03_a1a7d1": "नान्येषाम्",
 "bsb_2_2_5_u02_padya_p02_8b387a": "यथा पृथिव्या एव पर्जन्यानुगृहीतं तृणादिकमुत्पद्यते",
 "bsb_2_2_5_u10_padya_p02_264e0d": "चशब्देन प्रकृतिसत्तादिप्रदत्वं चाङ्गीकृतम्",
 "bsb_2_3_43_u11_gadya_p01_658c18": "इत्यादिना नानाव्यपदेशादंशो जीवः",
 "bsb_2_4_4_u03_padya_p01_a6d6fa": "इति गौपवनश्रुतौ मनसोऽनुत्पत्तिः सयुक्तिका श्रूयते",
 "bsb_3_1_4_u04_padya_p03_a94738": "भागतोऽग्न्यादिप्राप्तेः",
 "bsb_3_1_27_u02_padya_p02_f0dbfe": "हिंसारूपत्वात् पापस्यापि सम्भवाद् दुःखं च भवत्विति चेत्",
 "bsb_3_2_13_u02_padya_p02_5c45ae": "एवमभेदेनैव",
 "bsb_3_2_13_u04_padya_p03_80a0ef": "ब्रह्मतर्के च–",
 "bsb_3_2_22_u04_padya_p01_aa7892": "इति",
 "bsb_3_3_4_u02_padya_p03_2637dc": "एवं सर्वाणि वचनानि ब्रह्मज्ञानार्थानीति नियमः",
 "bsb_3_3_40_u02_padya_p03_c6884a": "स्वेच्छयैव मूलस्थाने स्थिताऽन्यत्रावतारान् करोतीश्वरेच्छानुसारेण",
 "bsb_3_3_56_u02_padya_p04_3ff82a": "परमसंहितायां च",
 "bsb_3_3_59_u02_padya_p01_be2dcb": "भूम्नः क्रतुवज्ज्यायस्त्वं तथाच दर्शयति",
 "bsb_3_4_1_u02_padya_p02_9d9364": "पुरुषार्थोऽतः शब्दादिति बादरायणः",
 "bsb_3_4_27_u08_padya_p01_bd2c9a": "इत्याग्नेये",
 "bsb_3_4_41_u02_padya_p03_1a9fac": "ब्रह्मादीनामपि नाकाङ्क्ष्यं",
 "bsb_3_4_41_u02_padya_p07_7a8a19": "एवमयोग्यस्य परमात्मैश्वर्यस्य ब्रह्मादिपदस्य चाकाङ्क्षायां पतनमनुमीयते",
 "bsb_4_1_4_u04_padya_p01_14f6fc": "इत्यादिना शब्दभ्रान्त्या न प्रतीके ब्रह्मदृष्टिः कार्या",
 "bsb_4_1_6_u04_padya_p02_8163ac": "स्वोत्पत्तिस्थानत्वात् स्वाश्रयत्वान्मुक्तौ तत्र लयस्यापेक्षितत्वाच्चोपपन्नं तेषां तथोपासनम्",
 "bsb_4_1_17_u02_padya_p03_925625": "अप्रारब्धमनभीष्टं च",
 "bsb_4_4_16_u04_padya_p03_7eb34c": "सुप्तौ मोक्षे वा तदुच्यते",
 "bsb_4_4_23_u07_padya_p01_6d00ca": "नित्यानन्दो हरिः पूर्णो नित्यदा प्रीयतां मम"
}