[{"id": "spr_seq10_u01_sutra_p01_7adb4d", "meter": "anuṣṭubh", "padas": ["तान् वरिष्ठः प्राण उवाच मा मोहमापद्यथ अहमेवैतत् पञ्चधाऽऽत्मानं विभज्यैतद् बाणमवष्टभ्य विधारयामीति तेऽश्रद्दधाना बभूवुः सोऽभिमानादूर्ध्वमुत्क्रमत इव तस्मिन्नुत्क्रामत्यथेतरे सर्व एवोत्क्रमन्ते तस्मिंश्च प्रतिष्ठमाने सर्व एव प्रतिष्ठन्ते तद् यथा मक्षिका मधुकरराजानमुत्क्रामन्तं सर्वा एवोत्क्रमन्ते तस्मिंश्च प्रतिष्ठमाने सर्वा एव प्रतिष्ठन्ते एवं वाङ् मनश्चक्षुः श्रोत्रं चेति ते प्रीताः प्राणं स्तुन्वन्ति एषोऽग्निस्तपत्येष सूर्य एष पर्जन्यो मघवानेष वायुः पृथिवी रयिर्देवः सदसच्चामृतं च यत् अरा इव रथनाभौ प्राणे सर्वं प्रतिष्ठितम् ऋचो यजूंषि सामानि यज्ञः क्षत्रं च ब्रह्म च प्रजापतिश्चरसि गर्भे त्वमेव प्रतिजायसे तुभ्यं प्राण प्रजास्त्विमाः यत् प्राणैः प्रतितिष्ठसि देवानामसि वह्नितमः पितॄणां प्रथमा स्वधा ऋषीणां चरितं सत्यमथर्वाऽङ्गिरसामपि इन्द्रस्त्वं प्राण तेजसा रुद्रोऽसि परिरक्षिता त्वमन्तरिक्षे चरसि सूर्यस्त्वं ज्योतिषां पतिः यदा त्वमभिवर्षस्यथेमाः प्राण ते प्रजाः आनन्दरूपास्तिष्ठन्ति कामायान्नं भविष्यतीति व्रात्यस्त्वं प्राणैकऋषिरत्ता विश्वस्य सत्पतिः वयमाद्यस्य दातारः पिता त्वं मातरिश्व नः या ते तनूर्वाचि प्रतिष्ठिता या श्रोत्रे या च चक्षुषि या मनसि सन्तता शिवां तां कुरु मोत्क्रमीः प्राणस्यैतद् वशे सर्वं त्रिदिवे यत् प्रतिष्ठितम् मातेव पुत्रान् रक्षस्व श्रीश्च प्रज्ञां च विधेहि न इति"], "seed": 60, "no_sandhi": true}, {"id": "spr_seq8_u01_sutra_p01_097f6e", "meter": "anuṣṭubh", "padas": ["अथ हैनं भार्गवो वैदर्भिः पप्रच्छ भगवन् कत्येव देवाः प्रजा विधारयन्ते कतर एतत् प्रकाशयन्ते कः पुनरेषां वरिष्ठ इति"], "seed": 60, "no_sandhi": true}, {"id": "spr_seq30_u08_padya_p02_ca225d", "meter": "anuṣṭubh", "padas": ["तस्मादिन्द्रस्त्विन्द्रियात्मा तस्य सोमोऽन्नदेवता"], "seed": 60, "no_sandhi": true}, {"id": "spr_seq20_u02_padya_p02_7ee836", "meter": "anuṣṭubh", "padas": ["सूर्यस्य मण्डलं यान्तीत्युच्यन्ते तददर्शनात्"], "seed": 60, "no_sandhi": true}, {"id": "spr_seq15_u02_padya_p02_e168d6", "meter": "anuṣṭubh", "padas": ["प्राणाद्यास्तान् नयन् प्राण आज्ञापयति राजवत्"], "seed": 60, "no_sandhi": true}, {"id": "