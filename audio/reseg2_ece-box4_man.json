{
 "bsb_1_1_3_u07_padya_p02_86e29c": "शक्यत्वाच्चानुमानां सर्वत्र",
 "bsb_1_1_26_u06_padya_p02_f74d54": "पाद इत्येकदेशपरिमितम्",
 "bsb_1_3_28_u06_padya_p01_650610": "यथैव कालनियमः सुरादिनियमस्तथा",
 "bsb_2_1_14_u04_padya_p08_802161": "तथाच श्रुतिः",
 "bsb_2_1_29_u02_padya_p01_d02005": "आत्मनि चैवं विचित्राश्च हि",
 "bsb_2_3_24_u02_padya_p02_0fc536": "अणोरपि जीवस्य सर्वशरीरव्याप्तिर्युज्यते",
 "bsb_3_1_4_u06_padya_p02_daefdb": "ब्रह्माण्डे च",
 "bsb_3_2_22_u02_padya_p02_1f6d01": "अत आह- प्रकृतैतावत्त्वं हि प्रतिषेधति ततो ब्रवीति च भूयः",
 "bsb_3_3_56_u02_padya_p02_bd2bc6": "ज्ञानादिभेदे विद्यमानेऽपि नांशांशिनोः पृथग्भाव एव",
 "bsb_3_4_27_u02_padya_p01_ee3945": "शमदमाद्युपेतः स्यात् तथाऽपि तु तद्विधेस्तदङ्गतया तेषामवश्यानुष्ठेयत्वात्",
 "bsb_3_4_51_u02_padya_p02_67999b": "एवमेव प्रारब्धकर्माभावे शरीरपातानन्तरमेव मोक्षः",
 "bsb_4_4_16_u04_padya_p01_5edefc": "इत्यादिना स्वर्गादिस्थस्यैतदिति वाच्यम्",
 "nvv_seq143_u02_padya_p01_6a8a0c": "नच वियत उत्पत्तिमत्वेऽनुभूतियुक्तिबहुवाग्विरोधोऽस्ति",
 "nvv_seq193_u02_padya_p01_949552": "नच यत्प्राप्तिर्यत्परित्याग उत्पत्तिर्मरणं तथा",
 "nvv_seq203_u02_padya_p03_374468": "रूपापेक्षं तथा नाम व्यवहारस्तदात्मकः",
 "nvv_seq262_u02_padya_p04_6bdb99": "इति श्रुतिमानात्",
 "nvv_seq288_u02_padya_p08_466dd0": "इति श्रुतेश्च",
 "nvv_seq290_u02_padya_p12_6cbc39": "अतः प्रलोभकल्पने श्रुतहानिरश्रुतकल्पना चेति हरिरेव फलप्रदः",
 "nvv_seq316_u02_padya_p01_c93f81": "ब्रह्मणश्च ब्रह्माण्याश्च स्थानैक्यं गुणतारतम्यं च यथागुणोपासनं मुक्तावाधिक्यं न भवतीत्यत्र लिङ्गम्",
 "nvv_seq320_u02_padya_p06_52270f": "देवानां युगपज्ज्ञानं मनुष्याणां तथा नतु",
 "nvv_seq336_u02_padya_p04_24a549": "पूर्ण आत्मा पूर्णो नात्र किञ्चिदूनं पूर्णमेवाधस्तात् पूर्णमुपरिष्टात् पूर्णं",
 "nvv_seq382_u02_padya_p04_99bab9": "विपरीतप्रवृत्तेस्तु तस्य ह्रासोऽधिकं भवेत्",
 "nvv_seq411_u02_padya_p02_d4eacf": "न चेत् कर्माक्षय इति वाच्यम्",
 "nvv_seq417_u02_padya_p08_57f97b": "पृथक्छक्तोऽपि तद्गैस्तु स्वरूपैस्तद्गकार्यकृत्",
 "nvv_seq449_u02_padya_p04_9b38ec": "पूर्णैश्वर्याद् भगवान् वासुदेवो विरुद्धशक्तिर्नच दोषस्पृगीशः",
 "nvv_seq459_u02_padya_p05_1a5c6d": "नहि कश्चित् सुशक्तोऽपि चकाराचेतनं चितम्",
 "ait_seq12_u01_padya_p07_74b2b0": "पृथक्पृथक् च तस्याङ्गान्युक्थानि जगदीशितुः",
 "ait_seq12_u01_padya_p19_bae3b1": "तस्मात् तस्यार्क इति सा प्रोच्यते वैदिकैः पदैः",
 "ait_seq12_u01_padya_p31_2c2709": "अङ्गाङ्गित्वेनैक एव स्वानन्दानुभवे स्थितः",
 "ait_seq12_u01_padya_p43_b498e3": "इतो गतं सर्वमत्ति द्युनामा भगवान् परः",
 "ait_seq16_u01_padya_p07_b574b0": "अयादूर्ध्वं ततो विष्णुः प्रपदादूरुमत्र च",
 "ait_seq16_u01_padya_p19_f40f3a": "उदरस्थं च हृद्गं च ते उभे ब्रह्म तत् परम्",
 "ait_seq16_u01_padya_p31_81a372": "ते विष्णोराज्ञयाऽवोचन्नुत्क्रमाम पृथक्पृथक्",
 "ait_seq16_u01_padya_p43_2aa3d2": "उच्चत्वं च गुणाधिक्यं त्वमुच्चोऽसीति तेऽब्रुवन्",
 "ait_seq18_u01_padya_p08_7c3a1a": "सङ्गतत्वात् सायमिति तद् रूपं नामतोऽभवत्",
 "ait_seq18_u01_padya_p20_23865d": "एताः सर्वा देवता हि ब्रह्मवायुसुपर्णकाः",
 "ait_seq18_u01_padya_p32_b9a213": "मन्निषेधे न शक्तोऽस्ति प्रीता देवा हि मे सदा",
 "ait_seq18_u01_padya_p44_3c22e3": "सर्वोत्तमत्वात् पूर्णत्वात् सर्वज्ञत्वात् तथैव च",
 "ait_seq18_u01_padya_p56_c7ce9c": "देवता मुनयश्चैव योग्या अस्या अपि स्फुटम्",
 "ait_seq20_u01_padya_p11_85b1fe": "योग्यश्चास्या उपासाया योग्यो ब्रह्मपदस्य यः",
 "ait_seq20_u01_padya_p23_158788": "योग्या अस्याश्च विद्याया भृग्वाद्या देवतास्तथा",
 "ait_seq20_u01_padya_p35_7a9f5f": "अन्तश्च सर्वलोकेषु चरतो लोकसाक्षिणौ",
 "ait_seq20_u01_padya_p47_845783": "इति विद्यात्",
 "ait_seq24_u01_padya_p12_18c193": "यथा पितामहाद्याश्च पितरो नाम कीर्तिताः",
 "ait_seq24_u01_padya_p24_07a967": "ज्ञानकर्मबलेहाद्या मद्दता इति किं वदे",
 "ait_seq24_u01_padya_p36_f74012": "अज्ञानादिप्रदातृत्वात् स एवाभूतिनामकः",
 "ait_seq24_u01_padya_p48_3c3009": "ज्ञानैश्वर्यादिभिः सोऽपि भवेत् तस्य परात्मनः",
 "ait_seq24_u01_padya_p60_132f5d": "अनित्या अपि देहास्ते शश्वत् सन्त्या विमोक्षतः",
 "ait_seq24_u01_padya_p72_6134c0": "ब्रह्म पन्थाः सत्यं कर्म इति तस्य नारायणस्य वासुदेवाद्याः",
 "ait_seq24_u04_padya_p04_4a5532": "स्वरस्पर्शविभागेन तत्रोक्तिः स्याद् विभक्तिषु",
 "ait_seq24_u08_padya_p01_61dc95": "तस्योष्णिग् लोमानि",
 "ait_seq24_u19_padya_p01_1ad601": "इति च स्कान्दे",
 "ait_seq24_u21_padya_p05_ab4664": "नहि यत्किञ्चित् कारणत्वमस्तीत्येतावता ब्राह्मणस्य चण्डालः पितेत्युच्यते",
 "ait_seq24_u27_padya_p03_c8ffea": "यथा",
 "ait_seq71_u03_padya_p02_53e904": "अष्टचतुरक्षराण्यनुष्टुप्",
 "ait_seq71_u03_padya_p14_2e4b30": "तस्माद् बृहत्याः सकाशादनुष्टुप्सम्पादने तस्यैव विष्णोः प्रतिमान्तरं तस्मादेव निर्मितं भवति",
 "ait_seq71_u15_padya_p01_e7580d": "इत्यादि शब्दनिर्णये",
 "ait_seq71_u15_padya_p13_a3b2c3": "यमर्थमकारो वक्ति तमेव वक्तीति",
 "ait_seq73_u05_padya_p03_80d981": "अतो विष्णावेवेन्द्रशब्दं प्रयुङ्क्ते श्रुतिः",
 "ait_seq73_u11_padya_p03_418f3a": "तस्मान्मुख्यतो विष्णावेवेन्द्रादिशब्दा अन्येषामुपचारतः",
 "ait_seq73_u25_padya_p01_bd5601": "इति धातोर्विशेषेण धारणपोषणकर्ता हि वेधाः",
 "ait_seq73_u33_padya_p02_f66615": "यदनेन रूपेणामुं लोकमभिसम्भवति",
 "ait_seq73_u39_padya_p05_e509a7": "दिविष्ठाय स्वपुरुषरूपाय प्रयच्छति देवरेतःस्थिताय च",
 "ait_seq75_u01_padya_p01_00959d": "यन्नारायणादिरूपेण पञ्चविधमक्षरं परं ब्रह्म तत् स्वस्मिन्नेव स्त्रीपुंरूपेण समेति",
 "ait_seq75_u04_padya_p05_226a04": "नचाज्ञात एकत्वे पुनर्ज्ञाते ऐक्यं प्राप्त इति प्रयोगो दृश्यते",
 "ait_seq75_u08_padya_p07_38a2ed": "ततश्चाधिकं समतृप्यन्",
 "ait_seq75_u14_padya_p06_12b084": "तस्माद् वदत्येव",
 "ait_seq75_u24_padya_p08_a02d5b": "नच शून्यस्याशब्दार्थता",
 "ait_seq75_u24_padya_p20_441afe": "तस्मादकारशब्दार्थ एव ब्रह्मशब्दार्थः",
 "ait_seq75_u28_padya_p01_1028a2": "इति",
 "ait_seq75_u36_padya_p04_b2a0bb": "नच नपुंसकरूपं भगवतः कुत्रचिदुक्तम्",
 "ait_seq75_u44_padya_p03_59e013": "विवस्वतो विष्णोः सकाशाद् दिवोदुहिता अहनी च जायन्ते",
 "ait_seq75_u48_padya_p01_415f84": "इति ज्ञानावस्थायां मुक्तौ भोगबाहुल्यकारणत्वात् साऽपि मुक्तिवत् सुदिनम्",
 "ait_seq186_u01_padya_p01_737262": "भगवदुपासकस्य यस्मिन् कस्मिंश्चिद् दोष उक्ते तं प्रत्युक्तिप्रकारः पूर्वं दर्शितः",
 "vtn_seq40_u06_padya_p03_f53149": "नच वर्णपदादीनामनित्यत्वं वक्तुं युक्तम्",
 "vtn_seq73_u01_padya_p08_196f82": "बल्येवानुभवस्तत्र निर्दोषं त्वक्षजादिकम्",
 "vtn_seq76_u01_padya_p09_337a83": "प्रतिज्ञावयवत्वात्तु स्वातन्त्र्येणैव मानताम्",
 "vtn_seq80_u01_padya_p03_9a8c26": "एतत्सदृशताज्ञानमुपमानं प्रकीर्तितम्",
 "vtn_seq170_u04_padya_p05_747666": "त इह व्याघ्रो वा सिंहो वा वृको वा",
 "vtn_seq170_u07_padya_p05_5589dd": "सोम्यैषोऽणिम्न एवं महान् न्यग्रोधस्तिष्ठति",
 "vtn_seq174_u08_padya_p02_c8bd10": "एकीभावविवक्षायां",
 "vtn_seq250_u02_padya_p04_877bc8": "नच निवर्तते",
 "vtn_seq250_u04_padya_p03_940060": "सर्वस्मादुत्तमोऽर्थः स एक एवेत्यर्थः",
 "vtn_seq250_u08_padya_p08_60a99d": "अज्ञानिनां पक्ष एव द्वैतं न विद्यत इत्यर्थः",
 "gb_2_17b_u26_padya_p01_475266": "इत्यादि मोक्षानन्तरमपि भेदवचनेभ्यः",
 "gb_2_17b_u44_padya_p02_bf4541": "अविद्यमानमेवेश्वरं सृष्ट्यादिकं चाप्राप्तमेवात्मनो भिन्नत्वेन प्रापयित्वा तन्निषेधे कथं श्रुतेरुन्मत्तवाक्यत्वं",
 "gb_2_17b_u53_padya_p08_d7b057": "अतः सत्यत्वं सत्यं स्यात्",
 "gb_2_39_u08_padya_p01_b715db": "इति",
 "gb_3_17_u16_padya_p01_eb7e37": "इत्येवशब्देन मुक्तानामेभ्यो विशेषो दर्शितः",
 "gb_7_27_u04_padya_p01_7446a9": "इति च भारते",
 "gb_11_1_u29_padya_p02_6e91e3": "कमलासने ब्रह्मणि स्थितं रुद्रम्",
 "gt_2_55_u04_padya_p01_60c27a": "इत्यादिना दर्शयिष्यन् लक्षणं प्रथमत आह- प्रजहातीति",
 "gt_2_55_u08_padya_p02_d33777": "अत एव वैलक्षण्यादनधिकारिणामाग्रहादि चेदस्ति",
 "gt_2_55_u12_padya_p02_6bd57c": "मनोगता हि कामाः",
 "gt_2_55_u16_padya_p01_10f955": "इत्युक्तं हि नारायणरामकल्पे",
 "gt_13_0_u02_padya_p01_2bd347": "श्रीभगवानुवाच- इदं शरीरं कौन्तेय क्षेत्रमित्यभिधीयते",
 "gt_16_1_u10_padya_p02_8d0034": "अचापलं स्थैर्यम्",
 "gt_17_27b_u01_padya_p01_b2d89c": "ओमित्युक्त्वाऽनभिसन्धाय फलं यज्ञदानतपआदिकृतामतिप्रीतेर्नामसाम्याद् ब्रह्मैव निष्पादितं भवतीत्याशयः",
 "tvk_seq18_u01_padya_p06_829954": "क्रियाक्रियावतोस्तद्वत् तथा जातिविशेषयोः",
 "uk_seq11_u07_gadya_p01_11ef1e": "इति श्रुतेः सदा",
 "tsk_seq12_u01_padya_p09_9cdc95": "ते च प्राप्तान्धतमसः सृतिसंस्था इति द्विधा",
 "kat_seq11_u11_padya_p04_471873": "नचाग्निपरिज्ञानमात्रेणानन्तलोकाप्तिर्भगवज्ज्ञानं विना",
 "kan_seq288_u06_padya_p08_f94f62": "स्तनयित्नुर्वृष्टिमिव",
 "knr_seq35_u04_padya_p06_32fe2b": "अयनेन प्राप्यं दूरस्थम् आयो इति वा",
 "bt_1_8_5_u01_padya_p02_05f65d": "सोग्निष्‍टोमस्य यो हन्ति गजरथौ सोऽश्‍वमेधराजसूयाभ्याम्",
 "bt_10_40_15_u04_padya_p08_85a627": "अनोऽस्यनन्तोऽसि सृजतो हि ते श्रुतयोऽनुवर्तन्ते नैवासृजतः",
 "bt_10_40_19_u13_padya_p02_698a82": "पुरुषं तस्मात्प्रपदे तस्मात्प्रपदे इत्याचक्षते"
}