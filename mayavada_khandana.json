  "07f22828-518f-4abf-9601-bf7b271b04a6": [
   {
    "content_type": "Sarvamula",
    "is_padya": false,
    "text": [
     "नहि ब्रह्मात्मैक्यस्य याथार्थ्यं तत्पक्षे।",
     "अद्वैतहानेः स्वरूपातिरेके।",
     "अनतिरेके स्वप्रकाशत्वादात्मनः सिद्धसाधनता।",
     "निर्विशेषत्वाच्चात्मनो नानधिगतो विशेषः।",
     "सिद्धत्वात्‌ स्वरूपस्य विशेषाभावाच्च नाज्ञानं कस्यचिदावरकम्।",
     "अनधिगतार्थगन्तृ",
     "प्रमाणमिति च तन्मतम्।"
    ],
    "variants": [
     {
      "pathanatara": "“निर्विशेषत्वाच्चात्मनः” इति गोविन्दाचार्यपाठः। “निर्विशेषत्वादात्मनः” इति प्रचलितपाठ इति ते वदन्ति। किन्तु, कृपाठे तु “निर्विशेषत्वात्मनो” इति स्फुटं मुद्रणदोषात् तत्पाठः कीदृश इति निर्णेतुं न शक्यते।"
     },
     {
      "bg_patha": "“प्रमाणमिति तन्मतम्”",
      "trk_patha": "“प्रमाणमिति च तन्मतम्”"
     }
    ]
   }
  ],
