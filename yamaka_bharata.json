  "793391b8-434e-4aa9-b499-4f8c5aa52492": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "देवानां पतयो नित्यं",
     "मतं यस्य न जानते।",
     "तस्मै देव नमस्येऽहं भवते(ऽ)सुरमारये॥ ७३॥"
    ],
    "variants": [
