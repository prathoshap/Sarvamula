  "7b6bb35b-918d-41db-9c65-9fef2a02cabe": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "ध्यायेत् परमानन्दं",
     "यन्माता पतिमयदपरमानन्दम्।",
     "उज्झितपरमानं दम्पत्याद्याद्याश्रमैः सदैव-परमानन्दम्॥ १॥"
    ],
    "variants": [
     {
      "bg_patha": "“ध्यायेत् परमानन्दं”",
      "trk_patha": "“ध्यायेत् तं परमानन्दं”"
     }
    ],
    "footnote": [
     "ध्यायेदिति, ध्यायेत् तमिति चोभयथा पाठोल्लेखो दृश्यते ताम्रपर्णीये।"
    ]
   }
  ],
