   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "यो निर्ममेऽशेषपुराणविद्द्यां यो निर्ममेशे षपुराणविद्द्याम्।",
     "योनिर्ममेशेषपुराऽणविद् यां योऽनिर्ममेऽशेषपुराणविद् द्याम्॥ ७६॥"
    ]
   }
  ],
