  "18858660-9c0b-4050-aa68-e6c97da2e93f": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "सुगतिं चरमामददान्निजयोग्यां",
     "ज्ञानिसुततिं परमामददात्।",
     "पार्थानां सयदूनां स पितृप्रेष्यादिनामिनां सयदूनाम्॥ ६८॥",
     "रेमे तत्रापिसुखी परमोऽनन्तो ननन्द तत्रापि सुखी।",
     "प्राणेनेन्दिरया च प्रयुतो नित्यं महागुणेन्दिरया च॥ ६९॥"
    ],
    "variants": [
     {
      "pathanatara": "आदौ ‘सुगतिं परमामददात्’ - पा।"
     },
     {
      "bg_patha": "“ज्ञानिसुततिपरमामददात्”",
      "trk_patha": "“ज्ञानिसुततिं परमामददात्”"
     },
     {
      "pathanatara": "‘परमप्रेष्यादिनामिनां’ - पा।"
     }
    ]
   }
  ],
