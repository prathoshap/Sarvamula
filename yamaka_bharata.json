  "912b25e5-2e5f-4d18-8567-dc4be8d67912": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "राम राम महाबाहो माया ते सुदुरासदा।",
     "वादसादद को लोके पादावेव तवासजेत्॥ ७१॥",
     "जेत् सवातव वेदापाके लोकोदद सादवा।",
     "दासरादुसुतेयामाहोबाहा मम राम रा॥ ७२॥"
    ],
    "variants": [
     {
      "bg_patha": "“[जेत् सवातव वेदापाके लोकोदद सादवा।]”",
      "trk_patha": "“जेत् सवातव वेदापाके लोकोदद सादवा”",
      "pathanatara": "प्राचीनकोशेषु नायं श्लोको ग्रन्थमध्ये पठितः, ग्रन्थान्त एव निविष्ट इति गोविन्दाचार्याः।"
     },
     {
      "bg_patha": "“[दासरादुसुतेयामाहोवाहा मम राम राः ७२॥]”",
      "trk_patha": "“दासरादुसुतेयामाहोबाहा मम राम राः॥ ७२”"
     }
    ]
   }
  ],
