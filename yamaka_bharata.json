  "cc455b08-9839-4a04-99bf-be67360de3b6": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "नैव परः केशवतः परमादस्मात्",
     "समश्च सुकेशवतः।",
     "सोऽयं शपथवरो नः शश्वत् सन्धारितः सुशपथवरोऽनः॥ ७९॥",
     "कृष्णकथेयं यमिता",
     "सुखतीर्थेनोदिताऽनने",
     "यं-यमिता।",
     "भक्तिमता परमेशे",
     "सर्वोद्रेकात्",
     "सदानुताऽऽप रमेशे॥ ८०॥",
     "इति नारायणनामा सुखतीर्थसुपूजितः",
     "सुरायण-ना मा।",
     "पूर्ण गुणैर्धिक पूर्णज्ञानेच्छाभक्तिभिः",
     "स्वधिकपूर्ण॥ ८१॥"
    ],
    "variants": [
     {
      "bg_patha": "“समश्च सुखकेशवतः”",
      "trk_patha": "“समश्च सुकेशवतः”"
     },
     {
      "bg_patha": "“सुशतीर्थेनोदिताऽनने”",
      "trk_patha": "“सुखतीर्थेनोदिताऽनने”"
     },
     {
      "bg_patha": "“सर्वोद्रेका”",
      "trk_patha": "“सर्वोद्रेकात्”"
     },
     {
      "pathanatara": "‘सदा नुवता’ - पा।"
     },
     {
      "bg_patha": "“इति नारायणनामाऽव कतीर्थं पूजितः”",
      "trk_patha": "“इति नारायणनामा सुखतीर्थसुपूजितः”",
      "pathanatara": "‘सुखतीर्थं पूजितः’ - पा। ‘सुखतीर्थपूजितः’ - पा।"
     },
     {
      "bg_patha": "“पूर्ण गुणैर्धिक पूर्णज्ञानेच्छाभक्तिभिः”",
      "trk_patha": "“पूर्ण गुणैरधिक ज्ञानेच्छाभक्तिभिः”"
     },
     {
      "pathanatara": "‘गुणाधिक’ - पा। ‘ज्ञानेच्छाशक्तिभिः’ - पा। ‘शक्तिभिः सदा स्वधिकपूर्णः’ - पा।"
     }
    ],
    "footnote": [
     "“समः सुकेशवतः” इति ताम्रपर्णीये।",
     "“पूर्ण गुणैर्धिक पूर्णज्ञानेच्छाभक्तिभिः” इत्येव ताम्रपर्णीये।"
    ]
   }
  ],
