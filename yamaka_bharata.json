  "69894167-38b8-4d03-a6c5-a7ace0829bb0": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "यद्बलवान् क्रोधवशान् निनाय नाशं वृकोदरः क्रोधवशान्।",
     "लेभेऽचान्या गम्यं स्थानं पुष्पाणि धाम चान्यागम्यम्॥ ४६॥",
     "यद्बलभारवहत्त्वान्नाचलदुरगादिभिः सुभारवहत्त्वात्।",
     "धर्मादरिहाऽपि पदं भीमो येनैव साहसं",
     "रिहाऽपि",
     "पदम्॥ ४७॥",
     "नहि नहुषोऽलं नहितुं धर्मो",
     "द्रौणिस्तथेतरोऽलं",
     "न हितुम्।",
     "नो राट्कर्णौ ब्रह्मवरी येन ध्वस्तोऽस्त्रमग्रहीत्",
     "सब्रह्म-वरी",
     "॥ ४८॥",
     "क्षात्रं धर्मं स्ववता गुरुवृत्त्यै",
     "केशवाज्ञया च मं",
     "स्ववता।",
     "सर्वं सेहेऽमनसा भीमेनेशैकमानिना हेमनसा॥ ४९॥",
     "यद्भक्तप्रवरेण प्रोतः स्वस्मिन् स कीचकः प्रवरेण।",
     "पतितास्तस्य सहायाः कृष्णार्थे मानिनः समस्य सहायाः॥ ५०॥",
     "यद्भक्त्याऽनुगृहीतौ पार्थो भीमश्च गोनृपौ नु गृहीतौ।",
     "ऋणमुक्त्यै सुव्यत्यस्त्यै क्रमशो वीरावमुञ्चतां सुव्यत्यस्त्यै॥ ५१॥"
    ],
    "variants": [
     {
      "bg_patha": "“लिहाऽपि”",
      "trk_patha": "“रिहाऽपि”"
     },
     {
      "bg_patha": "“द्रौणिस्तथेतरेऽलं”",
      "trk_patha": "“द्रौणिस्तथेतरोऽलं”"
     },
     {
      "bg_patha": "“सुब्रह्म-वरी”",
      "trk_patha": "“सब्रह्म-वरी”",
      "pathanatara": "‘ससुब्रह्मवरी’ - पा।"
     },
     {
      "bg_patha": "“केशवाज्ञया च मं”",
      "trk_patha": "“केशवाज्ञया चरमं”",
      "pathanatara": "‘केशवाज्ञया च चरमं’ - पा। ‘केशवाज्ञया स्ववता’ - पा।"
     },
     {
      "pathanatara": "‘भीमेनैशैकमानिना’ -पा।"
     },
     {
      "pathanatara": "‘गोनृपौ निगृहीतौ’ - पा।"
     }
    ],
    "footnote": [
     "इतरो द्रोणादिरिति ताम्रपर्णीये।",
     "‘ससुब्रह्मवरी’ इति ताम्रपर्णीये।",
     "‘केशवाज्ञया च’ इति ताम्रपर्णीये।",
     "‘पातिताः’ इति ‘मानिनः स्वसमस्य’ इति च ताम्रपर्णीये।",
     "क्रमेणेति ताम्रपर्णीये।"
    ]
   }
