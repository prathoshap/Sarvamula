  "ca02efb9-549d-41e2-868b-dd509594c512": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "समस्तदेवजनकवासुदेवपरामृत।",
     "वासुदेव परामृत ज्ञानमूर्ते नमोऽस्तु ते॥ ७४॥",
     "देवादे देवलोकप पूर्णानन्दमहोदधे।",
     "सर्वज्ञेश रमानाथ देवाऽदेऽदेऽव लोकप॥ ७५॥"
    ]
   }
