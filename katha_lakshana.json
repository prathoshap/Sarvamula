     },
     {
      "bg_patha": "“ऋग्यजुःसामाथर्वाः सपञ्चरात्रं च भारतम्”",
      "trk_patha": "“ऋग्यजुःसामाथर्वाश्च भारतं पञ्चरात्रकम्”"
     },
     {
      "bg_patha": "“सहितः”",
      "trk_patha": "“सहितैः”"
     }
    ],
    "footnote": [
     "‘सहितैः सुहृद्भावेन सङ्गतैः’ इति टीका।"
    ]
   }
