     "-",
     "-",
     "-",
     "-"
    ],
    "variants": [
     {
      "bg_patha": "“निगूहितुम्”",
      "trk_patha": "“निगूहितम्”"
     },
     {
      "bg_patha": "“विद्यापरीक्षापूर्वैव वितण्डा जल्प एव च”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“उच्चनीचत्वनिर्णीतिर्यतो जयपराजयौ॥ *”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“विनैव तत्वनिर्णीतिं नहि जल्पादिना क्वचित्”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“उच्चनीचत्वविज्ञानमिति विद्यापरीक्षणम्॥ *”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“वादेन चोच्चनीचत्वविज्ञानं भवति स्फुटम्”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“इति वादस्य पूर्वत्वं तत्सिद्धौ व्यर्थताऽन्ययोः॥ *”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“बहुविद्यत्वसिद्धौ तु नैव वादोऽपि कारणम्”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“सभासभापप्राश्नीकपूर्वस्तु स्पर्धिनामपि॥ *”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“वाद एवोभयार्थः स्यान्निर्णीतिजयकारकः”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“तत्वाप्रकाश एवैको वितण्डाजल्पयोः फलम्॥ *”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“विना वादेन विद्याया यदि शक्यं परीक्षणम्”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“स्याज्जल्पादिरपि क्वापि वाद एवान्यथा भवेत्॥ *”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“जल्प इत्यपि नाम स्याद् वादस्यैतादृशस्य तु”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“प्रतिज्ञामात्रसाध्यत्वमपि स्याद् याज्ञवल्क्यवत्॥ *”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“संवादे वादिनोः क्वापि विवादे हेतुरिष्यते”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“सभा सभापतिश्चैव प्राश्निकाश्चैव वैष्णवाः॥ *”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“रागद्वेषविहीनाश्च स्युः सभ्याः सर्ववेदिनः”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“प्राश्निकाश्चैतदज्ञाने सभ्याश्चैषां च दूरगाः”",
      "trk_patha": "“-”"
     },
     {
      "bg_patha": "“प्रमाणं निर्णयाय स्युः पक्षपातविवर्जिताः॥ *”",
      "trk_patha": "“-”"
     }
    ],
    "footnote": [
     "‘निगूहितं कर्तव्यम्’ इति टीका।",
     "अनुव्याख्यानगतानीमानि श्लोकान्यत्र तत्र च पठ्यन्ते प्राचीनकोशे इति गोविन्दाचार्याः। कृपाठे त्वत्र न पठ्यन्ते। न व्याख्यातानि चेमानि श्लोकान्यत्र प्राचीनटीकायां टीकायां वा। व्याख्यातानि च सर्वैरनुव्याख्याने।"
    ]
   }
  ],
  "56c57460-6c99-4b45-98de-123a3d3cedd2": [
   {
