  "c414e613-dc02-438a-8dd2-5d65d6e92a51": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "समिच्चर्वाज्यकान् हुत्वा सम्यक् पुरुषसूक्ततः।",
     "सर्वेषामभयं दत्वा विरक्तः प्रव्रजेद्धरिम्॥ १ ॥",
     "स्मृत्वा",
     "भागवतं शुद्धमाचार्यं शरणं व्रजेत्।",
     "अधीहि भगवो ब्रह्मेत्यस्मै ब्रूयाद् गुरुः परम्॥ २॥"
    ],
    "variants": [
     {
      "pathanatara": "‘समिच्चर्वाज्यकं’ - पा।"
     },
     {
      "bg_patha": "“स्मृत्वा”",
      "trk_patha": "“स्मृत्वा (श्रुत्वा)”",
      "pathanatara": "‘स्मृत्वा’ ‘श्रुत्वा’ इत्युभयथाऽपि पठ्यते कृपाठे।"
     }
    ]
   }
  ],
  "5717b53a-3b18-41b3-9a89-9416b4c71bd0": [
   {
    "content_type": "Heading1",
