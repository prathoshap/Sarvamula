  "f95082aa-1581-47f4-9ed4-dbde453ee30d": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "एवं कृते तु शपथे मस्तके हस्तपङ्कजम्।",
     "निधायोत्तीर्य संसारात् सुखी भव हरेः प्रियः॥ १८॥",
     "सर्वदुःखदिभिर्मुक्तो नित्यानन्दैकरूपकः।",
     "सम्प्राप्य विष्णुसामीप्यं तत्रापि हरिभक्तिमान्॥ १९॥",
     "भक्तिमांश्चान्यदेवेषु",
     "तारतम्यं च संस्मरन्।",
     "सर्वोत्कर्षं स्मरन् विष्णोर्भूयाश्चैव सदा सुखी॥ २०॥",
     "न मुक्तौ विष्णुनैक्यं वा मुक्तानां साम्यमेव वा।",
     "स्मरेथा इति",
     "चोक्त्वाऽथ समयाननुशिक्षयेत्",
     "॥ २१॥"
    ],
    "variants": [
     {
      "pathanatara": "नित्यानन्दैकरूपिणः"
     },
     {
      "bg_patha": "“भक्तिमांश्चाथ देवेषु”",
      "trk_patha": "“भक्तिमांश्चान्यदेवेषु”"
     },
     {
      "pathanatara": "‘तारतम्यं च सर्वदा’ - पा।"
     },
     {
      "bg_patha": "“चोक्त्वा तत्समयाननुशिक्षयेत्”",
      "trk_patha": "“चोक्त्वाऽथ समयाननुशिक्षयेत्”",
      "pathanatara": "‘चोक्त्वा तु’ - पा।"
