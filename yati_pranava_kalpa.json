  "2470daf8-ff98-47a2-8c8c-066a9071d3f9": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "एवमुक्त्वा गुरुर्ध्यानं शपथं कारयेत् ततः।",
     "न विष्णुं",
     "वैष्णवांश्चैव विसृजेयमिति",
     "त्रिशः॥ १५॥",
     "नचान्यदेवतासाम्यं",
     "तदैक्यमथवा हरेः।",
     "चिन्तयेयं मृतौ वाऽपि नचाप्येकत्ववादिभिः॥ १६॥",
     "समत्ववादिभिर्वाऽहं सङ्गच्छेयं कदाचन।",
     "तन्निन्दकैश्च तद्भक्तनिन्दकैर्वा महामुने॥ १७॥"
    ],
    "variants": [
     {
      "bg_patha": "“वैष्णवांश्चैवाप्युत्सृजेयमिति”",
      "trk_patha": "“वैष्णवांश्चैव विसृजेयमिति”"
     },
     {
      "bg_patha": "“नचान्यदेवसामान्यं”",
      "trk_patha": "“नचान्यदेवतासाम्यं”",
      "pathanatara": "‘नचान्यदैवसामान्यं’ - पा।"
     },
     {
      "pathanatara": "‘मृतो वाऽपि’ इति प्रचलितपाठ इति गोविन्दाचार्याः। कृपाठे तु नैवं पठ्यते।"
     },
     {
      "pathanatara": "‘कथञ्चन’ - पा।"
     }
    ]
   }
