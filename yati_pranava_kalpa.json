  "74a21d3f-ebf3-46c3-a200-62fb3ce1ed9e": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "उच्चारयेत् त्रिशस्तारं",
     "दक्षिणे श्रवणे तथा।",
     "ऋषिच्छन्दोदैवतानि ब्रूयात् तस्य क्रमात् सुधीः॥ ३॥",
     "अन्तर्यामीति गायत्री परमात्मेत्यनुक्रमात्।",
     "विश्वश्च तैजसः",
     "प्राज्ञस्तुर्यश्चाक्षरदेवताः",
     "॥ ४॥",
     "कृष्णो रामो नृसिंहश्च वराहो विष्णुरेव च।",
     "परञ्ज्योतिः परम्ब्रह्म वासुदेव इति क्रमात्॥ ५॥",
     "अकारादेस्तथा शान्तातिशान्तान्तस्य देवताः।",
     "एवमुक्त्वा तु तद्ध्यानं ब्रूयाद्",
     "भक्ताय",
     "सद्गुरुः॥ ६॥"
    ],
    "variants": [
     {
      "bg_patha": "“उच्चारयंस्त्रिशस्तारं”",
      "trk_patha": "“उच्चारयेत् त्रिशस्तारं”"
     },
     {
      "bg_patha": "“विश्वश्च तैजसः”",
      "trk_patha": "“विश्वश्च तैजसः”"
     },
     {
      "bg_patha": "“भक्तस्य”",
      "trk_patha": "“भक्ताय”",
      "pathanatara": "‘शिष्याय’ - पा।"
     }
    ]
   }
  ],
