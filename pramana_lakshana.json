    "text": [
     "आनन्दतीर्थमुनिना",
     "ब्रह्मतर्कोक्तिमार्गतः।",
     "मानलक्षणमित्युक्तं सङ्क्षेणाद् ब्रह्मसिद्धये॥",
     "अशेषमानमेयैकसाक्षिणेऽक्षयमूर्तये।",
     "अजेशपुरुहूतेड्य नमो नारायणाय ते॥"
    ],
    "variants": [
     {
      "bg_patha": "“ब्रह्मतर्कोक्तिमार्गतः”",
      "trk_patha": "“ब्रह्मतर्कोक्तमार्गतः”"
