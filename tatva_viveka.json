   {
    "content_type": "Heading2",
    "is_padya": false,
    "text": [
     "तत्त्वस्य सामान्यविभागोद्देशौ"
    ],
    "heading_level": 2
   }
  ],
  "8e531742-e2cd-4148-940f-a19b3a3e8ede": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "ॐ॥",
     "स्वतन्त्रं परतन्त्रं",
     "च प्रमेयं द्विविधं मतम्।"
    ],
    "variants": [
     {
      "bg_patha": "“स्वतन्त्रमस्वतन्त्रं”",
      "trk_patha": "“स्वतन्त्रं परतन्त्रं”"
     }
    ]
   }
  ],
  "75b66184-722d-4d02-a859-6a7cbca6862b": [
   {
    "content_type": "Heading2",
    "is_padya": false,
    "text": [
     "स्वतन्त्रप्रमेयोद्धेशः, तदुपपादनं च"
    ],
    "heading_level": 2
   }
  ],
  "160c78f0-cc05-49b2-a676-98221046f708": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "स्वतन्त्रो भगवान् विष्णुर्निर्दोषाखिलसद्गुणः॥ १॥"
    ]
   }
  ],
  "2be3972a-bbda-445f-a28a-adbb4de36c93": [
   {
    "content_type": "Heading2",
    "is_padya": false,
    "text": [
     "परतन्त्रप्रभेदाः"
    ],
    "heading_level": 2
   }
  ],
  "63360e08-c38d-471d-8cc2-d1a3deee6b5f": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "द्विविधं परतन्त्रं च भावोऽभाव इतीरितः।"
    ]
   }
  ],
  "f91f805c-7b3d-4620-bc53-def65594e673": [
   {
    "content_type": "Heading3",
    "is_padya": false,
    "text": [
     "अभावप्रभेदाः"
    ],
    "heading_level": 3
   }
  ],
  "6830ae03-ee87-4d3a-91be-ce44519fb25d": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "पूर्वापरसदात्वेन त्रिविधोऽभाव इष्यते॥ २ ॥",
     "भावाभावस्वरूपत्वान्नान्योन्याभावता पृथक्।"
    ]
   }
  ],
  "880dd3e6-dd7c-4018-afb9-1c9c73f89bae": [
   {
    "content_type": "Heading3",
    "is_padya": false,
    "text": [
     "भावविभागः"
    ],
    "heading_level": 3
   }
  ],
  "c8662307-e9bb-4565-a7d8-bd6b53e3ba63": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "चेतनोऽचेतनश्चेति भावश्च द्विविधः स्मृतः॥ ३॥"
    ],
    "variants": [
     {
      "bg_patha": "“चेतनोऽचेतनश्चेति भावोऽपि द्विविधः स्मृतः॥ ३”",
      "trk_patha": "“चेतनोऽचेतनश्चेति भावश्च द्विविधः स्मृतः॥ ३”"
     }
    ]
   }
  ],
  "4befde8a-a1c7-4ca7-b7c5-b44d4246cd48": [
   {
    "content_type": "Heading3",
    "is_padya": false,
    "text": [
     "चेतनविभागादि"
    ],
    "heading_level": 3
   }
  ],
  "f5f106ae-59e6-4d48-8320-2c06844081a4": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "नित्यमुक्तश्च सृतियुक् परतन्त्रोऽपि चेतनः।",
     "द्विधैव श्रीर्नित्यमुक्ता सृतियुक् च द्विधा मतः॥ ४॥",
     "मुक्तोऽमुक्त इति ह्यत्र ब्रह्मान्ता उत्तरोत्तरम्।",
     "मुक्ताः शतगुणाः प्रोक्ता रमा तेभ्योऽखिलैर्गुणैः॥ ५॥",
     "नित्यं बहुगुणोद्रिक्ता ततोऽनन्तगुणो हरिः।",
     "अमुक्तास्त्रिविधास्तत्र नीचमध्योच्चभेदतः॥ ६ ॥",
     "मुक्तियोग्यास्तत्र चोच्चा नित्यवर्तास्तु मध्यमाः।",
     "नीचा नित्यतमोयोग्याः --- --- --- ---"
    ]
   }
  ],
  "50daa67e-1ed1-4bc1-b69d-1dbe84049825": [
   {
    "content_type": "Heading3",
    "is_padya": false,
    "text": [
     "अचेतनविभागादि"
    ],
    "heading_level": 3
   }
  ],
  "4e15424c-70b7-4afb-a52f-c546ba1d3f3d": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "--- --- --- --- द्विधैवाचेतनं मतम्॥ ७॥",
     "नित्यानित्यत्वभेदेन देशः कालः श्रुतिस्तथा।",
     "भूतेन्द्रियप्राणगुणसूक्ष्मरूपं च नित्यकम्॥ ८॥",
     "एषां विकारोऽनित्यः स्यात्  --- --- --- ---"
    ]
   }
  ],
