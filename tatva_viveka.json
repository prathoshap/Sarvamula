   {
    "content_type": "Heading2",
    "is_padya": false,
    "text": [
     "अनुक्तसङ्ग्रहसूचना"
    ],
    "heading_level": 2
   }
  ],
  "59d27e13-a15e-4a6b-9d00-de8be2868530": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "--- --- --- ---   नित्या एव हि चेतनाः।"
    ]
   }
  ],
  "7c6f47af-93b0-4689-ac68-108b3db05e71": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "गुणादिविवेकः"
    ],
    "heading_level": 1
   }
  ],
  "a4659894-567a-465b-8c3a-28d8b9e24c34": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "गुणक्रियाजातिपूर्वा धर्माः सर्वेऽपि वस्तुनः॥ ९॥",
     "रूपमेव द्विधं तच्च यावद्वस्तु च खण्डितम्।",
     "खण्डिते भेद ऐक्यं च यावद्वस्तु न भेदवत्॥ १०॥",
     "खण्डितं रूपमेवात्र विकारोऽपि विकारिणः।",
     "कार्यकारणयोश्चैव तथैव गुणतद्वतोः॥ ११॥",
     "क्रियाक्रियावतोस्तद्वत् तथा जातिविशेषयोः।",
     "विशिष्टशुद्धयोश्चैव तथैवांशांशिनोरपि॥ १२॥"
    ],
    "variants": [
     {
      "pathanatara": "“द्विधा तच्च” इति प्रचलितपाठ इति गोविन्दाचार्याः। कृपाठे तु नैवं पठ्यते।"
     },
     {
      "bg_patha": "“क्रियाक्रियावतोश्चैव तथैवांशांशिनोरपि॥ १२”",
      "trk_patha": "“क्रियाक्रियावतोस्तद्वत् तथा जातिविशेषयोः”"
     },
     {
      "trk_patha": "“विशिष्टशुद्धयोश्चैव तथैवांशांशिनोरपि॥ १२”"
     }
    ]
   }
  ],
  "e4ebbd97-0919-4721-9338-e7669fda610a": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "उपसंहारः"
    ],
    "heading_level": 1
   }
  ],
  "f1e2179e-03c0-4c30-ab2b-30d64db68f5b": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "य एतत् परतन्त्रं तु सर्वमेव हरेः सदा।",
     "वशमित्येव जानाति संसारान्मुच्यते हि सः॥ १३ ॥"
    ]
   }
  ],
  "b8393786-b0cf-425f-a10e-d2b68c258b9e": [
   {
