      "bg_patha": "“निवर्तेदसंशयम्॥”",
      "trk_patha": "“निवर्तेदसंशयः॥”"
     },
     {
      "bg_patha": "“परब्रह्मादिवस्तु”",
      "trk_patha": "“परब्रह्मादिवस्तु तत्”",
      "pathanatara": "अन्यथाज्ञातमिति मुद्रणदोषः कृपाठे।"
     },
     {
      "bg_patha": "“विष्णुरव्ययः॥”",
      "trk_patha": "“विष्णुरच्युतः॥”"
