    "is_padya": true,
    "text": [
     "अतो",
     "विकल्पः",
     "शरीरादिसम्बन्धः",
     "केनचित्",
     "अज्ञानादिना कारणेन",
     "कल्पितः",
     "अपि",
     "उपदेशात्",
     "निवर्तते।",
     "अयं",
     "सतां",
     "वादः -",
     "ज्ञाते",
     "सति परब्रह्मणि",
     "द्वैतम्",
     "अन्यथाज्ञानं",
     "निवर्तते",
     "इति।",
     "“विकल्पो देहबन्धादिः केनचित् कारणेन तु।",
     "कल्पितो विनिवर्तेत",
     "गुरुवाक्यादसंशयः।",
     "एष एव सतां वादो ज्ञाते ब्रह्मणि तत्त्वतः।",
     "निवर्ततेऽन्यथाज्ञानं तत आनन्दमेत्यसौ॥”",
     "इति च॥*॥"
