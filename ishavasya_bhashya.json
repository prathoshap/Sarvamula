  "fd6e2fe6-ef88-414b-8b7c-371e5635b1d5": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "यस्मिन्नयं",
     "स्थितः सोऽप्यमृतः, किमु परः?",
     "अः ब्रह्मैव निलयनं यस्य वायोः सः",
     "अनिलम्।",
     "“अतिरोहितविज्ञानाद् वायुरप्यमृतः स्मृतः।",
     "मुख्यामृतः स्वयं रामः परमात्मा सनातनः॥”",
     "इति रामसंहितायाम्।",
     "“भक्तानां स्मरणं विष्णोर्नित्यज्ञप्तिस्वरूपतः।",
     "अनुग्रहोन्मुखत्वं तु नैवान्यत् क्वचिदिष्यते॥”",
     "इति ब्रह्मतर्के।"
    ],
    "pramana": true,
    "variants": [
     {
      "bg_patha": "“यस्मिन् प्राणे”",
