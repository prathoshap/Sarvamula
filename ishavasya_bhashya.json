    "heading_level": 0
   }
  ],
  "189ebc13-b0ec-4de8-8afe-2c6943bdb11b": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "ॐ पू॒र्णम॒दः पूर्णमि॒दं पू॒र्णात् पू॒र्णमु॑दच्यते।",
     "पू॒र्णस्य॑ पू॒र्णमा॒दाय॑ पू॒र्णमे॒वाव॑ शिष्यते॥",
     "ओ३म् शान्तिः॒ शान्तिः॒ शान्तिः॑॥ ०॥"
    ]
   }
  ],
  "b17b6a3b-62c0-4551-9fb9-a5a9acb605f3": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "ॐ॥ नित्यानित्यजगद्धात्रे नित्याय ज्ञानमूर्तये।",
     "पूर्णानन्दाय हरये सर्वयज्ञभुजे नमः॥ *॥",
     "यस्माद् ब्रह्मेन्द्ररुद्रादिदेवतानां श्रियोऽपि च।",
     "ज्ञानस्फूर्तिः सदा तस्मै हरये गुरवे नमः॥ *॥"
    ]
   }
  ],
  "bedd395d-d76b-4e19-aaca-b248b90a5f60": [
   {
    "content_type": "Heading1",
    "is_padya": false,
    "text": [
     "उपनिषत्"
    ],
    "heading_level": 1
   }
  ],
  "bd287824-289a-4b3d-90e3-5557d82518fe": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "ॐ॥ ई॒शावा॒स्य॑मि॒दꣳ सर्वं॒ यत्किञ्च॒ जग॑त्यां॒ जग॑त्।",
     "तेन॑ त्य॒क्तेन॑ भुञ्जीथा॒ मा गृ॑धः॒ कस्य॑ स्वि॒द्धन॑म्॥ १॥"
    ]
   }
  ],
  "190c6ce8-fa9c-4599-9f40-7c5e9dfd7cc8": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "स्वायम्भुवो मनुरेतैर्मन्त्रैर्भगवन्तमाकूतिसूनुं यज्ञनामानं विष्णुं तुष्टाव।",
     "“स्वायम्भुवः स्वदौहित्रं विष्णुं यज्ञाभिधं मनुः।",
     "ईशावास्यादिभिर्मन्त्रैस्तुष्टावावहितात्मना।",
     "रक्षोभिरुग्रैः सम्प्राप्तः खादितुं मोचितस्तदा।",
     "स्तोत्रं श्रुत्वैव यज्ञेन तान् हत्वाऽवध्यतां गतान्।",
     "प्रादाद्धि भगवांस्तेषामवध्यत्वं हरः प्रभुः।",
     "तैर्वध्यत्वं तथाऽन्येषामतः कोऽन्यो हरेः प्रभुः॥”",
     "इति ब्रह्माण्डे।",
     "भागवते",
     "चायमेवार्थ उक्तः।",
     "ईशस्यावासयोग्यम्‌",
     "ईशावास्यम्।",
     "जगत्यां",
     "प्रकृतौ",
     "तेन",
     "ईशेन",
     "त्यक्तेन",
     "दत्तेन",
     "भुञ्जीथाः।",
     "“स्वतः प्रवृत्त्यशक्तत्वादीशावास्यमिदं जगत्।",
     "प्रवृत्तये प्रकृतिगं यस्मात् स प्रकृतीश्वरः।",
     "तदधीनप्रवृत्तित्वात् तदीयं सर्वमेव यत्।",
     "तद्दत्तेनैव भुञ्जीथा अतो नान्यं प्रयाचयेत्॥”",
     "इति ब्राह्मे।"
    ],
    "pramana": true,
    "variants": [
     {
      "bg_patha": "“चायमर्थ एवोक्तः”",
      "trk_patha": "“चायमेवार्थ उक्तः”"
     },
     {
      "bg_patha": "“ईशस्य वासयोग्यम्‌”",
      "trk_patha": "“ईशस्यावासयोग्यम्‌”"
     },
     {
      "bg_patha": "“इति ब्राह्मे”",
      "trk_patha": "“इति ब्रह्माण्डे”"
     }
    ],
    "footnote": [
     "ब्राह्मेति वामनपण्डिताचार्यसम्मतः पाठः। पूर्वत्र ब्रह्माण्डस्य प्रकृतत्वात् पुनस्तस्य नामतो ग्रहणमस्वरसं च स्यात्।"
    ]
   }
  ],
  "70941d6a-90c1-441c-8d65-0e9d672596d6": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "कु॒र्वन्ने॒वेह कर्मा॑णि जिजीवि॒षेच्छ॒तꣳ समाः॑।",
     "ए॒वं त्वयि॒ नान्यथे॒तो॑ऽस्ति॒ न कर्म॑ लिप्यते॒ नरे॑॥ २॥"
    ]
   }
  ],
  "91ce17b9-0781-4d50-8367-47cb955b53ee": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "अकुर्वतः",
     "कर्म न लिप्यते",
     "इति नास्ति।",
     "“अज्ञस्य कर्म लिप्येत कृष्णोपास्तिमकुर्वतः।",
     "ज्ञानिनोऽपि यतो ह्रास आनन्दस्य भवेद् ध्रुवम्।",
     "अतोऽलेपेऽपि लेपः स्यादतः कार्यैव सा सदा॥”",
     "इति नारदीये।"
    ],
    "pramana": true
   }
  ],
  "efc84fc0-4287-438b-a125-954aeb248eba": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "अ॒सु॒र्या॒ नाम॑ ते लो॒का अ॒न्धेन॒ तम॒साऽऽवृ॑ताः।",
     "ताꣳस्ते प्रेत्या॒भि ग॑च्छन्ति॒ ये के चा॑त्म॒हनो॒ जनाः॑॥ ३॥"
    ]
   }
  ],
  "f7217cd8-f99a-4a0d-971a-bd5d04af9162": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "सुष्ठु रमणविरुद्धत्वादसुराणां प्राप्यत्वाच्चासुर्याः।",
     "“नच",
     "रमन्त्यहो असदुपासनयाऽऽत्महनः”",
     "इत्युक्तत्वात्।",
     "“महादुःखैकहेतुत्वात् प्राप्यत्वादसुरैस्तथा।",
     "असुर्या नाम ते लोकास्तान् यान्ति विमुखा हरौ॥”",
     "इति वामने।",
     "ये के च",
     "इति",
     "नियम उक्तः।",
     "“नियमेन तमो यान्ति सर्वेऽपि विमुखा",
     "हरौ”",
     "इति च।"
    ],
    "pramana": true,
    "kutra": [
     "भागवतम् १०/९४/२४"
    ],
    "variants": [
     {
      "bg_patha": "“न खलु”",
      "trk_patha": "“नच”"
     },
     {
      "bg_patha": "“इत्यनेन”",
      "trk_patha": "“इति”"
     },
     {
      "bg_patha": "“हरेः”",
      "trk_patha": "“हरौ”"
     }
    ]
   }
  ],
  "a04e21d8-0b6a-4ac6-a12b-92f846748021": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "अने॑ज॒देकं॒ मन॑सो॒ जवी॑यो॒ नैन॑द् दे॒वा आ॑प्नुव॒न् पूर्व॒मर्ष॑त्।",
     "तद् धाव॑तो॒ऽन्यानत्ये॑ति॒ तिष्ठ॒त् तस्मि॑न्न॒पो मा॑त॒रिश्वा॑ दधाति॥ ४॥"
    ]
   }
  ],
  "de791a39-acf8-467b-81c6-fa8990afc75f": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“अनेजन्निर्भयत्वात् तदेकं प्राधान्यतस्तथा।",
     "सम्यग्ज्ञातुमशक्यत्वादगम्यं तत् सुरैरपि।",
     "स्वयं तु",
     "सर्वानगमत्",
     "पूर्वमेव स्वभावतः।",
     "अचिन्त्यशक्तितश्चैव सर्वगत्वाच्च तत् परम्।",
     "द्रवतोऽत्येति सन्तिष्ठत् तस्मिन् कर्माण्यधान्मरुत्।",
     "मारुत्येव यतश्चेष्टा सर्वा तां हरयेऽर्पयेत्॥”",
     "इति ब्रह्माण्डे।",
     "“ऋष ज्ञाने”।"
    ],
    "pramana": true,
    "variants": [
     {
      "bg_patha": "“सर्वानुगमात्”",
      "trk_patha": "“सर्वानगमत्”"
     },
     {
      "pathanatara": "सन्तिष्ठन्निति प्राचीनपाठो गोविन्दाचार्यैरुल्लिखितः।"
     }
    ]
   }
  ],
  "c7f7fef6-8d87-4a36-9ab1-51f0fa56ca50": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "तदे॑जति॒ तन्नै॑जति॒ तद् दू॒रे तद्व॑न्ति॒के।",
     "तद॒न्तर॑स्य॒ सर्व॑स्य॒ तदु॒ सर्व॑स्यास्य बाह्य॒तः॥ ५॥"
    ]
   }
  ],
  "17de8589-578b-421d-9d0b-3ab734839dce": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "तदेजति",
     "तत एव एजत्यन्यत्।",
     "तत्",
     "स्वयं",
     "नेजति।",
     "“ततो बिभेति सर्वोऽपि न बिभेति हरिः स्वयम्।",
     "सर्वगत्वात् स दूरे च बाह्येऽन्तश्च समीपगः॥”",
     "इति तत्त्वसंहितायाम्।"
    ],
    "pramana": true,
    "variants": [
     {
      "bg_patha": "“तत एजत्यन्यत्”",
      "trk_patha": "“तत एव एजत्यन्यत्”"
     },
     {
      "pathanatara": "दूरगत्वादिति प्राचीनपाठो गोविन्दाचार्यैरुल्लिखितः।"
     }
    ]
   }
  ],
  "0c46eb4e-a838-4522-a3aa-ba9bbea78c3f": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "यस्तु सर्वा॑णि भू॒तान्या॒त्मन्ने॒वानु॒पश्य॑ति।",
     "स॒र्व॒भू॒तेषु॑ चा॒त्मानं॒ ततो॒ न वि जु॑गुप्सते॥ ६॥"
    ]
   }
  ],
  "2827a344-db05-4e36-843e-411106b3ac9a": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“सर्वगं परमात्मानं सर्वं च परमात्मनि।",
     "यः पश्येत् स भयाभावान्नात्मानं गोप्तुमिच्छति॥”",
     "इति सौकरायणश्रुतिः।"
    ],
    "pramana": true
   }
  ],
  "b1900ce8-7950-495c-a612-815b3394ce14": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "यस्मि॒न् सर्वा॑णि भू॒तान्या॒त्मैवाभू॑द् विजान॒तः।",
     "तत्र॒ को मोहः॒ कः शोक॑ एक॒त्वम॑नु॒पश्य॑तः॥ ७॥"
    ]
   }
  ],
  "8a5fb9c0-504a-4cd0-a525-f73b88697b11": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "यस्मिन्",
     "परमात्मनि सर्वभूतानि स परमात्मैव",
     "तत्र",
     "सर्वभूतेष्वभूत्।",
     "एवं सर्वभूतेष्वेकत्वेन परमात्मानं",
     "विजानतः को मोहः?",
     "“यस्मिन् सर्वाणि भूतानि स आत्मा सर्वभूतगः।",
     "एवं सर्वत्र यो विष्णुं पश्येत् तस्य विजानतः।",
     "को मोहः कोऽथवा शोकः स विष्णुं",
     "पर्यगाद् यतः॥”",
     "इति पिप्पलादशाखायाम्।",
     "पूर्वोक्तानुवादेन",
     "शोकमोहाभावोऽपि",
     "विजानतश्चात्रोच्यते।",
     "अभ्यासश्च सर्वगतत्वस्य तात्पर्यद्योतनार्थः।"
    ],
    "pramana": true,
    "variants": [
     {
      "bg_patha": "“पर्यगादतः॥”",
      "trk_patha": "“पर्यगाद् यतः॥”"
     },
     {
      "bg_patha": "“शोकमोहाभावो”",
      "trk_patha": "“शोकमोहाभावोऽपि”"
     }
    ]
   }
  ],
  "866e19e5-9964-45ab-8927-e7d677de06c3": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "स पर्य॑गाच्छु॒क्रम॑का॒यम॑व्र॒णम॑स्नावि॒रꣳ शु॒द्धमपा॑पविद्धम्।",
     "क॒विर्म॑नी॒षी प॑रि॒भूः स्व॑य॒म्भूर्या॑थातथ्य॒तोऽर्था॒न् व्य॑दधाच्छाश्व॒तीभ्यः॒ समा॑भ्यः॥ ८॥"
    ]
   }
  ],
  "38d2bc9f-035f-453b-93da-380f1f646a66": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“शुक्रं",
     "तच्छोकराहित्यादव्रणं",
     "नित्यपूर्णतः।",
     "पावनत्वात् सदा",
     "शुद्धमकायं",
     "लिङ्गवर्जनात्।",
     "स्थूलदेहस्य राहित्यादस्नाविरमुदाहृतम्।",
     "एवम्भूतोऽपि",
     "सार्वज्ञात्",
     "कविरित्येव शब्द्यते।",
     "ब्रह्मादिसर्वमनसां",
     "प्रकृतेर्मनसोऽपिच।",
     "ईशितृत्वान्मनीषी स परिभूः सर्वतो वरः।",
     "सदाऽनन्याश्रयत्वाच्च स्वयम्भूः परिकीर्तितः।",
     "स सत्यं जगदेतादृङ् नित्यमेव प्रवाहतः।",
     "अनाद्यनन्तकालेषु",
     "प्रवाहैकप्रकारतः।",
     "नियमेनैव ससृजे भगवान् पुरुषोत्तमः।",
     "सज्ज्ञानानन्दशीर्षोऽसौ सज्ज्ञानानन्दबाहुकः।",
     "सज्ज्ञानानन्ददेहश्च सज्ज्ञानानन्दपादवान्।",
     "एवम्भूतो महाविष्णुर्यथार्थं जगदीदृशम्।",
     "अनाद्यनन्तकालीनं ससर्जात्मेच्छया प्रभुः॥”",
     "इति वाराहे।"
    ],
    "pramana": true,
    "variants": [
     {
      "bg_patha": "“तच्छोकराहित्यादब्रणं”",
      "trk_patha": "“तच्छोकराहित्यादव्रणं”"
     },
     {
      "bg_patha": "“शुद्ध अकायं”",
      "trk_patha": "“शुद्धमकायं”",
      "pathanatara": "अत्र यद्यपि शुद्धमित्येव गोविन्दाचार्यपाठे मुद्रितम्। किन्तु, उपरितनतदीयटिप्पण्यनुसारेण पुंलिङ्गपाठस्तत्राभिमत इति स्पष्टम्।"
     },
     {
      "bg_patha": "“सार्वज्ञ्यात्”",
      "trk_patha": "“सार्वज्ञात्”"
     },
     {
      "bg_patha": "“प्रकृत्या मनसोऽपिच”",
      "trk_patha": "“प्रकृतेर्मनसोऽपिच”"
     },
     {
      "bg_patha": "“प्रवाहैकप्रकारकम्”",
      "trk_patha": "“प्रवाहैकप्रकारतः”"
     }
    ]
   }
  ],
  "cb00d5ef-007b-44b6-9183-787e3889364d": [
   {
    "content_type": "Mula",
    "is_padya": true,
    "text": [
     "अ॒न्धं तमः॒ प्र वि॑शन्ति॒ येऽवि॑द्यामु॒पास॑ते।",
     "ततो॒ भूय॑इव॒ ते तमो॒ य उ॑ वि॒द्याया॑ꣳ र॒ताः॥ ९॥",
     "अ॒न्यदे॒वाहुर्वि॒द्यया॒ऽन्यदा॑हु॒रवि॑द्याया।",
     "इति॑ शुश्रुम॒ धीरा॑णां॒ ये न॒स्तद् व्या॑चचक्षि॒रे॥ १०॥",
     "वि॒द्यां चावि॑द्यां च॒ यस्तद्वेदो॒भय॑ꣳ स॒ह।",
     "अवि॑द्यया मृ॒त्युं ती॒र्त्वा वि॒द्यया॒ऽमृत॑मश्नुते॥ ११॥",
     "अ॒न्धं तमः॒ प्रवि॑शन्ति॒ येऽस॑म्भूतिमु॒पास॑ते।",
     "ततो॒ भूय॑इव॒ ते तमो॒ य उ॒ सम्भू॑त्याꣳ र॒ताः॥ १२॥",
     "अ॒न्यदे॒वाहुः स॑म्भ॒वाद॒न्यदा॑हु॒रस॑म्भवात्।",
     "इति॑ शुश्रुम॒ धीरा॑णां॒ ये न॒स्तद् व्या॑चचक्षि॒रे॥ १३॥",
     "संभू॑तिं च विना॒शं च॒ यस्तद्वेदो॒भय॑ꣳ स॒ह।",
     "वि॒ना॒शेन॑ मृ॒त्युं ती॒र्त्वा सम्भू॑त्या॒ऽमृत॑मश्नुते॥ १४॥"
    ]
   }
  ],
  "654e0264-155a-4adb-aba7-50d87284b08d": [
   {
    "content_type": "Sarvamula",
    "is_padya": true,
    "text": [
     "“अन्यथोपासका ये तु तमोऽन्धं यान्त्यसंशयम्।",
     "ततोऽधिकमिव व्यक्तं यान्ति तेषामनिन्दकाः।",
     "तस्माद्‌ यथास्वरूपं तु नारायणमनामयम्।",
     "अयथार्थस्य निन्दां च",
     "ये विदुः सह",
     "सज्जनाः।",
     "ते[ऽ]निन्दयाऽयथार्थस्य दुःखाज्ञानादिरूपिणः।",
     "दुःखाज्ञानादिसन्तीर्णाः सुखज्ञानादिरूपिणः।",
     "यथार्थस्य परिज्ञानात् सुखज्ञानादिरूपताम्।",
     "यान्त्येवं",
     "सृष्टिकर्तृत्वं नाङ्गीकुर्वन्ति ये हरेः।",
     "तेऽपि यान्ति तमो घोरं तथा संहारकर्तृताम्।",
     "नाङ्गीकुर्वन्ति तेऽप्येवं तस्मात् सर्वगुणात्मकम्।",
     "सर्वकर्तारमीशेशं",
     "सर्वसंहारकारणम्।",
     "यो वेद संहृतिज्ञानाद् देहबन्धाद्‌ विमुच्यते।",
     "सुखज्ञानादिकर्तृत्वज्ञानात्",
     "तद्व्यक्तिमाव्रजेत्।",
     "सर्वदोषविनिर्मुक्तं गुणरूपं जनार्दनम्।",
     "जानीयान्न गुणानां च भागहानिं प्रकल्पयेत्।",
     "न मुक्तानामपि हरेः साम्यं विष्णोरभिन्नताम्।",
     "नैव प्रचिन्तयेत् तस्माद् ब्रह्मादेः साम्यमेव वा।",
     "मानुषादिविरिञ्चान्तं तारतम्यं विमुक्तिगम्।",
     "ततो विष्णोः परोत्कर्षं सम्यग् ज्ञात्वा विमुच्यते॥”",
     "इति कौर्मे।"
    ],
    "pramana": true,
    "variants": [
     {
      "bg_patha": "“ये विदुस्ते हि”",
